{
  "mcpServers": {
    "conductor": {
      "args": [
        "--project",
        "crypto"
      ],
      "command": "conductor-mcp",
      "type": "stdio"
    },
    "isolab": {
      "command": "bash",
      "args": ["-c", "exec bash \"$(git rev-parse --show-toplevel)/scripts/isolab-agent.sh\" mcp nats"],
      "type": "stdio"
    },
    "isolab-eks": {
      "command": "bash",
      "args": ["-c", "exec bash \"$(git rev-parse --show-toplevel)/scripts/isolab-agent.sh\" mcp eks"],
      "type": "stdio"
    },
    "ecdb": {
      "type": "http",
      "url": "https://l6zg6lz4dr45t75p5qn5aocnme0pckrm.lambda-url.us-west-2.on.aws/mcp",
      "headers": {
        "Authorization": "Bearer ${ECDB_TOKEN:-}"
      }
    },
    "cairn": {
      "args": [
        "--log",
        "${HOME}/.cairn/cairn.jsonl",
        "--root",
        "${HOME}/.cairn",
        "mcp"
      ],
      "command": "cairn",
      "type": "stdio"
    }
  }
}
