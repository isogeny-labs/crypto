# cp terraform.tfvars.example terraform.tfvars and edit. terraform.tfvars is
# gitignored; nothing secret belongs in it anyway (the AUTH token is generated).

region = "us-west-2"
name   = "taskq"

# Narrow the Kubernetes API to where you run Terraform and kubectl from.
cluster_endpoint_public_access_cidrs = ["203.0.113.0/24"]

# Pin the image by commit sha so results name exactly what ran.
image = { repository = "ghcr.io/aburan28/taskq-worker", tag = "latest" }

cpu_spot_instance_types = ["c7i.2xlarge", "c7a.2xlarge", "c6i.2xlarge", "m7i.2xlarge"]
# Keep AWS GPU provisioning disabled; the retained GPU is on RunPod.
gpu_spot_instance_types = []
# Pin a validated AMI release before applying in production.
karpenter_ami_alias = "al2023@latest"
enable_keda = true

pools = [
  # crypto / crypto-autoresearcher jobs
  { name = "cpu", queues = ["cpu"], replicas = 0, node_group = "cpu",
    cpu = "6", memory = "12Gi", labels = { pool = "cpu-spot" },
    keda = { min_replicas = 0, max_replicas = 20 } }, # used when enable_keda = true
  # cryptanalysis `ca` jobs, with its toolchain image
  { name = "ca-cpu", queues = ["ca-cpu"], replicas = 0, node_group = "cpu",
    cpu = "6", memory = "12Gi", labels = { pool = "cpu-spot" },
    image = { repository = "ghcr.io/aburan28/cryptanalysis-taskq-cpu", tag = "latest" },
    keda = { min_replicas = 0, max_replicas = 20 } },
]
