  "title":"Trusted resumable native ecbench computation and one fresh L2 epoch",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","run_name","deadline_unix_seconds","build","runtime_image_uri","spec","instance_type","checkpoint_interval_seconds","max_restores"],
  "properties":{
    "worker_campaign":{"type":["object","null"],"additionalProperties":false,"required":["policy","ledger_uid","computation_ceiling_seconds","fresh_ceiling_seconds","shutdown_reserve_seconds"],"properties":{"policy":{"type":"object","additionalProperties":false,"required":["schema","authorization_sha256","cumulative_ceiling_seconds","absolute_deadline_unix_seconds","latest_scientific_stop_unix_seconds","allocation_unit","route_spec_sha256","prior_charge_seconds","reconciliation_receipt_sha256","owner_enforcement_review_sha256"],"properties":{"schema":{"const":"isolab.worker-admission-policy/v1"},"authorization_sha256":{"const":"201df07743540ac247e2ae0ec79c82c7b284aa16dd07d468924c87cf2a4b7a2b"},"cumulative_ceiling_seconds":{"const":25200},"absolute_deadline_unix_seconds":{"const":1793398120},"latest_scientific_stop_unix_seconds":{"type":"integer","minimum":1,"maximum":1793396320},"allocation_unit":{"const":"conservative_worker_allocation_seconds"},"route_spec_sha256":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"prior_charge_seconds":{"type":"integer","minimum":0,"maximum":25200},"reconciliation_receipt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"owner_enforcement_review_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"ledger_uid":{"type":"string","pattern":"^[A-Za-z0-9-]{1,128}$"},"computation_ceiling_seconds":{"type":"integer","minimum":0,"maximum":25200},"fresh_ceiling_seconds":{"type":"integer","minimum":0,"maximum":25200},"shutdown_reserve_seconds":{"type":"integer","minimum":60,"maximum":25200}}},
    "fresh_owner":{"type":["object","null"],"additionalProperties":false,"required":["schema","binary_sha256","stop_utc_seconds"],"properties":{"schema":{"const":"isolab.fresh-owner-admission/v1"},"binary_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"stop_utc_seconds":{"type":"integer","minimum":1}}},
    "schema":{"const":"isolab.eks.resumable/v1"},
    "run_name":{"type":"string","maxLength":32,"pattern":"^[a-z](?:[a-z0-9-]*[a-z0-9])?$"},
    "deadline_unix_seconds":{"type":"integer","minimum":1,"description":"Original absolute UTC deadline; never reset by retries. New runs need 180..86400 seconds."},
    "build":{"type":"object","additionalProperties":false,"required":["image_uri","source_revision","ecbench_sha256"],"properties":{
      "image_uri":{"type":"string","pattern":"^104186811093\\.dkr\\.ecr\\.us-east-2\\.amazonaws\\.com/isolab/tasks@sha256:[a-f0-9]{64}$"},
      "source_revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},
      "ecbench_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
    }},
    "runtime_image_uri":{"type":"string","pattern":"^104186811093\\.dkr\\.ecr\\.us-east-2\\.amazonaws\\.com/isolab/tasks@sha256:[a-f0-9]{64}$","description":"Trusted recovery layer over the build image. The native binary hash must match build.ecbench_sha256."},
    "spec":{"type":"object","description":"Original ecbench.spec/v1 requiring L2, warmup >=1, rounds >=5, reference and matching A/A. Native controller and ecbench apply semantic validation."},
    "instance_type":{"const":"c8a.2xlarge"},
    "checkpoint_interval_seconds":{"type":"integer","minimum":30,"maximum":900},
    "max_restores":{"type":"integer","minimum":1,"maximum":5},
    "memory":{"type":"string","enum":["4Gi","8Gi"],"default":"4Gi","description":"Shared computation and fresh L2 memory request/limit. Omission preserves legacy 4Gi request identity; 8Gi must be explicit."},
    "diagnostic_transport":{"type":["object","null"],"additionalProperties":false,"required":["schema","computation","fresh"],"properties":{"schema":{"const":"isolab.diagnostic-transport/v1"},"computation":{"type":"object","additionalProperties":false,"required":["raw_json","sha256","spec_bytes_sha256"],"properties":{"raw_json":{"type":"string","minLength":1,"maxLength":65536,"description":"Exact decoded UTF-8 launch bytes; native validation also enforces a 65536-byte bound."},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"spec_bytes_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"fresh":{"type":"object","additionalProperties":false,"required":["raw_json","sha256","spec_bytes_sha256"],"properties":{"raw_json":{"type":"string","minLength":1,"maxLength":65536,"description":"Exact decoded UTF-8 launch bytes; native validation also enforces a 65536-byte bound."},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"spec_bytes_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},"description":"Optional independently frozen computation-L0 and fresh-L2 launches. Native validation preserves the 65536-byte total request cap and verifies all exact-byte hashes."}
  }
