{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "resume-process-restored",
    "namespace": "isolab-recovery-system",
    "labels": {
      "isolab.dev/recovery-probe": "true"
    },
    "annotations": {
      "karpenter.sh/do-not-disrupt": "true"
    }
  },
  "spec": {
    "activeDeadlineSeconds": 1800,
    "automountServiceAccountToken": false,
    "containers": [
      {
        "command": [
          "/bin/bash",
          "-ec",
          "LD_LIBRARY_PATH=/work/tools/lib /work/tools/criu check; sleep 1700"
        ],
        "image": "104186811093.dkr.ecr.us-east-2.amazonaws.com/isolab/tasks@sha256:67eea58f5d4a7a8882b55f089c6063bb49fad58d40260ee9b0ceb349fc0e4581",
        "imagePullPolicy": "IfNotPresent",
        "name": "supervisor",
        "resources": {
          "limits": {
            "cpu": "2",
            "memory": "2Gi"
          },
          "requests": {
            "cpu": "2",
            "memory": "2Gi"
          }
        },
        "securityContext": {
          "privileged": true,
          "runAsGroup": 0,
          "runAsUser": 0
        },
        "terminationMessagePath": "/dev/termination-log",
        "terminationMessagePolicy": "File",
        "volumeMounts": [
          {
            "mountPath": "/work",
            "name": "work"
          }
        ]
      }
    ],
    "dnsPolicy": "ClusterFirst",
    "enableServiceLinks": true,
    "nodeSelector": {
      "isolab.dev/pool": "cpu-spot",
      "node.kubernetes.io/instance-type": "c8a.2xlarge"
    },
    "preemptionPolicy": "PreemptLowerPriority",
    "priority": 0,
    "restartPolicy": "Never",
    "schedulerName": "default-scheduler",
    "securityContext": {},
    "serviceAccount": "default",
    "serviceAccountName": "default",
    "terminationGracePeriodSeconds": 30,
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "isolab.dev/workload",
        "operator": "Equal",
        "value": "cpu"
      },
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/not-ready",
        "operator": "Exists",
        "tolerationSeconds": 300
      },
      {
        "effect": "NoExecute",
        "key": "node.kubernetes.io/unreachable",
        "operator": "Exists",
        "tolerationSeconds": 300
      }
    ],
    "volumes": [
      {
        "name": "work",
        "persistentVolumeClaim": {
          "claimName": "resume-process-restored"
        }
      }
    ]
  }
}
