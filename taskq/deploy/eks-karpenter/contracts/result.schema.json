{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iso Lab EKS launcher result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "job_name",
    "job_uid",
    "pod_uid",
    "results_uri",
    "receipt_uri",
    "request_sha256",
    "launcher",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "isolab.eks.result/v1"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "launcher_failed",
        "submission_unknown",
        "identity_mismatch",
        "verification_failed",
        "launcher_timed_out"
      ]
    },
    "job_name": {
      "type": "string"
    },
    "job_uid": {
      "type": "string"
    },
    "pod_uid": {
      "type": "string"
    },
    "results_uri": {
      "type": "string"
    },
    "receipt_uri": {
      "type": "string"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "launcher": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    }
  }
}
