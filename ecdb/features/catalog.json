    {"key":"factor_base.artifact_bytes","version":1,"scope":"factor_base","data_type":"integer","unit":"bytes","nullable":true,"description":"Sum of known sizes of linked artifacts.","source_expression":"v_factor_base_ml_features.artifact_bytes"},

    {"key":"fbm.oracle","version":1,"scope":"factor_base_measurement","data_type":"category","nullable":true,"description":"FBM1 decomposition or relation oracle.","source_expression":"v_factor_base_measurement_ml_features.oracle","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
    {"key":"fbm.solver","version":1,"scope":"factor_base_measurement","data_type":"category","nullable":true,"description":"FBM1 solver identity.","source_expression":"v_factor_base_measurement_ml_features.solver","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
    {"key":"fbm.linalg","version":1,"scope":"factor_base_measurement","data_type":"category","nullable":true,"description":"FBM1 linear-algebra identity.","source_expression":"v_factor_base_measurement_ml_features.linalg","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
