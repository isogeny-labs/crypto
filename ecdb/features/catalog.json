{
  "schema": "ecdb.feature_catalog/v1",
  "description": "Versioned structural, factor-base and measurement features for curve comparison, index-calculus studies and reproducible ML exports. Null is never zero; observations retain status, context and provenance.",
  "features": [
    {"key":"field.kind","version":1,"scope":"curve","data_type":"category","nullable":false,"description":"Exact base-field kind.","source_expression":"v_curve_ml_features.field_kind"},
    {"key":"field.characteristic","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Base-field characteristic as an exact integer.","source_expression":"v_curve_ml_features.characteristic"},
    {"key":"field.degree","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Absolute degree over the prime field.","source_expression":"v_curve_ml_features.field_degree"},
    {"key":"field.order_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit length of the finite-field order q.","source_expression":"v_curve_ml_features.field_bits"},
    {"key":"curve.family","version":1,"scope":"curve","data_type":"category","nullable":true,"description":"Producer family such as koblitz, census-f2m, crypto-prime or pairing-bn.","source_expression":"v_curve_ml_features.family"},
    {"key":"curve.genus","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Curve genus.","source_expression":"v_curve_ml_features.genus"},
    {"key":"curve.model","version":1,"scope":"curve","data_type":"category","nullable":false,"description":"Exact stored curve model.","source_expression":"v_curve_ml_features.model"},
    {"key":"curve.j_is_0","version":1,"scope":"curve","data_type":"boolean","nullable":true,"description":"Whether the genus-one j-invariant is zero.","source_expression":"v_curve_ml_features.j_is_0"},
    {"key":"curve.j_is_1728","version":1,"scope":"curve","data_type":"boolean","nullable":true,"description":"Whether the genus-one j-invariant is 1728 under the repository characteristic-2/3 convention.","source_expression":"v_curve_ml_features.j_is_1728"},
    {"key":"curve.j_field_degree","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Least subfield degree containing j.","source_expression":"v_curve_ml_features.j_field_degree"},
    {"key":"isogeny_class.label","version":1,"scope":"curve","data_type":"category","nullable":true,"description":"Stored finite-field isogeny-class label determined by the Weil polynomial.","source_expression":"v_curve_ml_features.isogeny_class_label"},
    {"key":"isogeny_class.curve_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of stored curve models whose Jacobians link to the same finite-field isogeny class.","source_expression":"v_curve_ml_features.isogeny_class_curve_count"},
    {"key":"frobenius.trace","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Exact Frobenius trace.","source_expression":"v_curve_ml_features.trace"},
    {"key":"frobenius.trace_ratio","version":1,"scope":"curve","data_type":"number","nullable":true,"description":"Size-normalized trace t/(2 sqrt(q)).","source_expression":"v_curve_ml_features.trace_ratio"},
    {"key":"frobenius.discriminant","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Frobenius discriminant t^2-4q.","source_expression":"v_curve_ml_features.frobenius_discriminant"},
    {"key":"frobenius.discriminant_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit length of the absolute Frobenius discriminant.","source_expression":"v_curve_ml_features.frobenius_discriminant_bits"},
    {"key":"frobenius.is_ordinary","version":1,"scope":"curve","data_type":"boolean","nullable":true,"description":"Ordinarity of the finite-field isogeny class.","source_expression":"v_curve_ml_features.is_ordinary"},
    {"key":"frobenius.is_supersingular","version":1,"scope":"curve","data_type":"boolean","nullable":true,"description":"Supersingularity of the finite-field isogeny class.","source_expression":"v_curve_ml_features.is_supersingular"},
    {"key":"frobenius.is_anomalous","version":1,"scope":"curve","data_type":"boolean","nullable":true,"description":"Whether the group order is divisible by the characteristic.","source_expression":"v_curve_ml_features.is_anomalous"},
    {"key":"cm.fundamental_discriminant","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Fundamental discriminant of the imaginary quadratic Frobenius field.","source_expression":"v_curve_ml_features.cm_discriminant"},
    {"key":"cm.frobenius_conductor","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Index [O_K:Z[pi]].","source_expression":"v_curve_ml_features.frobenius_conductor"},
    {"key":"cm.frobenius_conductor_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit length of [O_K:Z[pi]].","source_expression":"v_curve_ml_features.conductor_bits"},
    {"key":"cm.frobenius_conductor_fraction","version":1,"scope":"curve","data_type":"number","nullable":true,"description":"log(v)/log(sqrt(abs(Delta))).","source_expression":"v_curve_ml_features.conductor_fraction"},
    {"key":"cm.maximal_order_class_number","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Class number h(d_K) of the maximal imaginary quadratic order.","source_expression":"v_curve_ml_features.class_number"},
    {"key":"endomorphism.kind","version":1,"scope":"curve","data_type":"category","nullable":true,"description":"Stored endomorphism-ring kind.","source_expression":"v_curve_ml_features.endomorphism_kind"},
    {"key":"endomorphism.discriminant","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Discriminant of End(E).","source_expression":"v_curve_ml_features.endomorphism_discriminant"},
    {"key":"endomorphism.discriminant_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit length of the absolute End(E) discriminant.","source_expression":"v_curve_ml_features.endomorphism_discriminant_bits"},
    {"key":"endomorphism.conductor","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Conductor [O_K:End(E)].","source_expression":"v_curve_ml_features.endomorphism_conductor"},
    {"key":"endomorphism.is_maximal","version":1,"scope":"curve","data_type":"boolean","nullable":true,"description":"Whether End(E) is the maximal order.","source_expression":"v_curve_ml_features.endomorphism_is_maximal"},
    {"key":"endomorphism.class_number","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Class number h(End(E)) of the stored imaginary quadratic order.","source_expression":"v_curve_ml_features.endomorphism_class_number"},
    {"key":"endomorphism.class_group_rank","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Number of invariant factors in Cl(End(E)).","source_expression":"v_curve_ml_features.endomorphism_class_group_rank"},
    {"key":"endomorphism.class_group_two_rank","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Dimension of Cl(End(E))[2].","source_expression":"v_curve_ml_features.endomorphism_class_group_two_rank"},
    {"key":"automorphism.base_field_order","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Order of the automorphism group over the base field.","source_expression":"v_curve_ml_features.automorphism_group_order"},
    {"key":"automorphism.geometric_order","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Order of the geometric automorphism group.","source_expression":"v_curve_ml_features.geometric_automorphism_group_order"},
    {"key":"group.order_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit length of the Jacobian group order over the base field.","source_expression":"v_curve_ml_features.group_order_bits"},
    {"key":"subgroup.order_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit length of the primary recorded target subgroup.","source_expression":"v_curve_ml_features.subgroup_bits"},
    {"key":"subgroup.cofactor","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Cofactor of the primary recorded target subgroup.","source_expression":"v_curve_ml_features.subgroup_cofactor"},
    {"key":"pairing.embedding_degree","version":1,"scope":"curve","data_type":"integer","nullable":true,"description":"Embedding degree of the primary recorded target subgroup.","source_expression":"v_curve_ml_features.embedding_degree"},
    {"key":"pairing.target_field_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Bit size of the pairing target field.","source_expression":"v_curve_ml_features.target_field_bits"},
    {"key":"security.rho_log2","version":1,"scope":"curve","data_type":"number","unit":"log2 group operations","nullable":true,"description":"Recorded heuristic generic rho cost before automorphism folding.","source_expression":"v_curve_ml_features.rho_log2"},
    {"key":"security.rho_log2_folded","version":1,"scope":"curve","data_type":"number","unit":"log2 group operations","nullable":true,"description":"Recorded heuristic rho cost after its stated automorphism fold.","source_expression":"v_curve_ml_features.rho_log2_folded"},
    {"key":"security.twist_largest_prime_bits","version":1,"scope":"curve","data_type":"integer","unit":"bits","nullable":true,"description":"Largest recorded prime-factor bit length for the primary quadratic twist.","source_expression":"v_curve_ml_features.twist_largest_prime_bits"},
    {"key":"graph.relation_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of explicit typed curve relations incident to the curve.","source_expression":"v_curve_ml_features.relation_count"},
    {"key":"graph.isomorphism_relation_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of explicit isomorphism relations incident to the exact model.","source_expression":"v_curve_ml_features.isomorphism_relation_count"},
    {"key":"graph.isogeny_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of explicit stored isogenies incident to the curve.","source_expression":"v_curve_ml_features.isogeny_count"},
