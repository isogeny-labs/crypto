    {"key":"factor_base.strict_points","version":1,"scope":"factor_base","data_type":"integer","unit":"points","nullable":true,"description":"Strict point count retained by the producer.","source_expression":"v_factor_base_ml_features.strict_points"},
    {"key":"factor_base.result_count","version":1,"scope":"factor_base","data_type":"integer","nullable":false,"description":"Number of linked result rows.","source_expression":"v_factor_base_ml_features.result_count"},
    {"key":"factor_base.solved_count","version":1,"scope":"factor_base","data_type":"integer","nullable":false,"description":"Number of linked results that recovered and verified their planted target.","source_expression":"v_factor_base_ml_features.solved_count"},
    {"key":"factor_base.best_s_solved","version":1,"scope":"factor_base","data_type":"number","unit":"GAE per sqrt(r)","nullable":true,"description":"Minimum solved S for this factor base; a best case, not an arm summary.","source_expression":"v_factor_base_ml_features.best_s_solved"},
    {"key":"factor_base.median_s_solved","version":1,"scope":"factor_base","data_type":"number","unit":"GAE per sqrt(r)","nullable":true,"description":"Median solved S over linked results.","source_expression":"v_factor_base_ml_features.median_s_solved"},
