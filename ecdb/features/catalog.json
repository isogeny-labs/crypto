    {"key":"factor_base.abscissae","version":1,"scope":"factor_base","data_type":"integer","unit":"x coordinates","nullable":true,"description":"Number of distinct abscissae in the inventory.","source_expression":"v_factor_base_ml_features.abscissae","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
    {"key":"factor_base.columns","version":1,"scope":"factor_base","data_type":"integer","unit":"matrix columns","nullable":true,"description":"Relation-matrix columns after the stated quotient rule.","source_expression":"v_factor_base_ml_features.columns","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
    {"key":"factor_base.dimension","version":1,"scope":"factor_base","data_type":"integer","nullable":true,"description":"Constructor dimension when defined.","source_expression":"v_factor_base_ml_features.dimension"},
