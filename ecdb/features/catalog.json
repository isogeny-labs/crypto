    {"key":"factor_base.measurement_count","version":1,"scope":"factor_base","data_type":"integer","nullable":false,"description":"Number of linked FBM1 configurations.","source_expression":"v_factor_base_ml_features.measurement_count"},
    {"key":"factor_base.points_stored","version":1,"scope":"factor_base","data_type":"integer","unit":"points","nullable":false,"description":"Number of point rows materialized in Postgres.","source_expression":"v_factor_base_ml_features.points_stored"},
    {"key":"factor_base.artifact_count","version":1,"scope":"factor_base","data_type":"integer","nullable":false,"description":"Number of linked content-addressed artifacts.","source_expression":"v_factor_base_ml_features.artifact_count"},
