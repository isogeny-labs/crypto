    {"key":"graph.morphism_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of stored curve morphisms incident to the curve.","source_expression":"v_curve_ml_features.morphism_count"},
    {"key":"graph.explicit_endomorphism_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of explicit endomorphisms recorded for the curve.","source_expression":"v_curve_ml_features.explicit_endomorphism_count"},
    {"key":"graph.volcano_level_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of primes with a recorded endomorphism level for the curve.","source_expression":"v_curve_ml_features.volcano_level_count"},
    {"key":"curve.factor_base_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of factor bases linked to the curve.","source_expression":"v_curve_ml_features.factor_base_count"},
    {"key":"curve.factor_base_result_count","version":1,"scope":"curve","data_type":"integer","nullable":false,"description":"Number of factor-base result rows linked to the curve.","source_expression":"v_curve_ml_features.factor_base_result_count"},
    {"key":"curve.best_s_solved","version":1,"scope":"curve","data_type":"number","unit":"GAE per sqrt(r)","nullable":true,"description":"Minimum recorded solved S over the curve's factor bases; a best case, not an arm summary.","source_expression":"v_curve_ml_features.best_s_solved"},
    {"key":"transfer.max_formula_ratio_log2","version":1,"scope":"curve","data_type":"number","nullable":true,"description":"Maximum stored formula-estimated transfer ratio. This is not a measured speedup.","source_expression":"v_curve_ml_features.max_transfer_ratio_log2"},

    {"key":"factor_base.scheme","version":1,"scope":"factor_base","data_type":"category","nullable":false,"description":"Identity scheme: FB1, archive, FBS1 spec or pointset.","source_expression":"v_factor_base_ml_features.scheme","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
    {"key":"factor_base.family","version":1,"scope":"factor_base","data_type":"category","nullable":false,"description":"Factor-base construction family.","source_expression":"v_factor_base_ml_features.factor_base_family","semantics_uri":"docs/ecbench/FACTOR_BASE_PROTOCOL.md"},
