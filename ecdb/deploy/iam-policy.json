{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeNetworkAndRds",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeAvailabilityZones",
        "rds:DescribeDBInstances",
        "rds:DescribeDBSubnetGroups",
        "rds:DescribeDBEngineVersions",
        "rds:DescribeOrderableDBInstanceOptions",
        "rds:DescribeDBParameters",
        "rds:DescribeDBParameterGroups",
        "rds:DescribeEvents",
        "logs:DescribeLogGroups",
        "secretsmanager:GetRandomPassword"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-2"
        }
      }
    },
    {
      "Sid": "CreateSecurityGroupInVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-west-2:104186811093:vpc/*"
    },
    {
      "Sid": "CreateOnlyEcdbTaggedSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:us-west-2:104186811093:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/project": "ecdb"
        }
      }
    },
    {
      "Sid": "TagOnlyOnSecurityGroupCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-west-2:104186811093:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSecurityGroup"
        }
      }
    },
    {
      "Sid": "ManageOnlyEcdbTaggedSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-west-2:104186811093:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "ecdb"
        }
      }
    },
    {
      "Sid": "EcdbRdsInstanceAndSubnetGroup",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:RebootDBInstance",
        "rds:DeleteDBInstance",
        "rds:CreateDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:DeleteDBSubnetGroup",
        "rds:CreateDBSnapshot",
        "rds:AddTagsToResource",
        "rds:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:rds:us-west-2:104186811093:db:ecdb*",
        "arn:aws:rds:us-west-2:104186811093:subgrp:ecdb*",
        "arn:aws:rds:us-west-2:104186811093:snapshot:ecdb*",
        "arn:aws:rds:us-west-2:104186811093:pg:default.postgres*",
        "arn:aws:rds:us-west-2:104186811093:og:default:postgres*",
        "arn:aws:rds:us-west-2:104186811093:secgrp:*"
      ]
    },
    {
      "Sid": "KmsForRdsStorageAndLambdaEnvDefaultKeysOnly",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:CreateGrant",
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "rds.us-west-2.amazonaws.com",
            "lambda.us-west-2.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "EcdbSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:TagResource",
        "secretsmanager:DeleteSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-west-2:104186811093:secret:ecdb/*"
    },
    {
      "Sid": "EcdbLambdaFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:InvokeFunction",
        "lambda:DeleteFunction",
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:GetFunctionUrlConfig",
        "lambda:DeleteFunctionUrlConfig",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:TagResource",
        "lambda:ListTags",
        "lambda:PutFunctionConcurrency"
      ],
      "Resource": "arn:aws:lambda:us-west-2:104186811093:function:ecdb-*"
    },
    {
      "Sid": "PassOnlyTheEcdbExecutionRoleToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::104186811093:role/ecdb-lambda-exec",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "EcdbLambdaLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-west-2:104186811093:log-group:/aws/lambda/ecdb-*",
        "arn:aws:logs:us-west-2:104186811093:log-group:/aws/lambda/ecdb-*:*"
      ]
    }
  ]
}