# Copy to .env (git ignores it) and fill in. Never commit the filled file.

# Postgres superuser of the local database (migrations, bootstrap, sync).
ECDB_ADMIN_PASSWORD=
# Password of ecdb_api, the read-only login the API connects as.
ECDB_API_PASSWORD=

# Read token of the deployed API, used only by `docker compose run --rm sync`.
# It is the `read_token` field of AWS Secrets Manager secret `ecdb/api`.
ECDB_TOKEN=
# Copy from another ecdb instead of the deployed one:
# ECDB_URL=https://l6zg6lz4dr45t75p5qn5aocnme0pckrm.lambda-url.us-west-2.on.aws
# true: let `sync` overwrite a local catalogue that already holds rows.
ECDB_SYNC_REPLACE=false

# Bearer token clients on the LAN must send. Empty: reads are open on the LAN.
ECDB_LAN_TOKEN=
# Host port of the API and MCP endpoint.
ECDB_PORT=8080
# Where Postgres keeps its files (a NAS share path works, e.g. /volume1/docker/ecdb/pgdata).
ECDB_DATA_DIR=./pgdata
