Mc=matrix(125,3,r,i,lift(cf(Km[i])[r])); fv=vecextract(cf(fm),"1..125")~; 
sol=matsolve(Mod(1,13)*Mc, Mod(1,13)*fv)~; print("f = combo of K with coeffs ",sol);
print("ker vec ",ker~);
