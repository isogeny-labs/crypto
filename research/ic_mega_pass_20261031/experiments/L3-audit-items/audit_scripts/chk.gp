while(cnt<400, a=random(t); b=random(t); g=subst(substvec(f,[x,y],[a,b]),z,'Z); if(poldegree(g)<1,next); R=polrootsmod(g,t); if(#R==0,next); for(i=1,#R, c=R[i]; cnt++; if(substvec(f,[x,y,z],[a,b,c])!=0,error("nf")); if(a^13==a && b^13==b && c^13==c, inF13++); listput(V,[a,b,c])));
