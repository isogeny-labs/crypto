default(parisizemax,500000000);
S3(x1,x2,x3,a,b)=(x1-x2)^2*x3^2-2*((x1+x2)*(x1*x2+a)+2*b)*x3+(x1*x2-a)^2-4*b*(x1+x2);
t1()={my(bad=0,a,b,x1,x2,d);
for(t=1,2000,a=random(1000)-500;b=random(1000)-500;x1=random(100)-50;x2=random(100)-50;if(x1==x2,next);
 d=poldisc(S3(x1,x2,'z,a,b));
 if(d!=16*(x1^3+a*x1+b)*(x2^3+a*x2+b),bad++));
print("disc identity bad=",bad)};
t2()={my(p=10007,a=3,b=7,E=ellinit([a,b],p),bad=0,cnt=0,P1,P2,s,d);
for(t=1,300,P1=random(E);P2=random(E);if(P1==[0]||P2==[0]||P1[1]==P2[1],next);
 s=elladd(E,P1,P2);d=elladd(E,P1,ellneg(E,P2));
 if(s==[0]||d==[0],next);cnt++;
 if(S3(lift(P1[1]),lift(P2[1]),lift(s[1]),a,b)%p!=0,bad++);
 if(S3(lift(P1[1]),lift(P2[1]),lift(d[1]),a,b)%p!=0,bad++));
print("S3 vs group law: checked ",cnt," pairs, bad=",bad)};
t3()={my(bad=0,q,a,b,d,E,Ed);
for(t=1,200,q=nextprime(random(20000)+100);a=random(q);b=random(q);if((4*a^3+27*b^2)%q==0,next);
 d=2;while(kronecker(d,q)!=-1,d++);
 E=ellinit([a,b],q);Ed=ellinit([a*d^2%q,b*d^3%q],q);
 if(ellcard(E)+ellcard(Ed)!=2*q+2,bad++));
print("twist order sum bad=",bad)};
t1();t2();t3();
