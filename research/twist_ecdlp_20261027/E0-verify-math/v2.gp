default(parisizemax,2000000000);
orbs(p)={my(seen=Map(),res=List());
 for(a=0,p-1,for(b=0,p-1, if((4*a^3+27*b^2)%p==0,next); my(k=a*p+b); if(mapisdefined(seen,k),next);
  my(n=0,o=Map()); for(u=1,p-1,my(a2=(u^4*a)%p,b2=(u^6*b)%p,k2=a2*p+b2); if(!mapisdefined(o,k2),mapput(o,k2,1);mapput(seen,k2,1);n++));
  listput(res,[a,b,n])));Vec(res)};
one(p)={my(c=orbs(p),ng=0,w=0,s=0,d=2,E,E2,nE,nEt,r,a,b);
 while(kronecker(d,p)!=-1,d++);
 for(i=1,#c, a=c[i][1];b=c[i][2];E=ellinit([a,b],p);nE=ellcard(E);
   E2=ellinit([d^2*a,d^3*b],p);nEt=ellcard(E2);
   if(nE+nEt!=2*p+2,error("order"));
   r=#polrootsmod(Mod(1,p)*(x^3+a*x+b));
   if(r>0,ng++); if((nE%2==0)!=(r>0),error("parity"));
   w+=c[i][3]; s+=nE*nEt);
 print("own p=",p," classes=",#c," weight=",w," g2gt1=",ng," sum_nE_nEt=",s);
 s};
tot=0;
forprime(p=5,31,tot+=one(p));
print("own sum p=5..31: ",tot);
p5()={my(nev=0,ntot=0,cnt,seenb,b);
 forprime(p=101,199, cnt=0;
  for(a=0,p-1, seenb=vector(p); for(x=0,p-1, b=(-x^3-a*x)%p; if((4*a^3+27*b^2)%p!=0, seenb[b+1]=1)); cnt+=vecsum(seenb));
  nev+=cnt; ntot+=p^2-p);
 print("own P5: even=",nev," total=",ntot," frac=",nev/ntot*1.)};
p5();
