digraph n83_image {
  graph [rankdir=TB, bgcolor="white", pad="0.12", nodesep="0.35", ranksep="0.48", fontname="Arial", label="N83 Colima toolchain provision | 2026-11-16T00:14Z", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#44637d", fillcolor="#ecf3f8", margin="0.15,0.1"];
  edge [fontname="Arial", fontsize=10, color="#425466"];
  dockerfile [label="Tracked Dockerfile\nSHA-256 93e2eada...", fillcolor="#ecf3f8"];
