digraph stop {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad="0.3"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#2b5274", fontname="Helvetica"];
  h2 [label="Clean H2 source\na30e6749"];
  sparse [label="Repository sparse helper\ntracked dependency paths"];
  stop [label="BSD realpath rejects -m\nsparse helper exits", fillcolor="#ffe7e4", color="#a13d34"];
  pending [label="No Cargo build\nNo S3 stage or solver", fillcolor="#fff3dc", color="#976b1d"];
  h2 -> sparse -> stop -> pending;
}
