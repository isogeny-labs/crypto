digraph stop {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad="0.3"];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#2b5274", fontname="Helvetica"];
  h2 [label="Clean H2\nGNU sparse + Cargo metadata pass"];
  build [label="Rust 1.99.1 release build\n346 s outer interval\nisogeny_algos reached"];
  stop [label="Boot free 4,388,412 KiB\nbelow 5 GiB floor\nwatcher sent TERM; exit 143", fillcolor="#ffe7e4", color="#a13d34"];
  pending [label="No arm binary\nNo S3 stage or solver", fillcolor="#fff3dc", color="#976b1d"];
  h2 -> build -> stop -> pending;
}
