digraph admission {
  graph [rankdir=TB, bgcolor="white", pad="0.12", nodesep="0.35", ranksep="0.48", fontname="Arial", label="N83 Colima build admission | 2026-11-16T00:25Z", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=13, color="#44637d", fillcolor="#ecf3f8", margin="0.15,0.1"];
  edge [fontname="Arial", fontsize=10, color="#425466"];
  source [label="Clean source + plan\n12 GiB cgroup observed"];
  first [label="Attempt 1: invalid pass\nGit alternate warning", fillcolor="#fbeae7", color="#b9564e"];
  restart [label="Colima restart\nGit alternate mounted RO", fillcolor="#ecf3f8"];
  second [label="Attempt 2: PASS\nHEAD object + no Git stderr", fillcolor="#e1f2e7", color="#287d45"];
  build [label="Native bootstrap + charged build\nPENDING", fillcolor="#fff4df", color="#bc8a2b"];
  {rank=same; source; first; restart;}
  {rank=same; second; build;}
  source -> first;
  first -> restart;
  restart -> second;
  second -> build [style=dashed];
}
