SetSeed(20261115);
R<x> := PolynomialRing(GF(2));
K<z> := ext<GF(2) | x^35+x^2+1>;
k := GF(32);
Embed(k,K);

function FromMask(n, z)
    v := Parent(z)!0;
    for i in [0..34] do
        if (n div 2^i) mod 2 eq 1 then
            v +:= z^i;
        end if;
    end for;
    return v;
end function;

b := FromMask(9698245,z);
E := EllipticCurve([K | 1,1,0,0,b]);
assert #E eq 34359894078;
C,h := WeilDescent(E,k,K!1);
assert Genus(C) eq 8;
J := Jacobian(C);
E0 := EllipticCurve([k | 1,1,0,0,1]);
assert #E0 eq 22;
t := 2^35+1-#E;
u := 33-#E0;
ZZT<T> := PolynomialRing(Integers());
expected := (1-u*T+32*T^2)*(1-t*T^7+32^7*T^14);
cpu := Cputime();
actual := EulerFactor(J);
print "euler_cpu_sec", Cputime(cpu);
print "source_trace", t;
print "base_trace", u;
print "expected", expected;
print "actual", actual;
print "factorization_matches", actual eq expected;
print "order_product", Evaluate(expected,1);
print "jacobian_order", #J;
assert actual eq expected;
assert Evaluate(actual,1) eq #J;
assert #J eq #E*#E0;
