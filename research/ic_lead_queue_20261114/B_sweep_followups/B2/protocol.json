  "decision_rule": {
    "text": "Gates: G1 verify --replay-all 0 problems in K1 and PC; G2 A/A paired counts identical (kang, rho-neg, bsgs-neg); G3 positive controls (a) rho-plain/rho-neg lower end above 1.2 and point in [1.25, 1.60], (b) bsgs-tb/bsgs-neg lower end above 1.2 and point in [1.43, 1.55]; G4 at least 90% complete pairs, no arm censored above 1%. Verdict on R = S(kang)/S(rho-plain), pooled, w = 0, interval [L, U]: dominated_supported if L >= 1.3 and U <= 2.4; dominated_below_range if 1.0 < L < 1.3 and U <= 2.4; dominated_above_range if L >= 1.3 and U > 2.4; dominated_wide if 1.0 < L < 1.3 and U > 2.4; unresolved if the interval contains 1; kangaroo_cheaper if U < 1; any gate failure is inconclusive. See PROTOCOL.md section 8.",
    "comparison_ids": [
      "C-R",
      "C-R-NEG"
    ],
    "threshold": "R interval against [1.3, 2.4] and 1",
    "statistic": "ratio of total cost over pooled paired workloads, charged at w = 0 (0.1 and 1 reported)",
    "interval": "ecbench compare workload-cluster bootstrap, 4,000 resamples, seed 275055567897761",
    "multiple_comparison_correction": "none",
    "effect_size_measure": "R and R - 1 in percent; distance to matched rho",
    "verdict_vocabulary": [
      "dominated_supported",
      "dominated_below_range",
      "dominated_above_range",
      "dominated_wide",
      "unresolved",
      "kangaroo_cheaper",
      "inconclusive"
    ]
  },
