  "question": "On the six 33- to 41-bit prime-order curves of the medium-tier studies, is the paired S ratio R = S(kangaroo.vow_v2)/S(rho.plain) at w = 0 inside [1.3, 2.4]?",
  "claims": [
    {
      "id": "K1",
      "text": "Every counted run recovers its planted target and replays identically.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "K2",
      "text": "The pooled 95% interval of S(kang)/S(rho-plain) at w = 0 lies inside [1.3, 2.4].",
      "class": "comparative",
      "decided_by": [
        "C-R"
      ],
      "if_supported": "closed_dominated stays, with a sealed medium-tier number",
      "if_not_supported": "the range is corrected from data (below, above or wide), or the row is reopened if the interval reaches 1"
    },
    {
      "id": "K3",
      "text": "Every full-group method here is at or above matched rho (the distance remaining).",
      "class": "comparative",
      "decided_by": [
        "C-R-NEG"
      ],
      "if_supported": "reported as the distance remaining, not as a gate",
      "if_not_supported": "a method below matched rho would be escalated to the breakthrough reviewers"
    },
    {
      "id": "K4",
      "text": "Nothing here is a security statement about any curve or about ECDLP at cryptographic sizes.",
      "class": "out_of_scope",
      "decided_by": []
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "On the full group, a two-kangaroo DP solver costs between 1.3 and 2.4 times matched r-adding rho (rho.plain).",
      "mechanism": "kangaroo needs about 2 sqrt(r) steps against about 1.25 sqrt(r) for rho before overheads",
      "predictions": [
        {
          "id": "P1",
          "metric": "s",
          "direction": "higher",
          "minimum_effect": "R about 1.5 (range 1.4 to 1.65): declared expected S 2.0 over the rho.plain floor 1.2533 gives 1.60; atlas 2.203 x floor over measured rho.plain 1.487 x floor gives 1.48; against rho.negation 2.203/1.067 = 2.06 (derived)",
          "provenance": {
            "written_at": "2026-11-14",
            "first_recorded_in": "research/ic_lead_queue_20261114/B_sweep_followups/B2/PROTOCOL.md",
