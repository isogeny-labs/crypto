  "question": "On two fresh 20-bit prime-order curves, does any factor-base size N in {56, 64, 80, 91} give a lower charged S than N = 45 for the pair-table IC oracle at all three section 5a weights (w = 0, 0.1, 1)?",
  "claims": [
    {
      "id": "K1",
      "text": "Every counted run recovers its planted or public target and replays identically.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "K2",
      "text": "For at least one N in {56, 64, 80, 91}, S(N) / S(45) has an upper 95% interval end below 1 at w = 0, 0.1 and 1 and a per-curve ratio below 1 on both curves.",
      "class": "comparative",
      "decided_by": [
        "C-NEXT"
      ],
      "if_supported": "a gain candidate for the 20-bit baseline, to be re-measured on further fresh curves and replayed on a second host before any gain claim",
      "if_not_supported": "relabelling or null: N = 45 stays the 20-bit baseline"
    },
    {
      "id": "K3",
      "text": "Every IC arm is above matched rho (the distance remaining).",
      "class": "comparative",
      "decided_by": [
        "C-GAP"
      ],
      "if_supported": "reported as the distance remaining, not as a gate",
      "if_not_supported": "a parity crossing would be escalated to the breakthrough reviewers"
    },
    {
      "id": "K4",
      "text": "Nothing here is a security statement about any curve or about ECDLP at cryptographic sizes.",
      "class": "out_of_scope",
      "decided_by": []
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "At least one N in {56, 64, 80, 91} is cheaper than N = 45 in S at every band weight on both fresh curves (rule gain).",
      "mechanism": "a larger base lowers the trials per relation but adds table work; the optimum depends on the weight of native operations",
      "predictions": [
        {
          "id": "P1",
          "metric": "s",
          "direction": "lower",
          "minimum_effect": "none predicted: H0 expected. On the train curve S(64)/S(45) = 1.048, 1.015, 0.881 at w = 0, 0.1, 1 (derived from select/band-train-P20.md); the order flips across the band, verdict relabelling for N = 64.",
          "provenance": {
            "written_at": "2026-11-14",
            "first_recorded_in": "research/ic_lead_queue_20261114/B_sweep_followups/B1/PROTOCOL.md",
            "data_seen": [
              {
                "path": "research/prime_base_oracle_tuning_20261029/select/band-train-P20.md",
