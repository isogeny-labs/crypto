              },
              {
                "path": "research/prime_base_oracle_tuning_20261029/README.md",
                "measured": "holdout n45/n32 0.818 [0.773, 0.866], 0.798 [0.752, 0.847], 0.726 [0.677, 0.778] at w = 0, 0.1, 1"
              }
            ],
            "sample_status": "out_of_sample"
          },
          "role": "decisive"
        }
      ]
    }
  ],
