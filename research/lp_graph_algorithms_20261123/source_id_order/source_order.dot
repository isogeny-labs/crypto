digraph SourceOrder {
  graph [rankdir=LR, bgcolor="white", pad="0.22", nodesep="0.28", ranksep="1.3", label="Canonicalize whole (source ID, coefficient) pairs", labelloc=t, fontname="DejaVu Sans", fontsize=16];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12", color="#CBD5E1"];
  edge [penwidth=2, arrowsize=0.8];
  subgraph left { rank=same;
    a [label="Input position 0\nID MAX | coefficient ell-3", fillcolor="#DBEAFE"];
    b [label="Input position 1\nID 0 | coefficient ell-2", fillcolor="#FEF3C7"];
    c [label="Input position 2\nID 42 | coefficient 1", fillcolor="#D1FAE5"];
  }
  subgraph right { rank=same;
    d [label="Canonical position 0\nID 0 | coefficient ell-2", fillcolor="#FEF3C7"];
    e [label="Canonical position 1\nID 42 | coefficient 1", fillcolor="#D1FAE5"];
    f [label="Canonical position 2\nID MAX | coefficient ell-3", fillcolor="#DBEAFE"];
  }
  a -> b -> c [style=invis];
  d -> e -> f [style=invis];
  a -> f [color="#2563EB"];
  b -> d [color="#D97706"];
  c -> e [color="#059669"];
}
