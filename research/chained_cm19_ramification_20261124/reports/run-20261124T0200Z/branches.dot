digraph branch {
 graph [rankdir=LR,bgcolor="white",nodesep="0.30",ranksep="1.05",pad="0.12"];
 node [shape=box,style="rounded,filled",fillcolor="#edf4f8",color="#375e76",fontname="DejaVu Sans",fontsize=12,margin="0.15,0.10"];
 edge [color="#365c73",arrowsize=0.7,fontname="DejaVu Sans",fontsize=10];
 subgraph sources {rank=same;p4[label="(1 : 4 : 5)"];p5[label="(1 : 5 : 5)"];pa[label="(1 : α : 5)"];pb[label="(1 : 3−α : 5)"];p4->p5->pa->pb[style=invis];}
 subgraph targets {rank=same;r7[label="(3, 2)",fillcolor="#e8f3e9"];r4[label="(3, 5)",fillcolor="#e8f3e9"];qa[label="(3−α, 4−α)",fillcolor="#e8f3e9"];qb[label="(α, 1+α)",fillcolor="#e8f3e9"];r7->r4->qa->qb[style=invis];}
 p4->r7[label="f₄, e=2"];p5->r4[label="f₄, e=2"];pa->qa[label="f₄, e=2"];pb->qb[label="f₄, e=2"];
 pa->pb[dir=both,style=dashed,color="#8d5b23",constraint=false,label="Frob₇"];
 qa->qb[dir=both,style=dashed,color="#8d5b23",constraint=false,label="Frob₇"];
}
