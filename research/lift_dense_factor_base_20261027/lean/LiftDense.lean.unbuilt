/-
  Lift-dense factor bases: the twisted-line theorem (draft, NOT BUILT).

  Status: written 2026-10-27 against Mathlib (the repository's pin,
  rev d13f23b7, toolchain leanprover/lean4:v4.34.1) but never compiled.
  This session could not install a Lean toolchain: the elan installer
  download was refused by the session's permission policy. The file
  therefore carries the `.unbuilt` suffix, so the repository proof gate does
  not treat it as a proof. Rename it to `LiftDense.lean` inside a Lake project
  (lakefile below) and run `lake build` + `#print axioms` to check it. Until
  then nothing here is a verified proof; see PROOF_MAP.md.

  Suggested lakefile.toml:
    name = "lift_dense"
    defaultTargets = ["LiftDense"]
    [[require]]
    name = "mathlib"
    scope = "leanprover-community"
    rev = "v4.34.1"
    [[lean_lib]]
    name = "LiftDense"
-/
import Mathlib

namespace LiftDense

open Algebra

variable {K L M : Type*} [Field K] [Field L] [Field M]
  [Algebra K L] [Algebra L M] [Algebra K M] [IsScalarTower K L M]
  [FiniteDimensional K L] [FiniteDimensional L M]

/-- Trace tower for a scalar multiple: for `y ∈ L` and `u ∈ M`,
`Tr_{M/K}(y u) = Tr_{L/K}(y · Tr_{M/L}(u))`. (Report: Lemma 1.) -/
theorem trace_mul_algebraMap (y : L) (u : M) :
    trace K M (algebraMap L M y * u) = trace K L (y * trace L M u) := by
  rw [← Algebra.trace_trace (R := K) (S := L) (T := M)]
  congr 1
  rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]

/-- Twisted-line theorem, trace form (Report: Theorem 2). If
`Tr_{M/L}(u) = 0` and `Tr_{M/L}(c u⁻¹) = 0`, then for every nonzero `y ∈ L`
the absolute trace of `x + a + c/x` at `x = y u` equals `Tr_{M/K}(a)`. -/
theorem twisted_line_trace_const (u c a : M) (hu : trace L M u = 0)
    (hcu : trace L M (c * u⁻¹) = 0) (y : L) (hy : y ≠ 0) :
    trace K M (algebraMap L M y * u + a + c * (algebraMap L M y * u)⁻¹)
      = trace K M a := by
  have h1 : trace K M (algebraMap L M y * u) = 0 := by
    rw [trace_mul_algebraMap, hu, mul_zero, map_zero]
  have h2 : c * (algebraMap L M y * u)⁻¹ = algebraMap L M y⁻¹ * (c * u⁻¹) := by
    rw [mul_inv, map_inv₀]; ring
  have h3 : trace K M (c * (algebraMap L M y * u)⁻¹) = 0 := by
    rw [h2, trace_mul_algebraMap, hcu, mul_zero, map_zero]
  rw [map_add, map_add, h1, h3, zero_add, add_zero]

end LiftDense

/-
  Open obligations (not attempted in this draft; see PROOF_MAP.md):
  O1  Artin–Schreier criterion over a finite field of characteristic 2:
      `∃ z, z^2 + z = w ↔ Tr_{M/F_2}(w) = 0`. This is the bridge from the
      trace statement above to "x lifts to E(F_q)".
  O2  `Tr(b/x^2) = Tr(sqrt(b)/x)` (Frobenius invariance of the absolute
      trace), connecting the curve equation to the `c/x` form.
  O3  The n = 2 / n = 3 / n = 4 u-count classification (Report:
      Proposition 3), including the degenerate quadratic case.
-/
