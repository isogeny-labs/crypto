namespace KoblitzRound12Boundary
inductive Gate where
 | input | constant | add (a b : Nat) | mul (a b : Nat) | frob (a : Nat) | inv (a : Nat)
 deriving Inhabited, DecidableEq
def eval (g : Gate) (i : Nat) (z : Array Bool) : Bool :=
 match g with
 | .input => true
 | .constant => !(z[i]!)
 | .add a b => z[i]! == ((z[a]!).xor (z[b]!))
 | .mul a b => !((z[a]!) && (z[b]!))
 | .frob a => z[i]! == z[a]!
 | .inv a => !((z[a]!) && (z[i]!))
def check (p : Array Gate) (z : Array Bool) (r : Array Nat) : Bool :=
 (p.toList.zipIdx.all fun gi => eval gi.1 gi.2 z) &&
 (r.toList.all fun i => !(z[i]!))
