def sparseEval (g : Gate) (i : Nat) (z : List Nat) : Bool :=
 match g with
 | .input => true
 | .constant => !(z.contains i)
 | .add a b => z.contains i == ((z.contains a).xor (z.contains b))
 | .mul a b => !((z.contains a) && (z.contains b))
 | .frob a => z.contains i == z.contains a
 | .inv a => !((z.contains a) && (z.contains i))
def sparseCheck (p : Array Gate) (z : List Nat) (r : Array Nat) : Bool :=
 (p.toList.zipIdx.all fun gi => sparseEval gi.1 gi.2 z) && (r.toList.all fun i => !(z.contains i))
def quad (z : List Nat) (q : Nat × Nat × Nat × Nat) : Bool := ((z.contains q.1) && (z.contains q.2.1)).xor ((z.contains q.2.2.1) && (z.contains q.2.2.2))
def extra (z : List Nat) (zeros : Array Nat) (eqs ps : Array (Nat × Nat)) (qs : List (Nat × Nat × Nat × Nat)) : Bool :=
 (zeros.toList.all fun i => !(z.contains i)) && (eqs.toList.all fun p => z.contains p.1 == z.contains p.2) && (ps.toList.all fun p => !((z.contains p.1) && (z.contains p.2))) && (qs.all fun q => !(quad z q))
