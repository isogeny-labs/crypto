import KoblitzRound18
namespace KoblitzRound18MapCounterexamples
def mul (a b:Nat) : Nat :=
 let raw:=(List.range 10).foldl (fun z i => if b.testBit i then Nat.xor z (a*2^i) else z) 0
 ((List.range 10).reverse).foldl (fun z i => if z.testBit (10+i) then Nat.xor z (1033*2^i) else z) raw
def residual (a x y:Nat) : Nat := Nat.xor (Nat.xor (Nat.xor (Nat.xor (mul y y) (mul x y)) (mul x (mul x x))) (mul a (mul x x))) 1
