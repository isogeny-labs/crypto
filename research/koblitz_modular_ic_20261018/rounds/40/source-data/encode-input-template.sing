proc export40(string category,int slot,poly value,link out){
 poly rebuilt=0;int k;intvec ex;
 write(out,category+" "+string(slot)+" "+string(size(value)));
 for(k=1;k<=size(value);k++){if(leadcoef(value[k])!=1){ERROR("ENC40_NONBINARY");}ex=leadexp(value[k]);if(size(ex)!=4){ERROR("ENC40_WIDTH");}write(out,string(ex));rebuilt=rebuilt+n^ex[1]*l^ex[2]*v^ex[3]*u^ex[4];}
 if(rebuilt!=value){ERROR("ENC40_RECONSTRUCTION");}return(1);
}

