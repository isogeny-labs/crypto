ring move27=0,(t),lp;
intmat M[5][5]=11,-5,-11,-7,0,0,11,-5,-11,-7,7,0,11,-5,-11,11,7,0,11,-5,5,11,7,0,11;
intvec z=1,2,4,8,5;intvec d=0,0,0,0,0;int i;int j;int x;
poly rel=11+7*t^2+11*t^3+5*t^4;ideal cyc=std(ideal(t^5+1));poly column;
for(j=1;j<=5;j++){
 column=0;for(i=1;i<=5;i++){column=column+M[i,j]*t^(i-1);}
 if(column!=reduce(t^(j-1)*rel,cyc)){ERROR("moving lattice not actual cusp relation");}
}
for(i=1;i<=5;i++){
 x=0;for(j=1;j<=5;j++){x=x+M[i,j]*z[j];}
 if(x%11!=0){ERROR("torsion coefficient is not integral");}d[i]=x div 11;
}
print("EXACT_POTENTIAL_11_TORSION_DIVISOR");d;
if(d!=intvec(-9,-11,-4,8,10)){ERROR("actual torsion divisor mismatch");}
intvec tz=-5,1,2,4,8;intvec eigen=-1,-1,-2,-4,-2;
for(i=1;i<=5;i++){if(tz[i]-6*z[i]!=11*eigen[i]){ERROR("integral T=6 class identity failed");}}
// Move a nonzero multiple into the complete R27 RR space by -div(lambda).
// This is bounded divisor reduction, not recovery or a map search.
int found=0;int k;int m0;int m1;int m2;int m3;int m4;int visits=0;
intvec mv;intvec moved;int ok;intvec coeff;
for(k=1;k<=10 && found==0;k++){
for(m0=-4;m0<=4 && found==0;m0++){
for(m1=-4;m1<=4 && found==0;m1++){
for(m2=-4;m2<=4 && found==0;m2++){
for(m3=-4;m3<=4 && found==0;m3++){
for(m4=-4;m4<=4 && found==0;m4++){
 visits=visits+1;mv=intvec(m0,m1,m2,m3,m4);moved=k*d;
 for(i=1;i<=5;i++){for(j=1;j<=5;j++){moved[i]=moved[i]+M[i,j]*mv[j];}}
 ok=1;
 for(i=1;i<=5;i++){
  if(i==2){if(moved[i]<-28 || moved[i]>21){ok=0;}}
  else{if(moved[i]<0 || moved[i]>11){ok=0;}}
 }
 if(ok==1){
  found=1;coeff=k*z+11*mv;
  for(i=1;i<=5;i++){
   x=0;for(j=1;j<=5;j++){x=x+M[i,j]*coeff[j];}
   if(x!=11*moved[i]){ERROR("moved 11-torsion principal certificate failed");}
  }
  print("MOVE27_FOUND k,translation,moved,11function_exponents,visits");
  k;mv;moved;coeff;visits;
  link output="ASCII:w move-certificate.sing";open(output);
  write(output,"int torsionMultiple="+string(k)+";");
  write(output,"intvec moved="+string(moved)+";");
  write(output,"intvec principalExponents="+string(coeff)+";");close(output);
 }
}
}
}
}
}
}
if(found==0){print("MOVE27_BOUNDED_NO_MOVEMENT visits="+string(visits));}
print("MOVE27_ALL_CHECKS_PASS");quit;
