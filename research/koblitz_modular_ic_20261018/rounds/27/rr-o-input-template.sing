for(enc=1;enc<=5;enc++){sourceTerms=insert(sourceTerms,encode27(original[enc]),size(sourceTerms));}
for(enc=1;enc<=8;enc++){registeredTerms=insert(registeredTerms,encode27(registered[enc]),size(registeredTerms));}
// Exact local charts on the retained degree-8-by-2 source tower.
option(redSB);
ring o=2,(q,y,l,t),dp;
poly E0=q+1+(1+t)*t^3*q^2;
ideal EB=std(ideal(E0));
poly cp=1+t+t^4*q+t^6*q^2;
poly rp=1+t^2*q+t^5*q^2;
poly b=t^3*q^3*rp*cp;
poly c=t^2*q^2*cp;
poly A=1+c;
poly delta=b+c*A^3;
poly Delta=b^3*delta;
poly C=b^4*(b^2+A^2*b+c*A^4);
poly d=Delta/t^11;poly e=C/t^14;
if(Delta!=t^11*d || C!=t^14*e){ERROR("tower coefficient division failed");}
print("O24_COEFFICIENT_UNIT_VALUES");
subst(subst(d,t,0),q,1);subst(subst(e,t,0),q,1);subst(subst(A,t,0),q,1);
if(subst(subst(d,t,0),q,1)!=1 || subst(subst(e,t,0),q,1)!=1 || subst(subst(A,t,0),q,1)!=1){ERROR("wrong O coefficient units");}
poly F=b*c^7+b^2*c^5+b*c^6+b^2*c^4+c^6+b^5+b^4*c+b^3*c^2+b^2*c^3;
print("O24_ORIGINAL_TATE_RESIDUAL");reduce(F,EB);
if(reduce(F,EB)!=0){ERROR("wrong Tate coordinate chart");}
// u=1/(t^2*q), v=1/(t^3*q); clear denominators in E, b and c.
poly cubic=q+t^3*q^2+1+t^4*q^2;
print("O24_CUBIC_CHART_RESIDUAL");reduce(cubic,EB);
if(reduce(cubic,EB)!=0){ERROR("wrong elliptic infinity chart");}
print("O24_ORIGINAL_BASE_COORDINATE_RESIDUALS");
reduce(c+t^2*q*(1+t*q*rp),EB);reduce(b+t^3*q^2*rp*(1+t*q*rp),EB);
if(reduce(c+t^2*q*(1+t*q*rp),EB)!=0 || reduce(b+t^3*q^2*rp*(1+t*q*rp),EB)!=0){ERROR("original base coordinate recovery failed");}
poly H0=t^10*y^8+t^3*d*y^2+A^2*d*y+e;
poly L0=l^2+A*l+t^3*y+b;
poly tower0=(t^3*y)^8+Delta*(t^3*y)^2+A^2*Delta*(t^3*y)+C;
if(tower0!=t^14*H0){ERROR("unramified tower identity failed");}
// Input: original ring r/circuit and nuEquation, then O24-charts prefix in o.
ring s=2,(w),dp;
int precision=768;
ideal cutoff=std(ideal(w^precision));
ideal checkcut=std(ideal(w^100));
proc tr(poly p){return(reduce(p,cutoff));}
proc invUnit(poly p){
 poly answer=1;int k;
 if(subst(p,w,0)!=1){ERROR("inverse input is not a unit");}
 for(k=1;k<=11;k++){answer=tr(p*answer^2);}
 if(tr(p*answer)!=1){ERROR("truncated unit inverse failed");}
 return(answer);
}
proc wVal(poly p){
 if(p==0){ERROR("order unresolved at retained precision");return(-999);}
 // In this univariate global ordering the last term has least exponent.
 return(deg(p[size(p)]));
}
proc recordOrder(string name,poly p){
 int value=wVal(p);
 print("ORDER "+name+" "+string(value)+" LEAD "+string(subst(p/w^value,w,0)));
 if(value<0 || value>=100){ERROR("valuation outside certified precision");}
}
int kind;int branch;int k;int j;
poly tt;poly qq;poly xx;poly yy;poly zz;poly bb;poly cc;poly aa;poly dd;poly ee;
poly ll;poly nnum;poly nden;poly nu;poly residue;int denorder;int numorder;
ideal lifted;ideal evaluatedUnits;
print("VALUATION_HELPER_CONTROLS");wVal(1+w^191);wVal(w+w^3);wVal(w^7+w^179);
if(wVal(1+w^191)!=0 || wVal(w+w^3)!=1 || wVal(w^7+w^179)!=7){ERROR("univariate valuation controls failed");}
// Append in the univariate seed ring s, with sourceTerms (integer lists).
// (p,e,P) represents w^e p + O(w^P). p is normalized with constant1.
proc lnrm(poly p,int e,int pr){
 if(pr<=e){return(list(poly(0),pr,pr));}
 p=jet(p,pr-e-1);
 if(p==0){return(list(poly(0),pr,pr));}
 int vv=deg(p[size(p)]);p=p/w^vv;e=e+vv;
 return(list(p,e,pr));
}
proc lc(int a){return(list(poly(a),0,4096));}
proc lseed(poly p,int pr){return(lnrm(p,0,pr));}
proc la(list a,list b){
 int pr=min(a[3],b[3]);int e=min(a[2],b[2]);
 return(lnrm(a[1]*w^(a[2]-e)+b[1]*w^(b[2]-e),e,pr));
}
proc lm(list a,list b){
 int pr=min(a[3]+b[2],b[3]+a[2]);
 return(lnrm(a[1]*b[1],a[2]+b[2],pr));
}
proc li(list a){
 if(a[1]==0){ERROR("Laurent inverse unresolved zero");return(lc(0));}
 int rel=a[3]-a[2];poly ans=1;int z;
 if(rel>4096){ERROR("inverse precision exceeds frozen iteration bound");}
 for(z=1;z<=13;z++){ans=jet(a[1]*ans^2,rel-1);}
 if(jet(a[1]*ans,rel-1)!=1){ERROR("Laurent unit inverse failed");}
 return(lnrm(ans,-a[2],a[3]-2*a[2]));
}
proc lpw(list a,int k){
 list ans=lc(1);
 while(k>0){if(k%2==1){ans=lm(ans,a);}k=k div 2;if(k>0){a=lm(a,a);}}
 return(ans);
}
proc leval(list terms,list coords){
 list ans=lc(0);list mon;int z;int j;intvec ex;
 for(z=1;z<=size(terms);z++){
  mon=lc(1);ex=terms[z];
  for(j=1;j<=4;j++){if(ex[j]>0){mon=lm(mon,lpw(coords[j],ex[j]));}}
  ans=la(ans,mon);
 }
 return(ans);
}
proc lzero(string name,list a){
 print("RESIDUAL "+name+" ABS_PRECISION "+string(a[3]));
 if(a[1]!=0 || a[3]<=0){ERROR("source residual nonzero or precision insufficient: "+name);}
}
proc lrecord(string name,list a){
 if(a[1]==0 || a[2]>=a[3]){ERROR("valuation unresolved: "+name);}
 print("LAURENT_ORDER "+name+" "+string(a[2])+" ABS_PRECISION "+string(a[3])+" LEAD "+string(subst(a[1],w,0)));
}
list ctl=lseed(w+w^3,50);list invctl=li(ctl);list checkctl=lm(ctl,invctl);
if(invctl[2]!=-1 || invctl[3]!=48 || checkctl[1]!=1 || checkctl[2]!=0 || checkctl[3]!=49){ERROR("inversion/pole precision control");}
checkctl=la(ctl,lseed(w,40));
if(checkctl[2]!=3 || checkctl[3]!=40){ERROR("cancellation control");}
checkctl=lm(lseed(w^3,50),lseed(w^5,60));
if(checkctl[2]!=8 || checkctl[3]!=55){ERROR("multiplication precision control");}
print("LAURENT27_HELPER_CONTROLS_PASS");
list charts;

for(kind=0;kind<=1;kind++){
 qq=1;xx=1;yy=1;
 if(kind==0){
  tt=w;
  for(k=1;k<=12;k++){qq=tr(1+(1+tt)*tt^3*qq^2);}
  map base=o,qq,0,0,tt;
  bb=tr(base(b));cc=tr(base(c));aa=tr(base(A));dd=tr(base(d));ee=tr(base(e));
  for(k=1;k<=12;k++){yy=tr((tt^10*yy^8+tt^3*dd*yy^2+ee)*invUnit(tr(aa^2*dd)));}
  zz=tr(tt^3*yy);
  residue=tr(tt^10*yy^8+tt^3*dd*yy^2+aa^2*dd*yy+ee);
 }else{
  for(k=1;k<=12;k++){
   tt=tr(w^7*xx^2);
   for(j=1;j<=10;j++){qq=tr(1+(1+tt)*tt^3*qq^2);}
   map base=o,qq,0,0,tt;
   bb=tr(base(b));cc=tr(base(c));aa=tr(base(A));dd=tr(base(d));ee=tr(base(e));
   xx=tr((1+(w^11*dd+w^10*ee)*xx^4)*invUnit(tr(aa^2*dd)));
  }
  tt=tr(w^7*xx^2);zz=tr(w^11*xx^3);
  map base=o,qq,0,0,tt;
  bb=tr(base(b));cc=tr(base(c));aa=tr(base(A));dd=tr(base(d));ee=tr(base(e));
  residue=tr(1+aa^2*dd*xx+w^11*dd*xx^4+w^10*ee*xx^4);
 }
 print("CHART "+string(kind)+" PARAMETER_SERIES");tt;qq;xx;yy;zz;
 print("BASE_AND_TOWER_SERIES_RESIDUALS");tr(qq+1+(1+tt)*tt^3*qq^2);residue;
 if(tr(qq+1+(1+tt)*tt^3*qq^2)!=0 || residue!=0){ERROR("implicit chart series residual");}
 for(branch=0;branch<=1;branch++){
  ll=branch;
  for(k=1;k<=12;k++){ll=tr((ll^2+zz+bb)*invUnit(aa));}
  print("BRANCH "+string(kind)+" "+string(branch));
  print("LAMBDA_SERIES");ll;
  if(tr(ll^2+aa*ll+zz+bb)!=0){ERROR("lambda series residual");}
  map getnu=r,0,ll,bb,cc;
  nnum=tr(getnu(nuEquation));nden=tr(getnu(nuCoefficient));
  numorder=wVal(nnum);denorder=wVal(nden);
  print("NU_NUMERATOR_DENOMINATOR_ORDERS");numorder;denorder;
  if(numorder<denorder){ERROR("nu has a pole; Laurent adaptation not frozen");}
  nu=tr((nnum/w^denorder)*invUnit(nden/w^denorder));
  print("NU_SERIES");nu;
  map evaluate=r,nu,ll,bb,cc;
  lifted=evaluate(original);
  print("ALL_FIVE_ORIGINAL_RESIDUALS_MOD_W100");
  for(j=1;j<=5;j++){
   residue=reduce(lifted[j],checkcut);residue;
   if(residue!=0){ERROR("original source residual failed");}
  }
  recordOrder("t",tt);recordOrder("b",bb);recordOrder("c",cc);
  recordOrder("lambda",ll);recordOrder("nu",nu);recordOrder("A",aa);
  recordOrder("Z",zz);
  evaluatedUnits=evaluate(registered);
  for(j=1;j<=8;j++){
   poly entry=tr(evaluatedUnits[j]);
   recordOrder("unit"+string(j),entry);
  }
// Insert inside each R24 seed branch after all original seed checks.
list ob=lseed(bb,precision);list oc=lseed(cc,precision);
list ol=lseed(ll,precision);list on=lseed(nu,precision-denorder);
list initialL=ol;list initialN=on;list initialB=ob;list initialC=oc;
list ou=li(lm(lpw(lseed(tt,precision),2),lseed(qq,precision)));
list ov=li(lm(lpw(lseed(tt,precision),3),lseed(qq,precision)));
list oa;list ok;list osc;list osl;list nb;list nc;list nl;list nnu;
list nbu;list nbv;list coords;list result;int orbit;int index27;int ram=1;
if(kind==1){ram=7;}
intvec expectedB=3,-7,1,2,1;
intvec expectedC=2,-4,1,2,-1;
for(orbit=0;orbit<=4;orbit++){
 print("CUSPORBIT "+string(kind)+" "+string(branch)+" "+string(orbit));
 coords=list(on,ol,ob,oc);
 charts=insert(charts,list(coords,ou,ov,ram,orbit),size(charts));
 for(index27=1;index27<=5;index27++){
  result=leval(sourceTerms[index27],coords);lzero("original"+string(index27),result);
 }
 lrecord("lambda",ol);lrecord("nu",on);
 for(index27=1;index27<=8;index27++){
  result=leval(registeredTerms[index27],coords);
  lrecord("registered"+string(index27),result);
  if(index27==1 && result[2]!=ram*expectedB[orbit+1]){ERROR("base b order mismatch");}
  if(index27==3 && result[2]!=ram*expectedC[orbit+1]){ERROR("base c order mismatch");}
 }
 oa=la(lc(1),oc);ok=la(ob,lm(oa,oc));
 osc=lm(lpw(oc,3),li(ok));osl=lm(ok,li(oc));
 nb=lm(lm(ob,oc),lpw(li(osc),3));
 nc=la(lc(1),lm(oa,li(osc)));
 nl=lm(la(ol,osl),li(osc)); // actual update, corrupt-control target
 nnu=lm(la(la(on,lm(ol,ob)),lm(ob,oc)),lpw(li(osc),3));
 nbu=lm(la(ou,ov),lpw(li(ou),2));
 nbv=lm(la(la(lm(ou,ov),ou),ov),lpw(li(ou),3));
 ob=nb;oc=nc;ol=nl;on=nnu;ou=nbu;ov=nbv;
 lzero("base_cubic",la(la(lpw(ov,2),ov),la(lpw(ou,3),ou)));
}
lzero("fifth_b",la(ob,initialB));lzero("fifth_c",la(oc,initialC));
lzero("fifth_lambda",la(ol,la(initialL,la(lc(1),initialC))));
lzero("fifth_nu",la(on,la(initialN,initialB)));

 }
}
// charts contains all20 (coords,u,v,e,cusp_index) Laurent records.
// Constraint bits and candidate-coefficient bits are polynomials over F2,
// used ONLY as finite vectors with XOR, never as polynomial modules.
write("chart-series.dump",charts);
list widths=8,16,24,32;
int widthIndex;int width;int il;int jn;int ev;int iu;int ch;int tid;
int total;int cand;int bound;int rrExponent;int pos;int pivot;int rankJ;
int dependent;int valid;int reductions;int gi;int z;
list oneChart;list chartCoords;list value;list baseValue;
poly bits;poly jj;poly comb;poly currentBits;poly currentJet;poly currentComb;
poly term;poly cc;poly verifyBits;poly verifyJet;
list allBits;list allJets;list constraintBasis;list constraintComb;list constraintJet;
list jetBasis;list jetComb;list accepted;
for(widthIndex=1;widthIndex<=size(widths);widthIndex++){
 width=widths[widthIndex];
 print("RR27_WIDTH "+string(width));
 allBits=list();allJets=list();constraintBasis=list();constraintComb=list();constraintJet=list();
 jetBasis=list();jetComb=list();accepted=list();
 for(z=1;z<=10240;z++){
  constraintBasis=insert(constraintBasis,poly(0),size(constraintBasis));
  constraintComb=insert(constraintComb,poly(0),size(constraintComb));
  constraintJet=insert(constraintJet,poly(0),size(constraintJet));
 }
 for(z=1;z<=129;z++){jetBasis=insert(jetBasis,poly(0),size(jetBasis));jetComb=insert(jetComb,poly(0),size(jetComb));}
 rankJ=0;dependent=0;valid=0;reductions=0;cand=0;
 for(il=0;il<=3;il++){
 for(jn=0;jn<=3;jn++){
 for(ev=0;ev<=1;ev++){
 for(iu=-width;iu<=2*width;iu++){
  bits=0;jj=0;
  for(ch=1;ch<=size(charts);ch++){
   oneChart=charts[ch];chartCoords=oneChart[1];
   baseValue=lm(lpw(la(oneChart[2],lc(1)),width),lc(1));
   baseValue=li(baseValue);
   if(iu<0){baseValue=lm(baseValue,lpw(li(oneChart[2]),-iu));}
   else{baseValue=lm(baseValue,lpw(oneChart[2],iu));}
   value=lm(lm(lm(baseValue,lpw(oneChart[3],ev)),lpw(chartCoords[2],il)),lpw(chartCoords[1],jn));
   bound=0;
   if(oneChart[5]==1){bound=7*oneChart[4];}
   if(oneChart[5]==4){bound=oneChart[4];}
   if(value[3]<=0 || value[2]<-512){ERROR("RR27 candidate precision/row bound insufficient");}
   if(ch==1 && value[3]<129){ERROR("RR27 evaluation jet precision insufficient");}
   for(tid=1;tid<=size(value[1]);tid++){
    term=value[1][tid];rrExponent=deg(term)+value[2];
    if(rrExponent < -bound){bits=bits+w^((ch-1)*512+rrExponent+512);}
    if(ch==1 && rrExponent>=0 && rrExponent<129){jj=jj+w^rrExponent;}
   }
  }
  allBits=insert(allBits,bits,size(allBits));allJets=insert(allJets,jj,size(allJets));
  print("RR27_CANDIDATE "+string(cand)+" "+string(il)+" "+string(jn)+" "+string(ev)+" "+string(iu));
  currentBits=bits;currentJet=jj;currentComb=w^cand;
  while(currentBits!=0){
   pivot=deg(currentBits)+1;
   if(constraintBasis[pivot]==0){
    constraintBasis[pivot]=currentBits;constraintComb[pivot]=currentComb;constraintJet[pivot]=currentJet;break;
   }
   currentBits=currentBits+constraintBasis[pivot];
   currentComb=currentComb+constraintComb[pivot];currentJet=currentJet+constraintJet[pivot];
   reductions=reductions+1;
  }
  if(currentBits==0){
   valid=valid+1;
   while(currentJet!=0){
    pivot=deg(currentJet)+1;
    if(jetBasis[pivot]==0){
     jetBasis[pivot]=currentJet;jetComb[pivot]=currentComb;
     accepted=insert(accepted,currentComb,size(accepted));rankJ=rankJ+1;break;
    }
    currentJet=currentJet+jetBasis[pivot];currentComb=currentComb+jetComb[pivot];
   }
   if(currentJet==0){dependent=dependent+1;}
  }
  cand=cand+1;
 }
 }
 }
 }
 print("RR27_COUNTS width,candidates,valid_vectors,jet_rank,dependent,reductions");
 width;cand;valid;rankJ;dependent;reductions;
 // Independent recombination from original columns for every accepted vector.
 for(gi=1;gi<=size(accepted);gi++){
  verifyBits=0;verifyJet=0;cc=accepted[gi];
  for(tid=1;tid<=size(cc);tid++){
   pos=deg(cc[tid])+1;verifyBits=verifyBits+allBits[pos];verifyJet=verifyJet+allJets[pos];
  }
  if(verifyBits!=0 || verifyJet==0){ERROR("RR27 independent certificate recombination failed");}
 }
 write("rr27-width"+string(width)+"-certificate.dump",accepted);
 write("rr27-width"+string(width)+"-constraints.dump",allBits);
 write("rr27-width"+string(width)+"-jets.dump",allJets);
 if(rankJ>68){ERROR("RR27 rank exceeds geometric dimension; stop and audit bridges");}
 if(rankJ==68){print("RR27_COMPLETE_BASIS_DIMENSION_68");break;}
}
print("RR27_FINAL_RANK "+string(rankJ));
print("RR27_ALL_CHECKS_PASS");quit;
