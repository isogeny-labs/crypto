proc encode27(poly f){list a;int i;for(i=1;i<=size(f);i++){a=insert(a,leadexp(f[i]),size(a));}return(a);}
list sourceTerms;list registeredTerms;int enc;
for(enc=1;enc<=5;enc++){sourceTerms=insert(sourceTerms,encode27(original[enc]),size(sourceTerms));}
for(enc=1;enc<=8;enc++){registeredTerms=insert(registeredTerms,encode27(registered[enc]),size(registeredTerms));}

ring residue27=(2,a),(v),lp;
minpoly=a^14+a^13+a^9+a^5+a^4+a^3+1;
number uu=a;
poly rn=(uu+1)*v+1;poly cn=rn+uu^3;
poly bn=rn*cn;poly an=uu^4+cn;
poly mu=bn^4+bn*cn*an^3*uu^5+cn^2*an^4*uu^4;
ideal fi=std(ideal(v^2+v+uu^3+uu,mu));
print("LAMBDA14_BASE_IDEAL");fi;
if(vdim(fi)!=1){ERROR("lambda14 base residue not unique");}
poly vp=reduce(v,fi);
if(size(vp)>1 || deg(vp)>0){ERROR("lambda14 residue not constant");}
number vv=leadcoef(vp);
number rr=(uu+1)*vv+1;number cn0=rr+uu^3;
number bb=rr*cn0/uu^7;number cc=cn0/uu^4;
number aa=1+cc;number delta=bb+cc*aa^3;
if(bb==0 || cc==0 || aa==0 || delta==0){ERROR("lambda14 exceptional denominator");}
map atZero=r,0,0,bb,cc;
number nv=leadcoef(atZero(nuEquation))/leadcoef(atZero(nuCoefficient));
map atPoint=r,nv,0,bb,cc;
ideal rr0=atPoint(original);ideal units=atPoint(registered);
print("LAMBDA14_ORIGINAL_SOURCE_RESIDUALS");rr0;
int k;for(k=1;k<=5;k++){if(rr0[k]!=0){ERROR("lambda14 original source residual");}}
for(k=1;k<=8;k++){if(units[k]==0){ERROR("lambda14 registered unit is zero");}}
if(nv==0 || (bb+cc)/cc^2!=uu){ERROR("lambda14 residue-degree/source check");}
print("LAMBDA14_EXPLICIT_POINT u,v,b,c,lambda,nu");uu;vv;bb;cc;0;nv;
print("LAMBDA14_SIMPLE_DERIVATIVE");aa^3*bb^3*delta;
if(aa^3*bb^3*delta==0){ERROR("lambda14 projection derivative zero");}
print("LAMBDA14_ALL_CHECKS_PASS");quit;
