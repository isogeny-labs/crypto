ring norms27=(2,b,c,l,n),(x),dp;
number aa=1+c;
number gl=l/(l+aa);number gn=n/(n+b);
number sl=(l+aa)/l;number sn=(n+b)/n;
print("ACTUAL_NORM_ONE_AND_NONTRIVIAL_RATIOS");gl*sl-1;gn*sn-1;
if(gl*sl!=1 || gn*sn!=1 || gl==1 || gn==1){ERROR("actual ratio norm/control failed");}
number z=b+l^2+aa*l;number u=aa*n+b*l;number v=n^2+b*n;
number sz=b+(l+aa)^2+aa*(l+aa);
number su=aa*(n+b)+b*(l+aa);number sv=(n+b)^2+b*(n+b);
number ss=z*u+v;number st=sz*su+sv;
number nn=b^3+aa*b^2*z+aa^2*b*u+aa^3*v;
number nt=b^3+aa*b^2*sz+aa^2*b*su+aa^3*sv;
print("ALL_REGISTERED_RATIO_IDENTITIES");
ideal registered=b,b+c*aa^3,c,c,b*(b+c),b+c+c^2,ss,nn;
ideal conjugated=b,b+c*aa^3,c,c,b*(b+c),b+c+c^2,st,nt;
int j;for(j=1;j<=8;j++){
 if(registered[j]!=conjugated[j] || registered[j]/conjugated[j]!=1){ERROR("registered invariant ratio failure");}
}
// Constructive degree-two Hilbert90 with actual ratios.
number liftL=1+gl;number liftN=1+gn;
if(liftL/(1+sl)!=gl || liftN/(1+sn)!=gn){ERROR("Hilbert90 recovery failed");}
print("HILBERT90_RATIOS_PASS");
ring free27=2,(b,ib,aa),dp;
ideal fixedIdeal=b,aa,b*ib+1;
matrix witness[1][3]=ib,0,1;
matrix fixedCert=matrix(fixedIdeal)*transpose(witness);
if(fixedCert[1,1]!=1){ERROR("b-unit fixed locus certificate failed");}
print("B_UNIT_FIXED_LOCUS_IDEAL_CERTIFICATE");witness;
// Exact degree accounting, literal accepted LAURENT02 rows; no Python math.
int lambdaPoles=4+3+28+21+1+7;
int lambdaCuspZeros=5+2+4+2+11+11+11+4;
int nuPoles=12+12+51+51+3+3;
int nuCuspZeros=32+21+14+7+25+14+12+7;
int sPoles=24+24+124+124+6+6;
int sKnownZeros=44+44+44+44+44+44+2+2+4*10;
int nPoles=36+36+186+186+9+9;
int nKnownZeros=66+66+66+66+66+66+3+3+6*10;
print("DEGREE_ACCOUNTING lambda_poles,cusp_zeros,gap,nu,S,N,nu_ratio");
lambdaPoles;lambdaCuspZeros;lambdaPoles-lambdaCuspZeros;
nuPoles;sPoles;nPoles;int ratioDegree=11+7+11+5;ratioDegree;
if(lambdaPoles!=64 || lambdaCuspZeros!=50 || nuPoles!=132 || nuPoles!=nuCuspZeros || sPoles!=308 || sPoles!=sKnownZeros || nPoles!=462 || nPoles!=nKnownZeros || ratioDegree!=34){ERROR("degree accounting failed");}
// Constant coefficient of G(lambda)/b^4: mu=b^4+b*c*A^3+c^2*A^4.
// Clear u^28, reduce on the actual elliptic base and take its quadratic norm.
ring support27=2,(v,u),lp;
ideal ei=std(ideal(v^2+v+u^3+u));
poly rn=(u+1)*v+1;poly cn=rn+u^3;
poly bn=rn*cn;poly an=u^4+cn;
poly mn=reduce(bn^4+bn*cn*an^3*u^5+cn^2*an^4*u^4,ei);
poly mnorm=reduce(mn*subst(mn,v,v+1),ei);
if(subst(mnorm,v,0)!=mnorm){ERROR("base norm still depends on v");}
print("LAMBDA_MU_NORM_NUMERATOR");mnorm;
list factors=factorize(mnorm);print("LAMBDA_MU_NORM_FACTORIZATION");factors;
poly product=1;int fi;
for(fi=1;fi<=size(factors[1]);fi++){product=product*factors[1][fi]^factors[2][fi];}
if(product!=mnorm){ERROR("lambda support factor product failed");}
print("NORM27_ALL_CHECKS_PASS");quit;
