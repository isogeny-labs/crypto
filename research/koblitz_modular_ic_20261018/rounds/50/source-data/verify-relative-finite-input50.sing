LIB "normal.lib";
option(redSB);short=0;
execute(read("../normal-relative-finite50-01/selected-prime50.sing"));
execute(read("../normal-relative-finite50-01/fractional-module50.sing"));
execute(read("../normal-relative-finite50-01/normalization50.sing"));
print("VERIFY_RELATIVE50_COEFFICIENT_FIELD charstr="+charstr(basering)+" characteristic="+string(char(basering))+" parameters="+string(npars(basering)));
if(char(basering)!=2 || npars(basering)!=0){ERROR("VERIFY_RELATIVE50_COEFFICIENT_DESCENT");quit;}
ideal normalStd50=std(norid);
map sourceMap50=selected50,normap;
if(size(reduce(sourceMap50(selectedPrime50),normalStd50))!=0 || size(reduce(sourceMap50(originalIdeal50),normalStd50))!=0){ERROR("VERIFY_RELATIVE50_SOURCE_IDENTITIES");quit;}
ideal corruptMapImages50=normap;corruptMapImages50[3]=corruptMapImages50[3]+1;
map corruptMap50=selected50,corruptMapImages50;
if(size(reduce(corruptMap50(originalIdeal50),normalStd50))==0){ERROR("VERIFY_RELATIVE50_CORRUPT_MAP_ACCEPTED");quit;}
print("VERIFY_RELATIVE50_STAGE source_identities_checked=true corrupted_map_rejected=true");
list normalPrimes50=minAssGTZ(norid);
if(size(normalPrimes50)!=1){ERROR("VERIFY_RELATIVE50_NORMAL_RING_NOT_DOMAIN");quit;}
if(size(reduce(norid,std(normalPrimes50[1])))!=0 || size(reduce(normalPrimes50[1],normalStd50))!=0){ERROR("VERIFY_RELATIVE50_NORMAL_RING_RADICAL");quit;}
list ringList50=normalized50;
setring selected50;
list moduleList50=module50;list deltaList50=intvec(delta50),delta50;
list reconstructed50=ringList50,moduleList50,deltaList50;
print("VERIFY_RELATIVE50_STAGE full_norTest_begin=true");
intvec test50=norTest(selectedPrime50,reconstructed50);
if(test50[1]!=1 || test50[2]!=1 || test50[3]!=1){ERROR("VERIFY_RELATIVE50_NORTEST");quit;}
print("VERIFY_RELATIVE50_STAGE injective=1 finite=1 normal=1");
setring normalized50;
string genericRingDecl50="ring genericNormalized50=(2,parameter50),("+varstr(basering)+"),dp;";
execute(genericRingDecl50);
ideal genericImages50=imap(normalized50,normap);
ideal genericIdeal50=imap(normalized50,norid),genericImages50[3]-parameter50;
int genericDegree50=vdim(std(genericIdeal50));
if(genericDegree50!=32){ERROR("VERIFY_RELATIVE50_NORMALIZED_GENERIC_DEGREE");quit;}
print("VERIFY_RELATIVE50_RESULT source_generic_degree=32 normalized_generic_degree=32 relative_field_degree=1 affine_verification=true projective_geometry_complete=false");
print("VERIFY_RELATIVE50_ALL_CHECKS_PASS");quit;
