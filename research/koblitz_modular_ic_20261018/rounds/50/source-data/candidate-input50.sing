ring genericCertificate49=(2,u),(n,l,v),dp;
ideal prime49_1;
prime49_1[1]=v2+v+(u3+u);
prime49_1[2]=(u64)*l16+(u40+u32)*l8v+(u64+u56+u52+u46+u43+u42+u41+u38+u36+u35+u34+u33+u32)*l8+(u57+u55+u53+u48+u47+u46+u35+u33+u32+u30+u29+u27)*l4v+(u58+u55+u53+u50+u47+u44+u42+u41+u40+u39+u38+u37+u35+u34+u33+u32+u31+u30+u28+u27)*l4+(u57+u56+u55+u54+u52+u49+u45+u42+u40+u39+u36+u35+u34+u33+u32+u31+u30+u29+u25+u19+u16+u15)*lv+(u58+u51+u50+u47+u46+u45+u38+u37+u35+u34+u32+u27+u26+u24+u19+u15)*l+(u54+u53+u50+u49+u48+u45+u43+u40+u39+u38+u36+u30+u24+u21+u19+u18+u17+u16+u15+u14+u13+u12+u8+1)*v+(u64+u56+u55+u53+u52+u51+u50+u49+u45+u44+u40+u37+u35+u33+u32+u31+u29+u28+u26+u25+u24+u22+u20+u17+u16+u12+u11+u10+u9+u6+u4+u3+u2+u+1);
prime49_1[3]=(u19+u18+u15+u14+u12+u10+u9+u7+u6+u5+u3+u+1)/(u15+u14+u11+u8+u7+u6+u3+1)*l14v+(u21+u19+u14+u12+u9+u7+u6+u5+u4+u2+u)/(u16+u14+u12+u11+u9+u6+u4+u3+u+1)*l14+(u19+u18+u17+u15+u14+u9+u8+u7+u5+u4+u2+u+1)/(u15+u11+u10+u9+u7+u3+u2+u)*l13v+(u21+u18+u17+u15+u14+u11+u8+u7+u5+u3+1)/(u16+u14+u12+u11+u9+u6+u4+u3+u+1)*l13+(u15+u14+u12+u11+u9+u8+u6+u4+u)/(u14+u10+u9+u8+u6+u2+u+1)*l12v+(u17+u16+u12+u9+u7+u6+u4+u3+u2)/(u14+u10+u9+u8+u6+u2+u+1)*l12+(u20+u16+u6+u3+1)/(u16+u15+u14+u13+u11+u8+u7+u6+u5+u3)*l11v+(u23+u21+u17+u15+u9+u7+u6+u4+u3+u2+1)/(u18+u16+u14+u13+u11+u8+u6+u5+u3+u2)*l11+(u28+u27+u26+u23+u22+u9+u8+u7+u6+u4+u3+u+1)/(u24+u23+u22+u21+u20+u19+u17+u16+u15+u14+u13+u11+u9+u4)*l10v+(u29+u27+u26+u25+u21+u18+u17+u16+u14+u13+u11+u10+u8+u6+u3+u+1)/(u24+u18+u17+u12+u11+u10+u9+u8+u4+u3)*l10+(u11+u10+u9+u8+u7+u5+u4+u2+u)/(u12+u10+u7+u6+u5+u3+u+1)*l9v+(u12+u11+u10+u7+u6+u5+u2)/(u12+u10+u7+u6+u5+u3+u+1)*l9+(u35+u34+u33+u30+u29+u28+u27+u26+u25+u22+u17+u16+u14+u11+u10+u6+u2+u+1)/(u31+u30+u26+u24+u22+u21+u18+u17+u16+u15+u14+u13+u9+u6)*l8v+(u36+u33+u30+u29+u28+u25+u24+u23+u22+u18+u16+u15+u14+u13+u12+u11+u10+u8+u7+u4+u2+u+1)/(u31+u29+u26+u25+u24+u23+u22+u20+u18+u12+u9+u8+u6+u5)*l8+(u24+u18+u16+u15+u14+u11+u10+u8+u7+u6+u4+u3+1)/(u20+u19+u18+u17+u15+u12+u11+u10+u9+u7)*l7v+(u27+u25+u23+u21+u18+u16+u11+u9+u3+u2+1)/(u22+u20+u18+u17+u15+u12+u10+u9+u7+u6)*l7+(u27+u26+u24+u23+u21+u19+u18+u15+u12+u11+u8+u7+u4+u+1)/(u23+u22+u19+u16+u15+u14+u11+u8)*l6v+(u28+u25+u23+u22+u20+u16+u14+u13+u12+u11+u9+u8+u7+u+1)/(u23+u21+u19+u18+u16+u13+u11+u10+u8+u7)*l6+(u14+u13+u12+u11+u9+u7+u5+u4+u2+u+1)/(u15+u13+u10+u9+u8+u6+u4+u3)*l5v+(u13+u12+u11+u10+u9+u8+u5+u+1)/(u14+u12+u9+u8+u7+u5+u3+u2)*l5+(u34+u33+u31+u30+u28+u26+u25+u24+u21+u20+u19+u18+u17+u16+u15+u13+u9+u4+u2+u+1)/(u30+u29+u28+u27+u26+u25+u23+u22+u21+u20+u19+u17+u15+u10)*l4v+(u35+u33+u32+u28+u26+u23+u22+u21+u18+u16+u14+u11+u10+u9+u8+u7+u5+u+1)/(u30+u24+u23+u18+u17+u16+u15+u14+u10+u9)*l4+(u25+u21+u17+u15+u12+u7+u5+u4+u3+u+1)/(u21+u20+u19+u18+u16+u13+u12+u11+u10+u8)*l3v+(u32+u30+u27+u26+u25+u23+u22+u20+u19+u14+u13+u9+u8+u3+u2+u+1)/(u27+u25+u23+u22+u20+u17+u15+u14+u12+u11)*l3+(u39+u38+u36+u34+u28+u27+u24+u23+u21+u19+u18+u16+u14+u12+u9+u7+u5+u3+u2+u+1)/(u38+u33+u32+u29+u25+u23+u21+u16+u15+u14)*l2v+(u41+u40+u39+u36+u35+u34+u33+u32+u28+u27+u22+u20+u19+u17+u16+u14+u12+u11+u10+u7+u5+u2+1)/(u38+u33+u32+u29+u25+u23+u21+u16+u15+u14)*l2+(u37+u36+u35+u32+u31+u29+u28+u24+u21+u20+u19+u17+u16+u15+u11+u10+u7+u+1)/(u33+u29+u28+u27+u25+u21+u20+u19)*lv+n+(u40+u37+u35+u34+u30+u29+u28+u24+u23+u22+u21+u20+u18+u15+u13+u12+u11+u10+u9+u8+u5+u2+1)/(u35+u33+u31+u30+u28+u25+u23+u22+u20+u19)*l+(u52+u51+u50+u49+u44+u42+u41+u38+u37+u36+u35+u34+u32+u29+u27+u25+u24+u23+u21+u20+u19+u17+u15+u12+u6+u3+1)/(u48+u47+u43+u41+u39+u38+u35+u34+u33+u32+u31+u30+u26+u23)*v+(u54+u52+u50+u46+u45+u44+u41+u39+u38+u35+u34+u33+u32+u31+u29+u21+u15+u10+u9+u7+u5+u3+1)/(u49+u47+u44+u43+u42+u41+u40+u38+u36+u30+u27+u26+u24+u23);
option(redSB);short=0;
print("CANDIDATE50_STAGE triangular_extraction_begin=true");
poly A50=subst(prime49_1[2],v,0);poly B50=(prime49_1[2]+A50)/v;
poly nRest50=prime49_1[3]+n;
poly C50=subst(nRest50,v,0);poly D50=(nRest50+C50)/v;
if(A50+B50*v!=prime49_1[2] || C50+D50*v!=nRest50 || subst(A50,v,0)!=A50 || subst(B50,v,0)!=B50 || subst(C50,v,0)!=C50 || subst(D50,v,0)!=D50 || subst(A50,n,0)!=A50 || subst(B50,n,0)!=B50 || subst(C50,n,0)!=C50 || subst(D50,n,0)!=D50){ERROR("CANDIDATE50_TRIANGULAR_STRUCTURE");quit;}
ring candidateField50=(2,u),(t),dp;
option(redSB);short=0;
map extract50=genericCertificate49,0,t,0;
poly a50=extract50(A50);poly b50=extract50(B50);poly c50=extract50(C50);poly d50=extract50(D50);
poly norm50=a50^2+a50*b50+(u^3+u)*b50^2;
if(deg(norm50)!=32 || b50==0){ERROR("CANDIDATE50_NORM_DEGREE");quit;}
number normLead50=leadcoef(norm50);poly monic50=norm50/normLead50;
poly nNumerator50=c50*b50+d50*a50;
link fieldOut50="ASCII:w rational-candidate50.sing";open(fieldOut50);
write(fieldOut50,"ring rationalCandidate50=(2,u),(t),dp;short=0;");
write(fieldOut50,"poly a50="+string(a50)+";");write(fieldOut50,"poly b50="+string(b50)+";");
write(fieldOut50,"poly c50="+string(c50)+";");write(fieldOut50,"poly d50="+string(d50)+";");
write(fieldOut50,"poly norm50="+string(norm50)+";");write(fieldOut50,"poly monic50="+string(monic50)+";");
write(fieldOut50,"poly nNumerator50="+string(nNumerator50)+";");close(fieldOut50);
print("CANDIDATE50_STAGE rational_arrays_exported=true polynomial_degree=32 inverse_computed=false map_verified=false");
poly integral50=u^128*subst(monic50,t,t/u^4);
if(deg(integral50)!=32 || leadcoef(integral50)!=1){ERROR("CANDIDATE50_SCALED_MONIC_DEGREE");quit;}
int term50;
for(term50=1;term50<=size(integral50);term50++){if(denominator(leadcoef(integral50[term50]))!=1){ERROR("CANDIDATE50_NOT_INTEGRAL");quit;}}
link planeOut50="ASCII:w integral-candidate50.sing";open(planeOut50);
write(planeOut50,"ring integralCandidate50=2,(t,u),dp;short=0;ideal candidateIdeal50;candidateIdeal50[1]="+string(integral50)+";");close(planeOut50);
print("CANDIDATE50_RESULT norm_degree=32 scale_u_power=4 monic_integral_candidate=true rational_arrays_exported=true model_binding_verified=false normalization_performed=false");
print("CANDIDATE50_ALL_CHECKS_PASS");quit;
