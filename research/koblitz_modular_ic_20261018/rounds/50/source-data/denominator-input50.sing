option(redSB);short=0;
proc euclid50(poly aa50,poly bb50)
{
 poly r050=aa50;poly r150=bb50;
 poly x050=1;poly x150=0;poly y050=0;poly y150=1;
 poly rem50;poly quotient50;poly factor50;poly nextX50;poly nextY50;number leading50;
 int oldDegree50;int outer50=0;
 while(r150!=0){
  rem50=r050;quotient50=0;
  while(rem50!=0 && deg(rem50)>=deg(r150)){
   oldDegree50=deg(rem50);
   factor50=(leadcoef(rem50)/leadcoef(r150))*t^(deg(rem50)-deg(r150));
   quotient50=quotient50+factor50;rem50=rem50+factor50*r150;
   if(rem50!=0 && deg(rem50)>=oldDegree50){ERROR("DENOM50_DIVISION_NO_DEGREE_DROP");return(list());}
  }
  if(r050!=quotient50*r150+rem50){ERROR("DENOM50_DIVISION_IDENTITY");return(list());}
  nextX50=x050+quotient50*x150;nextY50=y050+quotient50*y150;
  if(rem50!=nextX50*aa50+nextY50*bb50){ERROR("DENOM50_EUCLID_BEZOUT_STEP");return(list());}
  if(rem50!=0){leading50=leadcoef(rem50);rem50=rem50/leading50;nextX50=nextX50/leading50;nextY50=nextY50/leading50;}
  r050=r150;r150=rem50;x050=x150;x150=nextX50;y050=y150;y150=nextY50;
  outer50++;print("DENOM50_EUCLID_STEP index="+string(outer50)+" remainder_degree="+string(deg(r150)));
 }
 return(list(r050,x050,y050));
}
print("DENOM50_STAGE exported_norm_identities_begin=true");
