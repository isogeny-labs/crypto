poly cSource50=candidateToSource50(c50);poly dSource50=candidateToSource50(d50);
poly normSource50=candidateToSource50(norm50);poly nNumSource50=candidateToSource50(nNumerator50);
if(prime49_1[1]!=v^2+v+u^3+u || prime49_1[2]!=aSource50+bSource50*v || prime49_1[3]!=n+cSource50+dSource50*v){ERROR("DENOM50_SOURCE_TRIANGULAR_BINDING");quit;}
if(normSource50+prime49_1[2]^2+bSource50*prime49_1[2]+bSource50^2*prime49_1[1]!=0){ERROR("DENOM50_NORM_SOURCE_MEMBERSHIP");quit;}
if(bSource50*n+nNumSource50+bSource50*prime49_1[3]+dSource50*prime49_1[2]!=0){ERROR("DENOM50_N_REVERSE_IDENTITY");quit;}
map scaledToSource50=integralCandidate50,u^4*l,u;
ideal scaledBound50=scaledToSource50(candidateIdeal50);
if(scaledBound50[1]!=u^128*candidateToSource50(monic50)){ERROR("DENOM50_INTEGRAL_SCALING_BINDING");quit;}
print("DENOM50_RESULT actual_Bezout_checked=true denominator_unit_certificate=true inverse_corruption_rejected=true norm_source_membership=true reverse_coordinates=true integral_scaling_bound=true original_four_forward_equations_pending=true");
print("DENOM50_ALL_CHECKS_PASS");quit;
