write(fiberOut50,"ring parameterSaturation50=2,(t,v,u),wp(4,2,1);short=0;int contentPower50="+string(contentPower50)+";poly parameter50="+string(saturationParameter50)+";poly witness50="+string(saturationWitness50)+";poly planeNumerator50="+string(originalA50)+";poly sourceGenerator50="+string(relativeIdeal50[2])+";");close(fiberOut50);
setring boundaryCertificate50;
