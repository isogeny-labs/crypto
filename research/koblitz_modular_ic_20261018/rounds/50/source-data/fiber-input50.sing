ring relativeFinite50=2,(t,v,u),wp(4,2,1);short=0;ideal relativeIdeal50;relativeIdeal50[1]=v^2+v+u^3+u;relativeIdeal50[2]=t^16+(u^8+1)*t^8*v+(u^32+u^24+u^20+u^14+u^11+u^10+u^9+u^6+u^4+u^3+u^2+u+1)*t^8+(u^41+u^39+u^37+u^32+u^31+u^30+u^19+u^17+u^16+u^14+u^13+u^11)*t^4*v+(u^42+u^39+u^37+u^34+u^31+u^28+u^26+u^25+u^24+u^23+u^22+u^21+u^19+u^18+u^17+u^16+u^15+u^14+u^12+u^11)*t^4+(u^53+u^52+u^51+u^50+u^48+u^45+u^41+u^38+u^36+u^35+u^32+u^31+u^30+u^29+u^28+u^27+u^26+u^25+u^21+u^15+u^12+u^11)*t*v+(u^54+u^47+u^46+u^43+u^42+u^41+u^34+u^33+u^31+u^30+u^28+u^23+u^22+u^20+u^15+u^11)*t+(u^54+u^53+u^50+u^49+u^48+u^45+u^43+u^40+u^39+u^38+u^36+u^30+u^24+u^21+u^19+u^18+u^17+u^16+u^15+u^14+u^13+u^12+u^8+1)*v+(u^64+u^56+u^55+u^53+u^52+u^51+u^50+u^49+u^45+u^44+u^40+u^37+u^35+u^33+u^32+u^31+u^29+u^28+u^26+u^25+u^24+u^22+u^20+u^17+u^16+u^12+u^11+u^10+u^9+u^6+u^4+u^3+u^2+u+1);poly relativeB50=(u^8+1)*t^8+(u^41+u^39+u^37+u^32+u^31+u^30+u^19+u^17+u^16+u^14+u^13+u^11)*t^4+(u^53+u^52+u^51+u^50+u^48+u^45+u^41+u^38+u^36+u^35+u^32+u^31+u^30+u^29+u^28+u^27+u^26+u^25+u^21+u^15+u^12+u^11)*t+(u^54+u^53+u^50+u^49+u^48+u^45+u^43+u^40+u^39+u^38+u^36+u^30+u^24+u^21+u^19+u^18+u^17+u^16+u^15+u^14+u^13+u^12+u^8+1);
ring boundaryCertificate50=(2,a),(w),dp;minpoly=a^2+a+1;ideal point0;ideal point1;
point0[1]=(a);point0[2]=0;point0[3]=1;
point1[1]=(a);point1[2]=1;point1[3]=1;
point0[4]=(a+1);point0[5]=0;point0[6]=1;
point1[4]=(a+1);point1[5]=1;point1[6]=1;
setring relativeFinite50;short=0;
poly fiberFactor50=t^2+t+1;
map planeIntoRelative50=integralCandidate50,t,u;
ideal planeInside50=planeIntoRelative50(candidateIdeal50);
if(subst(relativeIdeal50[1],u,1)!=v^2+v || subst(relativeIdeal50[2],u,1)!=fiberFactor50^8 || subst(planeInside50[1],u,1)!=fiberFactor50^16){ERROR("FIBER50_COMPLETE_FIBER_FACTORS");quit;}
poly primitiveB50=relativeB50;poly originalA50=subst(relativeIdeal50[2],v,0);
int contentPower50=0;int previousDegree50;
if(primitiveB50==0 || subst(primitiveB50,v,0)!=primitiveB50){ERROR("FIBER50_DENOMINATOR_SHAPE");quit;}
while(subst(primitiveB50,u,1)==0){
 previousDegree50=deg(primitiveB50);primitiveB50=primitiveB50/(u+1);contentPower50++;
 if(deg(primitiveB50)>=previousDegree50){ERROR("FIBER50_CONTENT_DEGREE_DROP");quit;}
}
poly saturationParameter50=(u+1)^contentPower50;
poly saturationWitness50=primitiveB50*v;
if(saturationParameter50*primitiveB50!=relativeB50 || saturationParameter50*saturationWitness50+originalA50!=relativeIdeal50[2]){ERROR("FIBER50_FULL_SATURATION_IDENTITY");quit;}
if(saturationParameter50*(saturationWitness50+1)+originalA50==relativeIdeal50[2]){ERROR("FIBER50_CORRUPTED_IDENTITY_ACCEPTED");quit;}
