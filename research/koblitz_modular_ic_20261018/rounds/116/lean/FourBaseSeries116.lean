-- Bit i is the coefficient of s^i in F2[s]/(s^640).
def mul (a b : Nat) : Nat :=
 (List.range 640).foldl (fun acc i => if Nat.testBit b i then Nat.xor acc (Nat.shiftLeft a i) else acc) 0 % (2^640)
def power (a n : Nat) : Nat :=
 (List.range n).foldl (fun acc _ => mul acc a) 1
def eval (terms : List (Nat × Nat)) (z : Nat) : Nat :=
 terms.foldl (fun acc p => Nat.xor acc (Nat.shiftLeft (power z p.2) p.1)) 0 % (2^640)

