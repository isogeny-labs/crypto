// Exact A=0 fiber of the original QR equations; predictions are outcomes.
proc require53(int ok,string tag){if(!ok){ERROR(tag);quit;}}
execute(read("../../../51/runs/universal51-01/universal-polynomial51.sing"));
ring supersingular53=(2,b),(n,l),lp;short=0;
map fiberMap53=universalPolynomialCertificate51,n,l,b,1;
ideal source53=fiberMap53(qr51);poly G53=fiberMap53(G51);poly N53=fiberMap53(N51);
poly quartic53=l^4+b*l+b^2;
require53(G53==quartic53^4,"SUPER53_QUARTIC_FOURTH_POWER");
require53(diff(quartic53,l)==b,"SUPER53_SEPARABLE_QUARTIC");
ideal gb53=std(source53);int dimension53=vdim(gb53);
matrix forward53=lift(source53,gb53);matrix reverse53=lift(gb53,source53);
require53(matrix(source53)*forward53==matrix(gb53) && matrix(gb53)*reverse53==matrix(source53),"SUPER53_FULL_IDEAL_PRODUCTS");
ideal minors53=minor(jacob(source53),2);ideal augmented53=source53,minors53;
ideal singularGB53=std(augmented53);
int smooth53=(reduce(poly(1),singularGB53)==0);
int quarticMember53=(reduce(quartic53,gb53)==0);
matrix smoothLift53;matrix quarticLift53;
if(smooth53){smoothLift53=lift(augmented53,ideal(1));require53(matrix(augmented53)*smoothLift53==matrix(ideal(1)),"SUPER53_JACOBIAN_UNIT_PRODUCT");}
if(quarticMember53){quarticLift53=lift(source53,ideal(quartic53));require53(matrix(source53)*quarticLift53==matrix(ideal(quartic53)),"SUPER53_QUARTIC_MEMBERSHIP_PRODUCT");}
if(dimension53>0){require53(reduce(poly(1),gb53)!=0,"SUPER53_NONZERO_QUOTIENT");}
link out53="ASCII:w supersingular-certificate53.sing";
write(out53,"ring supersingularCertificate53=(2,b),(n,l),lp;short=0;ideal source53="+string(source53)+";ideal gb53="+string(gb53)+";ideal minors53="+string(minors53)+";poly G53="+string(G53)+";poly N53="+string(N53)+";poly quartic53="+string(quartic53)+";int dimension53="+string(dimension53)+";int smooth53="+string(smooth53)+";int quarticMember53="+string(quarticMember53)+";");
proc dump53(link out,string name,matrix A){int i;int j;write(out,"matrix "+name+"["+string(nrows(A))+"]["+string(ncols(A))+"];");for(i=1;i<=nrows(A);i++){for(j=1;j<=ncols(A);j++){if(A[i,j]!=0){write(out,name+"["+string(i)+","+string(j)+"]="+string(A[i,j])+";");}}}}
dump53(out53,"forward53",forward53);dump53(out53,"reverse53",reverse53);
if(smooth53){dump53(out53,"smoothLift53",smoothLift53);}
if(quarticMember53){dump53(out53,"quarticLift53",quarticLift53);}
close(out53);
print("SUPER53_GROEBNER_BASIS");print(gb53);
print("SUPER53_RESULT dimension="+string(dimension53)+" Jacobian_unit="+string(smooth53)+" quartic_member="+string(quarticMember53)+" compact_N_zero="+string(N53==0));
// Independently specialize the original equations at the actual fA point.
ring actualSuper53=(2,a),(n,l),lp;minpoly=a^5+a^2+1;short=0;
number vValue53=(1+a^4+a)/(a+a^2);number rValue53=(1+a)*vValue53+a^3;
number bValue53=1+1/a;
require53(vValue53^2+a^2*vValue53+a+a^3==0,"SUPER53_ACTUAL_BASE_POINT");
require53(a*(rValue53+1)==1 && a*rValue53*(rValue53+1)==bValue53 && bValue53!=0,"SUPER53_ACTUAL_TATE_POINT");
map actualMap53=universalPolynomialCertificate51,n,l,bValue53,1;
ideal actualSource53=actualMap53(qr51);poly actualG53=actualMap53(G51);poly actualN53=actualMap53(N51);
poly actualQuartic53=l^4+bValue53*l+bValue53^2;
require53(actualG53==actualQuartic53^4 && diff(actualQuartic53,l)==bValue53,"SUPER53_ACTUAL_QUARTIC");
ideal actualGB53=std(actualSource53);int actualDimension53=vdim(actualGB53);
matrix actualForward53=lift(actualSource53,actualGB53);matrix actualReverse53=lift(actualGB53,actualSource53);
require53(matrix(actualSource53)*actualForward53==matrix(actualGB53) && matrix(actualGB53)*actualReverse53==matrix(actualSource53),"SUPER53_ACTUAL_IDEAL_PRODUCTS");
ideal actualMinors53=minor(jacob(actualSource53),2);ideal actualAugmented53=actualSource53,actualMinors53;
int actualSmooth53=(reduce(poly(1),std(actualAugmented53))==0);
int actualQuarticMember53=(reduce(actualQuartic53,actualGB53)==0);
matrix actualSmoothLift53;matrix actualQuarticLift53;
if(actualSmooth53){actualSmoothLift53=lift(actualAugmented53,ideal(1));require53(matrix(actualAugmented53)*actualSmoothLift53==matrix(ideal(1)),"SUPER53_ACTUAL_JACOBIAN_PRODUCT");}
if(actualQuarticMember53){actualQuarticLift53=lift(actualSource53,ideal(actualQuartic53));require53(matrix(actualSource53)*actualQuarticLift53==matrix(ideal(actualQuartic53)),"SUPER53_ACTUAL_QUARTIC_PRODUCT");}
link actualOut53="ASCII:w actual-supersingular-certificate53.sing";
write(actualOut53,"ring actualSupersingularCertificate53=(2,a),(n,l),lp;minpoly=a^5+a^2+1;short=0;ideal source53="+string(actualSource53)+";ideal gb53="+string(actualGB53)+";ideal minors53="+string(actualMinors53)+";poly quartic53="+string(actualQuartic53)+";int dimension53="+string(actualDimension53)+";int smooth53="+string(actualSmooth53)+";int quarticMember53="+string(actualQuarticMember53)+";");
dump53(actualOut53,"forward53",actualForward53);dump53(actualOut53,"reverse53",actualReverse53);
if(actualSmooth53){dump53(actualOut53,"smoothLift53",actualSmoothLift53);}
if(actualQuarticMember53){dump53(actualOut53,"quarticLift53",actualQuarticLift53);}
close(actualOut53);print("SUPER53_ACTUAL_BASIS");print(actualGB53);
print("SUPER53_ACTUAL_QUARTIC_FACTORS");print(factorize(actualQuartic53));
print("SUPER53_ACTUAL_RESULT dimension="+string(actualDimension53)+" Jacobian_unit="+string(actualSmooth53)+" quartic_member="+string(actualQuarticMember53)+" compact_N_zero="+string(actualN53==0));
// Actual descended nu differs by b*zeta; lambda shift is zero at A=0.
ring twistedSuper53=(2,a),(zeta,n,l),lp;minpoly=a^5+a^2+1;short=0;
number bValue53=1+1/a;
map twistedMap53=universalPolynomialCertificate51,n+bValue53*zeta,l,bValue53,1;
ideal twistedQR53=twistedMap53(qr51);
ideal twistedAugmented53=zeta^2+zeta+1,twistedQR53;
ideal twistedStandard53=std(twistedAugmented53);
ideal eliminated53=eliminate(twistedStandard53,zeta);
ideal descendedAugmented53=zeta^2+zeta+1,eliminated53;
ideal descendedStandard53=std(descendedAugmented53);
int descent53=(size(reduce(twistedStandard53,descendedStandard53))==0 && size(reduce(descendedStandard53,twistedStandard53))==0);
matrix descentForward53;matrix descentReverse53;
if(descent53){
 descentForward53=lift(twistedAugmented53,descendedAugmented53);descentReverse53=lift(descendedAugmented53,twistedAugmented53);
 require53(matrix(twistedAugmented53)*descentForward53==matrix(descendedAugmented53) && matrix(descendedAugmented53)*descentReverse53==matrix(twistedAugmented53),"SUPER53_FULL_TWIST_DESCENT_PRODUCTS");
}
link descentOut53="ASCII:w supersingular-descent53.sing";
write(descentOut53,"ring supersingularDescentCertificate53=(2,a),(zeta,n,l),lp;minpoly=a^5+a^2+1;short=0;ideal source53="+string(twistedAugmented53)+";ideal descended53="+string(descendedAugmented53)+";int descent53="+string(descent53)+";");
if(descent53){dump53(descentOut53,"forward53",descentForward53);dump53(descentOut53,"reverse53",descentReverse53);}
close(descentOut53);
ring descendedSuper53=(2,a),(n,l),lp;minpoly=a^5+a^2+1;short=0;
map descentMap53=twistedSuper53,0,n,l;
ideal descendedSource53=descentMap53(eliminated53);ideal descendedGB53=std(descendedSource53);
int descendedDimension53=vdim(descendedGB53);
matrix descendedForward53=lift(descendedSource53,descendedGB53);matrix descendedReverse53=lift(descendedGB53,descendedSource53);
require53(matrix(descendedSource53)*descendedForward53==matrix(descendedGB53) && matrix(descendedGB53)*descendedReverse53==matrix(descendedSource53),"SUPER53_DESCENDED_IDEAL_PRODUCTS");
ideal descendedMinors53=minor(jacob(descendedSource53),2);
ideal descendedJacobian53=descendedSource53,descendedMinors53;
int descendedSmooth53=(reduce(poly(1),std(descendedJacobian53))==0);
matrix descendedSmoothLift53;
if(descendedSmooth53){descendedSmoothLift53=lift(descendedJacobian53,ideal(1));require53(matrix(descendedJacobian53)*descendedSmoothLift53==matrix(ideal(1)),"SUPER53_DESCENDED_JACOBIAN_PRODUCT");}
poly descendedQuartic53=l^4+(1+1/a)*l+(1+1/a)^2;
int descendedQuarticMember53=(reduce(descendedQuartic53,descendedGB53)==0);
matrix descendedQuarticLift53;
if(descendedQuarticMember53){descendedQuarticLift53=lift(descendedSource53,ideal(descendedQuartic53));require53(matrix(descendedSource53)*descendedQuarticLift53==matrix(ideal(descendedQuartic53)),"SUPER53_DESCENDED_QUARTIC_PRODUCT");}
int rectangular53=0;
if(size(descendedGB53)==2){rectangular53=((lead(descendedGB53[1])==n^4 && lead(descendedGB53[2])==l^4) || (lead(descendedGB53[2])==n^4 && lead(descendedGB53[1])==l^4));}
link descendedOut53="ASCII:w descended-supersingular53.sing";
write(descendedOut53,"ring descendedSupersingularCertificate53=(2,a),(n,l),lp;minpoly=a^5+a^2+1;short=0;ideal source53="+string(descendedSource53)+";ideal gb53="+string(descendedGB53)+";ideal minors53="+string(descendedMinors53)+";int dimension53="+string(descendedDimension53)+";int smooth53="+string(descendedSmooth53)+";int quarticMember53="+string(descendedQuarticMember53)+";");
if(descendedSmooth53){dump53(descendedOut53,"smoothLift53",descendedSmoothLift53);}
dump53(descendedOut53,"forward53",descendedForward53);dump53(descendedOut53,"reverse53",descendedReverse53);
if(descendedQuarticMember53){dump53(descendedOut53,"quarticLift53",descendedQuarticLift53);}
close(descendedOut53);
print("SUPER53_DESCENDED_BASIS");print(descendedGB53);
print("SUPER53_DESCENDED_RESULT dimension="+string(descendedDimension53)+" Jacobian_unit="+string(descendedSmooth53)+" quartic_member="+string(descendedQuarticMember53)+" full_descent="+string(descent53)+" rectangular4x4="+string(rectangular53));
print("SUPERSINGULAR53_ALL_CHECKS_PASS");quit;
