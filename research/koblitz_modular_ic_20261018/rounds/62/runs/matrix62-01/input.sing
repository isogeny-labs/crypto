LIB "linalg.lib";
proc require62(int ok,string tag){if(!ok){ERROR(tag);quit;}}
execute(read("../../../61/runs/field61-01/field-space61.sing"));
ideal GB62=std(sourceIdeal61);require62(dim(GB62)==0 && vdim(GB62)==32,"MATRIX62_COMPLETE_SOURCE_DEGREE");
ideal basis62;int i62;int j62;int k62;
for(j62=0;j62<=1;j62++){for(i62=0;i62<16;i62++){k62=1+i62+16*j62;basis62[k62]=l^i62*v^j62;require62(reduce(basis62[k62],GB62)==basis62[k62],"MATRIX62_ALL_STANDARD_MONOMIALS");}}
proc coordinates62(poly f){
 poly p=reduce(f,GB62);poly original=p;poly rebuilt=0;matrix C[32][1];intvec ex;int pos;number a;
 while(p!=0){ex=leadexp(p);require62(ex[1]<16 && ex[2]<2,"MATRIX62_CANONICAL_EXPONENTS");pos=1+ex[1]+16*ex[2];a=leadcoef(p);C[pos,1]=C[pos,1]+a;rebuilt=rebuilt+a*basis62[pos];p=p-lead(p);}
 require62(rebuilt==original,"MATRIX62_COMPLETE_COORDINATE_BINDING");return(C);
}
matrix square62[32][32];matrix column62[32][1];
for(j62=1;j62<=32;j62++){column62=coordinates62(basis62[j62]^2);for(i62=1;i62<=32;i62++){square62[i62,j62]=column62[i62,1];}}
matrix inverse62=lift(module(square62),module(unitmat(32)));
require62(nrows(inverse62)==32 && ncols(inverse62)==32,"MATRIX62_INVERSE_DIMENSION");
require62(square62*inverse62==unitmat(32) && inverse62*square62==unitmat(32),"MATRIX62_BOTH_INVERSE_PRODUCTS");
poly rebuilt62;
for(j62=1;j62<=32;j62++){
 rebuilt62=0;
 for(i62=1;i62<=32;i62++){
  require62(square62[i62,j62]==leadcoef(square62[i62,j62]) && inverse62[i62,j62]==leadcoef(inverse62[i62,j62]),"MATRIX62_COEFFICIENT_FIELD_ONLY");
  rebuilt62=rebuilt62+square62[i62,j62]*basis62[i62];
 }
 require62(reduce(rebuilt62+basis62[j62]^2,GB62)==0,"MATRIX62_ALL_SQUARED_SOURCE_COLUMNS");
}
matrix changed62=square62;changed62[1,1]=changed62[1,1]+1;require62(changed62*inverse62!=unitmat(32),"MATRIX62_CHANGED_MATRIX_REJECTED");
proc dumpMatrix62(link out,string name,matrix M){int i;int j;write(out,"matrix "+name+"["+string(nrows(M))+"]["+string(ncols(M))+"];");for(i=1;i<=nrows(M);i++){for(j=1;j<=ncols(M);j++){if(M[i,j]!=0){write(out,name+"["+string(i)+","+string(j)+"]="+string(M[i,j])+";");}}}}
link out62="ASCII:w square-matrix62.sing";open(out62);
write(out62,"// Requires the retained FIELD61 source ring F2(u),(l,v); cachedIdeal62 must match sourceIdeal61.");
write(out62,"ideal cachedIdeal62;ideal squareBasis62;");
for(i62=1;i62<=size(sourceIdeal61);i62++){write(out62,"cachedIdeal62["+string(i62)+"]="+string(sourceIdeal61[i62])+";");}
for(i62=1;i62<=32;i62++){write(out62,"squareBasis62["+string(i62)+"]="+string(basis62[i62])+";");}
dumpMatrix62(out62,"square62",square62);dumpMatrix62(out62,"inverse62",inverse62);close(out62);
print("MATRIX62_RESULT source_degree=32 standard_monomials=32 squared_source_bindings=32 inverse_products=2 coefficient_field_only=1 changed_matrix_rejected=1");
print("MATRIX62_ALL_CHECKS_PASS");quit;
