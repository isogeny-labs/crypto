proc require79(int ok,string tag){if(!ok){ERROR(tag);quit;}}
execute(read("../../../50/runs/normal-relative-finite50-01/normalization50.sing"));
require79(char(basering)==2 && npars(basering)==0,"CAND79_COEFFICIENT_FIELD");
require79(nvars(basering)==22 && size(norid)==400 && size(normap)==3,"CAND79_SAVED_SHAPES");
require79(normap[1]==x && normap[2]==y && normap[3]==p,"CAND79_LITERAL_SOURCE_MAP");
ideal specialized79=subst(norid,p,0);
ideal zeroBase79=specialized79,p,y;
ideal zero79=std(zeroBase79);
int dimZero79=vdim(zero79);
require79(dimZero79>0 && dimZero79<=32,"CAND79_ZERO_FINITE_DIMENSION");
require79(reduce(x^16+x^8+1,zero79)==0,"CAND79_ZERO_SOURCE_FACTOR");
print("CAND79_COMPONENT y=0 dimension="+string(dimZero79)+" source_factor=1");
ideal oneBase79=specialized79,p,y+1;
ideal one79=std(oneBase79);
int dimOne79=vdim(one79);
require79(dimOne79>0 && dimOne79<=32,"CAND79_ONE_FINITE_DIMENSION");
require79(reduce(x^16,one79)==0,"CAND79_ONE_SOURCE_FACTOR");
require79(dimZero79+dimOne79==32,"CAND79_FULL_CANDIDATE_RANK");
print("CAND79_COMPONENT y=1 dimension="+string(dimOne79)+" source_factor=1");
print("CAND79_RESULT components=2 total_dimension="+string(dimZero79+dimOne79)+" candidate_only=1");
print("CANDIDATE_U0_79_ALL_CHECKS_PASS");quit;
