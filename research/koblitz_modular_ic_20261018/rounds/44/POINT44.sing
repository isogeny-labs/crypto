proc inv44(poly a,ideal q){ideal g=q,a;if(std(g)[1]!=1){ERROR("POINT44_NONUNIT");}matrix w=lift(g,ideal(1));poly ans=reduce(w[nrows(w),1],q);if(reduce(a*ans+1,q)!=0){ERROR("POINT44_INVERSE");}return(ans);}
proc same44(list p,list q,ideal rel){int i;for(i=1;i<=4;i++){if(reduce(p[i]+q[i],rel)!=0){return(0);}}return(1);}
proc square44(list p,ideal q){list ans;int i;for(i=1;i<=4;i++){ans[i]=reduce(p[i]^2,q);}return(ans);}
proc source44(list p,ideal q){map ev=r,p[4],p[3],p[1],p[2];ideal residual=ev(original);ideal units=ev(registered);int i;for(i=1;i<=5;i++){if(reduce(residual[i],q)!=0){ERROR("POINT44_SOURCE_"+string(i));}}for(i=1;i<=8;i++){poly unused=inv44(units[i],q);}return(1);}
proc deck44(list p,ideal q){poly b=p[1];poly c=p[2];poly l=p[3];poly n=p[4];poly a=1+c;poly s=reduce(b*inv44(c,q)+a,q);poly v=reduce(s*(a+s),q);poly iu=inv44(reduce(b*c*inv44(v,q),q),q);return(list(reduce(v*iu^2,q),reduce(1+a*iu,q),reduce((l+s)*iu,q),reduce((l*b+n+b*c)*iu^3,q)));}
proc add44(list p,list q,poly b,poly a,ideal rel){if(size(p)==0){return(q);}if(size(q)==0){return(p);}poly x=p[1];poly y=p[2];poly z=q[1];poly w=q[2];poly slope;poly den;
 if(x==z){if(y!=w && reduce(y+w+a*x+b,rel)==0){return(list());}if(y!=w){ERROR("POINT44_EQUAL_X");}den=reduce(a*x+b,rel);if(den==0){return(list());}slope=reduce((x^2+a*y)*inv44(den,rel),rel);}else{slope=reduce((y+w)*inv44(x+z,rel),rel);}
 poly rx=reduce(slope^2+a*slope+b+x+z,rel);poly ry=reduce((slope+a)*rx+y+slope*x+b,rel);
 if(reduce(ry^2+a*rx*ry+b*ry+rx^3+b*rx^2,rel)!=0){ERROR("POINT44_GROUP_CURVE");}return(list(rx,ry));
}
proc passage44(int caseid,number mx,number my,poly kernelLocal44,int d){
 if(deg(kernelLocal44)!=5 || leadcoef(kernelLocal44)!=1 || gcd(kernelLocal44,diff(kernelLocal44,X))!=1){ERROR("POINT44_KERNEL_SHAPE");}
 ideal base=std(ideal(kernelLocal44,Z,T));if(vdim(base)!=5){ERROR("POINT44_BASE_DIM");}
 poly xf=X;poly fd;int k;for(k=1;k<=5*d;k++){xf=reduce(xf^2,base);if(k==d){fd=xf;}}if(xf!=X || gcd(fd-X,kernelLocal44)!=1){ERROR("POINT44_KERNEL_RABIN");}
 list triple=triple30(mx,my);number B=1/triple[1];list k7s=kernels30(B,7);poly k7=choose30(B,k7s,triple[2]);
 number c2=number((jet(k7,2)+jet(k7,1))/X^2);number c1=number((jet(k7,1)+jet(k7,0))/X);number c0=number(subst(k7,X,0));
 poly rr=X;poly x2=reduce(rr^2+B*inv44(rr^2,base),base);poly v=reduce(rr+x2,base);poly u=reduce(rr*inv44(v,base),base);poly iu=inv44(u,base);
 poly bb=reduce(v^3*inv44(rr^2,base),base);poly cc=reduce(x2*inv44(rr,base),base);poly aa=reduce(1+cc,base);
 if(reduce(u*aa+1,base)!=0 || reduce(bb*u^3+rr,base)!=0){ERROR("POINT44_NORMALIZATION");}
 poly g2=reduce((rr+c2)*iu^2,base);poly g1=reduce((rr^2+c1)*iu^4,base);poly g0=reduce((rr^3+c2*rr^2+c1*rr+c0)*iu^6,base);
 list sumLocal44;list P=list(poly(0),poly(0));for(k=1;k<=11;k++){sumLocal44=add44(sumLocal44,P,bb,aa,base);if(k<11 && size(sumLocal44)==0){ERROR("POINT44_EARLY_ORDER");}}if(size(sumLocal44)!=0){ERROR("POINT44_ORDER11");}
 int twist;int unused;int step;int j;int matches;int matched;int period;poly L;poly traceLocal44;poly term;poly nv;ideal q;ideal physical;list p;list ph;list deck;list cur;list fp;list sign;list bad;
 for(twist=0;twist<=1;twist++){
  L=Z^2+aa*Z+bb+g2+twist*aa^2;q=std(ideal(kernelLocal44,L,T));physical=std(ideal(kernelLocal44,L,T^2+T+1));
  if(vdim(q)!=10 || vdim(physical)!=20){ERROR("POINT44_SOURCE_DIM");}
  nv=reduce((g1+bb*Z)*inv44(aa,base),q);p=list(bb,cc,poly(Z),nv);ph=list(bb,cc,Z+twist*aa*T,nv+twist*bb*T);
  if(reduce(ph[4]^2+bb*ph[4]+g0,physical)!=0){ERROR("POINT44_QR_CONSTANT");}
  cur=ph;deck=list(p);for(step=0;step<10;step++){
   unused=source44(cur,physical);
   if(step==5){sign=list(bb,cc,ph[3]+aa,ph[4]+bb);if(same44(cur,sign,physical)==0){ERROR("POINT44_SIGN");}}
   if(step>0){list desc=list(cur[1],cur[2],reduce(cur[3]+twist*(1+cur[2])*T,physical),reduce(cur[4]+twist*cur[1]*T,physical));
    for(j=1;j<=4;j++){if(reduce(desc[j]+subst(desc[j],T,0),physical)!=0){ERROR("POINT44_DESCENT_T");}desc[j]=reduce(subst(desc[j],T,0),q);}deck[step+1]=desc;
   }
   cur=deck44(cur,physical);
  }if(same44(cur,ph,physical)==0){ERROR("POINT44_DECK_PERIOD");}
  bad=list(ph[1],ph[2],ph[3],ph[4]+1);map corrupt=r,bad[4],bad[3],bad[1],bad[2];ideal cr=corrupt(original);int rejected=0;for(j=1;j<=5;j++){if(reduce(cr[j],physical)!=0){rejected=1;}}if(rejected==0){ERROR("POINT44_CORRUPT_ACCEPTED");}
  term=reduce((bb+g2+twist*aa^2)*inv44(aa^2,base),base);traceLocal44=0;for(k=0;k<5*d;k++){traceLocal44=reduce(traceLocal44+term,base);term=reduce(term^2,base);}if(traceLocal44!=0 && traceLocal44!=1){ERROR("POINT44_AS_TRACE");}
  fp=p;for(k=1;k<=d;k++){fp=square44(fp,q);}matches=0;matched=-1;for(step=0;step<10;step++){if(same44(fp,deck[step+1],q)==1){matches++;matched=step;}}
  if(matches!=1){ERROR("POINT44_FROB_DECK_MATCH");}
  fp=p;for(k=1;k<=5*d;k++){fp=square44(fp,q);}sign=list(bb,cc,Z+aa*traceLocal44,nv+bb*traceLocal44);if(same44(fp,sign,q)==0){ERROR("POINT44_FROB_TRACE_SIGN");}
  fp=p;period=0;for(k=1;k<=10*d;k++){fp=square44(fp,q);if(same44(fp,p,q)==1){period=k;break;}}if(period==0){ERROR("POINT44_ABSOLUTE_PERIOD");}
  print("POINT44_RESULT case="+string(caseid)+" base_degree="+string(d)+" twist="+string(twist)+" kernel_dimension=5 source_dimension=10 physical_dimension=20 AS_trace="+string(traceLocal44)+" Frobenius_d_deck_step="+string(matched)+" source_tuple_period="+string(period)+" all_source_equations=5 all_registered_units=8 deck_iterates=10 corrupt_nu=rejected Tate_order=11");
  print("POINT44_KERNEL");kernelLocal44;print("POINT44_ORIENTATION");L;print("POINT44_b");bb;print("POINT44_c");cc;print("POINT44_lambda");Z;print("POINT44_nu");nv;
 }
 return(1);
}
