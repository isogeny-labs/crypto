proc modularValues44(list p,ideal q){
 list images=list(p[4],p[3],p[1],p[2]);list powers;list row;int v;int k;int i;int j;list terms;intvec ex;poly ans;poly term;ideal result;
 for(v=1;v<=4;v++){row=list(poly(1));for(k=1;k<=bounds44[v];k++){row[k+1]=reduce(poly(row[k])*poly(images[v]),q);}powers[v]=row;}
 for(i=1;i<=13;i++){ans=0;terms=encoded44[i];for(j=1;j<=size(terms);j++){ex=terms[j];term=1;for(v=1;v<=4;v++){if(ex[v]>0){row=powers[v];term=reduce(term*poly(row[ex[v]+1]),q);}}ans=ans+term;}result[i]=reduce(ans,q);}
 return(result);
}
proc sourceFast44(list p,ideal q){ideal values=modularValues44(p,q);int i;poly unused;for(i=1;i<=5;i++){if(values[i]!=0){ERROR("FAST44_SOURCE_"+string(i));}}for(i=6;i<=13;i++){unused=inv44(values[i],q);}return(1);}
