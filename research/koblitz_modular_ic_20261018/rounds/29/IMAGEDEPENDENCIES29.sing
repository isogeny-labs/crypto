if((secondX^3+secondX+1==0 || secondX^3+secondX^2+1==0) && secondY*(secondX^2+secondX+1)==secondX+1){ERROR("selected second image is a nonrational cusp");}
number originalX29=firstX;number originalY29=firstY;
