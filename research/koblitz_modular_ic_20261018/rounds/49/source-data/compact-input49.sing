option(redSB);short=0;ring original49=2,(n,l,b,c),dp;ideal sourceS49;ideal sourceU49;
sourceS49[1]=b^1*c^7+b^2*c^5+b^1*c^6+b^2*c^4+c^6+b^5+b^4*c^1+b^3*c^2+b^2*c^3;
sourceS49[2]=b^2*c^10+b^3*c^8+b^2*c^9+b^6*c^3+b^5*c^4+b^2*c^7+b^1*c^8+b^4*c^4+c^8+b^7+b^6*c^1+b^3*c^4+b^2*c^5;
sourceS49[3]=n^2*l^6+n^1*l^6*b^1+n^2*l^5*c^1+n^1*l^5*b^1*c^1+n^2*l^4*c^2+n^1*l^4*b^1*c^2+n^2*l^3*c^3+n^1*l^3*b^1*c^3+n^2*l^5+n^2*l^4*b^1+n^1*l^5*b^1+n^1*l^4*b^2+n^2*l^3*c^2+n^2*l^2*b^1*c^2+n^1*l^3*b^1*c^2+n^1*l^2*b^2*c^2+n^2*l^4+n^2*l^3*b^1+n^1*l^4*b^1+n^2*l^2*b^2+n^1*l^3*b^2+n^1*l^2*b^3+n^3*l^2*c^1+n^2*l^3*c^1+n^1*l^3*b^1*c^1+n^2*l^1*b^2*c^1+n^1*l^2*b^2*c^1+n^1*l^1*b^3*c^1+n^3*l^1*c^2+n^1*l^1*b^2*c^2+n^3*c^3+n^2*b^1*c^3+n^3*l^2+n^2*l^3+n^2*l^2*b^1+n^1*l^3*b^1+n^2*b^3+n^1*b^4+l^1*b^4+n^3*b^1*c^1+n^2*b^2*c^1+n^1*b^3*c^1+b^4*c^1+n^3*c^2+n^2*b^1*c^2+n^4+n^3*l^1+n^3*b^1+n^2*b^2+n^1*l^1*b^2+n^3*c^1+n^2*b^1*c^1+n^3+n^2*b^1;
sourceS49[4]=l^7*b^1+n^1*l^6*c^1+l^6*b^1*c^1+n^1*l^5*c^2+l^5*b^1*c^2+n^1*l^4*c^3+l^4*b^1*c^3+n^1*l^3*c^4+n^1*l^6+l^6*b^1+l^5*b^2+n^1*l^4*b^1*c^1+n^1*l^4*c^2+l^4*b^1*c^2+l^3*b^2*c^2+n^1*l^2*b^1*c^3+n^2*l^4+n^1*l^5+l^5*b^1+l^4*b^2+l^3*b^3+n^1*l^4*c^1+l^4*b^1*c^1+n^1*l^2*b^2*c^1+l^3*b^2*c^1+l^2*b^3*c^1+n^1*l^1*b^2*c^2+l^2*b^2*c^2+n^2*l^1*c^3+n^2*c^4+n^1*l^4+l^4*b^1+n^1*l^2*b^2+l^1*b^4+n^1*l^2*b^1*c^1+n^1*b^3*c^1+n^2*l^1*c^2+n^2*b^1*c^2+b^3*c^2+n^1*l^3+n^2*l^1*b^1+n^2*b^2+l^2*b^2+n^3*c^1+n^2*l^1*c^1+n^2*b^1*c^1+b^3*c^1+n^3+n^2*l^1+n^2;
sourceS49[5]=l^8+l^4*c^4+l^3*b^1*c^2+n^1*l^2*c^3+l^2*b^1*c^3+n^1*l^1*c^4+n^1*l^2*c^2+l^2*b^1*c^2+l^1*b^2*c^2+n^1*b^1*c^3+l^4+l^3*b^1+l^2*b^2+b^4+n^1*l^2*c^1+l^2*b^1*c^1+n^1*l^2+l^2*b^1+l^1*b^2+n^1*b^1*c^1+n^1*l^1;
