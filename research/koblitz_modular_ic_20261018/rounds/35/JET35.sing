proc evaluate35(list encoded,ideal images){
 intvec bounds=0,0,0,0;int i;int j;int k;int v;intvec ex;list terms;
 for(i=1;i<=size(encoded);i++){terms=encoded[i];for(j=1;j<=size(terms);j++){ex=terms[j];for(v=1;v<=4;v++){if(ex[v]>bounds[v]){bounds[v]=ex[v];}}}}
 list powers;list row;for(v=1;v<=4;v++){row=list(poly(1));for(k=1;k<=bounds[v];k++){row[k+1]=reduce(poly(row[k])*images[v],jetResidue35);}powers[v]=row;}
 ideal ans;poly termValue;poly val;
 for(i=1;i<=size(encoded);i++){val=0;terms=encoded[i];for(j=1;j<=size(terms);j++){ex=terms[j];termValue=1;for(v=1;v<=4;v++){row=powers[v];termValue=reduce(termValue*poly(row[ex[v]+1]),jetResidue35);}val=val+termValue;}ans[i]=reduce(val,jetResidue35);}return(ans);
}
