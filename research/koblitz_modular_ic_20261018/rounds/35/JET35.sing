proc inv35(poly f){ideal gens=jetResidue35,f;if(std(gens)[1]!=1){ERROR("JET35_NONUNIT");}matrix wit=lift(gens,ideal(1));poly ans=reduce(wit[nrows(wit),1],jetResidue35);if(reduce(f*ans+1,jetResidue35)!=0){ERROR("JET35_INVERSE");}return(ans);}
