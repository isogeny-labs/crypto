proc code35(number x){int i;for(i=1;i<=32;i++){if(x==number(field35[i])){return(i-1);}}ERROR("JET35_FIELD_WORD");return(-1);}
proc pack35(poly f){poly ans=0;int i;int j;int word;intvec ex;for(i=1;i<=size(f);i++){ex=leadexp(f[i]);if(ex[2]!=0 || ex[3]!=0 || ex[1]>=154){ERROR("JET35_PACK_DOMAIN");}word=code35(leadcoef(f[i]));for(j=0;j<5;j++){if(word%2==1){ans=ans+w^(5*ex[1]+j);}word=word div 2;}}return(ans);}
proc rank35(ideal columns,int count){list piv;list co;int i;int j;int p;int rk;poly bits;poly label;poly rebuilt;for(i=1;i<=770;i++){piv[i]=poly(0);co[i]=poly(0);}for(i=1;i<=count;i++){bits=pack35(columns[i]);label=w^(i-1);while(bits!=0){p=deg(bits)+1;if(piv[p]==0){piv[p]=bits;co[p]=label;rk++;break;}bits=bits+poly(piv[p]);label=label+poly(co[p]);}if(bits==0){ERROR("JET35_DEPENDENT_SELECTED_SECTION");}}
 for(p=1;p<=770;p++){if(piv[p]!=0){rebuilt=0;label=co[p];for(j=1;j<=size(label);j++){rebuilt=rebuilt+columns[deg(label[j])+1];}if(pack35(rebuilt)!=poly(piv[p])){ERROR("JET35_PIVOT_RECOMBINATION");}}}return(rk);}
int rankSections35=rank35(sections35,68);int rankQuadratic35=rank35(quadratic35,196);int rankCubic35=rank35(cubic35,324);
if(rankSections35!=68 || rankQuadratic35!=196 || rankCubic35!=324){ERROR("JET35_SELECTED_RANKS");}
short=0;link out35="ASCII:w padding-jets154.sing";open(out35);
write(out35,"poly paddingUJet35="+string(uj35)+";poly paddingVJet35="+string(vj35)+";poly paddingBJet35="+string(bj35)+";poly paddingCJet35="+string(cj35)+";poly paddingLambdaJet35="+string(lj35)+";poly paddingNuJet35="+string(nj35)+";ideal sourceUnits35;ideal sourceInverses35;ideal sectionValues35;ideal quadraticValues35;ideal cubicValues35;");
for(i35=1;i35<=8;i35++){write(out35,"sourceUnits35["+string(i35)+"]="+string(units35[i35])+";sourceInverses35["+string(i35)+"]="+string(inverses35[i35])+";");}
for(i35=1;i35<=68;i35++){write(out35,"sectionValues35["+string(i35)+"]="+string(sections35[i35])+";");}
for(i35=1;i35<=196;i35++){write(out35,"quadraticValues35["+string(i35)+"]="+string(quadratic35[i35])+";");}
for(i35=1;i35<=324;i35++){write(out35,"cubicValues35["+string(i35)+"]="+string(cubic35[i35])+";");}close(out35);
link bitsOut35="ASCII:w evaluation-words.txt";open(bitsOut35);list spaces35=sections35,quadratic35,cubic35;intvec counts35=68,196,324;ideal space35;intvec words35;poly coefficient35;
for(k35=1;k35<=3;k35++){space35=spaces35[k35];for(i35=1;i35<=counts35[k35];i35++){words35=intvec(0);for(j35=0;j35<154;j35++){coefficient35=jet(space35[i35],j35);if(j35>0){coefficient35=coefficient35+jet(space35[i35],j35-1);}words35[j35+1]=code35(number(coefficient35/z^j35));}write(bitsOut35,string(k35)+" "+string(i35)+" "+string(words35));}}close(bitsOut35);
print("JET35_RESULT precision=154 residue_degree=5 source_equations=5 units=8 conjugates=5 descent_functions=68 ranks=68,196,324 old_precision9=pass pivot_recombination=all");print("JET35_ALL_CHECKS_PASS");quit;
