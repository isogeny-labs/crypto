proc require88(int ok,string tag){if(!ok){ERROR(tag);quit;}}
ring target88=2,(p,q,t),dp;
poly ETarget88=q^2+p^2*q+p+p^3;
ideal targetIdeal88=ETarget88;
ideal targetStd88=std(targetIdeal88);
poly k88=p+q+p^2;
poly G88=p*k88^2+p+k88^2;
require88(reduce(p,targetStd88)!=0 && reduce(k88,targetStd88)!=0 && reduce(G88,targetStd88)!=0,"INV88_TARGET_DENOMINATOR_ZERO");
poly Ntarget88=(p+k88)*(k88+1)+p;
poly qResidual88=p*Ntarget88+q*k88^2;
require88(reduce(qResidual88,targetStd88)==0,"INV88_TARGET_BASE_COMPOSITION");
matrix targetLift88=lift(targetIdeal88,ideal(qResidual88));
require88(matrix(targetIdeal88)*targetLift88==matrix(ideal(qResidual88)),"INV88_TARGET_BASE_FULL_LIFT");
require88(p+(p+k88)==k88,"INV88_TARGET_Z_COMPOSITION");
poly TinvNumerator88=G88*(t+(k88+1)^2);
poly CinvNumerator88=G88*(k88+1)^2;
require88(TinvNumerator88+CinvNumerator88+G88*t==0,"INV88_TARGET_T_COMPOSITION");
require88(TinvNumerator88+1+CinvNumerator88+G88*t!=0,"INV88_CORRUPTED_T_INVERSE_ACCEPTED");
ring source88=2,(z,V,T),dp;
poly ESource88=V^2+z^2*V+z+z^3;
ideal sourceIdeal88=ESource88;
ideal sourceStd88=std(sourceIdeal88);
poly h88=z+V;
poly H88=1+z+z^2+z*V;
poly N88=V+z*V+z^2;
poly g88=1+z+z^2+V;
poly D88=z^2*g88;
poly C88=(1+z)^2*g88;
poly A88=T+C88;
require88(h88^2+z*H88==ESource88 && H88==N88+h88+1,"INV88_SOURCE_BASE_PRODUCTS");
require88(reduce(z,sourceStd88)!=0 && reduce(h88,sourceStd88)!=0 && reduce(D88,sourceStd88)!=0,"INV88_SOURCE_DENOMINATOR_ZERO");
poly Gforward88=H88^2+h88^4+h88*H88^2;
poly inverseDen88=H88^4;
poly inverseDnum88=Gforward88*h88^4;
poly inverseCnum88=Gforward88*(H88+h88^2)^2;
poly dResidual88=inverseDnum88+D88*inverseDen88;
poly cResidual88=inverseCnum88+C88*inverseDen88;
poly tResidual88=inverseDnum88*A88+inverseCnum88*D88+T*inverseDen88*D88;
ideal sourceResidual88=dResidual88,cResidual88,tResidual88;
require88(reduce(dResidual88,sourceStd88)==0 && reduce(cResidual88,sourceStd88)==0 && reduce(tResidual88,sourceStd88)==0,"INV88_SOURCE_COEFFICIENT_COMPOSITION");
matrix sourceLift88=lift(sourceIdeal88,sourceResidual88);
require88(matrix(sourceIdeal88)*sourceLift88==matrix(sourceResidual88),"INV88_SOURCE_FULL_LIFTS");
require88(reduce(tResidual88+inverseDen88*D88,sourceStd88)!=0,"INV88_CORRUPTED_SOURCE_T_ACCEPTED");
print("INV88_RESULT inverse_z=1/k inverse_V=1/k+1/p inverse_T=G*(t+(k+1)^2)/(p*k^4) target_lift=1 source_lifts=3 corruptions_rejected=2");
print("INVERSE88_ALL_CHECKS_PASS");
quit;
