 }
 for(jj61=1;jj61<=324;jj61++){
  val61=lm(vals61[pairs361[jj61,1]],quad61[pairs361[jj61,2]]);evaluations61++;
  require58(val61[3]>0 && (val61[1]==0 || val61[2]>=-bound61),"CUBIC61_ALL_ACTUAL_AMBIENT_POLE_BOUNDS");
