 }
 print("CUBIC61_CHART chart="+string(chartid61)+" cusp="+string(cusp61)+" ramification="+string(ram61)+" cubic_products=324 point_label="+string(point61));
}
for(ii61=1;ii61<=4;ii61++){require58(selected61[ii61]==1,"CUBIC61_FOUR_UNIQUE_POINTS");}
require58(evaluations61==6480 && conjugates61==1360,"CUBIC61_FULL_CHART_COUNTS");
int ambientRank61=mat_rk(cubicJets61);print("CUBIC61_AMBIENT_RANK "+string(ambientRank61));
