execute(read("../../../60/source-data/evaluation-prefix60.sing"));
execute(read("../../source-data/pairs361.sing"));
matrix cubicJets61[770][324];matrix cubicSigmaJets61[770][324];matrix cubicC61[248][324];matrix cubicProfiles61[272][324];
intvec ambientCaps61=147,21,21,3;intvec mixedCaps61=34,12,20,2;intvec constraintOffsets61=0,226,244,246;intvec profileOffsets61=0,136,184,264;
intvec selected61=0,0,0,0;int chartid61;int cusp61;int ram61;int point61;int bound61;int ii61;int jj61;int kk61;int order61;int row61;int evaluations61=0;int conjugates61=0;
list chart61;list coords61;list cached61;list old61;list vals61;list sig61;list quad61;list sigQuad61;list supp61;list val61;list sigVal61;list check61;
number coeff61;
for(ii61=1;ii61<=324;ii61++){require58(pairs361[ii61,1]>=1 && pairs361[ii61,1]<=68 && pairs361[ii61,2]>=1 && pairs361[ii61,2]<=196,"CUBIC61_SECTION_THEN_QUADRATIC_PAIR_ORDER");}
for(chartid61=1;chartid61<=20;chartid61++){
