 if(cusp61==1){bound61=21*ram61;}if(cusp61==4){bound61=3*ram61;}
 if(cusp61==1 && coords61[2][2]==-4*ram61){if(ram61==7){point61=1;}if(ram61==1){point61=2;}}
 if(cusp61==4 && coords61[2][2]==-ram61){if(ram61==7){point61=3;}if(ram61==1){point61=4;}}
 if(point61!=0){selected61[point61]=selected61[point61]+1;require58(bound61==ambientCaps61[point61],"CUBIC61_POINT_BOUND_LABEL");}
 cached61=cache58(coords61,chart61[2],chart61[3]);old61=list();vals61=list();sig61=list();quad61=list();sigQuad61=list();
 for(jj61=1;jj61<=68;jj61++){old61[jj61]=eval58(terms58[jj61],cached61);}
 for(jj61=1;jj61<=68;jj61++){
  val61=lc(0);supp61=sigmaSupports58[jj61];for(kk61=1;kk61<=size(supp61);kk61++){val61=la(val61,old61[supp61[kk61]]);}
  vals61[jj61]=la(val61,scale58(la(old61[jj61],val61),a));
  sig61[jj61]=la(old61[jj61],scale58(la(old61[jj61],val61),a));
  check61=la(conjugate58(vals61[jj61]),sig61[jj61]);require58(check61[1]==0 && check61[3]>0,"CUBIC61_DESCENT_COEFFICIENT_ORIENTATIONS");conjugates61++;
 }
 for(jj61=1;jj61<=196;jj61++){
