#Reduced Groebner basis data
#---
#field characteristic: 101
#variable order:       x, y, h
#monomial order:       graded reverse lexicographical
#length of basis:      5 elements sorted by increasing leading monomials
#---
[1*y^2+3*x^1*h^1+100*y^1*h^1,
1*x^1*y^1+13*x^1*h^1+17*y^1*h^1+26*h^2,
1*x^2+29*x^1*h^1+46*y^1*h^1+90*h^2,
1*y^1*h^2+26*h^3,
1*x^1*h^2+32*h^3]:
