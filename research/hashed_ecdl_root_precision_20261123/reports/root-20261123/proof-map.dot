digraph precision {
  rankdir=TB;
  graph [fontname="Helvetica", bgcolor="white", nodesep=0.3, ranksep=0.35, label="Root precision: exact Nat resource law", labelloc=t, fontsize=17];
  node [shape=box, style="rounded,filled", color="#42617c", fillcolor="#edf4fa", fontname="Helvetica", fontsize=11, margin="0.15,0.1"];
  edge [color="#526777", arrowsize=0.7];
  root [label="Source root shape: a = 2u\np <= M; i < u\nlength * array = 2^(26u) <= M"];
  margin [label="Shared root_array_margin\n32u <= M"];
  scale [label="D = 2^(2u-i) >= 2^(u+1)\n4u <= 2^(u+1)\n16u(2u+1) <= 21*2^(u+1)"];
  components [label="4 * precision * u\n<= (1 + 97 + 42) * M * D"];
  result [label="root_precision_of_array\nprecision * u <= 35 * M * D", fillcolor="#e3f1e6", color="#477355", penwidth=1.5];
  control [label="Normalized u=2 counterexample to34\nM=2E, p=E+1, i=1\n546E+2 > 544E", fillcolor="#fff3dc", color="#a8792f"];
  future [label="Remaining source bridge\nactual path, checked arithmetic,\nlater depths and complete bit cost", style="rounded,dashed", fillcolor="white", color="#8a8a8a"];
  root -> margin;
  root -> scale;
  margin -> components;
  scale -> components;
  components -> result;
  root -> control [label="separate family", fontsize=9];
  result -> future [style=dashed, label="requires further binding", fontsize=9];
}
