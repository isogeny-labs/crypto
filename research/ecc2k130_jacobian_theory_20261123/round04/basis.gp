default(parisize,268435456);
default(parisizemax,536870912);
read("../round03/field.gp");
u=Mod(x,H);
A=vector(132); U=vector(132); D=vector(132);
A[1]=0; A[2]=1; U[1]=0; U[2]=1; D[1]=2; D[2]=u;
for(j=2,131,A[j+1]=u*A[j]-2*A[j-1]; U[j+1]=-U[j]-2*U[j-1]; D[j+1]=u*D[j]-2*D[j-1]);
s=(2*A[132]+u*(U[131]-A[131]))/U[132];
if(u^2+s*u+2*s^2-7,error("relative quadratic identity"));
S=vector(65); S[1]=2;
for(j=1,64,S[j+1]=(U[j+1]*(s*A[j+1]+A[j])-U[j]*D[j+1])/2^(j-1));
if(S[2]!=s,error("s1 identity"));
for(j=2,64,if(S[j+1]!=s*S[j]-S[j-1],error("Chebyshev identity")));
T0=2; T1=s;
for(j=2,65,T2=s*T1-T0; T0=T1; T1=T2);
if(1+sum(j=1,64,S[j+1])+T1,error("cyclotomic real equation"));
B=concat(concat([1],vector(64,j,lift(S[j+1]))),concat([x],vector(64,j,lift(u*S[j+1]))));
print("identities=pass; basis_length=",#B);
M=matrix(130,130,i,j,polcoef(B[j],i-1));
voldisc=poldisc(H)*matdet(M)^2;
if(voldisc!=7^65*131^129,error("basis discriminant mismatch"));
print("basis_discriminant=",voldisc);
print("volume_discriminant=pass");
write("basis_data.gp",Str("Basis=",B,";"));
print("basis_written=basis_data.gp");
quit;
