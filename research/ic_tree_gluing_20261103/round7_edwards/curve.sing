// curve.sing -- choose a twisted Edwards curve a*u^2 + v^2 = 1 + d*u^2*v^2 over F_786433
// (round 7, native Singular). a = 1 (square), d a nonsquare: the addition law is complete.
// Group order via the birational Montgomery form B*y^2 = x^3 + A*x^2 + x,
// A = 2(a+d)/(a-d), B = 4/(a-d):  #E = p + 1 + chi(B) * sum_x chi(x^3 + A x^2 + x),
// with chi from a table of squares and f(x) by finite differences (integer arithmetic only).
// Tries d = 2, 3, ... (nonsquares) and stops at the first #E = 4 * prime.
// Usage: Singular -q curve.sing
LIB "general.lib";
short = 0;
int P = 786433;
intvec SQ; SQ[P] = 0;               // SQ[c+1] = 1 iff c is a nonzero square
int i; int s = 0;
for (i = 1; i <= (P - 1) div 2; i++) { s = s + 2 * i - 1; if (s >= P) { s = s - P; } SQ[s + 1] = 1; }
proc chi(int c) { if (c == 0) { return(0); } if (SQ[c + 1] == 1) { return(1); } return(-1); }
ring r = 786433, z, dp;
int d; number nA; number nB; int A; int B; int f; int d1; int d2; int x; int S; int N; int found = 0;
number na = 1;
for (d = 2; d < 200 and found == 0; d++)
{
  if (chi(d) == -1)
  {
    nA = 2 * (na + d) / (na - d); nB = 4 / (na - d);
    A = int(nA); if (A < 0) { A = A + P; } B = int(nB); if (B < 0) { B = B + P; }
    // f(0)=0; d1(x)=f(x+1)-f(x)=3x^2+3x+1+A(2x+1)+1; d2(x)=d1(x+1)-d1(x)=6x+6+2A; d3=6
    f = 0; d1 = (2 + A) mod P; d2 = (6 + 2 * A) mod P; S = 0;
    for (x = 0; x < P; x++)
    {
      S = S + chi(f);
      f = f + d1; if (f >= P) { f = f - P; }
      d1 = d1 + d2; if (d1 >= P) { d1 = d1 - P; }
      d2 = d2 + 6; if (d2 >= P) { d2 = d2 - P; }
    }
    N = P + 1 + chi(B) * S;
    print("a=1 d=" + string(d) + " A=" + string(A) + " B=" + string(B) + " #E=" + string(N)
          + " #E/4=" + string(N div 4) + " prime(#E/4)=" + string(N mod 4 == 0 and prime(N div 4) == N div 4));
    if (N mod 4 == 0) { if (prime(N div 4) == N div 4) { found = d; } }
  }
}
print("chosen d=" + string(found));
quit;
