// gen7.sing -- round 7: tree-glued PDP systems on a twisted Edwards curve (native Singular).
//
//   curve   a*u^2 + v^2 = 1 + d*u^2*v^2 over F_786433, a = 1, d = 11 (nonsquare: complete law),
//           #E = 4 * 196873 (curve.sing; re-checked here by scalar multiplication)
//   base    points with v = g*w, w in mu_(2^t)  (v is negation invariant: -(u,v) = (-u,v))
//   arms    E1  v-only cherry tree: (s,q) of each cherry's w's with the degree-2 remainder
//               chain (as arm T), glued by the Edwards 3-summation polynomial S3E in v
//           E1S E1 with every internal separator X_c fixed to its planted value (floor control)
//           E2  full-coordinate tree: leaves (u_i, w_i), v_i = g*w_i, curve equation, per-leaf
//               Kummer chain on w_i; internal nodes (U_c, V_c) by the two cleared addition-law
//               equations; root node = R (both coordinates known)
//           E1Q E1 quotiented by the 2-torsion translations (0,-1): variables are the invariants
//               of the sign group {e : e1 e2 eX = 1 at every node}: squares (W_i = w_i^2 in
//               mu_(2^(t-1)), Y_c = X_c^2) and one signed product per node (p_c = v v' X_c;
//               root: p = X v3 (m=3) or X1 X2 (m=4), with v_R known). Each node is
//               SI(A,B,C) - 2(a-d) pi = 0 and pi^2 = A B C, SI the invariant form of S3E.
//   cells   (m,t) in CELLS7 (env, default "3 4 3 5 4 4 4 5"), one planted target each
//   output  OUTDIR7 (env) / m<m>_t<t>_<arm>.ms ; msolve format; planted check before writing
// Helpers kn, mn, kchain, mchain, plantM, plantK, fmtpoly are copied from ../gen.sing.
// Randomness: LCG (as ../inst.sing) with seed 0xED7A1104.
LIB "general.lib";
short = 0;
string OUTDIR = system("getenv", "OUTDIR7");
if (OUTDIR == "") { OUTDIR = "/tmp/claude-0/-home-user/8900182d-dd1d-52b2-9106-78048929cee5/scratchpad/edw/ms"; }
string CELLSTR = system("getenv", "CELLS7");
if (CELLSTR == "") { CELLSTR = "3 4 3 5 4 4 4 5"; }
int rcmk = system("sh", "mkdir -p " + OUTDIR);
int P = 786433; int CA = 1; int CD = 11; bigint ORD = 787492; int RPR = 196873;

proc die(string msg) { print("ERROR: " + msg); system("sh", "kill -TERM $PPID"); quit; }
proc ix(string s, list L)
{
  int i;
  for (i = 1; i <= size(L); i++) { if (L[i] == s) { return(i); } }
  return(0);
}
proc kn(string nme, int t)
{
  list L; int j;
  for (j = 1; j < t; j++) { L[j] = nme + "u" + string(j); }
  return(L);
}
proc mn(string nme, int k, int t)
{
  list L; int j; int i;
  for (j = 1; j < t; j++)
  {
    if (2^j >= k) { for (i = 0; i < k; i++) { L[size(L) + 1] = nme + "r" + string(j) + "_" + string(i); } }
  }
  return(L);
}
proc kchain(string nme, poly w, int t, list nm)
{
  ideal E; int j; int ne = 0; poly prev = w; poly u;
  for (j = 1; j < t; j++) { u = var(ix(nme + "u" + string(j), nm)); ne++; E[ne] = u - prev^2; prev = u; }
  ne++; E[ne] = prev^2 - 1;
  return(E);
}
proc mchain(string nme, ideal es, int k, int t, list nm)
{
  poly T = var(1); poly Q = T^k; int i; int j; int ne = 0;
  for (i = 0; i < k; i++) { Q = Q + (-1)^(i + 1) * es[i + 1] * T^(k - 1 - i); }
  ideal G = std(ideal(Q));
  poly R = T; poly Rn; poly Rsym; poly df; ideal E; matrix M;
  for (j = 1; j <= t; j++)
  {
    Rn = reduce(R^2, G);
    if (j < t and 2^j < k) { R = T^(2^j); }
    else
    {
      if (j == t) { df = Rn - 1; }
      else
      {
        Rsym = 0;
        for (i = 0; i < k; i++) { Rsym = Rsym + var(ix(nme + "r" + string(j) + "_" + string(i), nm)) * T^i; }
        df = Rn - Rsym;
      }
      M = coeffs(df, T);
      for (i = nrows(M); i >= 1; i--) { if (M[i, 1] != 0) { ne++; E[ne] = M[i, 1]; } }
      R = Rsym;
    }
  }
  return(E);
}
proc plantM(string nme, int k, int t, ideal roots, list nm, ideal vals)
{
  poly T = var(1); poly Qn = 1; int i; int j; poly rm; matrix M;
  for (i = 1; i <= k; i++) { Qn = Qn * (T - roots[i]); }
  ideal G = std(ideal(Qn));
  for (j = 1; j < t; j++)
  {
    if (2^j >= k)
    {
      rm = reduce(T^(2^j), G); M = coeffs(rm, T);
      for (i = 0; i < k; i++)
      {
        if (i + 1 <= nrows(M)) { vals[ix(nme + "r" + string(j) + "_" + string(i), nm)] = M[i + 1, 1]; }
        else { vals[ix(nme + "r" + string(j) + "_" + string(i), nm)] = 0; }
      }
    }
  }
  return(vals);
}
proc plantK(string nme, poly w, int t, list nm, ideal vals)
{
  poly v = w; int j;
  for (j = 1; j < t; j++) { v = v^2; vals[ix(nme + "u" + string(j), nm)] = v; }
  return(vals);
}
proc fmtpoly(poly f)
{
  string s = ""; int i; int ci; poly mo;
  if (f == 0) { return("0"); }
  for (i = 1; i <= size(f); i++)
  {
    ci = int(leadcoef(f[i])); if (ci < 0) { ci = ci + 786433; }
    mo = leadmonom(f[i]);
    if (i > 1) { s = s + "+"; }
    if (mo == 1) { s = s + string(ci); } else { s = s + string(ci) + "*" + string(mo); }
  }
  return(s);
}

// ---------------------------------------------------------------- S3E by elimination
ring RE = 786433, (u1, u2, u3, v1, v2, v3), dp;
poly ea = CA; poly ed = CD;
ideal IE = ea*u1^2 + v1^2 - 1 - ed*u1^2*v1^2,
           ea*u2^2 + v2^2 - 1 - ed*u2^2*v2^2,
           u3*(1 + ed*u1*u2*v1*v2) - (u1*v2 + u2*v1),
           v3*(1 - ed*u1*u2*v1*v2) - (v1*v2 - ea*u1*u2);
ideal EL = eliminate(IE, u1*u2*u3);
if (size(EL) != 1) { print(EL); die("elimination of u is not principal"); }
// the eliminant carries the spurious factor(s) of the denominator locus 1 -+ d u1 u2 v1 v2 = 0;
// keep the irreducible factor that has degree 2 in v3
list FE = factorize(EL[1]); int fe; poly S3el = 0;
for (fe = 1; fe <= size(FE[1]); fe++)
{
  print("  eliminant factor: " + string(FE[1][fe]) + " ^" + string(FE[2][fe]));
  if (deg(FE[1][fe], intvec(0,0,0,0,0,1)) == 2) { S3el = FE[1][fe]; }
}
if (S3el == 0) { die("no degree-2 factor in v3"); }
S3el = S3el / leadcoef(S3el);
poly S3cf = ed*v1^2*v2^2*v3^2 - ed*(v1^2*v2^2 + v1^2*v3^2 + v2^2*v3^2) + ea*(v1^2 + v2^2 + v3^2)
            - 2*(ea - ed)*v1*v2*v3 - ea;
poly S3n = S3cf / leadcoef(S3cf);
if (S3el != S3n) { print(S3el); die("S3E closed form mismatch"); }
print("S3E (elimination of u1,u2,u3) = closed form: " + string(S3cf));
poly SIv = ed*v1^2*v2^2*v3^2 - ed*(v1^2*v2^2 + v1^2*v3^2 + v2^2*v3^2) + ea*(v1^2 + v2^2 + v3^2) - ea
           - 2*(ea - ed)*(v1*v2*v3);
if (SIv != S3cf) { die("invariant form SI(v^2) - 2(a-d) v1 v2 v3 != S3E"); }
print("E1Q: S3E = SI(v1^2, v2^2, v3^2) - 2(a-d) v1 v2 v3 checked (SI = d ABC - d(AB+AC+BC) + a(A+B+C) - a)");
print("S3E degree in v1: " + string(deg(S3cf, intvec(0,0,0,1,0,0))) + ", total degree " + string(deg(S3cf)));
// symmetric cherry form S3Esym(s, q, X): reduce S3E(v1, v2, X) modulo s - v1 - v2, q - v1 v2
ring RS = 786433, (v1, v2, Sv, Sq, SX), (dp(2), dp(3));
poly ea = CA; poly ed = CD;
poly S3x = ed*v1^2*v2^2*SX^2 - ed*(v1^2*v2^2 + v1^2*SX^2 + v2^2*SX^2) + ea*(v1^2 + v2^2 + SX^2)
           - 2*(ea - ed)*v1*v2*SX - ea;
poly S3s = reduce(S3x, std(ideal(Sv - v1 - v2, Sq - v1*v2)));
if (deg(S3s, intvec(1,1,0,0,0)) > 0) { die("S3E not symmetric"); }
print("S3Esym(s,q,X) = " + string(S3s) + "   (total degree " + string(deg(S3s)) + ")");
string S3Sstr = string(S3s);

// ---------------------------------------------------------------- Edwards arithmetic
ring r = 786433, z, dp;
number a = CA; number d = CD;
proc oncurve(list Pp) { return(a*Pp[1]^2 + Pp[2]^2 - 1 - d*Pp[1]^2*Pp[2]^2 == 0); }
proc eadd(list Pp, list Qq)
{
  number t1 = d*Pp[1]*Qq[1]*Pp[2]*Qq[2];
  if (1 + t1 == 0 or 1 - t1 == 0) { die("addition law denominator vanished"); }
  return(list((Pp[1]*Qq[2] + Qq[1]*Pp[2]) / (1 + t1), (Pp[2]*Qq[2] - a*Pp[1]*Qq[1]) / (1 - t1)));
}
proc emul(bigint n, list Pp)
{
  list Rr = list(number(0), number(1)); list Bb = Pp;
  while (n > 0) { if (n mod 2 == 1) { Rr = eadd(Rr, Bb); } Bb = eadd(Bb, Bb); n = n div 2; }
  return(Rr);
}
proc isid(list Pp) { return(Pp[1] == 0 and Pp[2] == 1); }
proc issq(number c) { if (c == 0) { return(0); } return(c^393216 == 1); }
proc sqrtp(number c)
{
  list F = factorize(z^2 - c); int i; poly h;
  for (i = 1; i <= size(F[1]); i++) { h = F[1][i]; if (deg(h) == 1) { return(-number(jet(h, 0)) / leadcoef(h)); } }
  die("no square root");
}
proc nint(number n) { int v = int(n); if (v < 0) { v = v + 786433; } return(v); }
bigint ST = 3984216324;      // 0xED7A1104
proc lcg() { ST = (ST * bigint(1103515245) + bigint(12345)) mod bigint(2147483648); return(ST); }
proc rnd(int n) { bigint v = lcg(); bigint q = v div bigint(65536); return(int(q mod bigint(n))); }

// group order check: a point Q with 4Q != O and r*(4Q) = O gives r | #E, and 4r is the only
// multiple of r = 196873 in the Hasse interval, so #E = 4r
list Q0; number qv; number qu2; int jq;
for (jq = 2; jq < 50; jq++)
{
  qv = jq; qu2 = (1 - qv^2) / (a - d*qv^2);
  if (issq(qu2)) { Q0 = list(sqrtp(qu2), qv); if (!isid(emul(4, Q0))) { break; } }
}
if (!oncurve(Q0)) { die("Q0 not on curve"); }
list Q4 = emul(4, Q0);
if (isid(Q4) or !isid(emul(RPR, Q4))) { die("order check failed"); }
if (!isid(emul(ORD, Q0))) { die("#E*Q != O"); }
print("order check: Q0=(" + string(Q0[1]) + "," + string(Q0[2]) + "), 4Q0 != O, " + string(RPR)
      + "*(4Q0) = O, #E*Q0 = O  =>  #E = 4*" + string(RPR) + " = " + string(ORD));

// ---------------------------------------------------------------- base offset g
// usable exponent j: v = g*zeta^j with u^2 = (1-v^2)/(a-d v^2) a nonzero square; classes j mod 2^(t-1)
proc usable(number g, int t)
{
  int D = 2^t; number zt = number(5)^(786432 div D);   // 5 is a nonsquare: zt has order exactly D
  if (zt^(D div 2) != -1) { die("zeta order"); }
  list U; int j; number v;
  for (j = 0; j < D; j++) { v = g*zt^j; if (v != 1 and v != -1) { if (issq((1 - v^2)/(a - d*v^2))) { U[size(U) + 1] = j; } } }
  return(U);
}
int gi; number g; list U4;
for (gi = 2; gi < 200; gi++) { g = gi; U4 = usable(g, 4); if (size(U4) >= 10) { break; } }
print("g = " + string(g) + ": usable exponents at t=4: " + string(size(U4)) + " (of 16), at t=5: "
      + string(size(usable(g, 5))) + " (of 32)");
int GG = nint(g);

// ---------------------------------------------------------------- one system
proc writesys(list nm, list EQ, ideal vals, string OUT, string tag)
{
  int i; int n = size(nm);
  map ev = basering, vals; poly ei;
  for (i = 1; i <= size(EQ); i++)
  {
    if (EQ[i] == 0) { die("zero equation in " + OUT); }
    ei = EQ[i];
    if (ev(ei) != 0) { die("planted check failed " + tag + " eq=" + string(i)); }
  }
  string txt = "";
  for (i = 2; i <= n; i++) { if (i > 2) { txt = txt + ","; } txt = txt + nm[i]; }
  txt = txt + newline + string(786433) + newline;
  int maxd = 0;
  for (i = 1; i <= size(EQ); i++) { if (i > 1) { txt = txt + "," + newline; } txt = txt + fmtpoly(EQ[i]); if (deg(EQ[i]) > maxd) { maxd = deg(EQ[i]); } }
  write(":w " + OUT, txt);
  print(tag + ": N=" + string(n - 1) + " eqs=" + string(size(EQ)) + " maxdeg=" + string(maxd) + " plant ok -> " + OUT);
}

proc S3E(poly x1, poly x2, poly x3, poly pa, poly pd)
{
  return(pd*x1^2*x2^2*x3^2 - pd*(x1^2*x2^2 + x1^2*x3^2 + x2^2*x3^2) + pa*(x1^2 + x2^2 + x3^2)
         - 2*(pa - pd)*x1*x2*x3 - pa);
}
proc addeq(poly x1, poly y1, poly x2, poly y2, poly X, poly Y, poly pa, poly pd)
{
  return(list(X*(1 + pd*x1*x2*y1*y2) - (x1*y2 + x2*y1), Y*(1 - pd*x1*x2*y1*y2) - (y1*y2 - pa*x1*x2)));
}
// arm E1 / E1S. W: list of w_i (int reps); XS: planted separators (ints); vR int
proc armE1(string arm, int m, int t, list W, list XS, int vR, string S3Sstr, int GG)
{
  list nm = "T"; int c; int i;
  for (c = 0; c < m div 2; c++) { nm = nm + list("s" + string(c), "q" + string(c)) + mn("h" + string(c), 2, t); }
  if (m == 3) { nm = nm + list("w3") + kn("c2", t) + list("X1"); }
  if (m == 4) { nm = nm + list("X1", "X2"); }
  string vl = ""; for (i = 1; i <= size(nm); i++) { if (i > 1) { vl = vl + ","; } vl = vl + nm[i]; }
  execute("ring R1 = 786433,(" + vl + "),lp;");
  ring RB = 786433, (v1, v2, Sv, Sq, SX), (dp(2), dp(3));
  execute("poly sb = " + S3Sstr + ";");
  setring R1;
  poly pa = CA; poly pd = CD; poly pg = GG; list EQ; ideal es; ideal E; ideal vals; vals[size(nm)] = 0; ideal rt;
  map ph;
  for (c = 0; c < m div 2; c++)
  {
    es = var(ix("s" + string(c), nm)), var(ix("q" + string(c), nm));
    E = mchain("h" + string(c), es, 2, t, nm); for (i = 1; i <= size(E); i++) { EQ[size(EQ) + 1] = E[i]; }
    ph = RB, 0, 0, pg*var(ix("s" + string(c), nm)), pg^2*var(ix("q" + string(c), nm)), var(ix("X" + string(c + 1), nm));
    EQ[size(EQ) + 1] = ph(sb);
    vals[ix("s" + string(c), nm)] = poly(W[2*c + 1]) + poly(W[2*c + 2]);
    vals[ix("q" + string(c), nm)] = poly(W[2*c + 1]) * poly(W[2*c + 2]);
    rt = poly(W[2*c + 1]), poly(W[2*c + 2]);
    vals = plantM("h" + string(c), 2, t, rt, nm, vals);
    vals[ix("X" + string(c + 1), nm)] = XS[c + 1];
  }
  if (m == 3)
  {
    E = kchain("c2", var(ix("w3", nm)), t, nm); for (i = 1; i <= size(E); i++) { EQ[size(EQ) + 1] = E[i]; }
    EQ[size(EQ) + 1] = S3E(var(ix("X1", nm)), pg*var(ix("w3", nm)), vR, pa, pd);
    vals[ix("w3", nm)] = W[3]; vals = plantK("c2", W[3], t, nm, vals);
  }
  if (m == 4) { EQ[size(EQ) + 1] = S3E(var(ix("X1", nm)), var(ix("X2", nm)), vR, pa, pd); }
  if (arm == "E1S") { for (c = 1; c <= m div 2; c++) { EQ[size(EQ) + 1] = var(ix("X" + string(c), nm)) - XS[c]; } }
  writesys(nm, EQ, vals, OUTDIR + "/m" + string(m) + "_t" + string(t) + "_" + arm + ".ms",
           "m=" + string(m) + " t=" + string(t) + " " + arm);
}

// arm E1Q (quotient by the even-sign group). W: w_i; XS: planted separators; vR
// SI(A,B,C) = d ABC - d (AB + AC + BC) + a (A + B + C) - a ; S3E(v) = SI(v1^2,v2^2,v3^2) - 2(a-d) v1 v2 v3
proc armE1Q(int m, int t, list W, list XS, int vR, int GG)
{
  list nm = "T"; int c; int i;
  for (c = 0; c < m div 2; c++) { nm = nm + list("S" + string(c), "Q" + string(c)) + mn("g" + string(c), 2, t - 1); }
  if (m == 3) { nm = nm + list("W3") + kn("k2", t - 1) + list("Y1", "p1", "p2"); }
  if (m == 4) { nm = nm + list("Y1", "Y2", "p1", "p2", "pr"); }
  string vl = ""; for (i = 1; i <= size(nm); i++) { if (i > 1) { vl = vl + ","; } vl = vl + nm[i]; }
  execute("ring RQ = 786433,(" + vl + "),lp;");
  poly pa = CA; poly pd = CD; poly pg = GG; poly pvR = vR; list EQ; ideal es; ideal E; ideal vals; vals[size(nm)] = 0; ideal rt;
  poly Sc; poly Qc; poly Yc; poly Pc; poly g2 = pg^2; poly g4 = pg^4; poly VR = pvR^2;
  list Wp; for (i = 1; i <= m; i++) { Wp[i] = poly(W[i]); }
  list Xp; for (c = 1; c <= m div 2; c++) { Xp[c] = poly(XS[c]); }
  for (c = 0; c < m div 2; c++)
  {
    Sc = var(ix("S" + string(c), nm)); Qc = var(ix("Q" + string(c), nm));
    Yc = var(ix("Y" + string(c + 1), nm)); Pc = var(ix("p" + string(c + 1), nm));
    es = Sc, Qc;
    E = mchain("g" + string(c), es, 2, t - 1, nm); for (i = 1; i <= size(E); i++) { EQ[size(EQ) + 1] = E[i]; }
    // cherry node: V1 + V2 = g^2 S, V1 V2 = g^4 Q, VX = Y
    EQ[size(EQ) + 1] = pd*g4*Qc*Yc - pd*(g4*Qc + g2*Sc*Yc) + pa*(g2*Sc + Yc) - pa - 2*(pa - pd)*Pc;
    EQ[size(EQ) + 1] = Pc^2 - g4*Qc*Yc;
    vals[ix("S" + string(c), nm)] = Wp[2*c + 1]^2 + Wp[2*c + 2]^2;
    vals[ix("Q" + string(c), nm)] = Wp[2*c + 1]^2 * Wp[2*c + 2]^2;
    rt = Wp[2*c + 1]^2, Wp[2*c + 2]^2;
    vals = plantM("g" + string(c), 2, t - 1, rt, nm, vals);
    vals[ix("Y" + string(c + 1), nm)] = Xp[c + 1]^2;
    vals[ix("p" + string(c + 1), nm)] = pg*Wp[2*c + 1] * pg*Wp[2*c + 2] * Xp[c + 1];
  }
  poly A; poly B; poly Pr;
  if (m == 3)
  {
    E = kchain("k2", var(ix("W3", nm)), t - 1, nm); for (i = 1; i <= size(E); i++) { EQ[size(EQ) + 1] = E[i]; }
    A = var(ix("Y1", nm)); B = g2*var(ix("W3", nm)); Pr = var(ix("p2", nm));
    vals[ix("W3", nm)] = Wp[3]^2; vals = plantK("k2", Wp[3]^2, t - 1, nm, vals);
    vals[ix("p2", nm)] = Xp[1] * pg*Wp[3];
  }
  if (m == 4)
  {
    A = var(ix("Y1", nm)); B = var(ix("Y2", nm)); Pr = var(ix("pr", nm));
    vals[ix("pr", nm)] = Xp[1] * Xp[2];
  }
  // root node (v_R known): pi = v_R * Pr
  EQ[size(EQ) + 1] = pd*A*B*VR - pd*(A*B + A*VR + B*VR) + pa*(A + B + VR) - pa - 2*(pa - pd)*pvR*Pr;
  EQ[size(EQ) + 1] = Pr^2 - A*B;
  writesys(nm, EQ, vals, OUTDIR + "/m" + string(m) + "_t" + string(t) + "_E1Q.ms",
           "m=" + string(m) + " t=" + string(t) + " E1Q");
}

// round 7c: Dickson towers. Cherry: R_0 = T, R_j = R_(j-1)^2 - 2 mod Q (R_j = D_(2^j) of the roots),
// variables for R_1..R_(t-1), final R_(t-1)^2 - 4 = 0 mod Q (D_(2^t) = 2  <=>  z^(2^t) = 1)
proc dchain(string nme, ideal es, int t, list nm)
{
  poly T = var(1); poly Q = T^2 - es[1]*T + es[2]; ideal G = std(ideal(Q));
  poly R = T; poly Rn; poly Rsym; poly df; ideal E; matrix M; int j; int i; int ne = 0;
  for (j = 1; j <= t; j++)
  {
    Rn = reduce(R^2 - 2, G);
    if (j == t) { df = Rn - 2; }
    else
    {
      Rsym = var(ix(nme + "r" + string(j) + "_1", nm))*T + var(ix(nme + "r" + string(j) + "_0", nm));
      df = Rn - Rsym;
    }
    M = coeffs(df, T);
    for (i = nrows(M); i >= 1; i--) { if (M[i, 1] != 0) { ne++; E[ne] = M[i, 1]; } }
    R = Rsym;
  }
  return(E);
}
proc plantD(string nme, int t, ideal roots, list nm, ideal vals)
{
  poly T = var(1); ideal G = std(ideal((T - roots[1])*(T - roots[2]))); poly R = T; int j; matrix M; int i;
  for (j = 1; j < t; j++)
  {
    R = reduce(R^2 - 2, G); M = coeffs(R, T);
    for (i = 0; i < 2; i++)
    {
      if (i + 1 <= nrows(M)) { vals[ix(nme + "r" + string(j) + "_" + string(i), nm)] = M[i + 1, 1]; }
      else { vals[ix(nme + "r" + string(j) + "_" + string(i), nm)] = 0; }
    }
  }
  return(vals);
}
proc dkchain(string nme, poly w, int t, list nm)   // z_j = z_(j-1)^2 - 2, z_(t-1)^2 - 4 = 0
{
  ideal E; int j; int ne = 0; poly prev = w; poly u;
  for (j = 1; j < t; j++) { u = var(ix(nme + "u" + string(j), nm)); ne++; E[ne] = u - (prev^2 - 2); prev = u; }
  ne++; E[ne] = prev^2 - 4;
  return(E);
}
proc plantDK(string nme, poly w, int t, list nm, ideal vals)
{
  poly v = w; int j;
  for (j = 1; j < t; j++) { v = v^2 - 2; vals[ix(nme + "u" + string(j), nm)] = v; }
  return(vals);
}
// arm TW (x-only Montgomery, Kummer towers) or TQ (quotient xi, Dickson towers).
// LF: leaf coordinates (x_i or xi_i); XS: separators; RT: root coordinate
proc armM(string arm, int m, int t, list LF, list XS, int RT, string Sfull, string Ssym)
{
  list nm = "T"; int c; int i;
  for (c = 0; c < m div 2; c++) { nm = nm + list("s" + string(c), "q" + string(c)) + mn("h" + string(c), 2, t); }
  if (m == 3) { nm = nm + list("w3") + kn("c2", t) + list("X1"); }
  if (m == 4) { nm = nm + list("X1", "X2"); }
  string vl = ""; for (i = 1; i <= size(nm); i++) { if (i > 1) { vl = vl + ","; } vl = vl + nm[i]; }
  execute("ring RW = 786433,(" + vl + "),lp;");
  ring RBs = 786433, (x1, x2, Sv, Sq, SX), (dp(2), dp(3));
  execute("poly fsym = " + Ssym + ";");
  ring RBf = 786433, (x1, x2, x3), dp;
  execute("poly ffull = " + rename3(Sfull, "k1", "k2", "k3", "x1", "x2", "x3") + ";");
  setring RW;
  list EQ; ideal es; ideal E; ideal vals; vals[size(nm)] = 0; ideal rt; map ph; poly pRT = RT;
  list Lp; for (i = 1; i <= m; i++) { Lp[i] = poly(LF[i]); }
  for (c = 0; c < m div 2; c++)
  {
    es = var(ix("s" + string(c), nm)), var(ix("q" + string(c), nm));
    if (arm == "TW") { E = mchain("h" + string(c), es, 2, t, nm); } else { E = dchain("h" + string(c), es, t, nm); }
    for (i = 1; i <= size(E); i++) { EQ[size(EQ) + 1] = E[i]; }
    ph = RBs, 0, 0, var(ix("s" + string(c), nm)), var(ix("q" + string(c), nm)), var(ix("X" + string(c + 1), nm));
    EQ[size(EQ) + 1] = ph(fsym);
    vals[ix("s" + string(c), nm)] = Lp[2*c + 1] + Lp[2*c + 2];
    vals[ix("q" + string(c), nm)] = Lp[2*c + 1] * Lp[2*c + 2];
    rt = Lp[2*c + 1], Lp[2*c + 2];
    if (arm == "TW") { vals = plantM("h" + string(c), 2, t, rt, nm, vals); } else { vals = plantD("h" + string(c), t, rt, nm, vals); }
    vals[ix("X" + string(c + 1), nm)] = XS[c + 1];
  }
  if (m == 3)
  {
    if (arm == "TW") { E = kchain("c2", var(ix("w3", nm)), t, nm); } else { E = dkchain("c2", var(ix("w3", nm)), t, nm); }
    for (i = 1; i <= size(E); i++) { EQ[size(EQ) + 1] = E[i]; }
    ph = RBf, var(ix("X1", nm)), var(ix("w3", nm)), pRT;
    EQ[size(EQ) + 1] = ph(ffull);
    vals[ix("w3", nm)] = Lp[3];
    if (arm == "TW") { vals = plantK("c2", Lp[3], t, nm, vals); } else { vals = plantDK("c2", Lp[3], t, nm, vals); }
  }
  if (m == 4) { ph = RBf, var(ix("X1", nm)), var(ix("X2", nm)), pRT; EQ[size(EQ) + 1] = ph(ffull); }
  writesys(nm, EQ, vals, OUTDIR + "/m" + string(m) + "_t" + string(t) + TAG + "_" + arm + ".ms",
           "m=" + string(m) + " t=" + string(t) + " " + arm);
}

// arm E2. UL: leaf u_i; W: leaf w_i; NU, NV: planted internal nodes; uR, vR
proc armE2(int m, int t, list UL, list W, list NU, list NV, int uR, int vR, int GG)
{
  list nm = "T"; int i; int c;
  for (i = 1; i <= m; i++) { nm = nm + list("u" + string(i), "w" + string(i)) + kn("c" + string(i - 1), t); }
  for (c = 1; c <= m div 2; c++) { nm = nm + list("U" + string(c), "V" + string(c)); }
  string vl = ""; for (i = 1; i <= size(nm); i++) { if (i > 1) { vl = vl + ","; } vl = vl + nm[i]; }
  execute("ring R2 = 786433,(" + vl + "),lp;");
  poly pa = CA; poly pd = CD; poly pg = GG; list EQ; ideal E; ideal vals; vals[size(nm)] = 0;
  poly uu; poly vv;
  for (i = 1; i <= m; i++)
  {
    uu = var(ix("u" + string(i), nm)); vv = pg*var(ix("w" + string(i), nm));
    EQ[size(EQ) + 1] = pa*uu^2 + vv^2 - 1 - pd*uu^2*vv^2;
    E = kchain("c" + string(i - 1), var(ix("w" + string(i), nm)), t, nm); for (c = 1; c <= size(E); c++) { EQ[size(EQ) + 1] = E[c]; }
    vals[ix("u" + string(i), nm)] = UL[i]; vals[ix("w" + string(i), nm)] = W[i];
    vals = plantK("c" + string(i - 1), W[i], t, nm, vals);
  }
  list L2; poly Uc; poly Vc;
  for (c = 1; c <= m div 2; c++)
  {
    Uc = var(ix("U" + string(c), nm)); Vc = var(ix("V" + string(c), nm));
    L2 = addeq(var(ix("u" + string(2*c - 1), nm)), pg*var(ix("w" + string(2*c - 1), nm)),
               var(ix("u" + string(2*c), nm)), pg*var(ix("w" + string(2*c), nm)), Uc, Vc, pa, pd);
    EQ = EQ + L2;
    vals[ix("U" + string(c), nm)] = NU[c]; vals[ix("V" + string(c), nm)] = NV[c];
  }
  if (m == 3) { L2 = addeq(var(ix("U1", nm)), var(ix("V1", nm)), var(ix("u3", nm)), pg*var(ix("w3", nm)), uR, vR, pa, pd); }
  if (m == 4) { L2 = addeq(var(ix("U1", nm)), var(ix("V1", nm)), var(ix("U2", nm)), var(ix("V2", nm)), uR, vR, pa, pd); }
  EQ = EQ + L2;
  writesys(nm, EQ, vals, OUTDIR + "/m" + string(m) + "_t" + string(t) + "_E2.ms",
           "m=" + string(m) + " t=" + string(t) + " E2");
}

// ---------------------------------------------------------------- instances and systems
intvec CV = 0; list CTOK; string tk = ""; int ii; string chh;
for (ii = 1; ii <= size(CELLSTR); ii++)
{
  chh = CELLSTR[ii, 1];
  if (chh == " ") { if (tk != "") { CTOK[size(CTOK) + 1] = tk; tk = ""; } } else { tk = tk + chh; }
}
if (tk != "") { CTOK[size(CTOK) + 1] = tk; }
string INST = "# round-7 planted instances (gen7.sing, LCG seed 0xED7A1104): a=1 d=11 g=" + string(GG) + newline
  + "# m t vR uR | w_i (v_i = g*w_i) | u_i | separators v(P_(2c-1)+P_(2c)) | node u's" + newline;
list UM; list XM; list XSM; list LW; list LQ; list SW; list SQ2; number xRM;
number nmA = MA; number nmB = MB;
string rec; int m; int t; int D; number zt; list U; list JS; int j; int ok; int tries; int i; int c;
list PTS; list W; list UL; list XS; list NU; list NV; list Rp; list Pc; intvec used; number v; number u;
for (ii = 1; ii + 1 <= size(CTOK); ii = ii + 2)
{
  execute("m = " + CTOK[ii] + "; t = " + CTOK[ii + 1] + ";");
  D = 2^t; zt = number(5)^(786432 div D); U = usable(g, t);
  ok = 0;
  for (tries = 1; tries <= 500 and ok == 0; tries++)
  {
    JS = list(); kill used; intvec used; used[D div 2] = 0;
    while (size(JS) < m)
    {
      j = U[rnd(size(U)) + 1];
      if (used[(j mod (D div 2)) + 1] == 0) { used[(j mod (D div 2)) + 1] = 1; JS[size(JS) + 1] = j; }
    }
    PTS = list(); W = list(); UL = list();
    for (i = 1; i <= m; i++)
    {
      v = g*zt^JS[i]; u = sqrtp((1 - v^2)/(a - d*v^2)); if (rnd(2) == 1) { u = -u; }
      PTS[i] = list(u, v); if (!oncurve(PTS[i])) { die("leaf off curve"); }
      W[i] = nint(zt^JS[i]); UL[i] = nint(u);
    }
    ok = 1; XS = list(); NU = list(); NV = list();
    for (c = 1; c <= m div 2; c++)
    {
      Pc = eadd(PTS[2*c - 1], PTS[2*c]);
      if (Pc[1] == 0 or Pc[2] == 0) { ok = 0; }
      XS[c] = nint(Pc[2]); NU[c] = nint(Pc[1]); NV[c] = nint(Pc[2]);
    }
    if (m == 3) { Rp = eadd(eadd(PTS[1], PTS[2]), PTS[3]); }
    if (m == 4) { Rp = eadd(eadd(PTS[1], PTS[2]), eadd(PTS[3], PTS[4])); }
    if (Rp[1] == 0 or Rp[2] == 0) { ok = 0; }
  }
  if (ok == 0) { die("no plant"); }
  rec = string(m) + " " + string(t) + " " + string(nint(Rp[2])) + " " + string(nint(Rp[1])) + " |";
  for (i = 1; i <= m; i++) { rec = rec + " " + string(W[i]); } rec = rec + " |";
  for (i = 1; i <= m; i++) { rec = rec + " " + string(UL[i]); } rec = rec + " |";
  for (c = 1; c <= m div 2; c++) { rec = rec + " " + string(XS[c]); } rec = rec + " |";
  for (c = 1; c <= m div 2; c++) { rec = rec + " " + string(NU[c]); }
  INST = INST + rec + newline;
  print("instance m=" + string(m) + " t=" + string(t) + " tries=" + string(tries - 1) + ": " + rec);
  if (find(ARMS, " E1 ")) { armE1("E1", m, t, W, XS, nint(Rp[2]), S3Sstr, GG); }
  if (find(ARMS, " E1S ")) { armE1("E1S", m, t, W, XS, nint(Rp[2]), S3Sstr, GG); }
  if (find(ARMS, " E2 ")) { armE2(m, t, UL, W, NU, NV, nint(Rp[1]), nint(Rp[2]), GG); }
  if (find(ARMS, " E1Q ")) { armE1Q(m, t, W, XS, nint(Rp[2]), GG); }
  setring r;
  if (find(ARMS, " TW ") or find(ARMS, " TQ "))
  {
    // Montgomery instance on the same group: x in mu_(2^t), classes {x, 1/x}, own LCG stream
    UM = list();
    for (j = 0; j < D; j++)
    {
      v = zt^j;
      if (v != 1 and v != -1) { if (issq((v^3 + nmA*v^2 + v)/nmB)) { UM[size(UM) + 1] = j; } }
    }
    ok = 0;
    for (tries = 1; tries <= 500 and ok == 0; tries++)
    {
      JS = list(); kill used; intvec used; used[D] = 0;
      while (size(JS) < m)
      {
        j = UM[rndM(size(UM)) + 1];
        if (used[j + 1] == 0 and used[((D - j) mod D) + 1] == 0) { used[j + 1] = 1; JS[size(JS) + 1] = j; }
      }
      PTS = list(); XM = list();
      for (i = 1; i <= m; i++)
      {
        v = zt^JS[i]; u = sqrtp((v^3 + nmA*v^2 + v)/nmB); if (rndM(2) == 1) { u = -u; }
        if (nmB*u^2 != v^3 + nmA*v^2 + v) { die("Montgomery leaf off curve"); }
        PTS[i] = list(v/u, (v - 1)/(v + 1)); if (!oncurve(PTS[i])) { die("birational image off the Edwards curve"); }
        XM[i] = v;
      }
      ok = 1; XSM = list();
      for (c = 1; c <= m div 2; c++)
      {
        Pc = eadd(PTS[2*c - 1], PTS[2*c]);
        if (Pc[2] == 1 or Pc[2] == -1) { ok = 0; } else { XSM[c] = (1 + Pc[2])/(1 - Pc[2]); }
      }
      if (m == 3) { Rp = eadd(eadd(PTS[1], PTS[2]), PTS[3]); }
      if (m == 4) { Rp = eadd(eadd(PTS[1], PTS[2]), eadd(PTS[3], PTS[4])); }
      if (Rp[2] == 1 or Rp[2] == -1) { ok = 0; }
    }
    if (ok == 0) { die("no Montgomery plant"); }
    xRM = (1 + Rp[2])/(1 - Rp[2]);
    LW = list(); LQ = list(); SW = list(); SQ2 = list();
    for (i = 1; i <= m; i++) { LW[i] = nint(XM[i]); LQ[i] = nint(XM[i] + 1/XM[i]); }
    for (c = 1; c <= m div 2; c++) { SW[c] = nint(XSM[c]); SQ2[c] = nint(XSM[c] + 1/XSM[c]); }
    rec = "M " + string(m) + " " + string(t) + " xR=" + string(nint(xRM)) + " | x_i:";
    for (i = 1; i <= m; i++) { rec = rec + " " + string(LW[i]); } rec = rec + " | sep x:";
    for (c = 1; c <= m div 2; c++) { rec = rec + " " + string(SW[c]); }
    INST = INST + rec + newline;
    print("Montgomery instance tries=" + string(tries - 1) + ": " + rec);
    if (find(ARMS, " TW ")) { armM("TW", m, t, LW, SW, nint(xRM), S3Mstr, S3Msym); }
    if (find(ARMS, " TQ ")) { armM("TQ", m, t, LQ, SQ2, nint(xRM + 1/xRM), S3Qstr, S3Qsym); }
  }
  setring r;
}
write(":w " + OUTDIR + "/instances7" + TAG + ".txt", INST[1, size(INST) - 1]);
quit;
