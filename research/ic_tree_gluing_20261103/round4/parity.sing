// parity.sing -- swap-adapted (Z/2-graded) form of the m = 4 tree system T (round 4, item 4).
//
// The m = 4 tree is invariant under swp, the exchange of its two cherries:
//   s0<->s1, q0<->q1, h0r*<->h1r*, X1<->X2   (the root S3(X1,X2,xR) is symmetric).
// Over F_p (p odd) the ideal I is generated by {f + swp f, f - swp f}, and in the
// coordinates a_v = v0 + v1, b_v = v0 - v1 every generator is even or odd in the
// b-variables. A Macaulay matrix of such generators splits into even and odd blocks
// (Faugere-Svartz); msolve does not exploit this, so this run is a control on the
// coordinate change itself. It also counts the even/odd monomial split in degree <= D.
//
// Usage: PIN=<T system .ms> POUT=<adapted .ms> Singular -q parity.sing
string INF = system("getenv", "PIN"); string OUTF = system("getenv", "POUT");
if (INF == "" or OUTF == "") { ERROR("set PIN and POUT"); }
short = 0;
string TX = read(INF);
// split into lines
list LN; string cur = ""; string ch; int i; int j;
for (i = 1; i <= size(TX); i++)
{
  ch = TX[i, 1];
  if (ch == newline) { LN[size(LN) + 1] = cur; cur = ""; } else { cur = cur + ch; }
}
if (cur != "") { LN[size(LN) + 1] = cur; }
string VL = LN[1];
// polynomials: lines 3.., each ends with "," except the last
list PS; string pl;
for (i = 3; i <= size(LN); i++)
{
  pl = LN[i];
  if (size(pl) == 0) { i++; continue; }
  if (pl[size(pl), 1] == ",") { pl = pl[1, size(pl) - 1]; }
  PS[size(PS) + 1] = pl;
}
// variable names
list VN; cur = "";
for (i = 1; i <= size(VL); i++)
{
  ch = VL[i, 1];
  if (ch == ",") { VN[size(VN) + 1] = cur; cur = ""; } else { cur = cur + ch; }
}
VN[size(VN) + 1] = cur;
int n = size(VN);
execute("ring R = 786433,(" + VL + "),dp;");
ideal I; for (i = 1; i <= size(PS); i++) { execute("I[" + string(i) + "] = " + PS[i] + ";"); }

// partner of each variable under swp
proc partner(string v)
{
  if (v == "X1") { return("X2"); } if (v == "X2") { return("X1"); }
  if (v[1, 1] == "s" or v[1, 1] == "q") { if (v[2, 1] == "0") { return(v[1, 1] + "1"); } if (v[2, 1] == "1") { return(v[1, 1] + "0"); } }
  if (size(v) >= 2) { if (v[1, 2] == "h0") { return("h1" + v[3, size(v) - 2]); } if (v[1, 2] == "h1") { return("h0" + v[3, size(v) - 2]); } }
  return(v);
}
ideal swpimg; int k;
for (i = 1; i <= n; i++)
{
  for (k = 1; k <= n; k++) { if (VN[k] == partner(VN[i])) { swpimg[i] = var(k); } }
}
map swp = R, swpimg;
// check swp(I) = I (both directions), via reduction modulo a GB would be costly; check
// generator-wise that each swp(f) equals some generator (true for this construction).
int found; int bad = 0; poly fi; poly ti;
for (i = 1; i <= size(I); i++)
{
  found = 0;
  fi = I[i]; ti = swp(fi);
  for (k = 1; k <= size(I); k++) { if (ti == I[k]) { found = 1; } }
  if (found == 0) { bad++; }
}
if (bad > 0) { ERROR(string(bad) + " generators have no swp-image among the generators"); }

// new coordinates: for each swp-pair (v0, v1) with v0 < v1 in VN order: a = v0 + v1, b = v0 - v1;
// fixed variables keep their name.
list NV; ideal sub; string nv; int p;
for (i = 1; i <= n; i++)
{
  p = 0; for (k = 1; k <= n; k++) { if (VN[k] == partner(VN[i])) { p = k; } }
  if (p == i) { NV[size(NV) + 1] = VN[i]; }
  if (p > i) { NV[size(NV) + 1] = "A_" + VN[i]; NV[size(NV) + 1] = "B_" + VN[i]; }
}
string NL = ""; for (i = 1; i <= size(NV); i++) { if (i > 1) { NL = NL + ","; } NL = NL + NV[i]; }
execute("ring Q = 786433,(" + NL + "),dp;");
// substitution v0 = (A + B)/2, v1 = (A - B)/2
ideal img;
for (i = 1; i <= n; i++)
{
  p = 0; for (k = 1; k <= n; k++) { if (VN[k] == partner(VN[i])) { p = k; } }
  if (p == i) { execute("img[" + string(i) + "] = " + VN[i] + ";"); }
  if (p > i) { execute("img[" + string(i) + "] = (A_" + VN[i] + " + B_" + VN[i] + ")/2;"); }
  if (p < i) { execute("img[" + string(i) + "] = (A_" + VN[p] + " - B_" + VN[p] + ")/2;"); }
}
map phi = R, img;
setring R;
ideal J; int nj = 0; list seen; poly fp; poly fm;
for (i = 1; i <= size(I); i++)
{
  fi = I[i]; ti = swp(fi); fp = fi + ti; fm = fi - ti;
  if (fp != 0) { nj++; J[nj] = fp; }
  if (fm != 0) { nj++; J[nj] = fm; }
}
setring Q;
ideal JQ = phi(J);
JQ = simplify(JQ, 2 + 4 + 8);   // drop zeros, duplicates, scalar multiples
// parity check: B-degree of every term has the same parity within each generator
intvec bw; for (i = 1; i <= nvars(Q); i++) { if (NV[i][1, 2] == "B_") { bw[i] = 1; } else { bw[i] = 0; } }
int odd; int ev; int mixed = 0; poly g; int nodd = 0; int nev = 0;
for (i = 1; i <= size(JQ); i++)
{
  g = JQ[i]; odd = 0; ev = 0;
  while (g != 0) { if (deg(lead(g), bw) mod 2 == 1) { odd = 1; } else { ev = 1; } g = g - lead(g); }
  if (odd and ev) { mixed++; } if (odd and !ev) { nodd++; } if (ev and !odd) { nev++; }
}
print("generators: " + string(size(JQ)) + "  even: " + string(nev) + "  odd: " + string(nodd) + "  mixed: " + string(mixed));
if (mixed > 0) { ERROR("some generators are not parity-homogeneous"); }
// write msolve input
string txt = NL + newline + "786433" + newline; string fs;
for (i = 1; i <= size(JQ); i++)
{
  fs = string(JQ[i]);
  if (i > 1) { txt = txt + "," + newline; }
  txt = txt + fs;
}
write(":w " + OUTF, txt);
// even/odd monomial counts of degree <= D in nB B-variables and nA other variables
int nB = 0; for (i = 1; i <= nvars(Q); i++) { nB = nB + bw[i]; }
print("variables: " + string(nvars(Q)) + "  B (odd) variables: " + string(nB));
quit;
