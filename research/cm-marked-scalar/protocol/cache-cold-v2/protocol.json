  "question": "Does the fixed deterministic prefix-reusing mu action reduce complete cold per-point time against every reproduced matched regular reference on all five curves?",
  "claims": [
    {
      "id": "C-point",
      "class": "exact_computation",
      "text": "Cached prefixes and full cold function preserve the original marked mu point output.",
      "decided_by": []
    },
    {
      "id": "C-primary",
      "class": "comparative",
      "text": "The deterministic candidate is faster end-to-end beyond the paired A/A envelope on every held-out point, reported per curve.",
      "decided_by": [
        "C-primary"
      ],
      "if_supported": "Finite-panel full cold result for the stated deterministic method and backend.",
      "if_not_supported": "Retain ties/losses and all costs; installed-plan or arithmetic-only results do not replace the primary claim."
    }
  ],
