.arms[0].instrument as $old |
.protocol_id="CM-BLOCK-PLAN-CENSUS-V1" | .version=1 | .created="2026-11-09" |
.question="Can block-aware offset/window selection lower the original-mu full group schedule below matched block-binary and the frozen optimized direct/binary references on P-192 primary and all five curves?" |
.claims=[{id:"C-fixed",class:"exact_computation",text:"Every selected block/single schedule preserves original mu; all rows and minima independently replay.",decided_by:[]},{id:"C-cost",class:"comparative",text:"Per curve the relation block minimum has strictly fewer primary D+A calls than matched block-binary and prior optimized direct/binary references.",decided_by:["C-count"],if_supported:"Finite source-specific group-count result; all tuning/planning/normalization runtime costs remain separate.",if_not_supported:"Retain every tie/loss and all five curves; do not infer an e2e claim."}] |
.arms=(["single","binary","relation","prior_direct","prior_binary"]|map(. as $id|{id:$id,role:(if $id=="relation" then "candidate" elif $id=="single" then "baseline" else "reference" end),description:(if ($id|startswith("prior_")) then "Frozen residual-v1/plans.json donor counts, no donor census repeated; original scalar and complete optimized direct/binary schedule." else "Paired retained-bank single-column/block schedules, all declared radices/offsets/windows; complete prefix/table and main group calls." end),instrument:(if ($id|startswith("prior_")) then $old else ($old|.commit=$commit|.binary_sha256=$binary|.build=[["make","-B","-j1","-C","research/cm-marked-scalar","block-tune-binary","block-tune-replay-binary"]]|.flags.claim="Exact event census; no clock") end)})) |
.controls.aa.not_applicable_reason="Exact complete deterministic integer census; no clocks or stochastic noise floor." |
.controls.positive.not_applicable_reason="Before freeze,630 paired boundary parameter cases must match actual block/single point operations and counters; standalone GMP small cases compare suffix DP to exhaustive enumeration." |
.controls.negative.not_applicable_reason="Independent replay must reject changed counters, missing/duplicate rows and wrong design; selected point/count checks must preserve original mu." |
.variable_ledger.independent=[{name:"method",levels:["block relation","block binary","same-bank single column","prior optimized direct/binary"]}] |
.variable_ledger.factors=[{name:"curve and scalar",treatment:"fixed",value:["P-192","P-224","P-256","P-384","P-521"],how:"Same original mu, curve and signed relation certificates; no target substitution."},{name:"radix/offset/window",treatment:"crossed",value:"ell and binary1,2,4,8,16,32; all offsets-64..64; widths2..7",how:"27090 complete rows. Both schedules share the same bank setup."},{name:"internal planner",treatment:"fixed",value:"span16, unweighted D+A,N,D,steps",how:"Existing frozen block_core.hpp. Sensitivity weights select among emitted programs, not globally weight-optimal chains."},{name:"reference",treatment:"fixed",value:"residual-v1/plans.json",how:"Existing independently replayed translation/window/radix optimized reference counts; no donor rerun."},{name:"resources",treatment:"fixed",value:"120seconds/2GiB/one process/thread per invocation",how:"One scan, zero unchanged retries; no clock or cloud job."}] |
.variable_ledger.comparisons=[{id:"C-count",arms:["relation","binary","prior_direct","prior_binary"],differs_in:["method"],design:"absolute"}] |
.randomization.instance_sampling.rule="Five curves x7radices x129offsets x6widths =27090 rows; one exact finite census." |
.metrics.primary=[{id:"D_plus_A",name:"Full group-call count",unit:"group API calls",kind:"counted",definition:"Prefix/table construction plus selected block program or original single-column schedule; minimum over the frozen finite parameter domain.",source:"scan.csv; GMP replay reconstructs every row",aggregation:"min",resolution:"exact deterministic integer",uncertainty:"none_exact"}] |
.metrics.secondary=[{id:"vectors",name:"Group and planner event vectors",unit:"events",kind:"counted",definition:"D,A,N,logicalT,physical bank,normalized entries,planner offers and steps; no CPU/allocator/field pricing inferred.",source:"scan.csv",aggregation:"per_row",resolution:"exact native events",uncertainty:"none_exact"}] |
.execution.placement={threads:1,memory_limit_kib:2097152,max_cloud_cost_usd:0,offset_min:-64,offset_max:64,widths:[2,3,4,5,6,7],weights:[1,2,3,4],binary_radices:[1,2,4,8,16,32],rows:27090,input_files:$inputs,source_files:$sources,replay_binary_sha256:$replay,scan_invocations:1} |
.sample_size.instances=5 | .sample_size.replicates=1 | .sample_size.warmups=0 |
.sample_size.power.note="Exact complete finite census;20curve/weight plan records,80minimum sets; no population or statistical-power claim." |
.sample_size.preflight_runtime.measured_on="No timing pilot; one scientific scan, all native invocations bounded120seconds/2GiB, zero unchanged retries." |
.stopping_rules=[{rule:"Stop after exactly27090rows or retain the first timeout/failure, zero unchanged retries.",kind:"fixed_n",preregistered:true},{rule:"Any point/counter/source/hash/design/completeness failure invalidates and is retained.",kind:"invalidation",preregistered:true}] |
.decision_rule.text="Per curve at weight1 require relation-block minimum D+A below matched block-binary and both prior direct/binary minima. Preserve ties/losses and vectors. Weights2..4 sensitivities over this emitted unweighted-planner program family only." |
.decision_rule.comparison_ids=["C-count"] |
.decision_rule.statistic="Exact minimum by score,N,D,A,T,radix,abs(offset),offset,width" |
.analysis_plan.script={path:"research/cm-marked-scalar/block_tune_replay.cpp",sha256:$source} |
.analysis_plan.inputs=["scan.csv","producer receipt","eight frozen inputs","independent suffix-DP/GMP replay","400selected point/count checks"] |
.analysis_plan.outputs=["all27090row replay","80minimum sets","20curve/weight records","per-curve full vector comparison","inspected report and export"] |
.analysis_plan.frozen_before_data=true |
.amendments=[] |
.inadmissible=["Changing original mu or subgroup","Omitting prefix/table/remainder work","Treating event counts as CPU time","Hiding offline tuning/first-use plan cost","Optimizing only the candidate","Changing domain after data","Repeating the V3 timing attempt","Claiming expanded global quotient polynomials"] |
.freeze={status:"draft",protocol_sha256:null,commit:$commit,frozen_at:null,filed_before_affected_data:false}
