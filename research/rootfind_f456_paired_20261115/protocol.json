  "question": "On eight fresh public Koblitz E0 n13 targets, is complete cold rootfind-negfold m3 bitop/v1 cost below matrix F4, matrix F5, inherited F4 and F6-IC using the identical standard-subspace base?",
  "claims": [
    {
      "id": "C1",
      "text": "All reported complete runs return a scalar that verifies against their public target.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C2",
      "text": "Rootfind-negfold m3 uses fewer complete cold bitop/v1 units than each F4, F5 and F6-IC arm on all eight fixed K13 targets.",
      "class": "comparative",
      "decided_by": [
        "C-matrix-f4",
        "C-matrix-f5",
        "C-inherited-f4",
        "C-f6"
      ]
    },
    {
      "id": "C3",
      "text": "Rootfind-negfold m2 is a separate whole-algorithm alternative and its complete bitop/v1 cost is reported on the same targets.",
      "class": "comparative",
      "decided_by": [
        "C-m2"
      ]
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "statement": "A negation-folded pair table makes relation decomposition cheap enough to offset its cold setup on this small Koblitz curve.",
      "mechanism": "A precomputed pair sum replaces repeated Boolean polynomial elimination; the table and all later phases are paid by each one-target solve.",
      "predictions": [
        {
          "id": "P1",
          "metric": "bitop_total",
          "direction": "lower",
          "minimum_effect": "rootfind-m3 < each of four Groebner arms on every target and measured repeat",
