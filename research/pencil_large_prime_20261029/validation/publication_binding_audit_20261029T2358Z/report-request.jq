def observation($id;$scope;$path;$sha;$fields):{id:$id,scope:$scope,source:{path:$path,sha256:$sha},fields:$fields};
{schema:"pencil-native-review-report-request/v1",title:"Mathematical experiment preparation: gate software and published runtime",snapshot:$snapshot,plan_summary:{path:$plan,sha256:$plan_sha},observations:[
observation("gate-software";"Software validation only. The full 1260 design remains intact; the exact p739 gate has 60 planned targets. Counts refer to software tests, not empirical targets.";$gate;$gate_sha;{"native_unit_tests":"/price_tests/unit","native_cli_tests":"/price_tests/cli","export_private_units":"/export_tests/private_units","export_production_scope_tests":"/export_tests/production_scope_tests","planned_gate_targets":"/gate/workloads","planned_gate_pairs":"/gate/measured_pairs","planned_gate_slots":"/gate/execution_slots","solver_executions":"/solver_executions","qualified_ratios":"/qualified_ratios"}),
observation("gate-review";"Independent read-only software scope review. No mathematical workload, timing observation or cost ratio was replayed; source-commit binding is a separate record.";$review;$review_sha;{"review_result":"/verdict","source_commit":"/source_commit","findings":"/findings","solver_executions":"/solver_executions"}),
observation("controller-publication";"Retained CodeBuild source-update receipt. The CloudFormation change set was not executed. Its source parameters remain old, so later stack changes require reconciliation.";$controller;$controller_sha;{"source_update_completed":"/controller_update_completed","other_project_properties_unchanged":"/all_other_project_properties_unchanged","inline_policy_unchanged":"/inline_iam_policy_unchanged","change_set_executed":"/change_set_executed","experiment_launched_at_receipt":"/experiment_launched"}),
observation("image-publication";"Approved FROM/COPY image publication and stopped-container extraction. Elapsed time is infrastructure publication/verification, not mathematical performance. No workload was started.";$image;$image_sha;{"publication_seconds":"/elapsed_wall_seconds","image_digest_pull_verified":"/digest_pull_verified","stopped_extraction_verified":"/stopped_container_extraction_verified","runtime_bytes_equal":"/all_runtime_archive_bytes_equal","solver_executions":"/solver_executions","historical_qualification_transferred":"/historical_runtime_qualification_transferred"}),
observation("bytebinding-audit";"Separate check of retained archive and image bytes plus API receipts. This auditor also published the image; it is not an independent-personnel audit or live cluster check.";$audit;$audit_sha;{"archive_readback_matches":"/archive_readback_checks_passed","image_runtime_bytes_equal":"/runtime_archive_all_image_bytes_equal","source_only_project_match":"/source_only_project_match","inline_policy_bytes_equal":"/inline_policy_bytes_equal","cloud_mutations_in_audit":"/cloud_mutations","empirical_ratios":"/empirical_ratios"})]}
