def obs($id;$scope;$path;$sha;$fields): {id:$id,scope:$scope,source:{path:$path,sha256:$sha},fields:$fields};
{schema:"pencil-native-review-report-request/v1",title:"First-gate infrastructure failure and executable-mode correction",snapshot:$snapshot,plan_summary:{path:$plan,sha256:$plan_sha},observations:[
obs("first-attempt";"Actual first gate terminated before payload spawn. This is an infrastructure failure; no mathematical target was executed and no cost ratio was measured.";$failure;$failure_sha;{"run":"/failed_run/run_name","phase":"/failed_run/terminal_phase","error":"/failed_run/error","payload_pid":"/failed_run/payload_pid","checkpoint_generations":"/failed_run/checkpoint_generations","targets_executed":"/scientific_execution/targets_executed","mathematical_results":"/scientific_execution/mathematical_results"}),
obs("mode-correction";"A new immutable image changes only the progress executable permission. File bytes and other modes are unchanged. Offline usage checks do not invoke a workload.";$correction;$correction_sha;{"changed_path":"/changed_path","old_mode":"/old_mode","new_mode":"/new_mode","other_modes_equal":"/all_other_runtime_modes_owners_types_equal","file_bytes_equal":"/all_runtime_file_bytes_equal","before_uid1000_exit":"/offline_before/exit_code","after_uid1000_exit":"/offline_after/exit_code","after_result":"/offline_after/result","solver_executions":"/solver_executions"}),
obs("independent-mode-review";"Independent receipt, recipe, inventory, image-readback and no-payload usage review. This verifies the identified permission correction, not a future controller run or mathematical result.";$review;$review_sha;{"review_result":"/verdict","registry_digest_active":"/checks/registry_readback_digest_active","instrument_bytes_equal":"/checks/instrument_bytes_identical","stopped_container_never_started":"/checks/stopped_container_never_started","recovery_verified":"/boundaries/controller_end_to_end_recovery_verified","scientific_qualification":"/boundaries/scientific_qualification"}),
obs("retry-boundary";"Retry execution and its outcome are handled separately. This report preserves the failed attempt and records no empirical ratio from a later attempt.";$scope;$scope_sha;{"retry_outcome":"/retry_outcome","new_empirical_ratio":"/new_empirical_ratio","new_solver_observations":"/new_solver_observations","report_launched_retries":"/cloud_retries_launched_by_report"})]}
