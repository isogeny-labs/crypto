+#[test]
+fn review_reproducer_protocol_warmups_can_be_omitted_without_finding() {
+    let mut f = Fixture::new();
+    f.rows.retain(|r| r["warmup"] == false);
+    let mut plan = load(&f.path("plan.json")).unwrap();
+    plan["executions"]
+        .as_array_mut()
+        .unwrap()
+        .retain(|e| e["warmup"] == false);
+    f.write("plan.json", &plan);
+    let mut receipt = load(&f.path("receipt.json")).unwrap();
+    receipt["files"]["plan.json"] = json!(digest(&f.path("plan.json")).unwrap());
+    f.write("receipt.json", &receipt);
+    f.refresh();
+    f.edit("native.json", "native_analysis", |n| {
+        n["expected_executions"] = json!(15);
+        n["observed_executions"] = json!(15);
+        n["missing_executions"] = json!([]);
+    });
+    let (e, findings) = f.run().unwrap();
+    assert!(findings.is_empty(), "{findings:?}");
+    assert_eq!(e["runs"].as_array().unwrap().len(), 15);
+    assert!(e["runs"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .all(|r| r["warmup"] == false));
+}
