+#[test]
+fn review_reproducer_missing_planted_check_is_marked_verified() {
+    let mut f = Fixture::new();
+    f.rows[0]["outcome"]
+        .as_object_mut()
+        .unwrap()
+        .remove("matches_planted");
+    f.refresh();
+    let (e, findings) = f.run().unwrap();
+    assert!(findings.is_empty());
