+#[test]
+fn review_reproducer_backend_record_can_be_rewritten_without_finding() {
+    let f = Fixture::new();
+    let (mut e, findings) = f.run().unwrap();
+    assert!(findings.is_empty());
+    e["backend_record"]["qualified"] = json!(true);
+    e["backend_record"]["expected_execution_slots"] = json!(0);
+    e["backend_record"]["missing_slots"] = json!([{"fabricated": true}]);
+    e["backend_record"]["diagnostics"] = json!([]);
+    e["backend_record"]["native_analysis_sha256"] = json!("0".repeat(64));
+    assert!(check_export(&e, &f.p).unwrap().is_empty());
+}
