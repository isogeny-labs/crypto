+#[test]
+fn review_reproducer_arbitrary_counter_string_is_accepted() {
+    let mut f = Fixture::new();
+    f.rows[0]["counters"]["actual"] = json!("not-a-nonnegative-integer");
+    f.refresh();
+    let (e, findings) = f.run().unwrap();
+    assert!(findings.is_empty());
+    assert_eq!(
+        e["runs"][0]["measurements"]["counters"]["native.actual"],
+        "not-a-nonnegative-integer"
+    );
+}
+
+#[test]
+fn review_reproducer_impossible_restore_history_is_accepted() {
+    let mut f = Fixture::new();
+    f.edit("history.json", "execution_history", |h| {
+        h["records"][0]["attempts"] = json!(1);
+        h["records"][0]["resumed"] = json!(2);
+        h["records"][0]["checkpoint"] = json!({
+            "policy": "criu",
+            "generations_written": 0,
+            "restored_from_generation": 99
+        });
+    });
+    let (e, findings) = f.run().unwrap();
+    assert!(findings.is_empty());
+    assert_eq!(e["runs"][0]["attempts"], 1);
+    assert_eq!(e["runs"][0]["resumed"], 2);
+    assert_eq!(
+        e["runs"][0]["checkpoint"]["restored_from_generation"],
+        99
+    );
+}
