    "theorem": "EllipticPicardBridgeAudit.actual_elliptic_picard_certificate",
    "statement": "theorem actual_elliptic_picard_certificate : (∀ (K : Type) [Field K] [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve.Affine K) (hΔ : W.Δ ≠ 0), Function.Bijective (pointClass W hΔ) ∧ (∀ P : W.Point, ellipticPicardEquiv W hΔ P=divisorClass W hΔ (pointDivisor W P)) ∧ (∀ D : W.Point →₀ ℤ, D ∈ principalPointDivisors W ↔ divisorDegree W D=0 ∧ divisorPointSum W D=0) ∧ (∀ P Q : W.Point, (∃ (f : W.FunctionField) (hf : f ≠ 0), functionDivisor W f hf=Finsupp.single P 1-Finsupp.single Q 1) ↔ P=Q) ∧ (∀ (f : W.FunctionField) (_ : f ≠ 0), FiniteRegular W f ↔ ∃ a : W.CoordinateRing, f=algebraMap W.CoordinateRing W.FunctionField a) ∧ (∀ (f : W.FunctionField) (_ : f ≠ 0), FiniteRegular W f → pointOrder W f 0 ≠ -1)) ∧ rationalCurve.Δ ≠ 0 ∧ divisorDegree rationalCurve (principalDivisorHom rationalCurve rationalBadUnit) = -4 ∧ (¬ ∃ h : Additive rationalCurve.FunctionFieldˣ → ZeroDivisors rationalCurve, ∀ u, (h u).val=principalDivisorHom rationalCurve u) ∧ geometricControlCurve.Δ ≠ 0 ∧ Function.Bijective geometricControlMap ∧ (∃ P, geometricControlMap P≠0)",
    "decl_sha256": "1d0707209326c4217584e719bcfaa2f2284a11b5d12e390a72c59c093d7ef9d4",
