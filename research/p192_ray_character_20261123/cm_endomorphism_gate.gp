\\ P-192 Frobenius-order certificate. Run: gp -q cm_endomorphism_gate.gp
die(msg) = { print("FAIL: ", msg); quit(1); };
p = 6277101735386680763835789423207666416083908700390324961279;
r = 6277101735386680763835789423176059013767194773182842284081;
t = p + 1 - r;
D = t^2 - 4*p;
factors = [5, 11, 31, 14140398275856956083603613626459809774163796198179979683];
if(t != 31607402316713927207482677199, die("unexpected trace"));
if(D != -24109379060336110122544161233113975664949272517896865359515, die("unexpected discriminant"));
if(D % 4 != 1 || D >= 0, die("not a negative 1-mod-4 discriminant"));
if(prod(i=1, #factors, factors[i]) != -D, die("factorization mismatch"));
for(i=1, #factors, if(isprime(factors[i]) != 1, die("factor not certified prime")));
if(gcd(t, p) != 1, die("not ordinary"));
min_noninteger_degree = (-D + 3) \ 4;
if(kronecker(D, 2) != -1 || kronecker(D, 3) != -1 || kronecker(D, 7) != -1, die("small inert-prime check failed"));
if(kronecker(D, 5) != 0 || kronecker(D, 11) != 0, die("small ramified-prime check failed"));
if(kronecker(D, 13) != 1, die("13 unexpectedly nonsplit"));
if(13^51 >= min_noninteger_degree, die("13-chain lower bound failed"));
small_form = qfbprimeform(-23, 2);
small_identity = qfbpow(small_form, 0);
small_second = qfbcomp(small_form, small_form);
if(small_form == small_identity || small_second == small_identity || qfbcomp(small_second, small_form) != small_identity, die("form-order control failed"));
prime13 = qfbprimeform(D, 13);
principal = qfbpow(prime13, 0);
class_power = principal;
for(k=1, 1000000, class_power = qfbcomp(class_power, prime13); if(class_power == principal, die(Str("degree-13 ideal class returned at ", k))));
if(class_power != qfbpow(prime13, 1000000), die("composition and powering disagree"));
print("trace=", t);
print("Frobenius_discriminant=", D);
print("squarefree_factors=", factors);
print("minimum_noninteger_endomorphism_degree=", min_noninteger_degree);
print("horizontal_2_3_7=inert; horizontal_5_11=ramified; horizontal_13=split; one-direction_13_cycle_edges>=52");
print("degree_13_prime_form=", prime13);
print("one_direction_13_ideal_class_order_gt=1000000");
print("End(E)=Z[pi]; pi acts as identity on E(F_p)");
