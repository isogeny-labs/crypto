+        let b = _mm512_loadu_si512(src.as_ptr().add(i).cast());
+        _mm512_storeu_si512(dst.add(i).cast(), _mm512_xor_si512(a, b));
+        i += 8;
+    }
+    while i < src.len() {
+        dst.add(i).write(previous.add(i).read() ^ src[i]);
+        i += 1;
+    }
