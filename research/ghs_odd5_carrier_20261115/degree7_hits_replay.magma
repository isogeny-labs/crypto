B := x^6 + (2*a^4 + 2*a^3 + 1)*x^5 + (2*a^4 + 2*a^3 + a^2 + 2*a + 1)*x^4 + (2*a^4 + a^2 + a)*x^3 + (a^4 + a^3 + 2*a)*x^2 + (a^3 + a)*x + 2*a^3 + a^2 + 2*a + 2;
C := (2*a^4 + 2*a^3 + 2*a^2 + a)*x^8 + (2*a^4 + 2*a^3 + 2*a^2 + 2*a + 2)*x^7 + (2*a + 2)*x^6 + (2*a^4 + a^3 + 2*a^2 + 1)*x^5 + (a^4 + 2*a)*x^4 + (2*a^3 + 2*a^2 + a + 2)*x^3 + (a^4 + a)*x^2 + (2*a^3 + a^2 + a + 2)*x + 2*a^4 + 2*a^3 + 2*a^2 + a + 1;
