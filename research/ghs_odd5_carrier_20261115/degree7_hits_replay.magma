A := (2*a^3 + 2*a^2)*x^7 + (2*a^4 + a^3 + a^2 + 2*a + 1)*x^6 + (a^4 + 2*a^3 + a^2 + a + 1)*x^5 + (2*a^4 + 2*a^2 + 2*a)*x^4 + (a^4 + a)*x^3 + (2*a^4 + a^3 + a + 1)*x^2 + (2*a^4 + a^2 + 2)*x + 2*a^2 + a + 2;
B := x^6 + (2*a^3 + 2*a^2 + 2*a + 2)*x^5 + (a^3 + a + 2)*x^4 + (2*a^4 + 2*a)*x^3 + (a^2 + a + 2)*x^2 + (2*a^4 + a^3 + a + 2)*x + a^4 + 2*a^3 + a^2 + a;
C := (a^2 + 1)*x^8 + (a^3 + a^2)*x^7 + (2*a^3 + 2)*x^6 + (a^4 + 2*a^3 + a^2 + 2*a)*x^5 + (a^4 + a^2)*x^4 + (a^4 + a^3 + 2*a^2)*x^3 + (a^4 + 2*a^3 + a^2)*x^2 + (a^4 + a^3 + a^2 + a)*x + a^2 + 2;
H := x^2 + (a^4 + a^3 + a^2 + a)*x + a^4 + 2*a^3 + 2;
assert Degree(A) eq 7 and Degree(B) eq 6 and Degree(C) eq 8;
assert GCD(A,B) eq 1;
assert f*C^2 eq B*(A^3+2*A^2*B+b*B^3);
