B := x^6 + (2*a^4 + a^3 + 1)*x^5 + (a^4 + 2*a^2 + a)*x^4 + (a^4 + 2*a^3 + a^2 + 2*a + 2)*x^3 + (2*a^4 + 2*a^3 + a^2 + 1)*x^2 + (a^4 + 2*a^3 + a + 1)*x + a^2 + 2;
C := (a^3 + 2*a^2 + a + 2)*x^8 + (a^4 + a^3 + a + 1)*x^7 + (2*a^4 + 2*a^2)*x^6 + (a^4 + 2*a^2 + 2*a + 2)*x^5 + (a + 1)*x^4 + (a^4 + a^3 + 2*a + 2)*x^3 + (2*a^4 + 2*a^2 + a)*x^2 + (2*a^4 + a^2)*x + a^3 + 2*a^2 + a + 1;
