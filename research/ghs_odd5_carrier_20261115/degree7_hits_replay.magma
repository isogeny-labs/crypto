F := GF(3); R0<z> := PolynomialRing(F);
K<a> := ext<F | z^5+2*z+1>; R<x> := PolynomialRing(K);
f := x^11+x^9+2*x^8+x^7+2*x^5+x^3+x^2+x+1;
assert GCD(f, Derivative(f)) eq 1;
b := 0*a^0 + 1*a^1 + 0*a^2 + 1*a^3 + 0*a^4;
A := (2*a^3 + a^2 + a)*x^7 + (2*a^4 + a^3 + a^2 + 1)*x^6 + (a^2 + 2*a)*x^5 + (a^4 + a^3 + a^2 + 2)*x^4 + (a^4 + a^2 + 2*a)*x^3 + (2*a^4 + 2*a^3 + a^2 + 2*a + 1)*x^2 + (2*a^4 + 2*a^3 + 2*a^2 + 2*a + 2)*x + a^4 + a^3 + a^2 + 2*a;
B := x^6 + (a^4 + 2*a^3 + 2*a^2 + a)*x^5 + (a^4 + 2*a^3 + a)*x^4 + (2*a^4 + 2*a^2 + a)*x^3 + (2*a^3 + a + 2)*x^2 + (2*a^4 + 2*a^3 + a^2 + 2*a + 2)*x + a^2 + 2*a + 2;
C := (a^4 + 2*a^3 + a^2 + a + 2)*x^8 + (a^3 + 2*a^2 + 2*a)*x^7 + (a^4 + a^3 + 2*a^2 + 2*a)*x^6 + (2*a^4 + 2*a + 1)*x^5 + (2*a^3 + 2)*x^4 + (2*a^2 + 2*a + 2)*x^3 + (a^4 + 2*a^2 + 2*a)*x^2 + (a^4 + a^3 + a)*x + a^4 + 2*a^3 + a^2 + a;
H := x^2 + (a^4 + a^3 + a)*x + a^3 + a^2 + a + 1;
assert Degree(A) eq 7 and Degree(B) eq 6 and Degree(C) eq 8;
assert GCD(A,B) eq 1;
assert f*C^2 eq B*(A^3+2*A^2*B+b*B^3);
