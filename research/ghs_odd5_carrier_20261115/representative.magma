SetSeed(20261115);
F := GF(3);
R<x> := PolynomialRing(F);
K<a> := ext<F | x^5+2*x+1>;
E := EllipticCurve([K | 0,1,0,0,a^2+a]);
assert #E eq 234;
f := x^11+x^7+2*x^5+2*x^4+x^3+x^2+1;
assert GCD(f,Derivative(f)) eq 1;
Y := HyperellipticCurve(f);
assert Genus(Y) eq 5;
J := Jacobian(Y);
S<T> := PolynomialRing(Integers());
expected := 1-10*T^5+3^5*T^10;
cpu := Cputime();
actual := EulerFactor(J);
print "euler_cpu_sec", Cputime(cpu);
print "source_equation", E;
print "source_order", #E;
print "target_equation", Y;
print "target_genus", Genus(Y);
print "expected", expected;
print "actual", actual;
print "polynomial_matches", actual eq expected;
print "target_order", #J;
assert actual eq expected and #J eq 234 and Evaluate(actual,1) eq #E;
