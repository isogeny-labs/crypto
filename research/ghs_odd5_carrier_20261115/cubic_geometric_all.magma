SetSeed(20261115);
L := GF(3^10);
R0<X> := PolynomialRing(L);
V<v> := PolynomialRing(L);
R<x> := PolynomialRing(V);
rows := [<-10,2801>, <10,2872>, <-14,9735>, <14,10172>, <14,17034>, <-14,17371>, <14,20805>, <-10,21088>, <-14,21624>, <10,21737>, <-22,28869>, <-26,28967>, <-22,30475>, <-10,32177>, <22,32280>, <22,35349>, <26,35518>, <22,36380>, <-22,38040>, <10,38080>, <-10,42333>, <10,43053>, <-14,44227>, <14,44228>, <22,51009>, <-26,51891>, <-22,57489>, <26,57795>, <-10,61358>, <10,62102>, <-14,64725>, <14,64726>, <-26,66715>, <22,67186>, <-22,74707>, <26,75595>, <-10,82995>, <10,83036>, <14,90456>, <-14,90937>, <14,91987>, <-14,92153>, <14,99569>, <-10,99770>, <-14,100118>, <10,100392>, <-10,106048>, <22,106121>, <-26,109438>, <-22,110018>, <-22,110972>, <22,112490>, <26,112704>, <22,113379>, <10,115017>, <-22,115130>, <10,120496>, <-10,121960>, <14,124584>, <-14,124586>, <22,127268>, <-26,128804>, <-22,132158>, <26,133127>, <-10,141283>, <10,141387>, <-14,144548>, <14,144640>, <-14,156795>, <14,157277>, <14,158437>, <-10,158712>, <-14,159256>, <10,159628>, <-22,165219>, <-22,165625>, <-26,165840>, <-10,168225>, <22,168265>, <-22,172387>, <10,172460>, <26,175130>, <22,175537>, <22,175771>];
for row in rows do
    trace := row[1];
    mask := row[2];
    f := X^11;
    for i in [0..10] do
        f +:= (mask mod 3)*X^i;
        mask := mask div 3;
    end for;
    assert mask eq 0 and GCD(f,Derivative(f)) eq 1;
    roots := Roots(f,L);
    assert #roots eq 11;
    pairs := 0;
    nonconstant := 0;
    for i in [1..10] do
        for j in [i+1..11] do
            B := (X-roots[i][1])*(X-roots[j][1]);
            C := f div B;
            assert B*C eq f;
            A0 := Modexp(C,3^9,B);
            assert (A0^3-C) mod B eq 0;
            bb := R!B;
            cc := R!C;
            aa := R!A0;
            A := aa+bb*(x+v);
            Q := (cc-A^3) div bb;
            assert (cc-A^3) mod bb eq 0;
            c2 := Coefficient(Q,6);
            Q -:= c2*A^2;
            c1 := Coefficient(Q,5);
            Q -:= c1*A*bb;
            c0 := Coefficient(Q,4);
            Q -:= c0*bb^2;
            G := V!0;
            for k in [0..3] do
                G := GCD(G,Coefficient(Q,k));
            end for;
            pairs +:= 1;
            if G eq 0 or Degree(G) gt 0 then
                nonconstant +:= 1;
                print "candidate",trace,i,j,G;
            end if;
        end for;
    end for;
    assert pairs eq 55;
    print "trace",trace,"pole_pairs",pairs,"nonconstant_gcd_pairs",nonconstant;
end for;
