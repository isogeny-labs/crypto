digraph T {
 graph [rankdir=LR,bgcolor="white",pad="0.2",ranksep="0.4"];
 node [shape=box,style="rounded,filled",fillcolor="#edf4fb",color="#456987",fontname="DejaVu Sans",fontsize=12,margin="0.13,0.12"];
 edge [color="#456987",fontname="DejaVu Sans",fontsize=10];
 x [label="Stated r-annihilated module
F³ = id, 3u + rv = 1"];
 f [label="Fixed component
pi(x) = u N(x)",fillcolor="#eaf5ed"];
 k [label="Trace-zero component
