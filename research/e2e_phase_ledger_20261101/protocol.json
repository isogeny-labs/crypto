  "question": "On Koblitz E0 at n=13, how do current F4, F5, F6-IC and root-finding PDP backends change the complete cold resource vector when relation collection is followed by full-rank checked relation solving?",
  "claims": [
    {
      "id": "C-correct",
      "text": "Every reported recovery replays and satisfies [d]G = Q; every IC result also reaches a full-rank relation system and point-checks each factor-base column.",
      "class": "exact_computation",
      "decided_by": []
    },
    {
      "id": "C-backend",
      "text": "At least one registered m=3 PDP backend lowers the complete counted resource vector relative to inherited F4 on this fixed toy cell without moving cost outside the ledger.",
      "class": "comparative",
      "decided_by": [
        "C-matrix-f4",
        "C-matrix-f5",
        "C-f6",
        "C-f6-pair",
        "C-root",
        "C-root-window",
        "C-root-negfold",
        "C-root-window-negfold"
      ],
      "if_supported": "a scoped implementation-level constant-factor improvement on the registered K13 cell",
      "if_not_supported": "no complete-resource improvement is established for the registered backends"
    },
    {
      "id": "C-scope",
      "text": "No result establishes novelty in the literature, an asymptotic improvement, or feasibility for ECC2K-130/131.",
      "class": "out_of_scope",
      "decided_by": []
    }
  ],
  "hypotheses": [
    {
      "id": "H-ledger",
      "statement": "F5 and F6 can reduce PDP matrix work, while root-finding can replace repeated algebraic solving by charged table construction and lookup, but only a complete cold phase ledger can show whether those savings survive relation collection and full-rank solving.",
      "mechanism": "The backends alter symbolic rows, elimination, split search, or reusable pair-table work while the factor base, targets, relation cap, and checked linear algebra remain fixed.",
      "predictions": [
        {
          "id": "P-complete",
          "metric": "bitop_v1_total",
          "direction": "lower",
          "minimum_effect": "paired candidate/inherited-F4 point ratio below 1 with a 95% interval below 1, complete coverage flags, and stable ordering across the declared pricing band",
          "provenance": {
            "written_at": "2026-11-01",
            "data_seen": [
              {
                "path": "research/f4_f5_f6_cross_family_20261011",
                "measured": "historical engine-native and partial end-to-end K13 calibration"
              },
              {
                "path": "research/ecbench_e2e_frontier_20261031",
                "measured": "phase and accounting contracts; no records from this registered full-rank panel"
              },
              {
                "path": "discarded pre-freeze smoke target_seed 202611010130",
                "measured": "instrument calibration: all m=3 arms verified; m=2 full-rank diagnostics plateaued at rank 10/11"
              }
            ],
            "sample_status": "partially_in_sample",
            "decisive_scope": "The rotated target streams 202611011130/202611011131 and measurement seeds 202611011230/202611011231 were fixed after calibration; none of their targets or rounds were run before freeze."
          },
          "role": "decisive"
        }
      ]
    }
  ],
