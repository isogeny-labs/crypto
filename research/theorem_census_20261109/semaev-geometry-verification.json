    "theorem": "RecursiveSemaevGeometryAudit.geometric_domain_audit_certificate",
    "statement": "theorem geometric_domain_audit_certificate : (∀ (F : Type*) [Field F] [DecidableEq F] [IsAlgClosed F] (W : WeierstrassCurve.Affine F),W.Δ≠0 → ∀ (n : ℕ) (xs : Fin (n+3)→F), evalCanonical W n xs=0 ↔ ∃ P : Fin (n+3)→W.Point, (∀ i,pointX (P i)=some (xs i)) ∧ (∑ i,P i)=0) ∧ (SkepticalAudit.rationalCurve.Δ≠0 ∧ ¬ ∀ (n : ℕ) (xs : Fin (n+3)→ZMod 5), evalCanonical SkepticalAudit.rationalCurve n xs=0 → ManyPoints SkepticalAudit.rationalCurve xs)",
