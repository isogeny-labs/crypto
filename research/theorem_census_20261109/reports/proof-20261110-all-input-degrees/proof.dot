 c [label="Introduced inputs\nActual selected birth variable"];
 d [label="Actual recursively lifted ring equivalences\nActual resultant recurrence; sharp old degree 2d"];
 e [label="Induct through every future stage\nActual sharp degree 2^(stage+1)"];
