digraph G {
 graph [rankdir=TB,bgcolor="white",nodesep=0.15,ranksep=0.3];
 node [shape=box,style="rounded,filled",fillcolor="#eaf2fb",fontname="DejaVu Sans",fontsize=11];
 a [label="Actual S3 cycles: degree 2\nAll four actual S4 base positions: degree 4"];
