+/// Ask for 2 MiB pages on a fresh, untouched filter allocation
+/// (`KIC_FILTER_HUGE=1`; Linux transparent huge pages in `madvise` mode).
+/// Advice only: the words and every answer are the same either way.
+fn advise_huge_filter(words: &mut [u64]) {
+    static HUGE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if !*HUGE.get_or_init(|| std::env::var("KIC_FILTER_HUGE").is_ok_and(|v| v == "1")) {
+        return;
+    }
+    #[cfg(target_os = "linux")]
+    {
+        const PAGE: usize = 2 << 20;
+        let start = words.as_mut_ptr() as usize;
+        let end = start + std::mem::size_of_val(words);
+        let (lo, hi) = (start.next_multiple_of(PAGE), end / PAGE * PAGE);
+        if hi > lo {
+            // SAFETY: `lo..hi` lies inside `words`' own allocation, and
+            // MADV_HUGEPAGE changes no contents.
+            unsafe {
+                libc::madvise(lo as *mut libc::c_void, hi - lo, libc::MADV_HUGEPAGE);
+            }
+        }
+    }
+}
