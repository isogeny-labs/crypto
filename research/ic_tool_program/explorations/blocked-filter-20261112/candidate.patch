+/// Probes a key sets in the **blocked** presence filter: one bit in each
+/// of the eight words of a 64-byte line its hash names, so a probe still
+/// touches one cache line (a split-block Bloom filter).  Built only on the
+/// folded table's partitioned path, and only with `KIC_FILTER=blocked`;
+/// the default build sets [`FILTER_PROBES`] bits in one word, as before.
+pub const FILTER_PROBES_BLOCKED: u8 = 8;
+
+/// Filter bits per stored key in the blocked layout, before rounding up to
+/// a power of two.
+const FILTER_BITS_PER_KEY_BLOCKED: usize = 16;
+
+/// [`filter_extra`] of a blocked filter: a tag, never a bit mask.
+const FILTER_EXTRA_BLOCKED: u64 = 0xb10c;
+
+/// Odd multipliers choosing the bit in each word of a block (the
+/// split-block Bloom filter's salts).
+const BLOCK_SALTS: [u32; 8] = [
+    0x47b6_137b,
+    0x4497_4d91,
+    0x8824_ad5b,
+    0xa2b7_289d,
+    0x7054_95c7,
+    0x2df1_424b,
+    0x9efc_4947,
+    0x5c6b_fb31,
+];
+
+/// Whether this process builds folded tables with the blocked filter
+/// (`KIC_FILTER=blocked`).  Only the filter's layout changes: every key
+/// it admits is still checked against the entries, so every answer is
+/// the default build's.
+pub(crate) fn filter_blocked_requested() -> bool {
+    static BLOCKED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *BLOCKED.get_or_init(|| std::env::var("KIC_FILTER").is_ok_and(|v| v.starts_with("blocked")))
+}
+
+/// Bits a key in the blocked layout: 16, or 8 with `KIC_FILTER=blocked8`
+/// (the default filter's size, for the exploration's size control).
+fn filter_bits_per_key_blocked() -> usize {
+    static BITS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *BITS.get_or_init(|| {
+        if std::env::var("KIC_FILTER").is_ok_and(|v| v == "blocked8") {
+            8
+        } else {
+            FILTER_BITS_PER_KEY_BLOCKED
+        }
+    })
+}
+
+/// The blocked filter's width in bits, as a power of two, within
+/// `2^9..=2^32` (at least one 512-bit block).
+pub(crate) fn filter_bits_blocked(keys: usize) -> u32 {
+    (usize::BITS
+        - keys
+            .max(1)
+            .saturating_mul(filter_bits_per_key_blocked())
+            .leading_zeros())
+    .clamp(9, 32)
+}
+
+/// The first word of a key's block, counted from the filter's aligned
+/// start: the hash's bits below the mask name the block.
+#[inline(always)]
+fn block_word(h: u64, mask: u64) -> usize {
+    (((h & mask) >> 9) as usize) * 8
+}
+
+/// The bit a key sets in each word of its block, from the hash's top half,
+/// which the block index (at most 32 bits) never reaches.
+#[inline(always)]
+fn block_bits(h: u64) -> [u64; 8] {
+    let x = (h >> 32) as u32;
+    BLOCK_SALTS.map(|salt| 1u64 << (x.wrapping_mul(salt) >> 26))
+}
+
+/// Whether every bit [`block_bits`] names is set in the eight words at
+/// `line`: one 512-bit load, the eight salted products and shifts as
+/// lanes, one test.  The same answer as the scalar loop.
+///
+/// # Safety
+///
+/// The CPU must have AVX-512F, and `line` must point at eight readable
+/// words.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx512f")]
+unsafe fn block_admits_avx512(line: *const u64, h: u64) -> bool {
+    use std::arch::x86_64::*;
+    let x = _mm512_set1_epi64(i64::from((h >> 32) as u32));
+    let salts = _mm512_set_epi64(
+        BLOCK_SALTS[7] as i64,
+        BLOCK_SALTS[6] as i64,
+        BLOCK_SALTS[5] as i64,
+        BLOCK_SALTS[4] as i64,
+        BLOCK_SALTS[3] as i64,
+        BLOCK_SALTS[2] as i64,
+        BLOCK_SALTS[1] as i64,
+        BLOCK_SALTS[0] as i64,
+    );
+    // Each 64-bit lane: its low half is `x · salt mod 2^32`, its high half
+    // 0 · 0; shifting the halves by 26 leaves the bit index as the lane.
+    let idx = _mm512_srli_epi32::<26>(_mm512_mullo_epi32(x, salts));
+    let bits = _mm512_sllv_epi64(_mm512_set1_epi64(1), idx);
+    let words = _mm512_loadu_si512(line as *const _);
+    let missing = _mm512_andnot_si512(words, bits);
+    _mm512_test_epi64_mask(missing, missing) == 0
+}
+
+/// Set every bit [`block_bits`] names in the eight words at `line`: one
+/// load, OR and store.  The same words as the scalar loop.
+///
+/// # Safety
+///
+/// The CPU must have AVX-512F, and `line` must point at eight writable
+/// words no other thread writes.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx512f")]
+unsafe fn block_set_avx512(line: *mut u64, h: u64) {
+    use std::arch::x86_64::*;
+    let x = _mm512_set1_epi64(i64::from((h >> 32) as u32));
+    let salts = _mm512_set_epi64(
+        BLOCK_SALTS[7] as i64,
+        BLOCK_SALTS[6] as i64,
+        BLOCK_SALTS[5] as i64,
+        BLOCK_SALTS[4] as i64,
+        BLOCK_SALTS[3] as i64,
+        BLOCK_SALTS[2] as i64,
+        BLOCK_SALTS[1] as i64,
+        BLOCK_SALTS[0] as i64,
+    );
+    let idx = _mm512_srli_epi32::<26>(_mm512_mullo_epi32(x, salts));
+    let bits = _mm512_sllv_epi64(_mm512_set1_epi64(1), idx);
+    let words = _mm512_loadu_si512(line as *const _);
+    _mm512_storeu_si512(line as *mut _, _mm512_or_si512(words, bits));
+}
