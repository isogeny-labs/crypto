+/// Words to skip so that `words[offset..]` starts on a 64-byte line.  A
+/// blocked filter keeps eight spare words for it.
+#[inline(always)]
+fn line_offset(words: &[u64]) -> usize {
+    ((64 - (words.as_ptr() as usize & 63)) & 63) / 8
+}
