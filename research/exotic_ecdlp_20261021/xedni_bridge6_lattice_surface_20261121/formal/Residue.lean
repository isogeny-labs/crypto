namespace XedniBridge6LatticeSurface

structure Term where
  eu : ℕ
  ev : ℕ
  et : ℕ
  c : ℤ
  deriving DecidableEq

def evalInt : List Term → ℤ → ℤ → ℤ → ℤ
  | [], _, _, _ => 0
  | a :: as, u, v, t => a.c * u ^ a.eu * v ^ a.ev * t ^ a.et + evalInt as u v t

def evalResidue : List Term → ZMod 47 → ZMod 47 → ZMod 47 → ZMod 47
  | [], _, _, _ => 0
  | a :: as, u, v, t => (a.c : ZMod 47) * u ^ a.eu * v ^ a.ev * t ^ a.et + evalResidue as u v t

theorem evalResidue_cast (xs : List Term) (u v t : ℤ) :
    evalResidue xs (u : ZMod 47) (v : ZMod 47) (t : ZMod 47) =
      (evalInt xs u v t : ZMod 47) := by
  induction xs with
  | nil => simp [evalInt, evalResidue]
  | cons a xs ih => simp [evalInt, evalResidue, ih]

def keep (a : Term) : Bool := decide ((a.c : ZMod 47) ≠ 0)

theorem eval_filter (xs : List Term) (u v t : ZMod 47) :
    evalResidue (xs.filter keep) u v t = evalResidue xs u v t := by
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    by_cases h : (a.c : ZMod 47) = 0
    · simp [keep, h, evalResidue, ih]
    · simp [keep, h, evalResidue, ih]

