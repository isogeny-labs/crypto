theorem relation_factor_mod47 (u v t : ZMod 47) :
    evalResidue terms u v t = 9 + 38 * u + 19 * v + 30 * t := by
  calc
    evalResidue terms u v t = evalResidue (terms.filter keep) u v t :=
      (eval_filter terms u v t).symm
    _ = 9 + 38 * u + 19 * v + 30 * t := by
      rw [filtered_terms]
      norm_num [evalResidue]
      have h0 : (9430678708838931191188181955202530509313600 : ZMod 47) = 9 := by decide
      have h1 : (142883357317689072933373545142852041075422016 : ZMod 47) = 17 := by decide
      have h2 : (116540592386593832303330213021383783302245760 : ZMod 47) = 28 := by decide
      have h3 : (2921303083352778770697883212391567217509232832 : ZMod 47) = 9 := by decide
      rw [h0, h1, h2, h3]
      calc
        _ = 9 + t * (-17) + v * (-28) + u * (-9) := by ring
        _ = 9 + t * 30 + v * 19 + u * 38 := by
          rw [show (-17 : ZMod 47) = 30 by decide,
            show (-28 : ZMod 47) = 19 by decide,
            show (-9 : ZMod 47) = 38 by decide]
        _ = _ := by ring

