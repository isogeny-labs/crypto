+// ---- F1 lane patch (2026-11-16): read-only saved-phase getter and saved-phase seeding.
+// Uses CaDiCaL's own 'Testing' friend accessor; CaDiCaL sources are unchanged.
+static int f1_map(CaDiCaL::External *ex, int eidx)
+{
+    if (eidx <= 0 || eidx > ex->max_var) return 0;
+    if ((size_t)eidx >= ex->e2i.size()) return 0;
+    return ex->e2i[eidx];
+}
+int f1_saved_phase(const std::unique_ptr<Solver> &solver, int eidx)
+{
+    CaDiCaL::Testing t(*solver);
+    int ilit = f1_map(t.external(), eidx);
+    if (!ilit) return 0;
+    CaDiCaL::Internal *in = t.internal();
+    int idx = abs(ilit);
+    if ((size_t)idx >= in->phases.saved.size()) return 0;
+    int sp = in->phases.saved[idx];
+    return ilit < 0 ? -sp : sp;
+}
+bool f1_seed_saved_phase(std::unique_ptr<Solver> &solver, int elit)
+{
+    CaDiCaL::Testing t(*solver);
+    int ilit = f1_map(t.external(), abs(elit));
+    if (!ilit) return false;
+    CaDiCaL::Internal *in = t.internal();
+    int idx = abs(ilit);
+    if ((size_t)idx >= in->phases.saved.size()) return false;
+    int s = (elit > 0 ? 1 : -1) * (ilit > 0 ? 1 : -1);
+    in->phases.saved[idx] = (signed char)s;
+    return true;
+}
