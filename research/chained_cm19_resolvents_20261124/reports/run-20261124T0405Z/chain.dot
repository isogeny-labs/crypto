digraph transfers {
  graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#eef4fa", color="#315574", fontname="DejaVu Sans", fontsize=11, margin="0.14,0.1"];
  edge [color="#315574", fontname="DejaVu Sans", fontsize=10];
  e [label="E / F7\ngenus 1"];
  jc [label="J(C) / F7\ndimension 3"];
  p [label="Prym(Y6/Y3) / F7\ndimension 2, principal Xi"];
  jd [label="J(D) / F7\ngenus 2"];
  e -> jc [label="beta3\nL beta3 = 0"];
  jc -> p [label="Psi on ker L"];
  p -> jd [label="iota inverse\npolarized isomorphism"];
  jd -> e [label="p1 pushforward\np1_* Gamma = I", color="#23845a", fontcolor="#17603e", constraint=false];
  subgraph cluster_models {
    label="Actual normalization covers over the same prime field";
    style="filled"; fillcolor="#f5f8fc"; bgcolor="white"; color="#c6d3df"; fontname="DejaVu Sans"; fontsize=11;
    y6 [label="Y6, genus 5"];
    y3 [label="Y3, genus 3"];
    y6 -> y3 [label="etale degree 2"];
  }
  y6 -> p [style=dotted, arrowhead=none, label="norm kernel (identity component)"];
}
