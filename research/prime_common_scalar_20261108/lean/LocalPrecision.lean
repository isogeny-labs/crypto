module
public import GlobalPolynomials
public section
namespace LocalPrecision
open LocalIntegral LocalCharts

/-- The actual reciprocal coefficient recurrence, with previously constructed
integral denominator and its genuine source-node unit. -/
theorem actual_inverse_recurrence (a : ℕ) (m : Fin (2^(a+1))) (n : ℕ) :
    PowerSeries.coeff n (inverseSeries a m) =
      if n=0 then (↑(rhoUnit a m)⁻¹ : integralRing) else
        -(↑(rhoUnit a m)⁻¹ : integralRing) *
          ∑ x ∈ Finset.antidiagonal n,
            if x.2 < n then
              PowerSeries.coeff x.1 (denominatorSeries a m) *
              PowerSeries.coeff x.2 (inverseSeries a m)
            else 0 := by
  exact PowerSeries.coeff_invOfUnit n (denominatorSeries a m) (rhoUnit a m)

/-- Congruence stability against any actual invertible approximation E.
No denominator-related loss is inserted in the ideal precision. -/
theorem inverse_ideal_stability (a : ℕ) (m : Fin (2^(a+1)))
    (I : Ideal (PowerSeries integralRing)) (E F : PowerSeries integralRing)
    (hinput : E-denominatorSeries a m ∈ I) (hEF : E*F=1) :
    F-inverseSeries a m ∈ I := by
  have hd : denominatorSeries a m-E ∈ I := by
    convert I.neg_mem hinput using 1
    ring
  have hprod : F * (denominatorSeries a m-E) * inverseSeries a m ∈ I :=
    I.mul_mem_right _ (I.mul_mem_left _ hd)
  have heq : F * (denominatorSeries a m-E) * inverseSeries a m = F-inverseSeries a m := by
    calc
      _ = F*(denominatorSeries a m*inverseSeries a m) - (E*F)*inverseSeries a m := by ring
      _ = _ := by rw [denominator_mul_inverse, hEF]; ring
  rwa [heq] at hprod

@[expose] noncomputable def jetIdeal (p q : ℕ) : Ideal (PowerSeries integralRing) :=
  Ideal.span {PowerSeries.C ((2 : integralRing)^p), (PowerSeries.X : PowerSeries integralRing)^q}

/-- Applies stability to the concrete ideal generated by2^p and X^q. Mapping
this formulation to a particular finite buffer representation is separate. -/
theorem inverse_jet_stability (a : ℕ) (m : Fin (2^(a+1))) (p q : ℕ)
    (E F : PowerSeries integralRing) (hinput : E-denominatorSeries a m ∈ jetIdeal p q)
    (hEF : E*F=1) : F-inverseSeries a m ∈ jetIdeal p q :=
  inverse_ideal_stability a m (jetIdeal p q) E F hinput hEF

end LocalPrecision
#print axioms LocalPrecision.actual_inverse_recurrence
#print axioms LocalPrecision.inverse_ideal_stability
#print axioms LocalPrecision.inverse_jet_stability
