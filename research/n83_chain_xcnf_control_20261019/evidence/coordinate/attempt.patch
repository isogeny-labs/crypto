@@ -363,6 +363,45 @@ impl ChainedS3Encoding {
         Ok(required)
     }
 
+    /// Give each summand its own exact finite x-coordinate domain. This
+    /// reuses the missing-prefix trie without orbit-selector or phase wires;
+    /// callers must enumerate the complete desired x-domain beforehand.
+    /// The preflight is atomic and leaves the solver unchanged on a cap.
+    pub fn constrain_coordinate_domains(
+        &mut self,
+        codes_by_summand: &[Vec<BigUint>],
+        max_domain_clauses: usize,
+    ) -> Result<usize, ChainBuildError> {
+        if self.domain_installed || codes_by_summand.len() != self.m {
+            return Err(ChainBuildError::Unsupported);
+        }
+        let mut sorted_domains = Vec::with_capacity(self.m);
+        let mut required = 0usize;
+        for codes in codes_by_summand {
+            let clauses =
+                finite_domain_clause_count(codes, self.n, 1).ok_or(ChainBuildError::Unsupported)?;
+            required = required
+                .checked_add(clauses)
+                .ok_or(ChainBuildError::Unsupported)?;
+            let mut sorted = codes.clone();
+            sorted.sort_unstable();
+            sorted.dedup();
+            sorted_domains.push(sorted);
+        }
+        if required > max_domain_clauses {
+            return Err(ChainBuildError::DomainClauseCap {
+                required,
+                maximum: max_domain_clauses,
+            });
+        }
+        self.first_pair_exchangeable = sorted_domains[0] == sorted_domains[1];
+        for (block, codes) in self.blocks[..self.m].iter().zip(&sorted_domains) {
+            add_coordinate_domain(&mut self.solver, block, codes, self.n as usize);
+        }
+        self.domain_installed = true;
+        Ok(required)
+    }
+
     /// Install the exact union of all binary-Frobenius phases of the given
     /// representative x-coordinates. One-hot representative selection and
     /// a bounded binary phase are linked to each summand by native XOR rows.
@@ -1184,4 +1223,66 @@ mod tests {
