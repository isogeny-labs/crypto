+    #[test]
+    fn heterogeneous_coordinate_domains_preserve_exact_sum_and_atomic_cap() {
+        let kc = KoblitzCurve::new(0, 7).unwrap();
+        let BinaryPoint::Affine { x, .. } = kc.generator() else {
+            panic!("generator is affine");
+        };
+        let point_x = x.to_biguint();
+        let other = (0u8..128)
+            .map(BigUint::from)
+            .find(|candidate| candidate != &point_x)
+            .unwrap();
+        let domains = vec![vec![point_x.clone()], vec![other.clone(), point_x.clone()]];
+        let required = finite_domain_clause_count(&domains[0], 7, 1).unwrap()
+            + finite_domain_clause_count(&domains[1], 7, 1).unwrap();
+        let mut enc =
+            ChainedS3Encoding::build(2, &kc.curve.irreducible, &kc.curve.b, None, 0, 2_000)
+                .unwrap();
+        let before = (
+            enc.solver.n_vars(),
+            enc.solver.n_clauses(),
+            enc.solver.n_xors(),
+        );
+        assert_eq!(
+            enc.constrain_coordinate_domains(&domains, required - 1),
+            Err(ChainBuildError::DomainClauseCap {
+                required,
+                maximum: required - 1,
+            })
+        );
+        assert_eq!(
+            (
+                enc.solver.n_vars(),
+                enc.solver.n_clauses(),
+                enc.solver.n_xors()
+            ),
+            before
+        );
+        assert_eq!(
+            enc.constrain_coordinate_domains(&domains, required),
+            Ok(required)
+        );
+        assert_eq!(enc.solver.n_vars(), before.0);
+        assert_eq!(enc.solver.n_clauses() - before.1, required);
+        assert_eq!(enc.solver.n_xors(), before.2);
+        assert_eq!(
+            enc.order_first_pair(2_000),
+            Err(ChainBuildError::Unsupported)
+        );
+        assert_eq!(enc.solver.solve(), SolveResult::Sat);
+        assert!(enc.verify_model());
+        assert_eq!(enc.decode_summands()[0].to_biguint(), point_x);
+        assert_eq!(enc.decode_summands()[1].to_biguint(), point_x);
+
+        let mut disjoint =
+            ChainedS3Encoding::build(2, &kc.curve.irreducible, &kc.curve.b, None, 0, 2_000)
+                .unwrap();
+        disjoint
+            .constrain_coordinate_domains(&[vec![point_x], vec![other]], required)
+            .unwrap();
+        assert_eq!(disjoint.solver.solve(), SolveResult::Unsat);
+    }
