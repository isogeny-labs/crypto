+    fn v2_native_sat_producer_and_exporter_bind_both_policies_and_twists() {
+        for index in 0..4 {
+            let fixture = TempRun::new();
+            let (dir, config) = v2_attempt_fixture_for_solver(&fixture, index, "sat");
+            telemetry::checked::install_policy(&dir).unwrap();
+            let binding = capture::AttemptBinding::from_cell_files(&dir).unwrap();
+            storage::write_json(
+                &dir,
+                "capture-binding.json",
+                "partial-capture-binding",
+                &binding,
+            )
+            .unwrap();
+            storage::write_json(
+                &dir,
+                "capture-limits.json",
+                "partial-capture-limits",
+                &capture::capture_limits(1).unwrap(),
+            )
+            .unwrap();
+            execution::create(&dir).unwrap();
+            storage::write_json(
+                &dir,
+                "worker-process.json",
+                "process-provenance",
+                &json!({}),
+            )
+            .unwrap();
+            for name in ["stdout.log", "stderr.log"] {
+                storage::write_bytes(&dir, name, "process-log", "utf8", b"").unwrap();
+            }
+            worker(&config, &dir).unwrap();
+            let outcome: Value = read_json(&dir.join("result.json")).unwrap();
+            let bound = admitted_worker_policy(&dir, &config).unwrap().unwrap();
+            assert_eq!(bound.spec().policy_index, index / 2);
+            assert_eq!(config.twist, index % 2 == 1);
+            let manifest = CellManifest {
+                schema: bound.cell_schema().into(),
+                cell_index: index,
+                plan_sha256: bound.plan_sha256().into(),
+                config,
+                outcome,
+                artifacts: collect_cell_artifacts(&dir).unwrap(),
+            };
+            let maps = manifest
+                .artifacts
+                .iter()
+                .filter(|a| a.role == "native-binary-s3-gate-map")
+                .count();
+            let formulas = manifest
+                .artifacts
+                .iter()
+                .filter(|a| a.role == "complete-original-cnf-xor")
+                .count();
+            assert!(maps > 0, "occurrence {index}: {}", manifest.outcome);
+            assert_eq!(maps, formulas);
+            fs::write(
+                dir.join("manifest.json"),
+                serde_json::to_vec(&manifest).unwrap(),
+            )
+            .unwrap();
+            verify_cell(&dir, true).unwrap();
+            let out = TempRun::new();
+            let first = export::export(&fixture.0, &out.0).unwrap();
+            let records: Vec<Value> =
+                fs::read_to_string(out.0.join("restricted/sat-records.jsonl"))
+                    .unwrap()
+                    .lines()
+                    .map(|line| serde_json::from_str(line).unwrap())
+                    .collect();
+            let summaries: Vec<&Value> = records
+                .iter()
+                .map(|row| &row["record"])
+                .filter(|record| record.get("patterns_admitted").is_some())
+                .collect();
+            assert_eq!(summaries.len(), 1, "occurrence {index}: {records:?}");
+            assert!(summaries[0]["patterns_admitted"].as_u64().unwrap() > 0);
+            assert_eq!(summaries[0]["native_execution_trace_verified"], false);
+            assert_eq!(summaries[0]["native_instruction_count_verified"], false);
+            assert_eq!(summaries[0]["unsat_proof_checked"], false);
+            let retained = retained_tree(&out.0);
+            assert_eq!(export::export(&fixture.0, &out.0).unwrap(), first);
+            assert_eq!(retained_tree(&out.0), retained);
+        }
+    }
