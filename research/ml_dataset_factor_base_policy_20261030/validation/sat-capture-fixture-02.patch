     #[test]
+    #[cfg(target_os = "linux")]
+    fn v2_native_sat_one_mib_capture_stops_without_promoting_solver_success() {
+        let fixture = TempRun::new();
+        let (dir, config) = v2_attempt_fixture_for_solver(&fixture, 0, "sat");
+        telemetry::checked::install_policy(&dir).unwrap();
+        let binding = capture::AttemptBinding::from_cell_files(&dir).unwrap();
+        let limits = capture::capture_limits(1).unwrap();
+        storage::write_json(
+            &dir,
+            "capture-binding.json",
+            "partial-capture-binding",
+            &binding,
+        )
+        .unwrap();
+        storage::write_json(
+            &dir,
+            "capture-limits.json",
+            "partial-capture-limits",
+            &limits,
+        )
+        .unwrap();
+        execution::create(&dir).unwrap();
+        storage::write_json(
+            &dir,
+            "worker-process.json",
+            "process-provenance",
+            &json!({}),
+        )
+        .unwrap();
+        for name in ["stdout.log", "stderr.log"] {
+            storage::write_bytes(&dir, name, "process-log", "utf8", b"").unwrap();
+        }
+        worker(&config, &dir).unwrap();
+        let outcome: Value = read_json(&dir.join("result.json")).unwrap();
+        assert_eq!(outcome["status"], "error");
+        assert!(outcome["reason"]
+            .as_str()
+            .unwrap()
+            .contains("StreamByteLimit"));
+        assert_eq!(outcome["solver_completed"], false);
+        assert_eq!(outcome["scalar_recovered_without_witness"], false);
+        let artifacts = collect_cell_artifacts(&dir).unwrap();
+        storage::verify_manifest(&dir, &artifacts).unwrap();
+        assert!(!artifacts
+            .iter()
+            .any(|a| a.role == "native-binary-s3-gate-map"));
+        assert!(artifacts
+            .iter()
+            .any(|a| a.path.starts_with("live/") && a.role == "unregistered-partial-artifact"));
+        let initial = capture::CaptureCursor::initial(&binding).unwrap();
+        let retained = TempRun::new();
+        let delta = capture::capture_committed_delta(
+            &dir,
+            &retained.0.join("prefix"),
+            &binding,
+            &initial,
+            &limits,
+        )
+        .unwrap()
+        .unwrap();
+        capture::verify_captured_delta(&retained.0.join("prefix"), &delta, &initial).unwrap();
+        assert!(delta.cursor.event_count > 0);
+        assert!(delta.cursor.byte_end <= limits.max_stream_bytes);
+    }
