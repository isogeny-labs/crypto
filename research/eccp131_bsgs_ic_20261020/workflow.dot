digraph ecc130_workflows {
  graph [label="Certicom challenge workflows: exact identity and execution scope", labelloc=t,
         fontname="Helvetica", fontsize=18, ranksep=0.55, nodesep=0.36];
  node [shape=box, style="rounded,filled", fillcolor="#f4f7fb", color="#55718b",
        fontname="Helvetica", fontsize=11];
  edge [color="#55718b", fontname="Helvetica", fontsize=10];

  p [label="ECCp-131\nprime field, published G and Q"];
  b [label="ECC2K-130\nbinary Koblitz, published G and Q"];
  pi [label="Exact parameter and\npoint inspection", fillcolor="#e4f2e7"];
  bi [label="Exact parameter and\npoint inspection", fillcolor="#e4f2e7"];
  pb [label="Interval BSGS\nverified scalar if in range", fillcolor="#e4f2e7"];
  bb [label="Interval BSGS\nverified scalar if in range", fillcolor="#e4f2e7"];
  ps [label="Prime IC structure and\nscaled pipeline", fillcolor="#fff2d6"];
  bf [label="Fixed-parameter IC\nselect / collect / logs / solve", fillcolor="#fff2d6"];
  pg [label="Exact ECCp-131 IC\nrelation / rank / descent", fillcolor="#fce5e5"];

  p -> pi -> pb;
  p -> ps;
  ps -> pg [style=dashed, label="missing validated path"];
  b -> bi -> bb;
  b -> bf;

}
