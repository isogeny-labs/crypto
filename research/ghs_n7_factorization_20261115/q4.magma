SetSeed(20261115);
R<x> := PolynomialRing(GF(2));
K<z> := ext<GF(2) | x^14+x^5+1>;
k := GF(4);
Embed(k,K);
a := z^12+z^9+z^8+z^7+z^6+z^5+z^4+z+1;
b := z^8+z^7+z^6+z^5+z+1;
assert a^4 eq a;
aa := [v : v in k | K!v eq a][1];
assert K!aa eq a;
E := EllipticCurve([K | 1,a,0,0,b]);
assert #E eq 16634;
C,h := WeilDescent(E,k,K!1);
assert Genus(C) eq 8;
J := Jacobian(C);
E0 := EllipticCurve([k | 1,aa,0,0,1]);
u := 5-#E0;
t := 2^14+1-#E;
ZZT<T> := PolynomialRing(Integers());
expected := (1-u*T+4*T^2)*(1-t*T^7+4^7*T^14);
cpu := Cputime();
actual := EulerFactor(J);
print "euler_cpu_sec", Cputime(cpu);
print "base_order", #E0;
print "source_trace", t;
print "base_trace", u;
print "expected", expected;
print "actual", actual;
print "factorization_matches", actual eq expected;
print "order_product", Evaluate(expected,1);
print "jacobian_order", #J;
assert actual eq expected;
assert Evaluate(actual,1) eq #J;
assert #J eq #E*#E0;
