+/// Lemma P arm: for each distinct `F_p`-root `rho` of `S3(u, x3, x_R)` over
+/// `x3` in the base, the m = 2 system with target `rho` on the same tower
+/// and curve, closure to `--hky-cmax`.
+#[allow(clippy::too_many_arguments)]
+fn spec_ladder_rows(
+    cell: &Cell,
+    a: &Args,
+    tower: &Tower,
+    curve: &PrimeCurve,
+    target: &Target,
+    k: usize,
+    m3_dfall: &Value,
+    mut rng: StdRng,
+    sink: &mut Sink,
+) {
+    let p = curve.p;
+    let (ca, cb) = (curve.a, curve.b);
+    // pairs (x3, rho), rho an F_p root of the quadratic S3(u, x3, x_R) in u.
+    let mut rhos: BTreeMap<u64, Vec<u64>> = BTreeMap::new();
+    let mut no_root = 0usize;
+    let mut degenerate = 0usize;
+    for &x3 in &tower.v {
+        let ev = |u: u64| -> u64 {
+            let v = s3(
+                &Pol::constant(1, u, p),
+                &Pol::constant(1, x3, p),
+                &Pol::constant(1, target.x_r, p),
+                ca,
+                cb,
+                p,
+            );
+            v.terms.get(&vec![0u32]).copied().unwrap_or(0)
+        };
+        let (v0, v1, vm) = (ev(0), ev(1), ev(p - 1));
+        let inv2 = invm(2, p);
+        let c2 = subm(mulm(addm(v1, vm, p), inv2, p), v0, p);
+        let c1 = mulm(subm(v1, vm, p), inv2, p);
+        let c0 = v0;
+        if c2 == 0 {
+            degenerate += 1;
+            continue;
+        }
+        let disc = subm(mulm(c1, c1, p), mulm(4, mulm(c2, c0, p), p), p);
+        match curve.sqrt(disc) {
+            None => no_root += 1,
+            Some(sq) => {
+                let i2a = invm(mulm(2, c2, p), p);
+                let r1 = mulm(addm(p - c1, sq, p), i2a, p);
+                let r2 = mulm(subm(p - c1, sq, p), i2a, p);
+                let mut roots = vec![r1];
+                if r2 != r1 {
+                    roots.push(r2);
+                }
+                for r in roots {
+                    rhos.entry(r).or_default().push(x3);
+                }
+            }
+        }
+    }
+    eprintln!(
+        "-- spec-ladder t={} target {k}: {} distinct rho, {} x3 without F_p root, {} degenerate",
+        cell.t,
+        rhos.len(),
+        no_root,
+        degenerate
+    );
+    let cell2 = Cell {
+        kind: cell.kind,
+        m: 2,
+        control: Control::Tower,
+        t: cell.t,
+        g: cell.g,
+    };
+    for (rho, x3s) in &rhos {
+        let tg = Target {
+            planted: false,
+            x_r: *rho,
+            solution: None,
+            xs: Vec::new(),
+        };
+        let (eqs, n, _sol, _tw) = system(
+            Control::Tower,
+            tower,
+            curve,
+            2,
+            &tg,
+            cell.g,
+            None,
+            &mut rng,
+        );
+        let out = measure_hky(&eqs, tower, &cell2, n, p, None, a);
+        let mut row = json!({
+            "kind": cell.kind.name(), "m": 2, "control": "tower", "t": cell.t,
+            "g": cell.g, "target": "random", "target_index": k, "x_r": rho, "p": p,
+            "curve": {"a": ca, "b": cb},
+            "spec_of": {"m": 3, "x_r_m3": target.x_r, "target_index": k, "rho": rho,
+                        "x3_list": x3s, "m3_last_fall_degree": m3_dfall},
+            "wall_s": out.ms / 1e3,
+        });
+        if let (Some(obj), Some(extra)) = (row.as_object_mut(), out.extra.as_object()) {
+            for (kk, v) in extra {
+                obj.insert(kk.clone(), v.clone());
+            }
+        }
+        sink.push(row);
+    }
+}
