+        }
+        // Both possible parity keys occupy adjacent bits in the same word:
+        // slots has power-of-two size >=2, hence bit is even and <=62 mod64.
+        let bit = ((2 * x) as usize) & (self.slots.len() - 1);
+        self.occupied[bit / 64] & (3u64 << (bit % 64)) != 0
