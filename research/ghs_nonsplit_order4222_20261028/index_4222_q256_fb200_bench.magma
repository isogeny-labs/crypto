ticAll := Cputime();
F2 := GF(2);
P<U> := PolynomialRing(F2);
L<z> := ext<F2 | U^24+U^16+U^15+U^14+U^13+U^10+U^9+U^7+U^5+U^3+1>;
k := FiniteField(2,4); Embed(k,L);
P2<X,Y,Z> := ProjectiveSpace(k,2);
Q := Curve(P2,(k!(L!(1)))*X^4*Y^0*Z^0+(k!(L!(1+z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^3*Y^1*Z^0+(k!(L!(z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^2*Y^2*Z^0+(k!(L!(z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^1*Y^3*Z^0+(k!(L!(1+z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^0*Y^4*Z^0+(k!(L!(1+z^2+z^3+z^9+z^12+z^13+z^14+z^15+z^16+z^17+z^18+z^20+z^22)))*X^1*Y^2*Z^1+(k!(L!(1+z^2+z^3+z^9+z^12+z^13+z^14+z^15+z^16+z^17+z^18+z^20+z^22)))*X^0*Y^3*Z^1+(k!(L!(1+z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^2*Y^0*Z^2+(k!(L!(z+z^2+z^5+z^6+z^11+z^12+z^15+z^17+z^18+z^22)))*X^0*Y^2*Z^2+(k!(L!(1+z^2+z^3+z^9+z^12+z^13+z^14+z^15+z^16+z^17+z^18+z^20+z^22)))*X^0*Y^1*Z^3+(k!(L!(1+z^4+z^6+z^7+z^8+z^9+z^10+z^12+z^13+z^15+z^16+z^17)))*X^0*Y^0*Z^4);
assert IsNonsingular(Q) and Genus(Q) eq 3;
R := CoordinateRing(Ambient(Q));
d_R_0 := Divisor(Q,ideal<R | (k!(L!(z+z^2+z^5+z^6+z^11+z^12+z^15+z^17+z^18+z^22)))*X^0*Z^3+(k!(L!(1+z^2+z^3+z^4+z^6+z^7+z^8+z^10+z^14+z^18+z^20+z^22)))*X^1*Z^2+(k!(L!(1+z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^2*Z^1+(k!(L!(1)))*X^3*Z^0, Y*Z + (k!(L!(z^2+z^3+z^9+z^12+z^13+z^14+z^15+z^16+z^17+z^18+z^20+z^22)))*X^0*Z^2 + (k!(L!(z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^1*Z^1 + (k!(L!(1+z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^2*Z^0>);
assert Degree(d_R_0) eq 3;
d_R_1 := Divisor(Q,ideal<R | (k!(L!(z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^0*Z^3+(k!(L!(z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^1*Z^2+(k!(L!(1)))*X^3*Z^0, Y*Z + (k!(L!(1+z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^0*Z^2 + (k!(L!(1+z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^2*Z^0>);
assert Degree(d_R_1) eq 3;
d_R := d_R_0 + d_R_1;
d_R_plus_G_0 := Divisor(Q,ideal<R | (k!(L!(z^2+z^3+z^4+z^6+z^7+z^8+z^10+z^14+z^18+z^20+z^22)))*X^0*Z^3+(k!(L!(1+z+z^2+z^5+z^6+z^11+z^12+z^15+z^17+z^18+z^22)))*X^1*Z^2+(k!(L!(z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^2*Z^1+(k!(L!(1)))*X^3*Z^0, Y*Z + (k!(L!(1+z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^0*Z^2 + (k!(L!(z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^1*Z^1 + (k!(L!(1+z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^2*Z^0>);
assert Degree(d_R_plus_G_0) eq 3;
d_R_plus_G_1 := Divisor(Q,ideal<R | (k!(L!(1+z^2+z^3+z^4+z^6+z^7+z^8+z^10+z^14+z^18+z^20+z^22)))*X^0*Z^3+(k!(L!(1+z+z^2+z^5+z^6+z^11+z^12+z^15+z^17+z^18+z^22)))*X^1*Z^2+(k!(L!(1+z^2+z^3+z^4+z^6+z^7+z^8+z^10+z^14+z^18+z^20+z^22)))*X^2*Z^1+(k!(L!(1)))*X^3*Z^0, Y*Z + (k!(L!(1+z^2+z^3+z^9+z^12+z^13+z^14+z^15+z^16+z^17+z^18+z^20+z^22)))*X^1*Z^1 + (k!(L!(z^2+z^3+z^9+z^12+z^13+z^14+z^15+z^16+z^17+z^18+z^20+z^22)))*X^2*Z^0>);
assert Degree(d_R_plus_G_1) eq 3;
d_R_plus_G := d_R_plus_G_0 + d_R_plus_G_1;
d_R_plus_Q_0 := Divisor(Q,ideal<R | (k!(L!(z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^0*Z^3+(k!(L!(z^2+z^3+z^4+z^6+z^7+z^8+z^10+z^14+z^18+z^20+z^22)))*X^1*Z^2+(k!(L!(1)))*X^3*Z^0, Y*Z + (k!(L!(z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^0*Z^2 + (k!(L!(1+z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^1*Z^1 + (k!(L!(z+z^3+z^4+z^5+z^7+z^8+z^10+z^11+z^12+z^14+z^15+z^17+z^20)))*X^2*Z^0>);
assert Degree(d_R_plus_Q_0) eq 3;
d_R_plus_Q_1 := Divisor(Q,ideal<R | (k!(L!(1+z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^0*Z^3+(k!(L!(z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^1*Z^2+(k!(L!(1+z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^2*Z^1+(k!(L!(1)))*X^3*Z^0, Y*Z + (k!(L!(z+z^2+z^4+z^5+z^7+z^8+z^9+z^10+z^11+z^13+z^16+z^18+z^22)))*X^0*Z^2 + (k!(L!(z+z^3+z^5+z^6+z^9+z^11+z^13+z^14+z^16+z^20)))*X^1*Z^1 + (k!(L!(1+z^4+z^6+z^7+z^8+z^9+z^10+z^12+z^13+z^15+z^16+z^17)))*X^2*Z^0>);
assert Degree(d_R_plus_Q_1) eq 3;
d_R_plus_Q := d_R_plus_Q_0 + d_R_plus_Q_1;
D := d_R_plus_G-d_R; T := d_R_plus_Q-d_R;
F256 := FiniteField(2,8); Embed(k,F256); Q256 := BaseChange(Q,F256);
R256 := CoordinateRing(Ambient(Q256));
function Lift(V)
    return Divisor(Q256,ideal<R256 | [R256!f : f in Basis(Ideal(V))]>);
end function;
e_R_0 := Lift(d_R_0);
e_R_1 := Lift(d_R_1);
e_R := e_R_0+e_R_1;
e_R_plus_G_0 := Lift(d_R_plus_G_0);
e_R_plus_G_1 := Lift(d_R_plus_G_1);
e_R_plus_G := e_R_plus_G_0+e_R_plus_G_1;
e_R_plus_Q_0 := Lift(d_R_plus_Q_0);
e_R_plus_Q_1 := Lift(d_R_plus_Q_1);
e_R_plus_Q := e_R_plus_Q_0+e_R_plus_Q_1;
DD := e_R_plus_G-e_R; TT := e_R_plus_Q-e_R;
P0 := RationalPoints(Q256)[1]; D0 := Divisor(P0);
print "PRE_INDEX_CPU", Cputime(ticAll);
SetVerbose("CurveIndexcal",1); tic := Cputime();
answer := IndexCalculus(DD,TT,D0,2111,200,260);
print "INDEX_ANSWER", answer, "INDEX_CPU", Cputime(tic);
if answer eq 7 then print "SOURCE_VERIFIED", true; else error "wrong logarithm"; end if;
