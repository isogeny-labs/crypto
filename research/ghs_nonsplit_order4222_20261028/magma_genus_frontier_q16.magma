for i in [0..4094] do
    try
        g := WeilDescentGenus(E,k,w^i);
        assert g le 99;
        counts[g+1] +:= 1;
        if g eq 3 and first3 eq -1 then first3 := i; end if;
    catch e
        errors +:= 1;
    end try;
end for;
assert &+counts + errors eq 4095;
print "ORDER",4178,"GENUS_HIST",[<g,counts[g+1]>:g in [0..99]|counts[g+1] ne 0],"FIRST3",first3,"ERRORS",errors;
