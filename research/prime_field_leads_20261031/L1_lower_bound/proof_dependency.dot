digraph L1 {
  rankdir=TB; node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=11];
  // green = PROVED, yellow = PROVED given H, red = GAP, grey = hypothesis
  A1 [label="A1 root counting\ndeg L >= |F|/2, t >= log_d|F|/2\nPROVED", fillcolor="#b7e4c7"];
  A2 [label="A2 D_sol >= |V| (direct)\nPROVED", fillcolor="#b7e4c7"];
  A3 [label="A3 rank >= C(m+v-s, m)\nPROVED", fillcolor="#b7e4c7"];
  A4 [label="A4 tower: D_sol >= alpha t,\nrank ~ cols  (H_T)\nGAP", fillcolor="#f4a6a6"];
  A4p [label="A4' c(alpha,m,d)\nPROVED given H_T", fillcolor="#fff3b0"];
  A5 [label="A5 Yokoyama-Yasuda\n(dense only)\ngiven H_YY", fillcolor="#fff3b0"];
  E1 [label="E1 yield <= C(B+m,m)/r\nPROVED", fillcolor="#b7e4c7"];
  E2 [label="E2 adaptive targets\nPROVED given H_E", fillcolor="#fff3b0"];
  E3 [label="E3 H_E: no fast sampling\nof decomposable R\nGAP", fillcolor="#f4a6a6"];
  C1 [label="C1 kernel support:\nrows >= 2|F*|/m\nPROVED", fillcolor="#b7e4c7"];
  C2 [label="C2 relation count\nm<=2 excluded\nPROVED given H_C", fillcolor="#fff3b0"];
  C3 [label="C3 H_C: no cheap sub-base\nGAP", fillcolor="#f4a6a6"];
  B1 [label="B1 T >= max(B, max(1,m!r/B^(m-1)) r(B))\nPROVED given H_C, H_E", fillcolor="#fff3b0"];
  B2 [label="B2 threshold e < m/2-1;\nbar c >= (m-1)/2\nPROVED", fillcolor="#b7e4c7"];
  B3 [label="B3 table MITM comparison\n(not a floor)", fillcolor="#dddddd"];
  B4 [label="B4 generic-group floor\nGAP", fillcolor="#f4a6a6"];
  D1 [label="D1 uniform in E\nPROVED", fillcolor="#b7e4c7"];
  D2 [label="D2 JMV: remark only\n(GRH, same End)", fillcolor="#dddddd"];
  D3 [label="D3 automorphism fold <= 36\nPROVED given exotic 1.3", fillcolor="#fff3b0"];
  T1 [label="THEOREM 1 (direct): T >= c_m r\ngiven H_C, H_E", fillcolor="#fff3b0", penwidth=2];
  T2 [label="THEOREM 2 (tower): T >= r^(1/2-o(1))\niff c >= (m-1)/2, given H_T, H_C, H_E", fillcolor="#fff3b0", penwidth=2];
  A1 -> A2; A1 -> A3; A2 -> A3; A3 -> T1; A1 -> A4; A4 -> A4p; A4p -> T2; A3 -> A4p;
  E1 -> E2; E3 -> E2; C1 -> C2; C3 -> C2; E1 -> B1; E2 -> B1; C2 -> B1; B1 -> B2; B1 -> T1; B2 -> T2; B1 -> T2;
  D1 -> T1; D1 -> T2; D3 -> B1; B3 -> B2 [style=dashed]; B4 -> B3 [style=dashed]; A5 -> T1 [style=dashed]; D2 -> D1 [style=dashed];
}
