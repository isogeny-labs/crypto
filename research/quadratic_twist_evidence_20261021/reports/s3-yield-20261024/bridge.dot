  main [label="E/F43: y²=x³+x\nP=(31,18), order 11\nPrefix base: (4,5),(13,19)\nFirst target: rank 0, closure 6"];
  twist [label="Twist T/F43: Y²=X³+4X\nU=(24,26), order 11\nPrefix base: (15,9),(17,6)\nFirst target: rank 2, closure 4", fillcolor="#fff2e4", color="#bd7935"];
  pullback [label="Same E/F43\nPulled-back base: (14,36),(13,24)\nFirst target: rank 2, closure 4\nSame exact coefficient sets", fillcolor="#eaf5ec", color="#65956e"];
