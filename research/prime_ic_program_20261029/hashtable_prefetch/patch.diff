+                assert_eq!(
+                    set.insert(key),
+                    map.insert(key, ()).is_some(),
+                    "capacity {capacity}, step {step}, key {key}"
+                );
+            }
+            assert_eq!(set.len + usize::from(set.has_zero), map.len());
