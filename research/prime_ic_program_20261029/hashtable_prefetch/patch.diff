+    #[test]
+    fn guard_set_answers_as_the_std_map() {
+        let mut rng = StdRng::seed_from_u64(20261029);
+        for capacity in [0usize, 1, 7, 1 << 12] {
+            let mut map: FastMap<()> = fast_map(capacity);
+            let mut set = GuardSet::with_capacity(capacity);
+            for step in 0..200_000u64 {
+                // Small keys repeat often; zero is among them.
+                let key = if step % 3 == 0 {
+                    rng.gen_range(0..4096u64)
