+// ── Line tables: open addressing with exposed slots ────────────────
+//
+// Lead ICP-prime-ic-constant-engineering, hash-table floor.  The guard
+// and the batched pair table are std hash maps, whose slot addresses are
+// private, so the lane round can only "touch" them with full demand
+// lookups.  A line table puts each key's home in one 64-byte line of
+// eight words, scanned in order and spilling to the next line only when
+// full; the home line is a pure function of the key, so the round can
+// issue a software prefetch for it and do nothing else.  No deletions
+// ever happen, so a lookup may stop at the first empty word.
+
+/// Eight words, one cache line.  Word `0` is an empty slot.
+#[derive(Clone, Copy, Default)]
+#[repr(C, align(64))]
+struct Line([u64; 8]);
+
+/// Lines a table needs so that `keys` entries fill it at most 3/4.
+fn lines_for(keys: usize) -> usize {
+    (keys.saturating_mul(4) / 3 / 8 + 1).next_power_of_two()
+}
+
+/// Bring the line at `lines[index]` towards L1.  A hint only: it reads,
+/// writes and decides nothing.  Off x86-64 it falls back to the demand
+/// read the old touch made, so other targets keep the overlapped load.
+#[inline(always)]
+#[allow(unused_unsafe)]
+fn prefetch_line(lines: &[Line], index: usize) {
+    #[cfg(target_arch = "x86_64")]
+    {
+        use core::arch::x86_64::{_mm_prefetch, _MM_HINT_T0};
+        let p = lines.as_ptr().wrapping_add(index).cast::<i8>();
+        // SAFETY: `prefetcht0` has no architectural effect and never
+        // faults, whatever the address; SSE is in the x86-64 baseline.
+        unsafe { _mm_prefetch::<_MM_HINT_T0>(p) };
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    {
+        std::hint::black_box(lines[index].0[0]);
+    }
+}
+
+/// **The relation guard as a line table of point keys.**  `insert`
+/// answers exactly what `FastMap::insert(key, ()).is_some()` answers;
+/// the key `0` (the identity's, never a guarded target in practice) is
+/// kept in a flag so that `0` can mark an empty word.
+struct GuardSet {
+    lines: Vec<Line>,
+    mask: usize,
+    len: usize,
+    has_zero: bool,
+}
+
+impl GuardSet {
+    fn with_capacity(keys: usize) -> Self {
+        let n = lines_for(keys);
+        Self {
+            lines: vec![Line::default(); n],
+            mask: n - 1,
+            len: 0,
+            has_zero: false,
+        }
+    }
+
+    /// The home line: high bits of a multiplier other than [`mix`]'s
+    /// (the walk's jump index reads `mix`), so the two stay unrelated.
+    #[inline]
+    fn home(&self, key: u64) -> usize {
+        (key.wrapping_mul(0xC2B2_AE3D_27D4_EB4F) >> 32) as usize & self.mask
+    }
+
+    #[inline]
+    fn prefetch(&self, key: u64) {
+        prefetch_line(&self.lines, self.home(key));
+    }
+
+    /// Insert `key`; `true` when it was already present.
+    #[inline]
+    fn insert(&mut self, key: u64) -> bool {
+        if key == 0 {
+            return std::mem::replace(&mut self.has_zero, true);
+        }
+        let mut l = self.home(key);
+        loop {
+            let line = &mut self.lines[l].0;
+            if let Some(w) = line.iter_mut().find(|w| **w == key || **w == 0) {
+                if *w == key {
+                    return true;
+                }
+                *w = key;
+                break;
+            }
+            l = (l + 1) & self.mask;
+        }
+        self.len += 1;
+        if self.len * 4 > self.lines.len() * 8 * 3 {
+            self.grow();
+        }
+        false
+    }
+
+    /// Double the lines and re-place every key.  Membership is all the
+    /// set answers, so the new placement changes no answer.
+    fn grow(&mut self) {
+        let n = self.lines.len() * 2;
+        let old = std::mem::replace(&mut self.lines, vec![Line::default(); n]);
+        self.mask = n - 1;
+        for line in &old {
+            for &w in line.0.iter().filter(|w| **w != 0) {
+                let mut l = self.home(w);
+                'place: loop {
+                    for s in self.lines[l].0.iter_mut() {
+                        if *s == 0 {
+                            *s = w;
+                            break 'place;
+                        }
+                    }
+                    l = (l + 1) & self.mask;
+                }
+            }
+        }
+    }
+}
+
+/// The relation loop's guard: the std map every recorded run used, or
+/// the line table (`layout=lines`).  Both answer the same membership.
+enum Guard {
+    Map(FastMap<()>),
+    Lines(GuardSet),
+}
+
+impl Guard {
+    fn new(lines: bool, capacity: usize) -> Self {
+        if lines {
+            Guard::Lines(GuardSet::with_capacity(capacity))
+        } else {
+            Guard::Map(fast_map(capacity))
+        }
+    }
+
+    /// `true` when `key` was already present.
+    #[inline]
+    fn insert(&mut self, key: u64) -> bool {
+        match self {
+            Guard::Map(m) => m.insert(key, ()).is_some(),
+            Guard::Lines(s) => s.insert(key),
+        }
+    }
+
+    /// Uncounted: the map's demand read, or the line table's prefetch.
+    #[inline]
+    fn touch(&self, key: u64) {
+        match self {
+            Guard::Map(m) => {
+                std::hint::black_box(m.contains_key(&key));
+            }
+            Guard::Lines(s) => s.prefetch(key),
+        }
+    }
+}
+
+/// **The batched pair table as a line table of [`PackedPairTable`]
+/// words** (key `x + 1 < 2^32` high, witness `(i, j)` in 16 bits each
+/// low), for `p < 2^32` and at most `2^16` base points.  Filled in the
+/// builder's emission order with insert-if-absent, so every key keeps
+/// the first pair that reached it, as `entry(key).or_insert(..)` does.
+struct FlatPairIndex {
+    lines: Vec<Line>,
+    mask: usize,
+    len: usize,
+    slots: usize,
+}
+
+impl FlatPairIndex {
+    /// Sized once for at most `entries` keys (the builders' `|F_x|² + 1`
+    /// bound), at most 3/4 full, so it never grows.
+    fn with_capacity(entries: usize) -> Self {
+        let n = lines_for(entries);
+        Self {
+            lines: vec![Line::default(); n],
+            mask: n - 1,
+            len: 0,
+            slots: 8 * n,
+        }
+    }
+
+    #[inline]
+    fn home(&self, key: u64) -> usize {
+        (key.wrapping_mul(0x9FB2_1C65_1E98_DF25) >> 32) as usize & self.mask
+    }
+
+    #[inline]
+    fn prefetch(&self, key: u64) {
+        prefetch_line(&self.lines, self.home(key));
+    }
+
+    /// `true` when `key` was new and now holds `(i, j)`.
+    fn insert_if_absent(&mut self, key: u64, i: u32, j: u32) -> bool {
+        debug_assert!(key != 0 && key <= u64::from(u32::MAX) && i < 1 << 16 && j < 1 << 16);
+        assert!(self.len < self.slots, "flat pair index sized too small");
+        let word = key << 32 | u64::from(i) << 16 | u64::from(j);
+        let mut l = self.home(key);
+        loop {
+            for s in self.lines[l].0.iter_mut() {
+                if *s == 0 {
+                    *s = word;
+                    self.len += 1;
+                    return true;
+                }
+                if *s >> 32 == key {
+                    return false;
+                }
+            }
+            l = (l + 1) & self.mask;
+        }
+    }
+
+    #[inline]
+    fn get(&self, key: u64) -> Option<(u32, u32)> {
+        if key == 0 || key > u64::from(u32::MAX) {
+            return None;
+        }
+        let mut l = self.home(key);
+        loop {
+            for &s in &self.lines[l].0 {
+                if s == 0 {
+                    return None;
+                }
+                if s >> 32 == key {
+                    return Some((((s >> 16) & 0xffff) as u32, (s & 0xffff) as u32));
+                }
+            }
+            l = (l + 1) & self.mask;
+        }
+    }
+}
