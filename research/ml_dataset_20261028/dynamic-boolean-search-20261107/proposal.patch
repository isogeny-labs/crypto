  #[test]fn both_children_execute_with_conditional_refutation(){let g=vec![vec![vec![],vec![0]],vec![vec![],vec![1],vec![2]]];let a=solve(3,&g,limits(),Instant::now()+Duration::from_secs(5),&mut Ledger::default());check(&g,&a);assert_eq!(a.result,Ok(()));assert_eq!(a.verdict,Verdict::Witness);let f=a.nodes[0].children[0].unwrap();let t=a.nodes[0].children[1].unwrap();assert_eq!(a.nodes[f].status,NodeStatus::Refuted);assert!(a.nodes[t].native.is_some());let r=&a.nodes[f].native.as_ref().unwrap().basis[a.nodes[f].refutation_row.unwrap()];assert!(r.proof.iter().any(|p|matches!(a.nodes[f].origins[p.generator],Origin::Branch{value:false,..})));}
  #[test]fn deadline_and_small_global_work_budget_stop_without_reset(){let g=vec![vec![vec![],vec![0],vec![1]]];let a=solve(2,&g,limits(),Instant::now(),&mut Ledger::default());assert_eq!(a.result,Err(Failure::Deadline));for cap in [0,1,10,100,1000]{let mut l=limits();l.native.work=cap;let mut o=Ledger::default();let a=solve(2,&g,l,Instant::now()+Duration::from_secs(5),&mut o);check(&g,&a);assert_eq!(a.verdict,Verdict::Unknown);assert!(a.charge.work<=cap);assert_eq!(a.charge.work,o.work);}}
 
