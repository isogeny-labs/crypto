{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyDatasetCampaignPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::setec-astronomy-artifacts",
      "Condition": {"StringLike": {"s3:prefix": ["ml-dataset/20261028/*", "ml-dataset-lab/runs/ml-dataset-*-20261028/*"]}}
    },
    {
      "Sid": "ReadWriteDatasetCampaignObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::setec-astronomy-artifacts/ml-dataset/20261028/*", "arn:aws:s3:::setec-astronomy-artifacts/ml-dataset-lab/runs/ml-dataset-*-20261028/*"]
    }
  ]
}
