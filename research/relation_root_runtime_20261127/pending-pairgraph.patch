+/// Equivalent native basis obligations; both variants require independent wire replay.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeCertification {
+    Exhaustive,
+    PairGraph,
+}
+fn certify_native(
+    kind: NativeCertification,
+    input: &[Poly],
+    basis: &[Poly],
+    p: u64,
+    stats: &mut TraceStats,
+) -> bool {
+    let opts = F4Options::new(Ordering::Grevlex, 8);
+    match kind {
+        NativeCertification::Exhaustive => super::reuse::certify(input, basis, p, &opts, stats),
+        NativeCertification::PairGraph => {
+            super::reuse::certify_pair_graph(input, basis, p, &opts, stats)
+        }
+    }
+}
+
