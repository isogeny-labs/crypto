digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.15", nodesep="0.3", ranksep="0.35"];
  node [shape=box, style="rounded,filled", fillcolor="#eaf1f5", color="#45667b", fontname="DejaVu Sans", fontsize=12, margin="0.12,0.08"];
  edge [color="#45667b", arrowsize=0.65];
  input [label="Public Spec, R, Q\n5 unknown coefficients"];
  norm [label="Monic sextic S\nFp[X] / S"];
  member [label="Trace and fast\nmembership recurrence"];
  equations [label="Quadratic gate equations\nall outputs and guards"];
  guards [label="beta S(-A/2) = 1\neta Res(S,J_A) = 1", fillcolor="#fff3dc", color="#a87a27"];
  replay [label="Separate known-input control\nprojection + original indexed replay", fillcolor="#e7f3ed", color="#3d7d62"];
  solver [label="Unknown-coefficient solver\nOPEN", style="rounded,dashed", color="#8a6270"];
  input -> norm -> member -> equations;
  norm -> guards -> member;
  equations -> replay;
  solver -> equations [style=dashed, label="future roots", fontname="DejaVu Sans", fontsize=10];
}
