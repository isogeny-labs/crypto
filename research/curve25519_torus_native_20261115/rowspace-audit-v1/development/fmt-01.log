+fn weighted(
+    original: &[Polynomial],
+    weights: &[(usize, String)],
+    source: usize,
+    p: &BigUint,
+    m: &mut Meter,
+    l: &Limits,
+) -> Result<Polynomial> {
+    let mut out = Polynomial::new();
+    let mut previous = None;
+    let mut diagonal = false;
+    for (i, c) in weights {
+        m.event(1, l)?;
+        if *i > source || previous.is_some_and(|old| old >= *i) {
+            return Err("Invalid: origin order/triangle".into());
