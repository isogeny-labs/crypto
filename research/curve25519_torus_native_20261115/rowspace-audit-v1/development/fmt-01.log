+fn subtract<K: Ord + Clone>(
+    a: &mut BTreeMap<K, BigUint>,
+    b: &BTreeMap<K, BigUint>,
+    c: &BigUint,
+    p: &BigUint,
+    m: &mut Meter,
+    l: &Limits,
+) -> Result<()> {
+    for (key, value) in b {
+        m.event(3, l)?;
+        m.write(1, l)?;
+        let product = (c * value) % p;
+        let current = a.get(key).cloned().unwrap_or_default();
+        let next = (current + p - product) % p;
+        if next.is_zero() {
+            a.remove(key);
+        } else {
+            a.insert(key.clone(), next);
+        }
     }
     Ok(())
 }
