+    pub fn recover_target(
+        &self,
+        coordinate: usize,
+        group: &Curve25519Wide,
+        target: WidePoint,
+        ops: &mut GroupOps,
+    ) -> Option<BigUint> {
+        if !group.on_curve(target) {
+            return None;
+        }
+        let scalar = self.solve_coordinate(coordinate)?;
+        (group.mul_biguint(ops, group.generator, &scalar) == target).then_some(scalar)
+    }
