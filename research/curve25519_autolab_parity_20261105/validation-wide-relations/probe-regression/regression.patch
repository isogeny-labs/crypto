+#[test]
+fn reproduce_probe_hit() {
+ let curve=Curve25519Wide::new(); let mut ops=GroupOps::default();
+ let mut base=HashMap::new(); let mut point=curve.generator;
+ for i in 1..=64 {base.insert(point.unwrap().0,i);point=curve.add(&mut ops,point,curve.generator);}
+ let q=curve.neg(curve.mul_u64(&mut ops,curve.generator,67));
+ let mut p=q; let mut expected=(0,8);
+ for t in 0..8 {if p.is_some_and(|p|base.contains_key(&p.0)){expected=(1,t);break;}p=curve.add(&mut ops,p,curve.generator);}
+ let actual=probe_hits_fast(&curve,q,&base,8,&mut GroupOps::default());
+ println!("affine={expected:?} fast={actual:?}"); assert_eq!(expected,(1,3));assert_eq!(actual,expected);
