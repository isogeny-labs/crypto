+#[test]
+fn projective_probe_handles_identity_and_batch_edges() {
+ let curve=Curve25519Wide::new(); let mut setup=GroupOps::default();
+ let mut base=HashMap::new();base.insert(curve.mul_u64(&mut setup,curve.generator,5).unwrap().0,0);
+ let mut failures=0;
+ for (offset,trials,base_scalar) in [(0i64,8u64,5u64),(-1,8,5),(-2,8,5),(-8,16,5),(-4105,4110,5),(-4103,4100,5),(-4103,4098,5),(1,8,5),(2,8,5),(3,8,5),(-4,10,5),(-4099,9100,5000),(-4098,9100,5000),(-4097,9100,5000),(0,0,5),(-1,0,5),(-2,1,5),(-4,3,5)] {
+  base.clear();base.insert(curve.mul_u64(&mut setup,curve.generator,base_scalar).unwrap().0,0);
+  let q=curve.mul_u64(&mut setup,curve.generator,offset.unsigned_abs());let q=if offset<0 {curve.neg(q)} else {q};
+  let mut p=q;let mut expected=(0,trials);let mut affine=GroupOps::default();
+  for t in 0..trials {if p.is_some_and(|p|base.contains_key(&p.0)){expected=(1,t);break;}p=curve.add(&mut affine,p,curve.generator);}
+  let mut fast=GroupOps::default();let actual=probe_hits_fast(&curve,q,&base,trials,&mut fast);
+  println!("offset={offset} trials={trials} base_scalar={base_scalar} affine={expected:?} fast={actual:?} affine_ops={affine:?} fast_ops={fast:?}");
+  if actual!=expected || fast!=affine {failures+=1;}
+ }
+ assert_eq!(failures,0);
+}
