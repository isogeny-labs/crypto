# Raw combined correctness replay is preserved as one archive; retain named receipts.
/evidence/e2e-v1/*
!/evidence/e2e-v1/COMPLETE.txt
!/evidence/e2e-v1/MANIFEST.sha256
/evidence/e2e-v2/*
!/evidence/e2e-v2/COMPLETE.txt
!/evidence/e2e-v2/MANIFEST.sha256
/evidence/geometry-e2e-v1/*
!/evidence/geometry-e2e-v1/COMPLETE.txt
!/evidence/geometry-e2e-v1/MANIFEST.sha256
