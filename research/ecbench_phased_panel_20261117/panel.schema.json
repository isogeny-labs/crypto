{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/isogeny-labs/crypto/research/ecbench_phased_panel_20261117/panel.schema.json",
  "title": "ECBench phased curve panel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "size_metric",
    "source_snapshot",
    "gate_defaults",
    "lane_definitions",
    "transfer_routes",
    "phases"
  ],
  "properties": {
    "schema": {"const": "ecbench.phased-panel/v2"},
    "status": {"const": "planned_unmeasured"},
    "size_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definition", "field_size_is_separate"],
      "properties": {
        "name": {"const": "subgroup_bits"},
        "definition": {"const": "ceil(log2(r))"},
        "field_size_is_separate": {"const": true}
      }
    },
    "source_snapshot": {
      "type": "object",
      "required": ["crypto_commit", "ecc_challenges_commit", "ecc_challenges_instances_blob"],
      "properties": {
        "crypto_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ecc_challenges_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ecc_challenges_instances_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "gate_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familywise_alpha",
        "minimum_terminal_episodes",
        "minimum_full_rank_success_probability",
        "maximum_yield_shortfall_factor",
        "next_phase_resource_headroom_factor",
        "targets_per_curve_below_64_bits",
        "targets_per_curve_at_or_above_64_bits"
      ],
      "properties": {
        "familywise_alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "minimum_terminal_episodes": {"type": "integer", "minimum": 1},
        "minimum_full_rank_success_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_yield_shortfall_factor": {"type": "number", "minimum": 1},
        "next_phase_resource_headroom_factor": {"type": "number", "minimum": 1},
        "targets_per_curve_below_64_bits": {"type": "integer", "minimum": 1},
        "targets_per_curve_at_or_above_64_bits": {"type": "integer", "minimum": 1}
      }
    },
    "lane_definitions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/lane_definition"}
    },
    "transfer_routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/transfer_route"}
    },
    "phases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "lane_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "object_kind",
        "algorithm_track",
        "curve_selector",
        "promotion_scope",
        "required_obligations"
      ],
      "properties": {
        "lane_id": {
          "enum": [
            "elliptic_algebraic",
            "elliptic_generic_decomposition",
            "hyperelliptic_jacobian",
            "cover_transfer"
          ]
        },
        "object_kind": {
          "enum": ["elliptic_subgroup", "jacobian_subgroup", "typed_transfer_route"]
        },
        "algorithm_track": {
          "enum": [
            "algebraic_decomposition",
            "generic_decomposition",
            "higher_genus_index_calculus",
            "cover_transfer"
          ]
        },
        "curve_selector": {
          "enum": [
            "source_panel_cells",
            "registered_destination_cells",
            "registered_transfer_routes"
          ]
        },
        "promotion_scope": {"const": "independent"},
        "required_obligations": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "transfer_route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "phase",
        "source_cell",
        "destination",
        "map_degree",
        "construction",
        "map",
        "subgroup_condition",
        "source_reference",
        "destination_methods",
        "destination_controls",
        "cost_adapter",
        "assessment"
      ],
      "properties": {
        "route_id": {"type": "string", "pattern": "^P[1-4]-[A-Z0-9-]+$"},
        "phase": {"type": "integer", "minimum": 1, "maximum": 4},
        "source_cell": {"type": "string", "pattern": "^P[1-4]-[A-Z0-9-]+$"},
        "destination": {"type": "string", "minLength": 1},
        "map_degree": {"type": "integer", "minimum": 2},
        "construction": {"type": "string", "minLength": 1},
        "map": {"type": "string", "minLength": 1},
        "subgroup_condition": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "destination_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "destination_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cost_adapter": {"type": "string", "minLength": 1},
        "assessment": {"type": "string", "minLength": 1}
      }
    },
    "phase_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "mandatory", "admission_state", "blockers"],
      "properties": {
        "lane_id": {
          "enum": [
            "elliptic_algebraic",
            "elliptic_generic_decomposition",
            "hyperelliptic_jacobian",
            "cover_transfer"
          ]
        },
        "mandatory": {"const": true},
        "admission_state": {
          "enum": ["ready_to_preregister", "partially_blocked", "blocked"]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"admission_state": {"const": "ready_to_preregister"}}},
          "then": {"properties": {"blockers": {"maxItems": 0}}},
          "else": {"properties": {"blockers": {"minItems": 1}}}
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "nominal_subgroup_bits",
        "subgroup_bit_window",
        "objective",
        "minimum_public_targets_per_curve",
        "admission_state",
        "lanes",
        "destination_cells",
        "curves"
      ],
      "properties": {
        "phase": {"type": "integer", "minimum": 1, "maximum": 4},
        "nominal_subgroup_bits": {"enum": [20, 30, 60, 80]},
        "subgroup_bit_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          }
        },
        "objective": {"type": "string", "minLength": 1},
        "minimum_public_targets_per_curve": {"type": "integer", "minimum": 1},
        "admission_state": {
          "enum": ["ready_to_preregister", "partially_blocked", "blocked"]
        },
        "lanes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/phase_lane"}
        },
        "destination_cells": {
          "type": "array",
          "items": {"$ref": "#/$defs/curve"}
        },
        "curves": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/curve"}
        }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "family",
        "role",
        "mandatory",
        "identity",
        "size",
        "cofactor",
        "traits",
        "evidence_status",
        "ecbench"
      ],
      "properties": {
        "cell_id": {"type": "string", "pattern": "^P[1-4]-[A-Z0-9-]+$"},
        "family": {"enum": ["koblitz", "binary", "prime", "genus2"]},
        "role": {"enum": ["core", "sentinel", "external_anchor"]},
        "mandatory": {"type": "boolean"},
        "identity": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {"enum": ["registered", "pending_local_import", "locally_pinned"]},
            "icv1": {"type": ["string", "null"]},
            "ec1": {"type": ["string", "null"]},
            "curve_uid": {"type": ["string", "null"]},
            "external_name": {"type": ["string", "null"]},
            "source_blob": {"type": ["string", "null"]},
            "external_parameters": {"type": ["object", "null"]}
          }
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subgroup_order", "subgroup_bits", "field_bits_or_degree"],
          "properties": {
            "subgroup_order": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "subgroup_bits": {"type": "integer", "minimum": 1},
            "field_bits_or_degree": {"type": "integer", "minimum": 1}
          }
        },
        "cofactor": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "traits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order", "subgroup"],
          "properties": {
            "order": {"enum": ["proved", "external_primary_source"]},
            "subgroup": {"enum": ["proved", "external_primary_source"]}
          }
        },
        "ecbench": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "curve_spec", "required_reference"],
          "properties": {
            "status": {
              "enum": [
                "runnable_narrow",
                "reference_only_wide",
                "blocked_pending_registry_and_wide_backend"
              ]
            },
            "curve_spec": {"type": ["object", "null"]},
            "required_reference": {"type": "string", "minLength": 1},
            "required_candidates": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
