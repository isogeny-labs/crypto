digraph Work {
  graph [bgcolor=white, margin=0.1];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  chart [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="6" CELLPADDING="4">
      <TR><TD COLSPAN="3"><B>Visited functional assignments: one four-bit regression fixture</B></TD></TR>
      <TR><TD ALIGN="LEFT">Prefix counts</TD><TD>
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR>
          <TD WIDTH="403" HEIGHT="28" FIXEDSIZE="TRUE" BGCOLOR="#446b8b"></TD>
          <TD WIDTH="13" HEIGHT="28" FIXEDSIZE="TRUE"></TD>
        </TR></TABLE></TD><TD ALIGN="LEFT">31</TD></TR>
      <TR><TD ALIGN="LEFT">Ordered search</TD><TD>
        <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR>
          <TD WIDTH="13" HEIGHT="28" FIXEDSIZE="TRUE" BGCOLOR="#20786d"></TD>
          <TD WIDTH="403" HEIGHT="28" FIXEDSIZE="TRUE"></TD>
        </TR></TABLE></TD><TD ALIGN="LEFT">1</TD></TR>
      <TR><TD COLSPAN="3">N=1 per method; identical selected word. Deterministic diagnostic counts.</TD></TR>
      <TR><TD COLSPAN="3">No runtime, calibration, uncertainty interval or cryptographic-size claim.</TD></TR>
    </TABLE>
  >];
}
