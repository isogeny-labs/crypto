K<w> := GF(512);
k<a> := GF(8);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..8]]>;
b := fromint(155);
gamma := fromint(392);
beta := fromint(295);
assert gamma*beta eq Sqrt(b);
assert gamma+gamma^8+gamma^64 eq 0;
assert beta+beta^8+beta^64 eq 0;
E := EllipticCurve([K|1,0,0,0,b]);
assert #E eq 548;
G := E![fromint(478),fromint(460),1];
Q := E![fromint(328),fromint(58),1];
assert Order(G) eq 137 and Q eq 7*G;
print "source_b", b;
print "source_order", #E;
print "source_generator", G;
print "source_target", Q;
print "factor_gamma", gamma;
print "factor_beta", beta;
print "hess_genus", WeilDescentGenus(E,k,gamma);
C,h := WeilDescent(E,k,gamma : HyperellipticImage := false);
assert Genus(C) eq 3;
dO := h(E!0);
D := h(G)-dO;
T := h(Q)-dO;
assert Degree(D) eq 0 and Degree(T) eq 0;
is0 := IsPrincipal(D);
is137 := IsPrincipal(137*D);
is7 := IsPrincipal(T-7*D);
isQ0 := IsPrincipal(T);
print "map_generator_nonzero", not is0;
print "map_generator_137_zero", is137;
print "map_target_equals_7G", is7;
print "map_target_nonzero", not isQ0;
phi := CanonicalMap(C);
Qcanon,hyp := CanonicalImage(C,phi);
print "canonical_hyperelliptic", hyp;
print "canonical_model", Qcanon;
print "canonical_smooth", IsNonsingular(Qcanon);
print "canonical_genus", Genus(Qcanon);
print "points_q", #RationalPoints(Qcanon);
print "points_q2", #RationalPoints(BaseChange(Qcanon,2));
print "points_q3", #RationalPoints(BaseChange(Qcanon,3));
