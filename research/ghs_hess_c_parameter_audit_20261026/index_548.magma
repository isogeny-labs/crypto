K<w> := GF(512);
k<a> := GF(8);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..8]]>;
E := EllipticCurve([K|1,0,0,0,fromint(155)]);
G := E![fromint(478),fromint(460),1];
Q := E![fromint(328),fromint(58),1];
assert #E eq 548 and Order(G) eq 137 and Q eq 7*G;
t0 := Cputime();
C,h := WeilDescent(E,k,fromint(392) : HyperellipticImage := false);
print "model_degree", Degree(C), "genus", Genus(C), "setup_cpu", Cputime(t0);
t1 := Cputime();
dO := h(E!0);
D := h(G)-dO;
T := h(Q)-dO;
print "map_cpu", Cputime(t1);
assert not IsPrincipal(D) and IsPrincipal(137*D) and IsPrincipal(T-7*D);
print "rational_points", #RationalPoints(C);
smooth_pts := [p : p in RationalPoints(C) | IsNonsingular(C,p)];
assert #smooth_pts gt 0;
D0 := Divisor(smooth_pts[1]);
print "base_degree", Degree(D0);
SetVerbose("CurveIndexcal",1);
t2 := Cputime();
x := IndexCalculus(D,T,D0,137);
print "index_answer", x, "index_cpu", Cputime(t2);
assert x*G eq Q;
print "verified", x*G eq Q, "total_cpu", Cputime(t0);
