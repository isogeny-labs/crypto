K<w> := GF(512);
k<a> := GF(8);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..8]]>;
b := fromint(32);
gamma := fromint(218);
beta := fromint(439);
assert gamma*beta eq Sqrt(b);
assert gamma + gamma^8 + gamma^64 eq 0;
assert beta + beta^8 + beta^64 eq 0;
E := EllipticCurve([K|1,0,0,0,b]);
assert #E eq 556;
print "source_order", #E;
print "source_b", b;
print "gamma", gamma;
print "beta", beta;
print "trace_factors_zero", true;
print "hess_genus", WeilDescentGenus(E,k,gamma);
print "hess_degree", WeilDescentDegree(E,k,gamma);
C,h := WeilDescent(E,k,gamma : HyperellipticImage := false);
print "curve", C;
print "curve_genus", Genus(C);
print "curve_smooth", IsNonsingular(C);
print "map_domain", Domain(h);
print "map_codomain", Codomain(h);
