K<w> := GF(512);
k<a> := GF(8);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..8]]>;
b := fromint(32);
gamma := fromint(218);
E := EllipticCurve([K|1,0,0,0,b]);
assert #E eq 556;
G := E![fromint(255),fromint(59),1];
Q := E![fromint(206),fromint(467),1];
assert Order(G) eq 139 and Q eq 7*G;
print "source_generator", G;
print "source_target", Q;
print "source_prime", Order(G);
C,h := WeilDescent(E,k,gamma : HyperellipticImage := false);
assert Genus(C) eq 3;
print "cover", C;
print "cover_genus", Genus(C);
dO := h(E!0);
dG := h(G);
dQ := h(Q);
print "map_type", Type(dG);
print "mapped_origin_degree", Degree(dO);
print "mapped_generator_degree", Degree(dG);
print "mapped_target_degree", Degree(dQ);
D := dG-dO;
T := dQ-dO;
print "generator_difference_degree", Degree(D);
print "target_difference_degree", Degree(T);
print "generator_difference", D;
print "target_difference", T;
