K<w> := GF(512);
k<a> := GF(8);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..8]]>;
E := EllipticCurve([K|1,0,0,0,fromint(32)]);
G := E![fromint(255),fromint(59),1];
Q := E![fromint(206),fromint(467),1];
assert #E eq 556 and Order(G) eq 139 and Q eq 7*G;
C,h := WeilDescent(E,k,fromint(218) : HyperellipticImage := false);
dO := h(E!0);
D := h(G)-dO;
T := h(Q)-dO;
phi := CanonicalMap(C);
Qcanon,hyp := CanonicalImage(C,phi);
assert not hyp and IsNonsingular(Qcanon);
print "canonical", Qcanon;
psi := Restriction(phi,C,Qcanon);
print "restricted", true;
DD := Pushforward(psi,D);
TT := Pushforward(psi,T);
print "degrees", Degree(DD), Degree(TT);
b0 := IsPrincipal(DD);
b139 := IsPrincipal(139*DD);
b7 := IsPrincipal(TT-7*DD);
print "orders", b0, b139, b7;
print "D_support_degrees", [<Degree(t[1]),t[2]> : t in Decomposition(DD)];
print "T_support_degrees", [<Degree(t[1]),t[2]> : t in Decomposition(TT)];
for t in Decomposition(DD) do
    p := RepresentativePoint(t[1]);
    print "D_representative", Degree(t[1]), Coordinates(p), t[2];
    if Degree(t[1]) eq 3 then print "D_minpoly", MinimalPolynomial(p[1],k); end if;
end for;
for t in Decomposition(TT) do
    p := RepresentativePoint(t[1]);
    print "T_representative", Degree(t[1]), Coordinates(p), t[2];
    if Degree(t[1]) eq 3 then print "T_minpoly", MinimalPolynomial(p[1],k); end if;
end for;
