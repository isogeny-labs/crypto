import JKSSTCyclicECDLP
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point

/-!
# Prime-order ECDLP bridge on actual Mathlib elliptic-curve points

This specializes the generic cyclic-group bridge to Mathlib's bundled affine
elliptic-curve point group over `ZMod p`.  It closes the finite-curve group
modeling step.  It does not construct a reduction homomorphism from rational
points on a lift to these finite-field points.
-/

open scoped BigOperators

namespace JKSSTEllipticCyclic

section

variable {p q : ℕ} [Fact p.Prime] [Fact q.Prime]
  {W : WeierstrassCurve.Affine (ZMod p)}
  {P : W.Point} (order_eq : addOrderOf P = q)

/-- The actual elliptic-curve subgroup generated by `P` is an injective copy
of the prime field `ZMod q`. -/
noncomputable def pointScalarMap : ZMod q →+ W.Point :=
  JKSSTCyclicECDLP.orderScalarMap q P order_eq

theorem pointScalarMap_injective :
    Function.Injective (pointScalarMap order_eq) :=
  JKSSTCyclicECDLP.orderScalarMap_injective q P order_eq

/-- Exact ECDLP extraction on the actual finite-field elliptic-curve point
group, conditional only on the displayed relation and nonzero denominator. -/
theorem extract_log_on_curve
    {ι : Type*} [Fintype ι]
    (w : ZMod q) (s t : ι → ZMod q) (m : ι → ℤ)
    (group_relation :
      ∑ i, m i •
        JKSSTCyclicECDLP.encodedSample q P order_eq w (s i) (t i) = 0)
    (useful : ∑ i, (m i : ZMod q) * t i ≠ 0) :
    w = (∑ i, (m i : ZMod q) * s i) /
      (∑ i, (m i : ZMod q) * t i) :=
  JKSSTCyclicECDLP.extract_log_of_group_relation
    q P order_eq w s t m group_relation useful

end

end JKSSTEllipticCyclic
