digraph protocol_gates {
  graph [bgcolor="white", rankdir=LR, nodesep=0.45, ranksep=0.7,
         fontname="DejaVu Sans", label="Arity-three protocol hardening gates",
         labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10,
        color="#46657b", fillcolor="#eef5f8", margin="0.12,0.08"];
  edge [color="#46657b", fontname="DejaVu Sans", fontsize=9];

  semantic [label="Signed point predicate\ndisjoint x windows + lift sign"];
  oracle [label="Development oracle\nPASS at small field", fillcolor="#dff3e4", color="#2c7a4b"];
  theory [label="Production CDCL(T)/Fp\nOPEN", fillcolor="#fff2d8", color="#a16b00"];
  natural [label="Complete natural panel\nno censoring", fillcolor="#fff2d8", color="#a16b00"];
  decision [label="Advance only if\ne < 0.5 and a < 1.5", fillcolor="#f3e7f7", color="#76428a"];

  setup [label="Reusable setup\nS(s)=2^(a s)"];
  online [label="2^s natural queries\nQ(s)=2^(e s)"];
  cold [label="Cold collection\n2^(a s)+2^((e+1)s)"];

  qfff [label="QF_FF\nSAT/model diagnostic", fillcolor="#f7e4e4", color="#9a3f3f"];
  continuation [label="One-hot s=27\n805,306,365 vars\nNOT ADMITTED", fillcolor="#f7e4e4", color="#9a3f3f"];

  semantic -> oracle -> theory -> natural -> decision;
  setup -> cold;
  online -> cold;
  cold -> decision;
  qfff -> natural [style=dashed, label="no checked FF UNSAT"];
  continuation -> natural [style=dashed, label="compact amendment first"];
}
