import Common22BranchMaximalIdeal
import Common22BranchParameter
import Common22LocalParameter

/-!
# A principal maximal ideal at a simple affine branch point

The actual localization at a rational simple branch point has maximal ideal
generated by the germ of `y`.  The result uses the checked branch-coordinate
kernel, the checked factorization, and the checked local unit.  A DVR still
requires a domain proof for this affine ring/localization.
-/

set_option autoImplicit false
noncomputable section

namespace Common22BranchLocalParameter

open Common22SeparateChartMap Common22BranchStalk Common22BranchParameter
  Common22BranchMaximalIdeal

variable {K : Type*} [Field K]

private abbrev Stalk (a3 a2 a1 a0 a : K)
    (hroot : fAt a3 a2 a1 a0 a = 0) :=
  Localization.AtPrime (branchIdeal a3 a2 a1 a0 a hroot)

def stalkXSubA (a3 a2 a1 a0 a : K) (hroot : fAt a3 a2 a1 a0 a = 0) :
    Stalk a3 a2 a1 a0 a hroot :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a hroot))
    (xbar a3 a2 a1 a0 - Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0) (MvPolynomial.C a))

def stalkY (a3 a2 a1 a0 a : K) (hroot : fAt a3 a2 a1 a0 a = 0) :
    Stalk a3 a2 a1 a0 a hroot :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a hroot))
    (ybar a3 a2 a1 a0)

def stalkQ (a3 a2 a1 a0 a : K) (hroot : fAt a3 a2 a1 a0 a = 0) :
    Stalk a3 a2 a1 a0 a hroot :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a hroot))
    (qAt a3 a2 a1 a0 a)

theorem maximalIdeal_coordinates (a3 a2 a1 a0 a : K)
    (hroot : fAt a3 a2 a1 a0 a = 0) :
    IsLocalRing.maximalIdeal (Stalk a3 a2 a1 a0 a hroot) =
      Ideal.span {stalkXSubA a3 a2 a1 a0 a hroot,
        stalkY a3 a2 a1 a0 a hroot} := by
  have hmap := IsLocalization.AtPrime.map_eq_maximalIdeal
    (branchIdeal a3 a2 a1 a0 a hroot) (Stalk a3 a2 a1 a0 a hroot)
  let f : AffineRing a3 a2 a1 a0 →+* Stalk a3 a2 a1 a0 a hroot := algebraMap _ _
  calc
    _ = Ideal.map f (branchIdeal a3 a2 a1 a0 a hroot) := hmap.symm
    _ = Ideal.map f (coordinateIdeal a3 a2 a1 a0 a) :=
      congrArg (Ideal.map f) (branchIdeal_eq_coordinateIdeal a3 a2 a1 a0 a hroot)
    _ = Ideal.span {stalkXSubA a3 a2 a1 a0 a hroot,
          stalkY a3 a2 a1 a0 a hroot} := by
      simp [coordinateIdeal, stalkXSubA, stalkY, f, Ideal.map_span]

theorem stalk_relation (a3 a2 a1 a0 a : K)
    (hroot : fAt a3 a2 a1 a0 a = 0) :
    stalkY a3 a2 a1 a0 a hroot ^ 2 =
      stalkXSubA a3 a2 a1 a0 a hroot * stalkQ a3 a2 a1 a0 a hroot := by
  let f : AffineRing a3 a2 a1 a0 →+* Stalk a3 a2 a1 a0 a hroot := algebraMap _ _
  have h := congrArg f (branch_factorization a3 a2 a1 a0 a hroot)
  have hC : (Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0) (MvPolynomial.C a) :
      AffineRing a3 a2 a1 a0) = algebraMap K (AffineRing a3 a2 a1 a0) a := by
    change Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0)
      (algebraMap K (Poly K) a) = _
    rfl
  change f (ybar a3 a2 a1 a0) ^ 2 =
    f (xbar a3 a2 a1 a0 -
      Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0) (MvPolynomial.C a)) *
        f (qAt a3 a2 a1 a0 a)
  rw [hC]
  simpa only [map_pow, map_mul, map_sub] using h

theorem maximalIdeal_eq_span_y (a3 a2 a1 a0 a : K)
    (hroot : fAt a3 a2 a1 a0 a = 0)
    (hsimple : derivativeAt a3 a2 a1 a0 a ≠ 0) :
    IsLocalRing.maximalIdeal (Stalk a3 a2 a1 a0 a hroot) =
      Ideal.span {stalkY a3 a2 a1 a0 a hroot} := by
  let hu := branch_qAt_local_unit a3 a2 a1 a0 a hroot hsimple
  let u : (Stalk a3 a2 a1 a0 a hroot)ˣ := hu.unit
  have hueq : (u : Stalk a3 a2 a1 a0 a hroot) = stalkQ a3 a2 a1 a0 a hroot :=
    hu.unit_spec
  apply Common22LocalParameter.maximalIdeal_eq_span_w
    (stalkXSubA a3 a2 a1 a0 a hroot)
    (stalkY a3 a2 a1 a0 a hroot) u
  · simpa [hueq] using stalk_relation a3 a2 a1 a0 a hroot
  · exact maximalIdeal_coordinates a3 a2 a1 a0 a hroot

#print axioms maximalIdeal_coordinates
#print axioms stalk_relation
#print axioms maximalIdeal_eq_span_y

end Common22BranchLocalParameter
