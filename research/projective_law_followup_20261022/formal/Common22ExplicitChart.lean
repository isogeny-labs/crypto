import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.Ideal.Quotient.Basic
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Submodule
import Mathlib.RingTheory.Ideal.Quotient.Noetherian
import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.Tactic.FinCases
import Common22LocalParameter

/-!
# Explicit algebraic infinity chart

This file constructs the affine coordinate ring of the infinity chart as an
actual polynomial quotient and localizes it at the origin. It does not prove
the quotient is a domain or identify the localization with the projective
curve's infinity stalk.
-/

set_option autoImplicit false

noncomputable section

namespace Common22ExplicitChart

open MvPolynomial

variable {K : Type*} [Field K]

abbrev ChartPoly (K : Type*) [CommRing K] := MvPolynomial (Fin 2) K

def z : ChartPoly K := X 0
def w : ChartPoly K := X 1

def unitFactor (a3 a2 a1 a0 : K) : ChartPoly K :=
  1 + C a3 * z ^ 2 + C a2 * z ^ 3 + C a1 * z ^ 4 + C a0 * z ^ 5

def equation (a3 a2 a1 a0 : K) : ChartPoly K :=
  w ^ 2 - z * unitFactor a3 a2 a1 a0

def relationIdeal (a3 a2 a1 a0 : K) : Ideal (ChartPoly K) :=
  Ideal.span {equation a3 a2 a1 a0}

abbrev ChartRing (a3 a2 a1 a0 : K) :=
  ChartPoly K ⧸ relationIdeal a3 a2 a1 a0

def zbar (a3 a2 a1 a0 : K) : ChartRing a3 a2 a1 a0 :=
  Ideal.Quotient.mk (relationIdeal a3 a2 a1 a0) z

def wbar (a3 a2 a1 a0 : K) : ChartRing a3 a2 a1 a0 :=
  Ideal.Quotient.mk (relationIdeal a3 a2 a1 a0) w

def ubar (a3 a2 a1 a0 : K) : ChartRing a3 a2 a1 a0 :=
  Ideal.Quotient.mk (relationIdeal a3 a2 a1 a0) (unitFactor a3 a2 a1 a0)

/-- The defining chart relation is an equality in the constructed quotient,
without assuming a local ring or a DVR. -/
theorem quotient_chart_relation (a3 a2 a1 a0 : K) :
    wbar a3 a2 a1 a0 ^ 2 =
      zbar a3 a2 a1 a0 * ubar a3 a2 a1 a0 := by
  have hmem : equation a3 a2 a1 a0 ∈ relationIdeal a3 a2 a1 a0 :=
    Ideal.subset_span (by simp)
  have hzero := (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
  simpa [equation, wbar, zbar, ubar] using sub_eq_zero.mp hzero

/-- Evaluation at the chart origin before passing to the equation quotient. -/
def originEval : ChartPoly K →+* K :=
  eval₂Hom (RingHom.id K) (fun _ => 0)

/-- A source polynomial differs from its origin value by an element of the
variable ideal. This is proved by polynomial induction, rather than assumed
as a property of the quotient chart. -/
theorem subtract_origin_value_mem_vars (p : ChartPoly K) :
    p - C (originEval p) ∈ idealOfVars (Fin 2) K := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [originEval]
  | add p q hp hq =>
      have h := Ideal.add_mem (idealOfVars (Fin 2) K) hp hq
      convert h using 1; simp [map_add]; ring
  | mul_X p i hp =>
      have hzero : originEval (p * X i) = 0 := by simp [originEval]
      simpa only [hzero, map_zero, sub_zero] using
        (Ideal.mul_mem_left (idealOfVars (Fin 2) K) p
          (Ideal.subset_span ⟨i, rfl⟩))

theorem origin_equation (a3 a2 a1 a0 : K) :
    originEval (equation a3 a2 a1 a0) = 0 := by
  simp [originEval, equation, unitFactor, z, w]

/-- The chart relation vanishes at the origin, so evaluation descends to the
explicit coordinate ring. -/
def originHom (a3 a2 a1 a0 : K) : ChartRing a3 a2 a1 a0 →+* K :=
  Ideal.Quotient.lift (relationIdeal a3 a2 a1 a0) originEval (by
    intro p hp
    have hle : relationIdeal a3 a2 a1 a0 ≤ RingHom.ker originEval := by
      apply Ideal.span_le.mpr
      intro x hx
      simp only [Set.mem_singleton_iff] at hx
      subst x
      exact origin_equation a3 a2 a1 a0
    exact hle hp)

theorem originHom_surjective (a3 a2 a1 a0 : K) :
    Function.Surjective (originHom a3 a2 a1 a0) := by
  apply Ideal.Quotient.lift_surjective_of_surjective
  intro k
  use C k
  simp [originEval]

/-- The constructed chart has a genuine maximal ideal at the origin. This
does not yet prove that this ideal is generated by the two chart coordinates. -/
theorem origin_ideal_maximal (a3 a2 a1 a0 : K) :
    (RingHom.ker (originHom a3 a2 a1 a0)).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ (originHom_surjective a3 a2 a1 a0)

def originIdeal (a3 a2 a1 a0 : K) : Ideal (ChartRing a3 a2 a1 a0) :=
  RingHom.ker (originHom a3 a2 a1 a0)

def chartCoordinateIdeal (a3 a2 a1 a0 : K) :
    Ideal (ChartRing a3 a2 a1 a0) :=
  Ideal.span {zbar a3 a2 a1 a0, wbar a3 a2 a1 a0}

theorem mapped_variable_ideal (a3 a2 a1 a0 : K) :
    Ideal.map (Ideal.Quotient.mk (relationIdeal a3 a2 a1 a0))
      (idealOfVars (Fin 2) K) = chartCoordinateIdeal a3 a2 a1 a0 := by
  simp only [idealOfVars, Ideal.map_span]
  apply congrArg Ideal.span
  ext x
  constructor
  · rintro ⟨p, ⟨i, rfl⟩, rfl⟩
    fin_cases i <;> simp [zbar, wbar, z, w]
  · intro hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨X 0, ⟨0, rfl⟩, rfl⟩
    · exact ⟨X 1, ⟨1, rfl⟩, rfl⟩

/-- The origin ideal of the actual chart quotient is generated by the two
coordinate classes. This removes the earlier caller-supplied maximal-ideal
hypothesis for the explicit affine chart. -/
theorem originIdeal_eq_chartCoordinateIdeal (a3 a2 a1 a0 : K) :
    originIdeal a3 a2 a1 a0 = chartCoordinateIdeal a3 a2 a1 a0 := by
  apply le_antisymm
  · intro q hq
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hp : originEval p = 0 := by
      have hq' : originHom a3 a2 a1 a0
          (Ideal.Quotient.mk (relationIdeal a3 a2 a1 a0) p) = 0 :=
        (RingHom.mem_ker).mp hq
      exact hq'
    have hvars : p ∈ idealOfVars (Fin 2) K := by
      simpa [hp] using subtract_origin_value_mem_vars p
    rw [← mapped_variable_ideal]
    exact Ideal.mem_map_of_mem _ hvars
  · rw [chartCoordinateIdeal]
    apply Ideal.span_le.mpr
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl
    · simp [originIdeal, RingHom.mem_ker, originHom, zbar, originEval, z]
    · simp [originIdeal, RingHom.mem_ker, originHom, wbar, originEval, w]

instance originIdeal_prime (a3 a2 a1 a0 : K) :
    (originIdeal a3 a2 a1 a0).IsPrime :=
  (origin_ideal_maximal a3 a2 a1 a0).isPrime

/-- An actual local ring, obtained by localizing the explicit chart at the
maximal ideal of the origin. Domain, dimension, DVR, and projective-stalk
identification are separate proof obligations. -/
abbrev OriginStalk (a3 a2 a1 a0 : K) :=
  Localization.AtPrime (originIdeal a3 a2 a1 a0)

def stalkZ (a3 a2 a1 a0 : K) : OriginStalk a3 a2 a1 a0 :=
  algebraMap (ChartRing a3 a2 a1 a0) (OriginStalk a3 a2 a1 a0)
    (zbar a3 a2 a1 a0)

def stalkW (a3 a2 a1 a0 : K) : OriginStalk a3 a2 a1 a0 :=
  algebraMap (ChartRing a3 a2 a1 a0) (OriginStalk a3 a2 a1 a0)
    (wbar a3 a2 a1 a0)

def stalkU (a3 a2 a1 a0 : K) : OriginStalk a3 a2 a1 a0 :=
  algebraMap (ChartRing a3 a2 a1 a0) (OriginStalk a3 a2 a1 a0)
    (ubar a3 a2 a1 a0)

/-- The constructed local chart's maximal ideal is generated by its actual
coordinate germs, rather than by a caller-supplied equation. -/
theorem originStalk_maximalIdeal (a3 a2 a1 a0 : K) :
    IsLocalRing.maximalIdeal (OriginStalk a3 a2 a1 a0) =
      Ideal.span {stalkZ a3 a2 a1 a0, stalkW a3 a2 a1 a0} := by
  have hmap := IsLocalization.AtPrime.map_eq_maximalIdeal
    (originIdeal a3 a2 a1 a0) (OriginStalk a3 a2 a1 a0)
  let f : ChartRing a3 a2 a1 a0 →+* OriginStalk a3 a2 a1 a0 := algebraMap _ _
  calc
    _ = Ideal.map f (originIdeal a3 a2 a1 a0) := hmap.symm
    _ = Ideal.map f (chartCoordinateIdeal a3 a2 a1 a0) :=
      congrArg (Ideal.map f) (originIdeal_eq_chartCoordinateIdeal a3 a2 a1 a0)
    _ = Ideal.span {stalkZ a3 a2 a1 a0, stalkW a3 a2 a1 a0} := by
      simp [chartCoordinateIdeal, stalkZ, stalkW, f, Ideal.map_span]

theorem originStalk_isLocal (a3 a2 a1 a0 : K) :
    IsLocalRing (OriginStalk a3 a2 a1 a0) := inferInstance

theorem originStalk_noetherian (a3 a2 a1 a0 : K) :
    IsNoetherianRing (OriginStalk a3 a2 a1 a0) := inferInstance

theorem originStalk_relation (a3 a2 a1 a0 : K) :
    (algebraMap (ChartRing a3 a2 a1 a0)
      (OriginStalk a3 a2 a1 a0) (wbar a3 a2 a1 a0)) ^ 2 =
    algebraMap (ChartRing a3 a2 a1 a0)
      (OriginStalk a3 a2 a1 a0) (zbar a3 a2 a1 a0) *
    algebraMap (ChartRing a3 a2 a1 a0)
      (OriginStalk a3 a2 a1 a0) (ubar a3 a2 a1 a0) := by
  let f : ChartRing a3 a2 a1 a0 →+* OriginStalk a3 a2 a1 a0 := algebraMap _ _
  have h := congrArg f (quotient_chart_relation a3 a2 a1 a0)
  simpa only [map_pow, map_mul] using h

theorem originHom_ubar (a3 a2 a1 a0 : K) :
    originHom a3 a2 a1 a0 (ubar a3 a2 a1 a0) = 1 := by
  simp [originHom, ubar, originEval, unitFactor, z]

/-- The chart factor is unconditionally a unit in the constructed local
ring at the origin. This replaces the earlier caller-supplied unit hypothesis
for this explicit affine chart. -/
theorem originStalk_ubar_unit (a3 a2 a1 a0 : K) :
    IsUnit (algebraMap (ChartRing a3 a2 a1 a0)
      (OriginStalk a3 a2 a1 a0) (ubar a3 a2 a1 a0)) := by
  apply (IsLocalization.AtPrime.isUnit_to_map_iff
    (OriginStalk a3 a2 a1 a0) (originIdeal a3 a2 a1 a0)
    (ubar a3 a2 a1 a0)).mpr
  simp [Ideal.primeCompl, originIdeal, RingHom.mem_ker, originHom_ubar]

/-- The maximal ideal of the actually constructed local chart is generated
by `w`. This applies the earlier local-algebra lemma after proving both its
coordinate-ideal and unit hypotheses in the explicit quotient/localization. -/
theorem originStalk_maximalIdeal_eq_span_w (a3 a2 a1 a0 : K) :
    IsLocalRing.maximalIdeal (OriginStalk a3 a2 a1 a0) =
      Ideal.span {stalkW a3 a2 a1 a0} := by
  let hu := originStalk_ubar_unit a3 a2 a1 a0
  let u : (OriginStalk a3 a2 a1 a0)ˣ := hu.unit
  have hueq : (u : OriginStalk a3 a2 a1 a0) = stalkU a3 a2 a1 a0 :=
    hu.unit_spec
  apply Common22LocalParameter.maximalIdeal_eq_span_w
    (stalkZ a3 a2 a1 a0) (stalkW a3 a2 a1 a0) u
  · simpa [stalkZ, stalkW, stalkU, hueq] using
      originStalk_relation a3 a2 a1 a0
  · exact originStalk_maximalIdeal a3 a2 a1 a0

end Common22ExplicitChart
end

