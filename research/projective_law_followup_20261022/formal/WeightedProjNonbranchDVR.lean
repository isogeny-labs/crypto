import Common22SeparableAffineDomain
import Common22BranchParameter
import Mathlib.RingTheory.DiscreteValuationRing.TFAE

/-!
# Rational nonbranch point: local parameter and DVR

At a rational point `(a,y)` with `y²=f(a)` and `2*y≠0`, the point ideal
is generated by `x-a,y-y₀`. The curve relation makes `y-y₀` a multiple
of `x-a` after localization. The characteristic restriction is essential:
over `F₂`, `f=X⁵+X³+1` is separable but `(0,1)` is singular.

Stacks Project Tag 00PD is the DVR criterion; Tag 01HD identifies the
weighted-Proj stalk with the affine localization. The branch-point pattern
is `Common22BranchMaximalIdeal` and `Common22BranchDomain`.
-/

set_option autoImplicit false
noncomputable section

namespace WeightedProjNonbranchDVR

open MvPolynomial Common22SeparateChartMap Common22BranchStalk
  WeightedProjNonbranchZeroOrder Common22BranchParameter

variable {K : Type*} [Field K]

private abbrev c (a3 a2 a1 a0 : K) (b : K) :
    AffineRing a3 a2 a1 a0 :=
  algebraMap K (AffineRing a3 a2 a1 a0) b

def sourceIdeal (a y : K) : Ideal (Poly K) :=
  Ideal.span {(X 0 : Poly K) - C a, X 1 - C y}

theorem subtract_pointPreEval_mem (a y : K) (p : Poly K) :
    p - C (pointPreEval a y p) ∈ sourceIdeal a y := by
  induction p using MvPolynomial.induction_on with
  | C b => simp [pointPreEval]
  | add p q hp hq =>
      have h := Ideal.add_mem (sourceIdeal a y) hp hq
      convert h using 1 <;> simp [map_add] <;> ring
  | mul_X p i hp =>
      fin_cases i
      · have hval : pointPreEval a y (p * X 0) = pointPreEval a y p * a := by
          simp [pointPreEval]
        have heq : p * X 0 - C (pointPreEval a y (p * X 0)) =
            p * (X 0 - C a) + C a * (p - C (pointPreEval a y p)) := by
          rw [hval]
          simp only [map_mul]
          ring
        have hgen : X 0 - C a ∈ sourceIdeal a y :=
          Ideal.subset_span (by simp [sourceIdeal])
        have hmem : p * X 0 - C (pointPreEval a y (p * X 0)) ∈
            sourceIdeal a y := by
          rw [heq]
          exact Ideal.add_mem _ (Ideal.mul_mem_left _ p hgen)
            (Ideal.mul_mem_left _ (C a) hp)
        simpa using hmem
      · have hval : pointPreEval a y (p * X 1) = pointPreEval a y p * y := by
          simp [pointPreEval]
        have heq : p * X 1 - C (pointPreEval a y (p * X 1)) =
            p * (X 1 - C y) + C y * (p - C (pointPreEval a y p)) := by
          rw [hval]
          simp only [map_mul]
          ring
        have hgen : X 1 - C y ∈ sourceIdeal a y :=
          Ideal.subset_span (by simp [sourceIdeal])
        have hmem : p * X 1 - C (pointPreEval a y (p * X 1)) ∈
            sourceIdeal a y := by
          rw [heq]
          exact Ideal.add_mem _ (Ideal.mul_mem_left _ p hgen)
            (Ideal.mul_mem_left _ (C y) hp)
        simpa using hmem

private theorem quotient_C (a3 a2 a1 a0 b : K) :
    (Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0) (C b) :
      AffineRing a3 a2 a1 a0) = c a3 a2 a1 a0 b := by
  change Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0)
    (algebraMap K (Poly K) b) = _
  rfl

private theorem pointEval_c (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) (b : K) :
    pointEval a3 a2 a1 a0 a y hcurve (c a3 a2 a1 a0 b) = b := by
  rw [← quotient_C]
  change pointPreEval a y (C b) = b
  simp [pointPreEval]

private theorem pointEval_xbar (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    pointEval a3 a2 a1 a0 a y hcurve (xbar a3 a2 a1 a0) = a := by
  simp [pointEval, xbar, pointPreEval]

def coordinateIdeal (a3 a2 a1 a0 a y : K) :
    Ideal (AffineRing a3 a2 a1 a0) :=
  Ideal.span {xbar a3 a2 a1 a0 - c a3 a2 a1 a0 a,
    ybar a3 a2 a1 a0 - c a3 a2 a1 a0 y}

theorem mapped_sourceIdeal (a3 a2 a1 a0 a y : K) :
    Ideal.map (Ideal.Quotient.mk (affineIdeal a3 a2 a1 a0))
      (sourceIdeal a y) = coordinateIdeal a3 a2 a1 a0 a y := by
  simp only [sourceIdeal, coordinateIdeal, Ideal.map_span]
  apply congrArg Ideal.span
  ext x
  constructor
  · rintro ⟨p, hp, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
    rcases hp with rfl | rfl
    · left
      simpa [xbar] using quotient_C a3 a2 a1 a0 a
    · right
      simpa [ybar] using quotient_C a3 a2 a1 a0 y
  · intro hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨X 0 - C a, by simp, by simp [xbar, quotient_C]⟩
    · exact ⟨X 1 - C y, by simp, by simp [ybar, quotient_C]⟩

theorem pointIdeal_eq_coordinateIdeal (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    pointIdeal a3 a2 a1 a0 a y hcurve =
      coordinateIdeal a3 a2 a1 a0 a y := by
  apply le_antisymm
  · intro q hq
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
    have hp : pointPreEval a y p = 0 := (RingHom.mem_ker).mp hq
    have hsrc : p ∈ sourceIdeal a y := by
      simpa [hp] using subtract_pointPreEval_mem a y p
    rw [← mapped_sourceIdeal]
    exact Ideal.mem_map_of_mem _ hsrc
  · rw [coordinateIdeal]
    apply Ideal.span_le.mpr
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl
    · simp [pointIdeal, RingHom.mem_ker, pointEval_xbar, pointEval_c]
    · simp [pointIdeal, RingHom.mem_ker, pointEval_ybar, pointEval_c]

private abbrev Stalk (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :=
  Localization.AtPrime (pointIdeal a3 a2 a1 a0 a y hcurve)

def stalkXSubA (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    Stalk a3 a2 a1 a0 a y hcurve :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a y hcurve))
    (xbar a3 a2 a1 a0 - c a3 a2 a1 a0 a)

def stalkYSubY (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    Stalk a3 a2 a1 a0 a y hcurve :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a y hcurve))
    (ybar a3 a2 a1 a0 - c a3 a2 a1 a0 y)

def stalkYPlusY (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    Stalk a3 a2 a1 a0 a y hcurve :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a y hcurve))
    (ybar a3 a2 a1 a0 + c a3 a2 a1 a0 y)

def stalkQ (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    Stalk a3 a2 a1 a0 a y hcurve :=
  (algebraMap (AffineRing a3 a2 a1 a0) (Stalk a3 a2 a1 a0 a y hcurve))
    (qAt a3 a2 a1 a0 a)

theorem maximalIdeal_coordinates (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    IsLocalRing.maximalIdeal (Stalk a3 a2 a1 a0 a y hcurve) =
      Ideal.span {stalkXSubA a3 a2 a1 a0 a y hcurve,
        stalkYSubY a3 a2 a1 a0 a y hcurve} := by
  have hmap := IsLocalization.AtPrime.map_eq_maximalIdeal
    (pointIdeal a3 a2 a1 a0 a y hcurve)
    (Stalk a3 a2 a1 a0 a y hcurve)
  let f : AffineRing a3 a2 a1 a0 →+* Stalk a3 a2 a1 a0 a y hcurve :=
    algebraMap _ _
  calc
    _ = Ideal.map f (pointIdeal a3 a2 a1 a0 a y hcurve) := hmap.symm
    _ = Ideal.map f (coordinateIdeal a3 a2 a1 a0 a y) :=
      congrArg (Ideal.map f) (pointIdeal_eq_coordinateIdeal a3 a2 a1 a0 a y hcurve)
    _ = Ideal.span {stalkXSubA a3 a2 a1 a0 a y hcurve,
          stalkYSubY a3 a2 a1 a0 a y hcurve} := by
      simp [coordinateIdeal, stalkXSubA, stalkYSubY, f, Ideal.map_span]

theorem affine_point_relation (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    (ybar a3 a2 a1 a0 - c a3 a2 a1 a0 y) *
      (ybar a3 a2 a1 a0 + c a3 a2 a1 a0 y) =
    (xbar a3 a2 a1 a0 - c a3 a2 a1 a0 a) *
      qAt a3 a2 a1 a0 a := by
  have hr : c a3 a2 a1 a0 (y ^ 2) =
      c a3 a2 a1 a0 (fAt a3 a2 a1 a0 a) := by rw [hcurve]
  simp only [fAt, map_add, map_mul, map_pow] at hr
  have hrel := quotient_affine_relation a3 a2 a1 a0
  dsimp [qAt]
  simp only [c, map_pow]
  linear_combination hrel - hr

theorem stalk_relation (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a) :
    stalkYSubY a3 a2 a1 a0 a y hcurve *
      stalkYPlusY a3 a2 a1 a0 a y hcurve =
    stalkXSubA a3 a2 a1 a0 a y hcurve *
      stalkQ a3 a2 a1 a0 a y hcurve := by
  simpa only [stalkYSubY, stalkYPlusY, stalkXSubA, stalkQ,
    map_mul] using congrArg
      (algebraMap (AffineRing a3 a2 a1 a0)
        (Stalk a3 a2 a1 a0 a y hcurve))
      (affine_point_relation a3 a2 a1 a0 a y hcurve)

theorem stalkYPlusY_unit (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a)
    (h2y : 2 * y ≠ 0) :
    IsUnit (stalkYPlusY a3 a2 a1 a0 a y hcurve) := by
  apply (IsLocalization.AtPrime.isUnit_to_map_iff
    (Stalk a3 a2 a1 a0 a y hcurve)
    (pointIdeal a3 a2 a1 a0 a y hcurve) _).mpr
  simp only [Ideal.mem_primeCompl_iff]
  intro hmem
  have hz : pointEval a3 a2 a1 a0 a y hcurve
      (ybar a3 a2 a1 a0 + c a3 a2 a1 a0 y) = 0 :=
    (RingHom.mem_ker).mp hmem
  simp only [map_add, pointEval_ybar, pointEval_c] at hz
  apply h2y
  linear_combination hz

theorem maximalIdeal_eq_span_x (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a)
    (h2y : 2 * y ≠ 0) :
    IsLocalRing.maximalIdeal (Stalk a3 a2 a1 a0 a y hcurve) =
      Ideal.span {stalkXSubA a3 a2 a1 a0 a y hcurve} := by
  rw [maximalIdeal_coordinates a3 a2 a1 a0 a y hcurve]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl
    · exact Ideal.mem_span_singleton_self _
    · let u := (stalkYPlusY_unit a3 a2 a1 a0 a y hcurve h2y).unit
      have hueq : (u : Stalk a3 a2 a1 a0 a y hcurve) =
          stalkYPlusY a3 a2 a1 a0 a y hcurve :=
        (stalkYPlusY_unit a3 a2 a1 a0 a y hcurve h2y).unit_spec
      have hrel := stalk_relation a3 a2 a1 a0 a y hcurve
      rw [← hueq] at hrel
      have heq : stalkYSubY a3 a2 a1 a0 a y hcurve =
          stalkXSubA a3 a2 a1 a0 a y hcurve *
            (stalkQ a3 a2 a1 a0 a y hcurve * (u⁻¹ : _)) := by
        calc
          _ = (stalkYSubY a3 a2 a1 a0 a y hcurve * (u : _)) * (u⁻¹ : _) := by simp [mul_assoc]
          _ = _ := by rw [hrel]; ring
      exact Ideal.mem_span_singleton.mpr ⟨_, heq⟩
  · exact Ideal.span_mono (by simp)

theorem affine_ybar_sub_y_ne_zero (a3 a2 a1 a0 y : K) :
    ybar a3 a2 a1 a0 - c a3 a2 a1 a0 y ≠ 0 := by
  intro hy
  have hmem : (X 1 - C y : Poly K) ∈ affineIdeal a3 a2 a1 a0 := by
    apply (Ideal.Quotient.eq_zero_iff_mem).mp
    simpa [ybar, quotient_C] using hy
  have hdvd : affineEquation a3 a2 a1 a0 ∣ (X 1 - C y : Poly K) := by
    simpa only [affineIdeal, Ideal.mem_span_singleton] using hmem
  have hdvd' : Common22Domain.nestedEquiv (affineEquation a3 a2 a1 a0) ∣
      Common22Domain.nestedEquiv (X 1 - C y : Poly K) := by
    obtain ⟨q, hq⟩ := hdvd
    exact ⟨Common22Domain.nestedEquiv q,
      by simpa using congrArg Common22Domain.nestedEquiv hq⟩
  have hmapy : Common22Domain.nestedEquiv (X 1 - C y : Poly K) =
      Polynomial.X - Polynomial.C (MvPolynomial.C y) := by
    simp [Common22Domain.nestedEquiv, MvPolynomial.renameEquiv_apply,
      MvPolynomial.finSuccEquiv_X_zero, MvPolynomial.finSuccEquiv_apply]
  rw [Common22BranchDomain.nested_affine_equation, hmapy] at hdvd'
  have hdeg := Polynomial.natDegree_le_of_dvd hdvd'
    (Polynomial.X_sub_C_ne_zero (MvPolynomial.C y))
  rw [Polynomial.natDegree_X_pow_sub_C,
    Polynomial.natDegree_X_sub_C] at hdeg
  omega

theorem stalkYSubY_ne_zero (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a)
    (hsep : (WeightedProjSmoothPoints.quintic a3 a2 a1 a0).Separable) :
    stalkYSubY a3 a2 a1 a0 a y hcurve ≠ 0 := by
  letI : IsDomain (AffineRing a3 a2 a1 a0) :=
    Common22SeparableAffineDomain.affine_ring_domain_of_separable a3 a2 a1 a0 hsep
  have hinj : Function.Injective
      (algebraMap (AffineRing a3 a2 a1 a0)
        (Stalk a3 a2 a1 a0 a y hcurve)) :=
    FaithfulSMul.algebraMap_injective _ _
  intro hz
  exact affine_ybar_sub_y_ne_zero a3 a2 a1 a0 y
    (hinj (by simpa [stalkYSubY] using hz))

theorem stalkXSubA_ne_zero (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a)
    (hsep : (WeightedProjSmoothPoints.quintic a3 a2 a1 a0).Separable)
    (h2y : 2 * y ≠ 0) :
    stalkXSubA a3 a2 a1 a0 a y hcurve ≠ 0 := by
  letI : IsDomain (Stalk a3 a2 a1 a0 a y hcurve) :=
    Common22SeparableAffineDomain.point_local_domain_of_separable
      a3 a2 a1 a0 a y hcurve hsep
  intro hx
  have hrel := stalk_relation a3 a2 a1 a0 a y hcurve
  rw [hx, zero_mul, mul_eq_zero] at hrel
  rcases hrel with hy | hu
  · exact stalkYSubY_ne_zero a3 a2 a1 a0 a y hcurve hsep hy
  · exact (stalkYPlusY_unit a3 a2 a1 a0 a y hcurve h2y).ne_zero hu

theorem point_local_dvr (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a)
    (hsep : (WeightedProjSmoothPoints.quintic a3 a2 a1 a0).Separable)
    (h2y : 2 * y ≠ 0) :
    @IsDiscreteValuationRing (Stalk a3 a2 a1 a0 a y hcurve) _
      (Common22SeparableAffineDomain.point_local_domain_of_separable
        a3 a2 a1 a0 a y hcurve hsep) := by
  letI : IsDomain (AffineRing a3 a2 a1 a0) :=
    Common22SeparableAffineDomain.affine_ring_domain_of_separable a3 a2 a1 a0 hsep
  letI : IsDomain (Stalk a3 a2 a1 a0 a y hcurve) :=
    Common22SeparableAffineDomain.point_local_domain_of_separable
      a3 a2 a1 a0 a y hcurve hsep
  let R := Stalk a3 a2 a1 a0 a y hcurve
  have hnotfield : ¬IsField R := by
    intro hfield
    have hmzero : IsLocalRing.maximalIdeal R = ⊥ :=
      IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield
    have hxmem : stalkXSubA a3 a2 a1 a0 a y hcurve ∈
        IsLocalRing.maximalIdeal R := by
      rw [maximalIdeal_eq_span_x a3 a2 a1 a0 a y hcurve h2y]
      exact Ideal.mem_span_singleton_self _
    have hxzero : stalkXSubA a3 a2 a1 a0 a y hcurve = 0 := by
      simpa [hmzero] using hxmem
    exact stalkXSubA_ne_zero a3 a2 a1 a0 a y hcurve hsep h2y hxzero
  have hmprincipal : (IsLocalRing.maximalIdeal R).IsPrincipal := by
    rw [maximalIdeal_eq_span_x a3 a2 a1 a0 a y hcurve h2y]
    infer_instance
  exact ((IsDiscreteValuationRing.TFAE R hnotfield).out 5 1 rfl rfl).mp hmprincipal

theorem projective_point_dvr (a3 a2 a1 a0 a y : K)
    (hcurve : y ^ 2 = fAt a3 a2 a1 a0 a)
    (hsep : (WeightedProjSmoothPoints.quintic a3 a2 a1 a0).Separable)
    (h2y : 2 * y ≠ 0) :
    @IsDiscreteValuationRing (ProjPointRing a3 a2 a1 a0 a y hcurve) _
      (Common22SeparableAffineDomain.projective_point_domain_of_separable
        a3 a2 a1 a0 a y hcurve hsep) := by
  letI : IsDomain (Stalk a3 a2 a1 a0 a y hcurve) :=
    Common22SeparableAffineDomain.point_local_domain_of_separable
      a3 a2 a1 a0 a y hcurve hsep
  letI : IsDiscreteValuationRing (Stalk a3 a2 a1 a0 a y hcurve) :=
    point_local_dvr a3 a2 a1 a0 a y hcurve hsep h2y
  letI : IsDomain (ProjPointRing a3 a2 a1 a0 a y hcurve) :=
    Common22SeparableAffineDomain.projective_point_domain_of_separable
      a3 a2 a1 a0 a y hcurve hsep
  exact IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing
    (pointRingEquiv a3 a2 a1 a0 a y hcurve).symm

#print axioms subtract_pointPreEval_mem
#print axioms pointIdeal_eq_coordinateIdeal
#print axioms maximalIdeal_coordinates
#print axioms stalk_relation
#print axioms stalkYPlusY_unit
#print axioms maximalIdeal_eq_span_x
#print axioms affine_ybar_sub_y_ne_zero
#print axioms stalkXSubA_ne_zero
#print axioms point_local_dvr
#print axioms projective_point_dvr

end WeightedProjNonbranchDVR
