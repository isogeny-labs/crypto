import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-!
# Conditional local-parameter step at the infinity chart

The actual stalk of the smooth projective curve is not constructed here. If
that stalk is supplied as a local ring with maximal ideal generated by the
chart coordinates `z,w`, the chart relation and the unit factor make the
maximal ideal principal, generated by `w`.
-/

set_option autoImplicit false

namespace Common22LocalParameter

variable {R : Type*} [CommRing R] [IsLocalRing R]

omit [IsLocalRing R] in
/-- `w²=z*u` and a unit `u` make `z` a multiple of `w`. -/
theorem z_mem_span_w (z w : R) (u : Rˣ) (heq : w ^ 2 = z * (u : R)) :
    z ∈ Ideal.span {w} := by
  have hz : z = w * (w * (↑(u⁻¹) : R)) := by
    calc
      z = (z * (u : R)) * (↑(u⁻¹) : R) := by simp [mul_assoc]
      _ = w * (w * (↑(u⁻¹) : R)) := by rw [← heq]; ring
  exact Ideal.mem_span_singleton.mpr ⟨w * (↑(u⁻¹) : R), hz⟩

/-- In any supplied local chart whose maximal ideal is generated by `z,w`,
the chart relation makes `w` generate the maximal ideal. This is not a
construction of that local chart, and principal maximal ideal alone is not a
DVR assertion without domain/dimension/Noetherian hypotheses. -/
theorem maximalIdeal_eq_span_w (z w : R) (u : Rˣ)
    (heq : w ^ 2 = z * (u : R))
    (hmax : IsLocalRing.maximalIdeal R = Ideal.span {z, w}) :
    IsLocalRing.maximalIdeal R = Ideal.span {w} := by
  rw [hmax]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with hx | hx
    · simpa [hx] using z_mem_span_w z w u heq
    · rw [hx]
      exact Ideal.mem_span_singleton_self w
  · exact Ideal.span_mono (by simp)

/-- In a supplied local domain with this chart maximal ideal, `w` is
irreducible. A DVR identification still needs the geometric/local-ring
construction and its dimension/Noetherian arguments. -/
theorem chart_w_irreducible [IsDomain R] (z w : R) (u : Rˣ)
    (hw : w ≠ 0) (heq : w ^ 2 = z * (u : R))
    (hmax : IsLocalRing.maximalIdeal R = Ideal.span {z, w}) :
    Irreducible w :=
  IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal w hw
    (maximalIdeal_eq_span_w z w u heq hmax)

end Common22LocalParameter

#print axioms Common22LocalParameter.z_mem_span_w
#print axioms Common22LocalParameter.maximalIdeal_eq_span_w
#print axioms Common22LocalParameter.chart_w_irreducible
