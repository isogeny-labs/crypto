if(!(isprime(p)&&isprime(l)&&isprime(q)),error("primality"));
if(!(p==(1+k*l)^2+7*l^2 && n==8*q*l^2 && n==p+1-t && kronecker(-7,l)==-1 && gcd(t,p)==1),error("identities"));
if(!(E.j==Mod(-3375,p)&&ellisoncurve(E,P)&&ellisoncurve(E,K)&&ellisoncurve(E,G)),error("curve"));
if(!(ellmul(E,P,n)==[0]&&ellmul(E,P,2*t)!=[0]&&K!=[0]&&ellmul(E,K,l)==[0]&&G!=[0]&&ellmul(E,G,q)==[0]),error("orders"));
if(!(2^128>l && (l-1)%2^64==0 && Mod(3,l)^(l-1)==1 && gcd(lift(Mod(3,l)^((l-1)/2))-1,l)==1),error("Pocklington"));
print("Independent PARI primality, CM j, norm/trace identities, point membership, trace-sign witness, kernel order and subgroup order: PASS");
