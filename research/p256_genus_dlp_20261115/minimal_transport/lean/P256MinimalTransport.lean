import CryptoLean.Curve.QuadraticNormTransport
import Mathlib.Tactic.NormNum

set_option autoImplicit false

namespace P256MinimalTransport

-- Constants copied from the already frozen transfer_search audit, not
-- generated by the unqualified native coefficient-construction candidate.
def subgroupOrder : ℤ :=
  115792089210356248762697446949407573529996955224135760342422259061068512044369

def cubicEigenvalue : ℤ :=
  37331913611544787191735787721145577660445201969982241541979348390299652607521

/-- Per-instance integer arithmetic, checked by the kernel, not native_decide. -/
theorem cubic_root_contract :
    subgroupOrder ∣ cubicEigenvalue^2+cubicEigenvalue+1 := by
  norm_num [subgroupOrder, cubicEigenvalue, Int.dvd_iff_emod_eq_zero]

/-- Apply the shared integer law to the fixed P-256 eigenline coefficients. -/
theorem coefficient_norm_floor {a b : ℤ}
    (hline : subgroupOrder ∣ b+cubicEigenvalue*a) (hne : a ≠ 0 ∨ b ≠ 0) :
    subgroupOrder ≤ CryptoLean.quadraticNorm (-1) 1 a b :=
  CryptoLean.eisenstein_norm_lower_bound cubic_root_contract hline hne

/-- The geometric polarization coefficient is an explicit hypothesis here. -/
theorem polarization_coefficient_floor {a b degree : ℤ}
    (hline : subgroupOrder ∣ b+cubicEigenvalue*a) (hne : a ≠ 0 ∨ b ≠ 0)
    (hdegree : degree = 2*CryptoLean.quadraticNorm (-1) 1 a b) :
    2*subgroupOrder ≤ degree := by
  calc
    2*subgroupOrder ≤ 2*CryptoLean.quadraticNorm (-1) 1 a b :=
      mul_le_mul_of_nonneg_left (coefficient_norm_floor hline hne) (by norm_num)
    _ = degree := hdegree.symm

/-- A norm-minimal vector in the declared sector has both magnitudes below 2^128.
Existence/construction of that vector is not asserted by this endpoint. -/
theorem minimal_vector_coefficient_bound {a b : ℤ} (ha : 0 < a) (hb : b < 0)
    (hnorm : CryptoLean.quadraticNorm (-1) 1 a b = subgroupOrder) :
    a < 2^128 ∧ -b < 2^128 := by
  have hs := CryptoLean.eisenstein_sector_bounds ha hb hnorm
  have hn : subgroupOrder < (2^128 : ℤ)^2 := by norm_num [subgroupOrder]
  constructor
  · exact (sq_lt_sq₀ ha.le (by norm_num)).mp (lt_trans hs.1 hn)
  · apply (sq_lt_sq₀ (by omega : 0 ≤ -b) (by norm_num)).mp
    nlinarith [hs.2]

end P256MinimalTransport
