fn direct_checks(){let(mut second_equalities,mut factor_equalities,mut endpoint_checks)=(0,0,0);
 for r in [7u64,17,41,97,281]{let mut p=polynomial::Poly::new(r).unwrap();let(mut previous,mut current)=(vec![0],vec![1]);for j in 0..65{let got=second_pair(&mut p,j);assert_eq!(got,(current.clone(),previous.clone()));let wc=p.mul(&[0,1],&current);let next=p.sub(&wc,&previous);previous=current;current=next;second_equalities+=1;}}
 for r in [17u64,41,97,193,281]{let i=(2..r).find(|&i|mul(i,i,r)==r-1).unwrap();let mut p=polynomial::Poly::new(r).unwrap();for n in 1..=(r as usize-1).min(64){let dn=initial_dickson(&mut p,n);for sign in [1,r-1]{for(u,g)in direct_phase_domains(r,n,i,sign).unwrap(){let mut equation=dn.clone();equation[0]=(equation[0]+r-(u+pow(u,3,r))%r)%r;assert_eq!(g,squarefree(r,&equation).unwrap());assert_eq!(squarefree(r,&g).unwrap(),g);assert_eq!(eval(&g,2,r)==0,u==1);assert_eq!(eval(&g,r-2,r)==0,u==if n%2==0{1}else{r-1});factor_equalities+=1;endpoint_checks+=2;}}}
  assert!(matches!(direct_phase_domains(r,0,i,1),Err(Error::Domain)));assert!(matches!(direct_phase_domains(r,r as usize,i,1),Err(Error::Domain)));assert!(matches!(direct_phase_domains(r,1,1,1),Err(Error::Domain)));assert!(matches!(direct_phase_domains(r,1,i,0),Err(Error::Domain)));
 }
 let mut dickson_equalities=0;for r in [17u64,41,97,281]{let mut p=polynomial::Poly::new(r).unwrap();let(mut a,mut b)=(vec![2],vec![0,1]);for n in 0..33{assert_eq!(initial_dickson(&mut p,n),a);let wb=p.mul(&[0,1],&b);let next=p.sub(&wb,&a);a=b;b=next;dickson_equalities+=1;}}
 let(mut states,mut retained,mut wrong,mut zero,mut public,mut route_changes,mut call_changes,mut updates)=(0,0,0,0,0,0,0,0);
 for(r,m)in[(17u64,4usize),(41,5),(97,3),(193,3),(281,5),(281,35)]{
  let zeta=(2..r).find(|&z|pow(z,m as u64,r)==1&&(1..m).all(|j|pow(z,j as u64,r)!=1)).unwrap();let i=(2..r).find(|&x|mul(x,x,r)==r-1).unwrap();let stream=StreamModes::new(r,m,zeta,64,2048,7).unwrap();let modes=RecoveryModes::from_modes(&stream).unwrap();let l=((r-1)/2/m as u64)as usize;
  let n=((r-1)/(4*m as u64))as usize;let mut poly=polynomial::Poly::new(r).unwrap();let dn=initial_dickson(&mut poly,n);
  for u in [1,r-1,i,r-i]{let mut d=dn.clone();d[0]=(d[0]+r-(u+pow(u,3,r))%r)%r;let got=squarefree(r,&d).unwrap().len()-1;let expected=if u==1{n/2+1}else if u==r-1{(n+1)/2}else{n};assert_eq!(got,expected);}
  for sign in [1,r-1]{let degree=if sign==1{n/2+1}else{n};let bound=2*m*degree;assert!(SeededImage::initial_direct_phase(&modes,1,&[0,0,0],i,bound,sign).is_ok());assert!(matches!(SeededImage::initial_direct_phase(&modes,1,&[0,0,0],i,bound-1,sign),Err(Error::Limit)));}
  let ks:Vec<_>=if m==35{vec![0,1,2,3,7,17,r-1]}else{(0..r).collect()};
  for k in ks{for slots in [0usize,16,1024]{for sign in [1,r-1]{let(mut old,mut new):(Option<SeededImage>,Option<SeededImage>)=(None,None);
   for b in [2,1,3,2]{let mut z=1;let signs:Vec<_>=(0..m).map(|_|{let s=pow((k+r-mul(b,z,r))%r,(r-1)/2,r);z=mul(z,zeta,r);s}).collect();let pair=modes.signed_observed(&signs).unwrap();let f=[signs.iter().fold(0,|a,&s|(a+s)%r),pair[0],pair[1]];
    if let Some(old)=&mut old{old.update(&modes,b,&f).unwrap();new.as_mut().unwrap().update(&modes,b,&f).unwrap();}else{
     assert!(matches!(SeededImage::new_direct_phase(&modes,b,&f,i,slots,0),Err(Error::Domain)));assert!(matches!(SeededImage::new_direct_phase(&modes,b,&f,i,slots,2),Err(Error::Domain)));
     old=Some(SeededImage::new_sectioned(&modes,b,&f,i,slots,sign).unwrap());new=Some(SeededImage::new_direct_phase(&modes,b,&f,i,slots,sign).unwrap());
     let normalized=mul(sign,pow(b,(r-1)/2,r),r);assert_eq!([1,r-1,i,r-i].into_iter().filter(|&u|mul(u,u,r)==normalized).count(),2);
    }
    let(old,new)=(old.as_mut().unwrap(),new.as_mut().unwrap());let dense=old.materialize(r as usize,r as usize).unwrap();let got=new.materialize(r as usize,r as usize).unwrap();let mut condition=vec![0;l+1];condition[0]=r-sign;condition[l]=1;let mut p=polynomial::Poly::new(r).unwrap();let expected=p.gcd_monic(&dense,&condition,2*r as usize).unwrap().polynomial;
    assert_eq!(got,expected,"r={r} m={m} k={k} b={b} slots={slots} sign={sign}");assert!(!new.zero);assert_eq!(old.rounds,new.rounds);states+=1;
    for branch in &new.branches{let prior=old.branches.iter().find(|a|a.u==branch.u).unwrap();assert_eq!(canonical_signature(&prior.canonical),canonical_signature(&branch.canonical));}
    if k==0{assert_ne!(eval(&got,0,r),0);zero+=1;}else if sign==pow(k,(r-1)/2,r){assert_eq!(eval(&got,pow(k,m as u64,r),r),0);retained+=1;}else{assert_ne!(eval(&got,pow(k,m as u64,r),r),0);wrong+=1;}
   }
  }}}
 }
 let(p,a,b,r,base,m)=(257,1,7,281,[1,3],5usize);let curve=group::Curve::new(p,a,b);let bp=group::Point{x:base[0],y:base[1]};let source=source::Source::new(p,a,b,r,base,64).unwrap();let z=(2..r).find(|&z|pow(z,m as u64,r)==1&&(1..m).all(|j|pow(z,j as u64,r)!=1)).unwrap();let modes=StreamModes::new(r,m,z,16,256,7).unwrap();let extra:Vec<_>=(0..17).collect();
 for cap in [8usize,16,64]{for k in 0..r{let target=multiple(curve,bp,k);for slots in [0usize,16,1024]{let old=modes.recover_sectioned_image(&source,curve,bp,target,&[1,2,3,4],cap,&extra,128,slots).unwrap();SEEDED_IMAGE_COUNTS.with(|c|c.set((0,0,0,0)));let new=modes.recover_direct_phase_image(&source,curve,bp,target,&[1,2,3,4],cap,&extra,128,slots).unwrap();assert_eq!(old.0,Some(k));assert_eq!(new.0,Some(k));assert_eq!(old.2,new.2);assert_eq!((old.1.calls,old.1.extra,old.1.replayed,old.1.lifted,old.1.image_count),(new.1.calls,new.1.extra,new.1.replayed,new.1.lifted,new.1.image_count));assert!(new.1.calls<=128);route_changes+=usize::from(old.2!=new.2);call_changes+=usize::from(old.1.calls!=new.1.calls);updates+=SEEDED_IMAGE_COUNTS.with(|c|c.get().1);public+=1;
  if k==0{assert_eq!(new.1.calls,1);assert_eq!(new.2,"identity");}
 }}}
 // Exhausting the budget immediately must not issue a second sign query.
 for k in 1..r{let q=modes.recover_direct_phase_image(&source,curve,bp,multiple(curve,bp,k),&[1,2],64,&extra,1,1024).unwrap();assert_eq!(q.0,None);assert_eq!(q.1.calls,1);assert_eq!(q.2,"call-cap");}
 assert!(retained>0&&wrong>0&&zero>0&&updates>0);
 println!("support_equalities={states} true_images_retained={retained} wrong_sign_exclusions={wrong} zero_exclusions={zero} public_target_capacity_cases={public} route_changes={route_changes} call_changes={call_changes} subsequent_updates={updates} single_call_cap_cases=280 invalid_signs=rejected phase_choices=2_of_4");
 let(powered,fallback)=DIRECT_INITIAL_POWER.with(|c|c.get());assert!(powered>0&&fallback>0);println!("dickson_equalities={dickson_equalities} powered_initializations={powered} streaming_fallbacks={fallback} public_outcomes_routes_stats_equal=true phase_degree_checks=24 exact_capacity_boundaries=12");
 let(positive,negative)=DIRECT_DOMAINS.with(|c|c.get());assert!(positive>0&&negative>0);println!("second_kind_equalities={second_equalities} direct_factor_equalities={factor_equalities} ramified_endpoint_checks={endpoint_checks} positive_domain_builds={positive} negative_domain_builds={negative} invalid_domains=rejected");
}
