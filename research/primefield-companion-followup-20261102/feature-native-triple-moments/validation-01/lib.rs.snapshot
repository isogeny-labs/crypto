//! Bounded moments for three nonzero quadratic-character constraints.
//! The caller certifies primality. General seeds are a mathematical precondition,
//! not authenticated by this API. No elliptic target or scalar labels are inputs.
#[derive(Debug, PartialEq)]
pub enum Error { Domain, Limit, Sign, Certificate }
fn mul(a:u64,b:u64,r:u64)->u64 { ((a as u128*b as u128)%r as u128) as u64 }
fn add(a:u64,b:u64,r:u64)->u64 { (a+b)%r }
fn sub(a:u64,b:u64,r:u64)->u64 { (a+r-b)%r }
fn pow(mut a:u64,mut n:u64,r:u64)->u64 { let mut v=1; while n>0 { if n&1!=0 {v=mul(v,a,r)} a=mul(a,a,r); n>>=1 } v }
fn domain(r:u64)->bool {r>=5 && r<=u64::MAX/2 && r%2==1}
fn chi(x:u64,r:u64)->i8 {if x==0 {0} else if pow(x,(r-1)/2,r)==1 {1} else {-1}}
fn signed(x:i128,r:u64)->u64 {x.rem_euclid(r as i128) as u64}
// Batch inversion: one exponentiation and linear field work/storage.
fn invert(xs:&[u64],r:u64)->Vec<u64> {
 let mut prefixes=Vec::with_capacity(xs.len()); let mut product=1;
 for &x in xs {prefixes.push(product); product=mul(product,x,r)}
 let mut inv=pow(product,r-2,r); let mut out=vec![0;xs.len()];
 for i in (0..xs.len()).rev() {out[i]=mul(inv,prefixes[i],r); inv=mul(inv,xs[i],r)} out
}
#[derive(Debug,Clone)]
pub struct Triple {r:u64,tau:u64,seeds:[u64;2]}
impl Triple {
 /// seeds=[c_h,c_(h-1)] for ((X+1)(X+tau))^h. Caller must establish this.
 pub fn with_seeds(r:u64,tau:u64,seeds:[u64;2])->Result<Self,Error> {
  if !domain(r)||tau<2||tau>=r||seeds.iter().any(|&x|x>=r) {return Err(Error::Domain)}
  Ok(Self{r,tau,seeds})
 }
 /// Returns mu_0..mu_order for chi(x),chi(x+1),chi(x+tau)=signs.
 /// Bound checked before allocation. Only nonzero signs are accepted.
 pub fn moments(&self,signs:[i8;3],order:usize,max_order:usize)->Result<Vec<u64>,Error> {
  let(r,tau)=(self.r,self.tau); let h=(r-1)/2;
  if signs.iter().any(|s|![-1,1].contains(s)) {return Err(Error::Sign)}
  if order>max_order||order as u128>=h as u128 {return Err(Error::Limit)}
  let den:Vec<_>=(0..=order).map(|j|h+j as u64+1).collect(); let central_inv=invert(&den,r);
  let den:Vec<_>=(1..=order).map(|j|j as u64).collect(); let inv=invert(&den,r);
  let mut b=vec![0;order+1]; b[0]=self.seeds[0]; if order>0 {b[1]=self.seeds[1]}
  for j in 1..order {let k=j as u64;
   b[j+1]=mul(sub(mul(mul(tau,h-k+1,r),b[j-1],r),mul(mul(k,(1+tau)%r,r),b[j],r),r),central_inv[j],r);
  }
  let offsets=[0,1,tau]; let mut out=vec![0;order+1];
  for (a,c) in [(0,1),(0,2),(1,2)] {
   let (u,v)=(offsets[a],offsets[c]); let mut prev2=0; let mut prev=1;
   for j in 0..=order {
    let q=if j==0 {1} else {let k=j as u64;
     mul(add(mul(mul(h-k+1,add(u,v,r),r),prev,r),mul(mul((2*h-k+2)%r,mul(u,v,r),r),prev2,r),r),inv[j-1],r)};
    out[j]=add(out[j],mul(signed(-(signs[a]as i128)*(signs[c]as i128),r),q,r),r);
    prev2=prev; prev=q;
   }
  }
  let triple_sign=signed(-(signs[0]as i128)*(signs[1]as i128)*(signs[2]as i128),r);
  for j in 0..=order {out[j]=add(out[j],mul(triple_sign,b[j],r),r)}
  for i in 0..3 {
   let mut endpoint=1i128;
   for l in 0..3 {if l!=i {endpoint*=1+(signs[l]as i128)*(chi(sub(offsets[l],offsets[i],r),r)as i128)}}
   let mut power=1; let x=sub(0,offsets[i],r);
   for value in &mut out {*value=sub(*value,mul(endpoint as u64,power,r),r);power=mul(power,x,r)}
  }
  let inv8=pow(8%r,r-2,r); for x in &mut out {*x=mul(*x,inv8,r)} Ok(out)
 }
}
#[derive(Debug,Clone)]
pub struct CmCertificate {pub r:u64,pub a:i64,pub b:u64,pub nonresidue:u64,pub sqrt_minus_one:u64,pub attempts:u64}
impl CmCertificate {
 pub fn valid(&self)->bool {
  let r=self.r; if !domain(r)||r%4!=1||self.a%2==0||self.b%2!=0 {return false}
  let a=self.a as i128; let b=self.b as u128;
  (a*a) as u128+b*b==r as u128 && (a+self.b as i128).rem_euclid(4)==1
   && self.sqrt_minus_one<r && mul(self.sqrt_minus_one,self.sqrt_minus_one,r)==r-1
   && self.nonresidue>=2 && self.nonresidue<r && chi(self.nonresidue,r)==-1
   && self.attempts==self.nonresidue-1
 }
 pub fn triple(&self)->Result<Triple,Error> {if !self.valid(){return Err(Error::Certificate)} let trace=signed(2*self.a as i128,self.r); Triple::with_seeds(self.r,2,[trace,sub(0,trace,self.r)])}
}
fn isqrt(n:u64)->u64 {let(mut lo,mut hi)=(0u64,1u64<<32);while hi-lo>1 {let mid=lo+(hi-lo)/2;if (mid as u128)*(mid as u128)<=n as u128 {lo=mid}else{hi=mid}}lo}
/// Bounded nonresidue search then Cornacchia. Exhaustion returns Limit.
/// Primality is a caller precondition; the certificate does not prove it.
pub fn consecutive_cm(r:u64,max_attempts:u64)->Result<CmCertificate,Error> {
 if !domain(r)||r%4!=1{return Err(Error::Domain)}
 let cap=max_attempts.min(r-2); let mut found=None;
 for i in 0..cap {let z=i+2;if chi(z,r)==-1 {found=Some(z);break}}
 let z=found.ok_or(Error::Limit)?;let root=pow(z,(r-1)/4,r);if mul(root,root,r)!=r-1{return Err(Error::Certificate)}
 let(mut x,mut y)=(r,root);while(y as u128)*(y as u128)>r as u128 {let t=x%y;x=y;y=t}
 let rem=r-y*y;let other=isqrt(rem);if other*other!=rem{return Err(Error::Certificate)}
 let(mut a,b)=if y%2==1 {(y as i64,other)}else{(other as i64,y)};
 if (a as i128+b as i128).rem_euclid(4)!=1 {a=-a}
 let c=CmCertificate{r,a,b,nonresidue:z,sqrt_minus_one:root,attempts:z-1};if !c.valid(){return Err(Error::Certificate)}Ok(c)
}
#[cfg(test)] mod triple_tests {
 use super::*;
 // Test-only dense coefficients, independent of the production recurrence.
 fn dense(r:u64,tau:u64)->Vec<u64> {let mut p=vec![1];for _ in 0..(r-1)/2 {let mut q=vec![0;p.len()+2];for(j,&v)in p.iter().enumerate(){q[j]=add(q[j],mul(tau,v,r),r);q[j+1]=add(q[j+1],mul((1+tau)%r,v,r),r);q[j+2]=add(q[j+2],v,r)}p=q}p}
 fn check(t:&Triple,d:usize)->usize {let r=t.r;let mut checks=0;for s in [-1,1] {for v in [-1,1] {for w in [-1,1] {
  let signs=[s,v,w];let roots:Vec<_>=(0..r).filter(|&x|[chi(x,r),chi((x+1)%r,r),chi((x+t.tau)%r,r)]==signs).collect();
  let got=t.moments(signs,d,d).unwrap();assert_eq!(got[0],roots.len()as u64);
  for j in 0..=d {let expected=roots.iter().fold(0,|a,&x|add(a,pow(x,j as u64,r),r));assert_eq!(got[j],expected,"r={r},tau={},signs={signs:?},j={j}",t.tau);checks+=1}
 }}}checks}
 #[test] fn general_seed_stream() {let mut checks=0;for r in [5,7,11,13,17,31,43,101] {for tau in 2..r {let p=dense(r,tau);let h=((r-1)/2)as usize;let t=Triple::with_seeds(r,tau,[p[h],p[h-1]]).unwrap();checks+=check(&t,8.min(h-1));}}println!("general_moment_equalities={checks}");}
 #[test] fn cm_seed_and_moments() {let mut count=0;let mut checks=0;for r in [5,13,17,29,37,41,53,61,73,89,97,101,109,113,137,149,157,173,181,193] {
  let c=consecutive_cm(r,64).unwrap();assert!(c.valid());let mut points=1i64;
  for x in 0..r {points+=1+chi(sub(mul(mul(x,x,r),x,r),x,r),r)as i64}
  assert_eq!(r as i64+1-points,2*c.a);let p=dense(r,2);let h=((r-1)/2)as usize;let t=c.triple().unwrap();assert_eq!(t.seeds,[p[h],p[h-1]]);checks+=check(&t,8.min(h-1));count+=1;
  let mut bad=c.clone();bad.a=-bad.a;assert!(!bad.valid());assert!(matches!(bad.triple(),Err(Error::Certificate)));
 }println!("cm_primes={count} cm_moment_equalities={checks}");}
 #[test] fn large_prefix_partition_and_limits() {let r=998244353;let c=consecutive_cm(r,64).unwrap();let t=c.triple().unwrap();let mut sums=vec![0;33];for s in [-1,1]{for v in [-1,1]{for w in [-1,1]{let p=t.moments([s,v,w],32,32).unwrap();assert!(p[0]<=(r-1)/2);for j in 0..=32{sums[j]=add(sums[j],p[j],r)}}}}
  assert_eq!(sums[0],r-3);for j in 1..=32 {assert_eq!(sums[j],sub(0,add(pow(r-1,j as u64,r),pow(r-2,j as u64,r),r),r))}
  assert_eq!(t.moments([1,1,1],33,32),Err(Error::Limit));assert_eq!(t.moments([0,1,1],1,1),Err(Error::Sign));
  assert!(matches!(consecutive_cm(479,64),Err(Error::Domain)));assert!(matches!(consecutive_cm(13,0),Err(Error::Limit)));
  assert!(matches!(Triple::with_seeds(8,2,[0,0]),Err(Error::Domain)));assert!(matches!(Triple::with_seeds(7,1,[0,0]),Err(Error::Domain)));
  let t=consecutive_cm(13,64).unwrap().triple().unwrap();assert_eq!(t.moments([1,1,1],6,6),Err(Error::Limit));
  let mut altered=t.clone();altered.seeds[1]=add(altered.seeds[1],1,13);assert_ne!(altered.moments([1,1,1],1,1),t.moments([1,1,1],1,1));
  println!("large_scalar_prime={r} moment_prefix=33 classes=8 certificate_a={} certificate_b={}",c.a,c.b);
 }
}
