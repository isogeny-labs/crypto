digraph VerifiedGrowingGroup {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", nodesep=0.25, ranksep=0.28];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, fillcolor="#eef3fa", color="#2d4262", margin="0.15,0.10"];
  edge [color="#53657e", arrowsize=0.7];
  inputs [label="Every t: F3, g=12t+2, n=24t+5\nActual pairs identity and (X^d, ±1), 1≤d≤g"];
  runs [label="All ordered pairs: explicit normalized Cantor runs\nSame signs: compose, reduce once if needed\nOpposite signs: gcd cancellation / degree difference\nIdentity and input-swap certificates", fillcolor="#e6f3e9"];
  independent [label="Unique polynomial output and closure\npairwiseOutput / cantorAdd defined here\nBefore any group transport", fillcolor="#e6f3e9"];
  residues [label="Actual signed-residue bijection to ZMod n\nEvery candidate output respects residue addition"];
  group [label="Transport additive group; prove sum = cantorAdd\nEvery group sum has an actual normalized run", fillcolor="#e6f3e9"];
  generator [label="Actual generator coordinates (X,1), exact order n\nEvery member is generated by a scalar < n\nEarlier actualStep equals generator addition", fillcolor="#e6f3e9"];
  fractions [label="Unbounded genus and order\nAll group members smooth, fraction 1\nFull valid-pair ambient fraction < 1"];
  scope [label="64 declarations pass, 0 failing / 0 trusted-native\nGroup law verified on the family\nFull ambient group / geometric Picard bridge open\nKnown torsion family; signed standing unverified", fillcolor="#fce7e7"];
  inputs -> runs; runs -> independent;
  inputs -> residues; independent -> group; residues -> group;
  group -> generator; generator -> fractions; fractions -> scope;
}
