SetSeed(20261115);
R<x> := PolynomialRing(GF(2));
K<z> := ext<GF(2) | x^28+x^3+1>;
k := GF(16);
Embed(k,K);
a := z^25+z^24+z^23+z^22+z^21+z^19+z^17+z^15+z^13+z^12+z^9+z^2+z;
b := z^18+z^17+z^13+z^12+z^9+z^7+z^4+z^2+z;
assert a^16 eq a;
assert a+a^2+a^4+a^8 eq 1;
assert b+b^16+b^(16^2)+b^(16^3)+b^(16^4)+b^(16^5)+b^(16^6) eq 1;
for d in [1,2,4,7,14] do
    assert b^(2^d) ne b;
end for;
E := EllipticCurve([K | 1,a,0,0,b]);
r := 44735531;
assert IsPrime(r) and #E eq 268413186;
P := E![z^27+z^25+z^23+z^21+z^20+z^17+z^14+z^13+z^6+1,
        z^27+z^26+z^23+z^22+z^21+z^20+z^19+z^18+z^17+z^16+z^15+z^11+z^10+z^7+z^6+z^4+z^3+z^2+1,1];
assert P ne E!0 and r*P eq E!0;
Q := 1234567*P;
assert Q ne E!0;
assert WeilDescentGenus(E,k,K!1) eq 8;
cpu := Cputime();
wall := Realtime();
C,h := WeilDescent(E,k,K!1);
assert Type(C) eq CrvHyp and Genus(C) eq 8;
J := Jacobian(C);
G := h(P);
T := h(Q);
assert G ne J!0 and r*G eq J!0;
assert T eq 1234567*G and h(2*P) eq 2*G and h(3*P) eq 3*G;
print "source_order", #E;
print "source_prime", r;
print "source_point", P;
print "source_target", Q;
print "subfield_generator_in_K", K!k.1;
print "target_curve", C;
print "target_generator", G;
print "target_point", T;
print "target_genus", Genus(C);
print "image_order_r", G ne J!0 and r*G eq J!0;
print "map_cpu_sec", Cputime(cpu);
print "map_wall_sec", Realtime(wall);
