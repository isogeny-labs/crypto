+        committed["metadata"]["uid"] = json!("replacement");
+        assert!(validate_campaign_cas_response(&input, &committed).is_err());
+        committed["metadata"]["uid"] = json!("u");
+        committed["data"]["ledger.json"] = json!("changed bytes");
+        assert!(validate_campaign_cas_response(&input, &committed).is_err());
+    }
