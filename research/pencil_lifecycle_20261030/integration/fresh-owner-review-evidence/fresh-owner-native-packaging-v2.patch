+    }
+    let binding = if c.phase == "run" && findings.is_empty() && observed.is_some() {
+        match bind_files(&c.session, end.as_ref().ok_or("missing end")?, begin.raw_ns) {
+            Ok(v) => Some(v),
+            Err(e) => {
