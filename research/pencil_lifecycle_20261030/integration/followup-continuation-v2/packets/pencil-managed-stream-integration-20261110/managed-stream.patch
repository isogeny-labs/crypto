+/// Every input is retained as exact bytes and a FilePin. Semantic admission is
+/// performed by the native validators and the full-cohort aggregator, never by
+/// substituting a present file for a passed gate.
+fn export_attempt(a:&AttemptFiles,out:&Path)->Result<Value,String>{
+ if a.relation_stream.is_some()==a.relation_prefix.is_some(){
+   return Err("pencil attempt requires exactly one terminal stream or durable prefix".into())
+ }
+ let mut total=0usize;
+ let mut pin=|label:&str,path:&Path,cap:usize|->Result<Value,String>{
+   let b=read(path,cap)?; total=total.checked_add(b.len()).ok_or("attempt byte overflow")?;
+   if total>64*1024*1024{return Err("attempt export byte bound".into())}
+   write(out,label,&b)
+ };
+ let context=pin("context.json",&a.context,65536)?;
+ let ordinary_record=a.ordinary_record.as_ref().map(|p|pin("record.json",p,4*1024*1024)).transpose()?;
+ let mut progress=Vec::new();
+ for (i,p) in a.progress.iter().enumerate(){progress.push(pin(&format!("progress-{i:03}.json"),p,65536)?)}
+ let progress_totals=pin("progress-totals.json",&a.progress_totals,65536)?;
+ let relation_stream=a.relation_stream.as_ref().map(|p|pin("relations.jsonl",p,64*1024*1024)).transpose()?;
+ let relation_prefix=a.relation_prefix.as_ref().map(|p|pin("relations.partial.jsonl",p,64*1024*1024)).transpose()?;
+ let resource_prefix=a.resource_prefix.as_ref().map(|p|pin("resource-prefix.json",p,65536)).transpose()?;
+ let resource_tail=a.resource_tail.as_ref().map(|p|pin("resource-tail.json",p,65536)).transpose()?;
+ Ok(json!({"schema":"ecbench.pencil-attempt-join/v1","execution":a.execution,
+   "attempt":a.attempt,"context":context,"ordinary_record":ordinary_record,
+   "progress_files":progress,"progress_totals":progress_totals,
+   "relation_stream":relation_stream,"relation_prefix":relation_prefix,
+   "resource_prefix":resource_prefix,"resource_tail":resource_tail,
+   "process":pin("process.json",&a.process_observation,65536)?,
+   "controller":pin("controller.json",&a.controller_receipt,256*1024)?,
+   "cost_record":pin("cost.json",&a.cost_record,4*1024*1024)?}))
+}
