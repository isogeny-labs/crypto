+fn advance(
+    k: [u64; 4],
+    kp: [u64; 4],
+    kg: [u64; 4],
+    k0: [u64; 4],
+    constants: [u64; 4],
+    acts: &[(u64, [[u64; 4]; 4])],
+    j: &Jacobian,
+    t: &Value,
+    p: u64,
+    r: u64,
+    g: Divisor,
+    q: Divisor,
+    a: u64,
+    b: u64,
+    validate_transition: bool,
