+    let (next, choice, roots, evaluated, selected) = walk::step(k, kp, kg, k0, constants, acts, p);
+    if let Some((nk, nkp)) = next {
+        if validate_transition {
+            let aa = (2 * a + choice) % r;
+            let bb = (2 * b) % r;
+            let d = j.add(j.mul(g, aa), j.mul(q, bb));
+            let dplus = j.add(d, g);
