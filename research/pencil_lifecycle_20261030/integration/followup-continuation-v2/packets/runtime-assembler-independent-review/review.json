      "severity": "admission_obligation",
      "location": "assemble.py:105-110,60",
      "finding": "Synchronous context checks have only a pre-entry deadline check; final check may finish after deadline or pending signal and still return success. No hard whole-process deadline is enforced.",
      "resolution_required": "Reject final success after expiry or interruption, and retain external whole-process containment as unresolved."
    },
    {
      "id": "R2",
      "severity": "admission_obligation",
      "location": "assemble.py:83-90,121-124",
      "finding": "Client termination and tag readback do not prove Docker daemon build termination.",
      "resolution_required": "Operator-owned containment, reconciliation and finite accounting of unresolved daemon work before bounded admission."
    },
    {
      "id": "R3",
      "severity": "scope_limit",
      "finding": "Owner marker prevents repeat use of one owner; new-owner duplicates and lost/deleted markers require external reconciliation."
    },
    {
      "id": "R4",
      "severity": "scope_limit",
      "finding": "Pinned reviewer fields are structural assertions, not authentication. Trusted reviewer provenance is an external obligation."
    },
    {
      "id": "R5",
      "severity": "scope_limit",
      "finding": "Output polling detects overflow but is not a hard storage quota; daemon CPU/RAM are not enforced here."
    }
