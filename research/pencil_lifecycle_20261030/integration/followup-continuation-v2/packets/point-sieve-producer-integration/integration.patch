+                        v: [0; 2],
+                    };
+                    d.u[degree] = 1;
+                    for i in 0..degree {
+                        d.u[i] = z % p;
+                        z /= p;
+                        d.v[i] = z % p;
+                        z /= p;
+                    }
+                    for q in 0..=1 {
+                        pair(d, q, p, pairs, &mut coverage);
+                        pairs += 1;
