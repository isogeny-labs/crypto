+   'hard_is_infinity':hard==resource.RLIM_INFINITY}
+  R['native_limits']['getrlimit']=inherited;checkpoint()
+ qualified=all(v['soft_is_infinity'] and v['hard_is_infinity'] for v in inherited.values())
