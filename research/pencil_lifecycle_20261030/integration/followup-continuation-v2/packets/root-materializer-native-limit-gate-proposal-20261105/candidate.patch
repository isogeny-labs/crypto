+ checkpoint()
+ inherited={}
+ for name,kind in [('RLIMIT_AS',resource.RLIMIT_AS),('RLIMIT_DATA',resource.RLIMIT_DATA)]:
+  soft,hard=resource.getrlimit(kind)
