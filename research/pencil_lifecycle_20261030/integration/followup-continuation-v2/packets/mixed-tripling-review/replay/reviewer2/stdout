                  a.x * (b.z * b.z) = (other a b).x →
                    have c := rawOutput a1 a2 a3 a;
                    classify a b = Branch.positiveCoincidence ∧
                      2 ≠ 0 ∧ a.y ≠ 0 ∧ c.z ≠ 0 ∧ c.w ≠ 0 ∧ validTwo (MixedGeneric.curve a0 a1 a2 a3) c :=
fun {K} [Field K] [DecidableEq K] a0 a1 a2 a3 a b haz haw hbz hbw ha hb hk hc he =>
