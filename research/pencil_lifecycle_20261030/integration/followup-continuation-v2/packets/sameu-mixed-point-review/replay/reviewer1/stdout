theorem SameUMixed.source_point_valid.{u_1} : ∀ {K : Type u_1} [inst : Field K] (f : K[X]) (a b : D2 K),
  a.z ≠ 0 →
    a.w ≠ 0 →
      b.z ≠ 0 →
        b.w ≠ 0 →
          validTwo f a →
            validTwo f b →
              nq a = nq b →
                nr a = nr b →
                  ns a - ns b ≠ 0 →
                    ¬(ns a = -ns b ∧ nt a = -nt b) →
                      (sourcePoint a b).z ≠ 0 ∧ (sourcePoint a b).w ≠ 0 ∧ validPoint f (sourcePoint a b) :=
fun {K} [Field K] f a b haz haw hbz hbw ha hb hq hr hk hn =>
  have hb' :=
    Eq.mpr (id (congrArg (fun _a => MixedCancellation.support _a (nr a) ∣ f - ordinate (ns b) (nt b) ^ 2) hq))
      (Eq.mpr (id (congrArg (fun _a => MixedCancellation.support (nq b) _a ∣ f - ordinate (ns b) (nt b) ^ 2) hr)) hb);
  have hv := (extracted_point_valid f (nq a) (nr a) (ns a) (nt a) (ns b) (nt b) ha hb' hk hn).right;
  And.casesOn (source_point_decode a b haz haw hbz hbw hk) fun hz right =>
    And.casesOn right fun hw right =>
      And.casesOn right fun hx hy =>
        ⟨hz,
          ⟨hw,
            id
              (Eq.mpr (id (congrArg (fun _a => X - C _a ∣ f - C (WeightedAdd11.ny (sourcePoint a b)) ^ 2) hx))
                (Eq.mpr (id (congrArg (fun _a => X - C ((nt b - nt a) / (ns a - ns b)) ∣ f - C _a ^ 2) hy)) hv))⟩⟩
