MixedPositiveDistinct.source_branch_preserves.{u_1} {K : Type u_1} [Field K] [DecidableEq K] (a0 a1 a2 a3 : K)
  (a : WeightedAdd11.Input K) (b : MixedCancellation.D2 K) (haz : a.z ≠ 0) (haw : a.w ≠ 0) (hbz : b.z ≠ 0)
  (hbw : b.w ≠ 0) (ha : MixedCancellation.validPoint (MixedGeneric.curve a0 a1 a2 a3) a)
  (hb : MixedCancellation.validTwo (MixedGeneric.curve a0 a1 a2 a3) b) (hk : MixedCancellation.rawK a b = 0)
  (hc : a.y * MixedCancellation.rawW3 b ≠ -(MixedCancellation.rawY3 a b * a.w))
  (hd : a.x * (b.z * b.z) ≠ (MixedCancellation.other a b).x) :
  have d := MixedPositiveDistinct.doubled a0 a1 a2 a3 a;
  have c := MixedGeneric.output (MixedCancellation.other a b) d a3;
