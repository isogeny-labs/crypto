# Preserve verbatim receipt-bound diagnostic output.
packets/mixed-positive-word/controls1/stdout -whitespace
packets/mixed-positive-word/controls2/stdout -whitespace
packets/mixed-positive-word/report.log -whitespace
preflight-review/boxed-request-software-checks/typed-retained/stdout -whitespace
packets/mixed-positive-word/controls3/stdout -whitespace

# Additional immutable producer diagnostics and reviewed patch artifacts.
packets/**/stdout -whitespace
packets/**/*.patch -whitespace
packets/**/report.log -whitespace
preflight-review/**/stdout -whitespace
packets/**/*.stdout -whitespace
packets/benchlock-controls-*/benchlock.rs whitespace=-blank-at-eof

