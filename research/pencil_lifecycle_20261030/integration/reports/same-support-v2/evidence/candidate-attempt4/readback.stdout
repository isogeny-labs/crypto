@SameSupportCandidate.valid_inputs_exclude_same_support_error : ∀ {K : Type u_1} [inst : Field K]
  [inst_1 : DecidableEq K] (f : Polynomial K) (q r s1 t1 s2 t2 : K),
  2 ≠ 0 →
    Polynomial.X ^ 2 + Polynomial.C q * Polynomial.X + Polynomial.C r ∣
        f - (Polynomial.C s1 * Polynomial.X + Polynomial.C t1) ^ 2 →
      Polynomial.X ^ 2 + Polynomial.C q * Polynomial.X + Polynomial.C r ∣
          f - (Polynomial.C s2 * Polynomial.X + Polynomial.C t2) ^ 2 →
        ProjectiveLawRuntime.classifySameU22 s1 t1 s2 t2 ≠ ProjectiveLawRuntime.Branch22Prelude.sameUMixedZeroSlope
'SameSupportCandidate.valid_inputs_exclude_same_support_error' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
