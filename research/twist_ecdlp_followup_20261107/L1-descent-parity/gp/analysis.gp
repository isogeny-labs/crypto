default(parisizemax,1000000000);
read(Str(getenv("GPDIR"),"/lib.gp"));
SIZES=eval(Str("[",getenv("SIZES"),"]"));
BOOT=eval(getenv("BOOT"));
setrand(7000005);
PRICES=[0,0.1,1];
ARMS=["A","B","Bp","D","Dh","Dq","C"];
ARMREC=Map(["A",1;"B",1;"Bp",1;"D",4;"Dh",4;"Dq",4;"C",3]);
jf=Str(OUTDIR,"/results.json");mf=Str(OUTDIR,"/RESULTS.md");
system(Str("rm -f ",jf," ",mf));
rd(f)={my(L);if(!fileisreg(f),return([]));L=readstr(f);if(#L<2,return([]));vector(#L-1,i,eval(Str("[",L[i+1],"]")))}
fileisreg(f)=(externstr(Str("test -f ",f," && echo 1 || echo 0"))[1]=="1");
med(v)={my(w=vecsort(v),n=#w);if(n==0,return(0));if(n%2,w[(n+1)/2],(w[n/2]+w[n/2+1])/2)}
mean(v)=vecsum(v)/#v;
bci(v)={my(n=#v,m=vector(BOOT));for(b=1,BOOT,m[b]=med(vector(n,j,v[1+random(n)])));m=vecsort(m);[m[ceil(0.025*BOOT)],m[floor(0.975*BOOT)+1]]}
fl(x)=if(type(x)=="t_VEC",vector(#x,i,fl(x[i])),x*1.0);
nospace(t)=strjoin(strsplit(t," "),"");
fmt(x)=if(type(x)=="t_VEC",Str("[",strjoin(vector(#x,i,fmt(x[i])),","),"]"),if(type(x)=="t_STR",Str("\"",x,"\""),if(type(x)=="t_INT",Str(x),nospace(strprintf("%.6g",x*1.0)))));
JS=List();
jadd(s)=listput(JS,s);
\\ json object builder from [key,value,...] pairs
jo(v)=Str("{",strjoin(vector(#v\2,i,Str("\"",v[2*i-1],"\":",fmt(v[2*i]))),","),"}");
md(s)=write(mf,s);
g4(x)=nospace(strprintf("%.4g",x*1.0));
g3(x)=nospace(strprintf("%.3g",x*1.0));
ci4(c)=Str("[",g3(c[1]),", ",g3(c[2]),"]");

\\ ---------- data access
RECS=Map();ICR=Map();RHO=Map();CEN=Map();CTL=Map();
loadsize(s)={
  my(r);
  mapput(RECS,s,rd(Str(OUTDIR,"/curves_",s,".csv")));
  foreach(ARMS,a,mapput(ICR,[a,s],rd(Str(OUTDIR,"/ic_",a,"_",s,".csv"))));
  mapput(RHO,s,rd(Str(OUTDIR,"/rho_",s,".csv")));
  mapput(CEN,s,rd(Str(OUTDIR,"/census_",s,".csv")));
  mapput(CTL,s,readstr(Str(OUTDIR,"/controls_",s,".csv")));
}
getrec(s,armrec,inst)={my(R=mapget(RECS,s));for(i=1,#R,if(R[i][1]==armrec&&R[i][3]==inst,return(R[i])));0}
precomp(rec)=2*ceil(#binary(rec[13])/8)*262;
\\ per-instance medians over replicates of f(run); returns [ids,values]
perinst(rows,f)={
  my(ids=vecsort(Set(vector(#rows,i,rows[i][3]))),m=Map(),out);
  for(i=1,#rows,my(id=rows[i][3],cur);if(mapisdefined(m,id,&cur),mapput(m,id,concat(cur,[f(rows[i])])),mapput(m,id,[f(rows[i])])));
  [ids,vector(#ids,i,med(mapget(m,ids[i])))];
}
icrows(a,s)=mapget(ICR,[a,s]);
\\ cost of an IC run: GAE + c*NAT (with or without the one-time comb precomputation)
iccost(s,armrec,c,incl)=(r->my(rec=getrec(s,armrec,r[3]));r[17]-if(incl,0,precomp(rec))+c*r[18]);
rhorows(s,armrec,mode)=select(r->r[1]==armrec&&r[4]==mode,mapget(RHO,s));
rhocost(c,setup)=(r->r[11]+if(setup,r[14],0)+c*r[12]);

\\ bootstrapped median of paired ratios num_i/den_i
pratio(num,den)={my(r=vector(#num,i,num[i]/den[i]));[med(r),bci(r)]}
\\ verdict from three price triples [med,[lo,hi]]
rank3(rt)={
  my(lt=1,gt=1);
  for(i=1,3,if(!(rt[i][1]<1&&rt[i][2][2]<1),lt=0);if(!(rt[i][1]>1&&rt[i][2][1]>1),gt=0));
  if(lt,"numerator cheaper at all c (CI excludes 1)",if(gt,"numerator costlier at all c (CI excludes 1)","order not stable across the band"));
}

\\ ================= cell statistics =================
CELL=Map();
cellstats(a,s)={
  my(rows=icrows(a,s),pi,ids,res=List(),nf,att,krel,gae,nat,la,ci,costs,costsx,mc,p,kdeg,armrec,pr,reps);
  if(#rows==0,return(0));
  armrec=mapget(ARMREC,a);
  pi=perinst(rows,(r->r[7]));ids=pi[1];att=pi[2];
  krel=perinst(rows,(r->r[9]))[2];
  mc=perinst(rows,(r->r[25]))[2];
  gae=perinst(rows,(r->r[17]))[2];nat=perinst(rows,(r->r[18]))[2];
  la=perinst(rows,(r->r[19]/r[18]))[2];
  costs=vector(3,k,perinst(rows,iccost(s,armrec,PRICES[k],1))[2]);
  costsx=vector(3,k,perinst(rows,iccost(s,armrec,PRICES[k],0))[2]);
  nf=#select(r->r[6]==0,rows);
  p=getrec(s,armrec,ids[1])[4];
  reps=#rows/#ids;
  mapput(CELL,[a,s],[ids,att,krel,mc,gae,nat,la,costs,costsx,nf,#rows,reps,p]);
}

\\ ================= run =================
foreach(SIZES,s,loadsize(s));
foreach(SIZES,s,foreach(ARMS,a,cellstats(a,s)));

md("# RESULTS L1-descent-parity");
md("");
md("Generated by `gp/analysis.gp` from the CSV files in this directory (fixed seed 7000005 for the bootstrap, BOOT resamples over instances). Every number below is read from those files; nothing is quoted from memory or from the smoke runs. All sizes are toy sizes and nothing here is a statement about cryptographic security or about a speedup over the repository's index-calculus baseline.");
md("");
md(Str("Sizes analysed: ",SIZES,". Unit conventions are those of PREREGISTRATION.md section 1: GAE = group addition equivalent, NAT = unpriced native operation, priced cost = GAE + c NAT for c in {0, 0.1, 1}. Wall time is not used anywhere (4 cores shared with other agents)."));
md("");

\\ ---------- table 1: IC cells
md("## 1. Index-calculus cells (per-instance medians over attempt streams; cell median and bootstrap 95% CI over instances)");
md("");
md("| arm | s | p | instances | streams/instance | failed runs | attempts | relations needed k* | columns M | k*/M | GAE (incl. comb precomputation) | NAT | LA share of NAT | priced c=0 | priced c=0.1 | priced c=1 |");
md("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|");
cellrows()={
  my(c,ids,att,krel,mc,gae,nat,la,costs,jl=List());
  foreach(SIZES,s,foreach(ARMS,a,
    if(!mapisdefined(CELL,[a,s],&c),next);
    ids=c[1];att=c[2];krel=c[3];mc=c[4];gae=c[5];nat=c[6];la=c[7];costs=c[8];
    my(kM=vector(#ids,i,krel[i]/mc[i]),ca=bci(att),ck=bci(krel),ckm=bci(kM),cc=vector(3,k,bci(costs[k])));
    md(Str("| ",a," | ",s," | ",c[13]," | ",#ids," | ",g3(c[12])," | ",c[10]," | ",g4(med(att))," ",ci4(ca)," | ",g4(med(krel))," ",ci4(ck)," | ",g4(med(mc))," | ",g4(med(kM))," ",ci4(ckm)," | ",g4(med(gae))," | ",g4(med(nat))," | ",g3(med(la))," | ",g4(med(costs[1]))," ",ci4(cc[1])," | ",g4(med(costs[2]))," ",ci4(cc[2])," | ",g4(med(costs[3]))," ",ci4(cc[3])," |"));
    jadd(jo(["arm",a,"s",s,"p",c[13],"n_instances",#ids,"streams_per_instance",c[12],"failed_runs",c[10],"runs",c[11],"attempts_med",med(att),"attempts_ci",bci(att),"krel_med",med(krel),"krel_ci",ck,"M_med",med(mc),"k_over_M_med",med(kM),"k_over_M_ci",ckm,"GAE_med",med(gae),"NAT_med",med(nat),"LA_share_med",med(la),"cost_c0_med",med(costs[1]),"cost_c0_ci",cc[1],"cost_c0.1_med",med(costs[2]),"cost_c0.1_ci",cc[2],"cost_c1_med",med(costs[3]),"cost_c1_ci",cc[3]]));
  ));
}
cellrows();
md("");

\\ ---------- table 2: rho cells, calibration (PC3), NC3
md("## 2. Matched Pollard rho with negation map on <G*> (order l*), calibration PC3 and null control NC3");
md("");
md("| group | s | instances | matched runs | failed | mean steps / (0.886 sqrt(l*)) | PC3 [0.9, 1.35] | steps median | priced c=0 | priced c=0.1 | priced c=1 | NC3 ratio of mean steps (random target / real target) [95% CI] | NC3 contains 1 |");
md("|---|---|---|---|---|---|---|---|---|---|---|---|---|");
RHOCELL=Map();
rhorowsum()={
  my(m1,m3,ids,cr,st,ra,cal,nc3,pi,jl);
  foreach(SIZES,s,foreach([1,4,3],ar,
    m1=rhorows(s,ar,1);m3=rhorows(s,ar,3);if(#m1==0,next);
    ids=vecsort(Set(vector(#m1,i,m1[i][3])));
    ra=vector(#m1,i,m1[i][8]/m1[i][16]);cal=mean(ra);
    cr=vector(3,k,perinst(m1,rhocost(PRICES[k],0))[2]);
    st=perinst(m1,(r->r[8]))[2];
    \\ NC3: per instance mean steps (5 matched) vs the single random-target run
    my(a1=vector(#ids,i,mean(vector(5,j,select(r->r[3]==ids[i],m1)[j][8]))),a3=vector(#ids,i,select(r->r[3]==ids[i],m3)[1][8]),rr=vector(BOOT));
    for(b=1,BOOT,my(sa=0,sb=0);for(j=1,#ids,my(t=1+random(#ids));sa+=a3[t];sb+=a1[t]);rr[b]=sa/sb);
    rr=vecsort(rr);nc3=[vecsum(a3)/vecsum(a1),[rr[ceil(0.025*BOOT)],rr[floor(0.975*BOOT)+1]]];
    my(nm=if(ar==1,"A,B (F_p curves)",if(ar==4,"D (F_p^2 generic)","C (F_p^3 generic)")),ok=(cal>=0.9&&cal<=1.35));
    mapput(RHOCELL,[ar,s],[ids,cr,cal,ok,nc3,#select(r->r[7]==0,m1)]);
    md(Str("| ",nm," | ",s," | ",#ids," | ",#m1," | ",#select(r->r[7]==0,m1)," | ",g4(cal)," | ",if(ok,"pass","MISCALIBRATED")," | ",g4(med(st))," | ",g4(med(cr[1]))," | ",g4(med(cr[2]))," | ",g4(med(cr[3]))," | ",g4(nc3[1])," ",ci4(nc3[2])," | ",if(nc3[2][1]<=1&&nc3[2][2]>=1,"yes","NO")," |"));
    jadd(jo(["rho_group",nm,"s",s,"instances",#ids,"matched_runs",#m1,"failed",#select(r->r[7]==0,m1),"mean_steps_over_0.886sqrtL",cal,"PC3_pass",if(ok,1,0),"steps_med",med(st),"cost_c0_med",med(cr[1]),"cost_c0.1_med",med(cr[2]),"cost_c1_med",med(cr[3]),"NC3_ratio",nc3[1],"NC3_ci",nc3[2]]));
  ));
}
rhorowsum();
md("");
md("Rho pricing: steps + doublings as GAE, 5 NAT per step (frozen). The one-time cost of the 16 step-table points and of the random start points is reported separately in `rho_<s>.csv` (column GAEsetup) and is not included here, following the frozen GAE list of section 5 (this choice favours rho).");
md("");

\\ ================= paired comparisons =================
md("## 3. Paired comparisons and the GAE-band table");
md("");
md("Ratios are medians over instances of the per-instance ratio (each instance's value is the median over its attempt streams), with a 95% percentile bootstrap interval over instances. A ranking is stated only where the median ratio and its interval lie on the same side of 1 at c = 0, 0.1 and 1 (section 5); otherwise the row says the order is not stable. Priced cost includes the one-time comb precomputation (frozen rule); the no-precomputation rows are a labelled sensitivity analysis.");
md("");
md("| comparison | s | n | attempts ratio | k* ratio | priced ratio c=0 | c=0.1 | c=1 | verdict (ranking rule) |");
md("|---|---|---|---|---|---|---|---|---|");
PAIR=Map();
doc(label,s,nm,att,kr,rt,verd)={
  md(Str("| ",label," | ",s," | ",nm," | ",if(att==0,"-",Str(g4(att[1])," ",ci4(att[2])))," | ",if(kr==0,"-",Str(g4(kr[1])," ",ci4(kr[2])))," | ",g4(rt[1][1])," ",ci4(rt[1][2])," | ",g4(rt[2][1])," ",ci4(rt[2][2])," | ",g4(rt[3][1])," ",ci4(rt[3][2])," | ",verd," |"));
  jadd(jo(["comparison",label,"s",s,"n",nm,"attempts_ratio",if(att==0,[],concat([att[1]],att[2])),"kstar_ratio",if(kr==0,[],concat([kr[1]],kr[2])),"ratio_c0",concat([rt[1][1]],rt[1][2]),"ratio_c0.1",concat([rt[2][1]],rt[2][2]),"ratio_c1",concat([rt[3][1]],rt[3][2]),"verdict",verd]));
}
\\ IC arm X over IC arm Y on the same instances
icpair(X,Y,s,tag,incl)={
  my(cx,cy,rt,att,kr,rx,ry,key=[X,Y,s]);
  if(!mapisdefined(CELL,[X,s])||!mapisdefined(CELL,[Y,s]),return(0));
  cx=mapget(CELL,[X,s]);cy=mapget(CELL,[Y,s]);
  if(incl,
    rt=vector(3,k,pratio(cx[8][k],cy[8][k])),
    rt=vector(3,k,pratio(cx[9][k],cy[9][k])));
  att=pratio(cx[2],cy[2]);kr=pratio(cx[3],cy[3]);
  mapput(PAIR,[X,Y,s,incl],[att,kr,rt]);
  doc(Str(tag,if(incl,""," (no comb precomputation, sensitivity)")),s,#cx[1],att,kr,rt,rank3(rt));
}
\\ IC arm over its matched rho
rhopair(X,s)={
  my(cx,ar=mapget(ARMREC,X),rc,rt,cal,ok,rx);
  if(!mapisdefined(CELL,[X,s]),return(0));
  cx=mapget(CELL,[X,s]);
  if(!mapisdefined(RHOCELL,[ar,s],&rc),return(0));
  rt=vector(3,k,pratio(cx[8][k],rc[2][k]));
  ok=rc[4];
  mapput(PAIR,[X,"rho",s],[rt,ok,[vector(3,k,med(cx[8][k])),vector(3,k,med(rc[2][k]))]]);
  doc(Str(X," / matched rho",if(ok,""," (rho MISCALIBRATED: no ranking)")),s,#cx[1],0,0,rt,if(ok,rank3(rt),"not ranked: rho miscalibrated in this cell"));
}
cmpall()={
  foreach(SIZES,s,
    icpair("A","B",s,"A / B (doubling isolated)",1);
    icpair("A","B",s,"A / B (doubling isolated)",0);
    icpair("Bp","B",s,"B' / B (NC1 null half)",1);
    icpair("Dh","D",s,"D-half / D (PC1)",1);
    icpair("Dq","D",s,"D-quarter / D (PC1)",1);
    foreach(["A","B","D","C"],X,rhopair(X,s)));
}
cmpall();
md("");

\\ cross-arm (secondary): A versus D at the same p, independent instances, ratio of cell medians
md("### 3b. Subfield control A versus D (cross-arm, secondary; A solves l* ~ p, D solves N ~ p^2)");
md("");
md("| s | p | attempts A | attempts D | D/A attempts | predicted D/A = 0.49 p / (0.886 sqrt(p)) | within factor 1.5 | D/A >= 3 |");
md("|---|---|---|---|---|---|---|---|");
H7=Map();
h7()={
  my(ca,cd,ra,rd2,pr,r,rr);
  foreach(SIZES,s,
    if(!mapisdefined(CELL,["D",s]),next);
    ca=mapget(CELL,["A",s]);cd=mapget(CELL,["D",s]);
    ra=med(ca[2]);rd2=med(cd[2]);pr=0.49*ca[13]/(0.886*sqrt(ca[13]));r=rd2/ra;
    my(bb=vector(BOOT,b,med(vector(#cd[2],j,cd[2][1+random(#cd[2])]))/med(vector(#ca[2],j,ca[2][1+random(#ca[2])]))));bb=vecsort(bb);
    mapput(H7,s,[r,pr,[bb[ceil(0.025*BOOT)],bb[floor(0.975*BOOT)+1]]]);
    md(Str("| ",s," | ",ca[13]," | ",g4(ra)," | ",g4(rd2)," | ",g4(r)," ",ci4([bb[ceil(0.025*BOOT)],bb[floor(0.975*BOOT)+1]])," | ",g4(pr)," | ",if(r/pr<=1.5&&r/pr>=1/1.5,"yes","no")," | ",if(r>=3,"yes","no")," |"));
    jadd(jo(["subfield_control_s",s,"p",ca[13],"attempts_A",ra,"attempts_D",rd2,"D_over_A",r,"predicted",pr]));
  );
}
h7();
md("");

\\ ================= census (H1, H2, P1, P2) and PC1 rate ratios =================
cenv(s,armrec,var)=select(r->r[1]==armrec&&r[4]==var,mapget(CEN,s));
bpool(n1,n2)={ \\ ratio of sums, bootstrap over instances
  my(n=#n1,rr=vector(BOOT));
  for(b=1,BOOT,my(sa=0,sb=0);for(j=1,n,my(t=1+random(n));sa+=n1[t];sb+=n2[t]);rr[b]=sa/sb);
  rr=vecsort(rr);[vecsum(n1)/vecsum(n2),[rr[ceil(0.025*BOOT)],rr[floor(0.975*BOOT)+1]]];
}
md("## 4. Census over random targets (H1, H2, P1, P2) and factor-base halving (PC1 rate)");
md("");
md("Degenerate draws (x(R) in F_p, outside the hypothesis of L1(ii); frequency about 1/p) are counted separately and excluded from the per-target statistics; their target-generation cost is still charged in the run totals (DEVIATIONS.md D1).");
md("");
md("| s | targets (non-degenerate) | degenerate draws | A: D(R)=0 | D(R)=1 | D(R)=2 | D(R)>=3 | A rate (relations per attempt) | B rate [95% CI] | B' rate [95% CI] | H2 B within 1/4 +- 0.01 | H1 |");
md("|---|---|---|---|---|---|---|---|---|---|---|---|");
CENS=Map();
cens()={
  my(a,b,bp,ntA,ndA,h,rB,rBp,okH1,okH2,rA);
  foreach(SIZES,s,
    a=cenv(s,1,1);b=cenv(s,1,2);bp=cenv(s,1,3);
    if(#a==0,next);
    ntA=vecsum(vector(#a,i,a[i][5]));ndA=vecsum(vector(#a,i,a[i][6]));
    h=vector(6,k,vecsum(vector(#a,i,a[i][6+k])));
    rA=vecsum(vector(#a,i,a[i][13]))/ntA;
    rB=bpool(vector(#b,i,b[i][13]),vector(#b,i,b[i][5]));
    rBp=bpool(vector(#bp,i,bp[i][13]),vector(#bp,i,bp[i][5]));
    okH1=(h[2]==ntA);okH2=(abs(rB[1]-0.25)<=0.01&&rA>=1);
    mapput(CENS,s,[ntA,ndA,h,rA,rB,rBp,okH1,okH2]);
    md(Str("| ",s," | ",ntA," | ",ndA," | ",h[1]," | ",h[2]," | ",h[3]," | ",h[4]+h[5]+h[6]," | ",g4(rA)," | ",g4(rB[1])," ",ci4(rB[2])," | ",g4(rBp[1])," ",ci4(rBp[2])," | ",if(okH2,"yes","NO")," | ",if(okH1,"holds (D(R)=1 for every non-degenerate target)","FALSIFIED")," |"));
    jadd(jo(["census_s",s,"targets",ntA,"degenerate",ndA,"hist_D0_to_5plus",h,"A_rate",rA,"B_rate",rB[1],"B_rate_ci",rB[2],"Bp_rate",rBp[1],"Bp_rate_ci",rBp[2],"H1_holds",if(okH1,1,0),"H2_holds",if(okH2,1,0)]));
  );
}
cens();
md("");
md("Naive (random-model) predictions rejected if H2 holds: A mean 2 relations per attempt, B mean 1/2 per attempt (structure-aware: 1 and 1/4).");
md("");

\\ ---- PC1
md("### PC1 (factor-base size effect on D)");
md("");
md("| s | rate half/D (pred 0.25) | rate quarter/D (pred 0.0625) | attempts half/D (pred 2) | attempts quarter/D (pred 4) | passes (CI excludes 1 and inside +-25% of prediction) |");
md("|---|---|---|---|---|---|");
PC1=Map();
pc1()={
  my(d1,d2,d3,r2,r3,a2,a3,p,res);
  foreach(SIZES,s,
    d1=cenv(s,4,1);d2=cenv(s,4,2);d3=cenv(s,4,3);
    if(#d1==0||!mapisdefined(PAIR,["Dh","D",s,1]),next);
    r2=bpool(vector(#d2,i,d2[i][13]),vector(#d1,i,d1[i][13]));
    r3=bpool(vector(#d3,i,d3[i][13]),vector(#d1,i,d1[i][13]));
    a2=mapget(PAIR,["Dh","D",s,1])[1];a3=mapget(PAIR,["Dq","D",s,1])[1];
    my(ok(m,ci,pr)=(ci[1]>1||ci[2]<1)&&ci[1]>=0.75*pr&&ci[2]<=1.25*pr);
    res=[ok(r2[1],r2[2],0.25),ok(r3[1],r3[2],1/16),ok(a2[1],a2[2],2),ok(a3[1],a3[2],4)];
    mapput(PC1,s,res);
    md(Str("| ",s," | ",g4(r2[1])," ",ci4(r2[2])," | ",g4(r3[1])," ",ci4(r3[2])," | ",g4(a2[1])," ",ci4(a2[2])," | ",g4(a3[1])," ",ci4(a3[2])," | ",strjoin(vector(4,i,if(res[i],"pass","fail")),", ")," |"));
    jadd(jo(["PC1_s",s,"rate_half",concat([r2[1]],r2[2]),"rate_quarter",concat([r3[1]],r3[2]),"att_half",concat([a2[1]],a2[2]),"att_quarter",concat([a3[1]],a3[2]),"passes",vector(4,i,if(res[i],1,0))]));
  );
}
pc1();
PC1OK=0;
pc1verdict()={
  my(tot=vector(4),ns=0);
  foreach(SIZES,s,my(r);if(mapisdefined(PC1,s,&r),ns++;for(i=1,4,tot[i]+=r[i])));
  PC1OK=(ns>=2&&vecmin(tot)>=2);
  md("");
  md(Str("PC1 verdict: sizes with D-half and D-quarter runs = ",ns,"; sizes passing per statistic [rate half, rate quarter, attempts half, attempts quarter] = ",tot,"; PC1 ",if(PC1OK,"PASSES (needs >= 2 sizes for each statistic).","FAILS: all A-versus-B conclusions below are voided as 'instrument not validated'.")));
  md("");
}
pc1verdict();

\\ ================= hypotheses H3 .. H8 =================
md("## 5. Hypotheses");
md("");
H3()={
  my(r,pr,pm);
  md("### H3 (attempts ratio A/B), H4 (priced A/B), H6 (linear-algebra share)");
  md("");
  md("| s | attempts A/B (median of per-instance ratio, CI) | model prediction at the measured M (A: sqrt(pi M/2)+2/3; B: 4 x same) | contains 0.354 | contains 0.5 | contains 1 | verdict H3 | priced A/B in [0.30,0.45] at all c | CI upper < 1 at all c | verdict H4 | max LA share of NAT, A / B | H6 (< 5%) |");
  md("|---|---|---|---|---|---|---|---|---|---|---|---|");
  foreach(SIZES,s,
    my(pa=mapget(PAIR,["A","B",s,1]),att=pa[1],rt=pa[3],ca=mapget(CELL,["A",s]),cb=mapget(CELL,["B",s]));
    my(pm=med(vector(#ca[1],i,(sqrt(Pi*ca[4][i]/2)+2/3)/(4*(sqrt(Pi*cb[4][i]/2)+2/3)))));
    my(c354=(att[2][1]<=0.354&&att[2][2]>=0.354),c5=(att[2][1]<=0.5&&att[2][2]>=0.5),c1=(att[2][1]<=1&&att[2][2]>=1));
    my(v3=if(att[2][2]>=1,"doubling does not help (CI upper >= 1)",if(c354&&!c1,"structure-aware model supported",if(c5&&!c354,"naive model supported","neither prediction contained"))));
    my(inr=(rt[1][1]>=0.30&&rt[1][1]<=0.45&&rt[2][1]>=0.30&&rt[2][1]<=0.45&&rt[3][1]>=0.30&&rt[3][1]<=0.45),up1=(rt[1][2][2]<1&&rt[2][2][2]<1&&rt[3][2][2]<1));
    my(v4=if(!up1,"falsified (CI upper >= 1 at some c)",if(inr,"supported","ratio below 1 at all c, but outside [0.30,0.45] at some c")));
    my(lA=vecmax(ca[7]),lB=vecmax(cb[7]),h6=(lA<0.05&&lB<0.05));
    md(Str("| ",s," | ",g4(att[1])," ",ci4(att[2])," | ",g4(pm)," | ",if(c354,"yes","no")," | ",if(c5,"yes","no")," | ",if(c1,"yes","no")," | ",v3," | ",if(inr,"yes","no")," | ",if(up1,"yes","no")," | ",v4," | ",g3(lA)," / ",g3(lB)," | ",if(h6,"holds","does not hold")," |"));
    jadd(jo(["H3H4H6_s",s,"att_ratio",concat([att[1]],att[2]),"model_pred",pm,"H3",v3,"H4",v4,"LA_share_max_A",lA,"LA_share_max_B",lB,"H6_holds",if(h6,1,0)]));
  );
  md("");
}
H3();

H5()={
  md("### H5 (relations needed)");
  md("");
  md("| arm | s | median k*/M | tolerance | inside | dense scaling k* ~ |F| (k*/M ~ 2) rejected (k*/M < 1) | k* vs birthday sqrt(pi M/2)+2/3 (A,B,B'): median ratio | within +-30% |");
  md("|---|---|---|---|---|---|---|---|");
  foreach(SIZES,s,foreach(["A","B","Bp","D","Dh","Dq","C"],a,
    my(c,kM,tol,ins,bday,bd,okb);
    if(!mapisdefined(CELL,[a,s],&c),next);
    kM=med(vector(#c[1],i,c[3][i]/c[4][i]));
    tol=if(a=="D",[0.40,0.65],if(a=="C",[0.75,1.15],[0,0]));
    ins=if(tol[2]==0,"-",if(kM>=tol[1]&&kM<=tol[2],"yes","no"));
    bd=if(a=="A"||a=="B"||a=="Bp",med(vector(#c[1],i,c[3][i]/(sqrt(Pi*c[4][i]/2)+2/3))),0);
    okb=if(bd==0,"-",if(bd>=0.7&&bd<=1.3,"yes","no"));
    md(Str("| ",a," | ",s," | ",g4(kM)," | ",if(tol[2]==0,"-",Str("[",g3(tol[1]),", ",g3(tol[2]),"]"))," | ",ins," | ",if(kM<1,"yes","no")," | ",if(bd==0,"-",g4(bd))," | ",okb," |"));
    jadd(jo(["H5_arm",a,"s",s,"kM_med",kM,"tolerance_ok",ins,"birthday_ratio",bd,"birthday_ok",okb]));
  ));
  md("");
}
H5();

H7note()={
  md("### H7 (subfield control) and the lead's hypothesis");
  md("");
  md("See table 3b. H7 holds at a size if D/A is within a factor 1.5 of the prediction and A's advantage is at least 3x at p ~ 2^10 (s = 20). The doubling itself is isolated only by A versus B (section 3, H3/H4).");
  md("");
}
H7note();

\\ ================= H8: gap to matched rho =================
md("### H8 and the gap to matched rho (distance remaining)");
md("");
md("Ratio = IC priced cost / matched-rho priced cost on the same instance (median over instances, 95% CI). A ratio above 1 means rho is cheaper by that factor; this is reported as the distance remaining, not as a pass/fail gate (owner's success criterion). A value below 1 would be flagged and re-verified before any statement.");
md("");
md("| arm | s | IC median c=0 | rho median c=0 | ratio c=0 | ratio c=0.1 | ratio c=1 | rho calibrated (PC3) | ranking |");
md("|---|---|---|---|---|---|---|---|---|");
H8()={
  my(pr,rt,ok,m);
  foreach(SIZES,s,foreach(["A","B","D","C"],X,
    if(!mapisdefined(PAIR,[X,"rho",s],&pr),next);
    rt=pr[1];ok=pr[2];m=pr[3];
    md(Str("| ",X," | ",s," | ",g4(m[1][1])," | ",g4(m[2][1])," | ",g4(rt[1][1])," ",ci4(rt[1][2])," | ",g4(rt[2][1])," ",ci4(rt[2][2])," | ",g4(rt[3][1])," ",ci4(rt[3][2])," | ",if(ok,"pass","MISCALIBRATED")," | ",if(ok,rank3(rt),"not ranked")," |"));
    if(ok&&(rt[1][1]<1||rt[2][1]<1||rt[3][1]<1),md(Str("FLAG: ratio below 1 for ",X," at s = ",s,"; must be re-verified before any statement.")));
  ));
  md("");
}
H8();

md("### Information only: rho on the whole group order N for the F_p-curve instances (the L3 point)");
md("");
md("| s | steps rho on <G*> (median) | steps rho on N (median) | ratio | predicted sqrt(N/l*) scale |");
md("|---|---|---|---|---|");
L3()={
  my(m1,m2);
  foreach(SIZES,s,
    m1=rhorows(s,1,1);m2=rhorows(s,1,2);if(#m2==0,next);
    my(a=perinst(m1,(r->r[8]))[2],b=perinst(m2,(r->r[8]))[2],pr=med(vector(#m1,i,sqrt(m2[1][15]/m1[i][15]))));
    md(Str("| ",s," | ",g4(med(a))," | ",g4(med(b))," | ",g4(med(b)/med(a))," | ",g4(med(vector(#a,i,sqrt(getrec(s,1,i)[13]/getrec(s,1,i)[16]))))," |"));
    jadd(jo(["L3_s",s,"steps_lstar_med",med(a),"steps_N_med",med(b)]));
  );
  md("");
}
L3();

md("### Uncharged one-time work (reported, not priced)");
md("");
md("Factor-base construction (one square root per abscissa, charged at the frozen square-root cost) is done once per instance and is not included in any priced cost above, for every IC arm; the rho baseline has no analogue. Formula value p x sqrt-cost NAT:");
md("");
md("| s | A,B,D (p, F_p^2 sqrt cost) | C (p, F_p^3 sqrt cost) |");
md("|---|---|---|");
fbn()={
  foreach(SIZES,s,
    my(r2=getrec(s,4,1),r3=getrec(s,3,1),c2,c3);
    fq_setup(r2[4],2,r2[6]);c2=r2[4]*sqrtcost();
    fq_setup(r3[4],3,r3[6]);c3=r3[4]*sqrtcost();
    md(Str("| ",s," | ",r2[4]," x ",sqrtcost()," = ",c2," | ",r3[4]," x ",sqrtcost()," = ",c3," |"));
    jadd(jo(["fb_build_nat_uncharged_s",s,"AB_D",c2,"C",c3]));
  );
  md("");
}
fbn();

\\ ================= controls =================
md("## 6. Controls");
md("");
NC1OK=1;
ctl()={
  my(L,f);
  md("### Unit tests, PC2, NC2, stopping-rule check (raw lines of controls_<s>.csv: test, n, pass, value1, value2, note)");
  md("");
  md("```");
  foreach(SIZES,s,L=mapget(CTL,s);md(Str("# s=",s));for(i=2,#L,md(L[i])));
  md("```");
  md("");
  md("PC2 requires 100% rejection of the planted k+1 and exact recovery on all 200 synthetic systems. NC2 is reported twice: the literal criterion of section 4.NC (accepted recoveries above 1/l* + 3 sigma over the runs falsify the verifier) and the same criterion restricted to runs where the shuffle gave at least one of the two colliding rows a foreign (a,b) (DEVIATIONS.md D5: with few relations the shuffle often leaves the colliding pair intact, or swaps it, which returns the true q, so the literal null is mis-specified).");
  md("");
  md("### NC1 (null half, B' versus B)");
  md("");
  md("| s | rate B'/B | attempts B'/B | k* B'/B | priced c=0 | c=0.1 | c=1 | all intervals contain 1 |");
  md("|---|---|---|---|---|---|---|---|");
  foreach(SIZES,s,
    my(pp=mapget(PAIR,["Bp","B",s,1]),b=cenv(s,1,2),bp=cenv(s,1,3),rr);
    rr=bpool(vector(#bp,i,bp[i][13]),vector(#b,i,b[i][13]));
    my(ints=concat([[rr[2]],[pp[1][2]],[pp[2][2]],vector(3,k,pp[3][k][2])]),all=1);
    for(i=1,#ints,if(!(ints[i][1]<=1&&ints[i][2]>=1),all=0));
    if(!all,NC1OK=0);
    md(Str("| ",s," | ",g4(rr[1])," ",ci4(rr[2])," | ",g4(pp[1][1])," ",ci4(pp[1][2])," | ",g4(pp[2][1])," ",ci4(pp[2][2])," | ",g4(pp[3][1][1])," ",ci4(pp[3][1][2])," | ",g4(pp[3][2][1])," ",ci4(pp[3][2][2])," | ",g4(pp[3][3][1])," ",ci4(pp[3][3][2])," | ",if(all,"yes","NO")," |"));
    jadd(jo(["NC1_s",s,"rate_ratio",rr[1],"all_contain_1",if(all,1,0)]));
  );
  md("");
}
ctl();

md("## 7. Verdicts against the preregistered hypotheses");
md("");
verd()={
  my(h1=1,h2=1,pc3=1,nc3=1,c);
  foreach(SIZES,s,my(x=mapget(CENS,s));if(!x[7],h1=0);if(!x[8],h2=0));
  foreach(SIZES,s,foreach([1,4,3],ar,my(r);if(mapisdefined(RHOCELL,[ar,s],&r),if(!r[4],pc3=0);if(!(r[5][2][1]<=1&&r[5][2][2]>=1),nc3=0))));
  md(Str("- H1 (exact L1/L2 census): ",if(h1,"HOLDS at every size run","FALSIFIED at some size")));
  md(Str("- H2 (rates A = 1.000, B within 1/4 +- 0.01): ",if(h2,"HOLDS at every size run, naive model rejected","FAILS at some size")));
  md(Str("- PC1: ",if(PC1OK,"passes","FAILS (instrument not validated, A-versus-B voided)")));
  md(Str("- PC3 (rho calibrated in every cell): ",if(pc3,"passes","fails in at least one cell (see table 2; those cells carry no ranking)")));
  md(Str("- NC1 (all intervals contain 1): ",if(NC1OK,"passes","FAILS at some size")));
  md(Str("- NC3 (rho on random target, interval for ratio of means contains 1): ",if(nc3,"passes in every cell","an interval excludes 1 in at least one cell (see table 2)")));
  my(bad=List());
  foreach(SIZES,s,foreach([1,4,3],ar,my(r);if(mapisdefined(RHOCELL,[ar,s],&r),if(!(r[5][2][1]<=1&&r[5][2][2]>=1),listput(bad,Str("armrec ",ar," s=",s," ratio ",g3(r[5][1])," ",ci4(r[5][2])))))));
  md(Str("  NC3 intervals excluding 1: ",#bad," of ",3*#SIZES," cells: ",strjoin(Vec(bad),"; ")));
  if(vecsearch(vecsort(SIZES),20),
    my(L=mapget(CTL,20),f);
    for(i=2,#L,f=strsplit(L[i],",");
      if(#f>=5 && (f[1]=="PC2a_planted_wrong_k"||f[1]=="PC2b_synthetic_planted_q"),md(Str("- ",f[1],": ",f[3]," of ",f[2]," passed")));
      if(#f>=5 && (f[1]=="NC2_permuted_targets"||f[1]=="NC2b_permuted_targets_collision_rows_moved"),my(acc=eval(f[2])-eval(f[3]),bd=eval(f[5]));md(Str("- ",f[1],": ",acc," recovered k equal to the planted k out of ",f[2]," runs; chance bound (sum 1/l* + 3 sigma) = ",g3(bd),"; ",if(acc<=bd,"criterion met","criterion NOT met (falsified as literally stated; see DEVIATIONS.md D5)"))))));
  md("- H3, H4, H5, H6, H7, H8: per-size verdicts are in sections 3 to 5 above.");
  md("");
  jadd(jo(["verdict_H1",if(h1,1,0),"verdict_H2",if(h2,1,0),"PC1",if(PC1OK,1,0),"PC3",if(pc3,1,0),"NC1",if(NC1OK,1,0),"NC3",if(nc3,1,0)]));
}
verd();
write(jf,Str("{\"experiment\":\"L1-descent-parity\",\"sizes\":",fmt(SIZES),",\"bootstrap_resamples\":",BOOT,",\"items\":[",strjoin(Vec(JS),",\n"),"]}"));
print("analysis done: ",#JS," json items");
