digraph pairtable {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.45"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
        color="#25425b", fillcolor="#eef4f8", margin="0.13,0.09"];
  edge [color="#57728b", fontname="Helvetica", fontsize=10];
  row [label="ordered abscissa row\ndiagonal + off-diagonal"];
  diagonal [label="complete diagonal\nexceptional sums", fillcolor="#fff0db"];
  pairs [label="off-diagonal\nadjacent signed pairs"];
  simd [label="x86 paired SIMD\nif accepted", fillcolor="#e5f3e8"];
  fallback [label="paired batch fallback\nportable / declined", fillcolor="#e5f3e8"];
  witness [label="ordered x keys\nfirst witness wins", fillcolor="#e6e8fa"];
  gate [label="release parity + x86 build\nthen admitted wall study", fillcolor="#f7e8e8"];
  row -> diagonal; row -> pairs; pairs -> simd [label="eligible"]; pairs -> fallback [label="otherwise"];
  diagonal -> witness; simd -> witness; fallback -> witness; witness -> gate;
}
