K<a> := GF(8);
print "field", DefiningPolynomial(K);
P<x,y,z> := PolynomialRing(K, 3);
F := (1)*x^4 +
     (a^2)*x^3*y +
     (a^2)*x^3*z +
     (a+a^2)*x^2*y^2 +
     (1+a+a^2)*x^2*y*z +
     (a)*x*y^3 +
     (1+a^2)*x*y*z^2 +
     (1+a+a^2)*x*z^3 +
     (1+a)*y^4 +
     (1+a^2)*y^3*z +
     (a+a^2)*y^2*z^2 +
     (a^2)*y*z^3 +
     (1+a+a^2)*z^4;
C := Curve(ProjectiveSpace(P), F);
print "rational_points", #RationalPoints(C);
print "smooth", IsNonsingular(C);
CK := BaseChange(C,3);
L := BaseField(CK);
w := L.1;
P1<X> := PolynomialRing(L);
for n in [14,84,105,222,235,408,437,454,493] do
    bn := &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..8]];
    Es := EllipticCurve([L|1,1,0,0,bn]);
    F2, map2 := IsogenyFromKernel(Es,X);
    print "source", n, "codomain_order", #F2, "degree", Degree(map2);
    for m in [14,84,105,222,235,408,437,454,493] do
        bm := &+[(Integers()!((m div 2^i) mod 2))*w^i : i in [0..8]];
        Em := EllipticCurve([L|1,1,0,0,bm]);
        if IsIsomorphic(F2,Em) then print "edge", n, m; end if;
    end for;
end for;
