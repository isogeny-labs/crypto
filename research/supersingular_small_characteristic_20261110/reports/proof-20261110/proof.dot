digraph {
 graph [rankdir=TB,bgcolor="white",pad=.2,nodesep=.25,ranksep=.33];
 node [shape=box,style="rounded,filled",fillcolor="#eaf1fa",fontname="DejaVu Sans",fontsize=11];
 edge [color="#46566b"];
 tuples [label="All five Weierstrass coefficients\nF2: 32 tuples; F3: 243 tuples"];
 kernel [label="Kernel-decided finite forall\nNonzero discriminant + source trace predicate"];
 bridge [label="Explicit equivalence\nPolynomial count = actual point cardinality"];
 cases [label="Actual supersingular count sets\nF2: {1,3,5}; F3: {1,4,7}"];
 bound [label="Every prime divisor of actual point count\nModular embedding order at most 6",fillcolor="#d9efe1"];
 e2 [label="Actual E/F2\n#E = 5; subgroup prime 5; k = 4"];
 e3 [label="Actual E/F3\n#E = 7; subgroup prime 7; k = 6"];
 neg [label="Direct Lean negation of universal k = 2\nEven p > 2 and subgroup prime r > 2",fillcolor="#f7eedb"];
 tuples->kernel->cases->bound;
 bridge->cases;
 bridge->e2;bridge->e3;
 e2->neg;e3->neg;
}
