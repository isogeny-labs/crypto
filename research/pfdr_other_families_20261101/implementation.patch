> def quad_base(E, b: int, rng: random.Random) -> tuple[list, dict]:
>     """Quadratic progression x_k = x0 + k^2."""
>     x0 = rng.randrange(E.p)
> 
>     def stream():
>         k = 0
>         while True:
>             yield x0 + k * k
