> def dickson_base(E, b: int, rng: random.Random) -> tuple[list, dict]:
>     """x_k = D_k(x_1) = u^k + u^-k (Chebyshev recurrence D_{k+1} = x_1 D_k - D_{k-1}, D_0 = 2), u random in F_p^*."""
>     p = E.p
>     u = rng.randrange(2, p - 1)
>     x1 = (u + pow(u, -1, p)) % p
> 
>     def stream():
>         dprev, dcur = 2, x1
>         while True:
>             yield dcur
>             dprev, dcur = dcur, (x1 * dcur - dprev) % p
> 
>     return _fill(E, b, stream(), {"family": "dickson", "u": u, "x1": x1})
> 
> 
> def gp_base(E, b: int, rng: random.Random) -> tuple[list, dict]:
>     """Geometric progression x_k = x0 * rho^k, rho random in F_p^*."""
>     p = E.p
>     x0 = rng.randrange(1, p)
>     rho = rng.randrange(2, p - 1)
> 
>     def stream():
>         x = x0
>         while True:
