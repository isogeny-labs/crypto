SetSeed(20261028); F2:=GF(2); P<X>:=PolynomialRing(F2);
K<w>:=ext<F2|X^12+X^7+X^6+X^5+X^3+X+1>;
k:=FiniteField(2,4); Embed(k,K);
E:=EllipticCurve([K|1,w^5,0,0,w+w^4+w^5+w^8]);
assert #E eq 3974;
G:=E!0;
for tries in [1..100] do
  G:=2*Random(E);
  if G ne E!0 then break; end if;
end for;
assert G ne E!0 and 1987*G eq E!0;
Q:=7*G;
assert WeilDescentGenus(E,k,K!1) eq 4;
C,h:=WeilDescent(E,k,K!1); J:=Jacobian(C);
D:=h(G); T:=h(Q);
assert D ne J!0 and 1987*D eq J!0 and T eq 7*D;
print "B",306,"J_ORDER",#J,"G",G,"D",D,"CHECK",true;
E:=EllipticCurve([K|1,w^5,0,0,1+w+w^4+w^5+w^7+w^9]);
