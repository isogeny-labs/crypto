total_wall := Realtime();
K<w> := GF(4096);
k<a> := GF(16);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..11]]>;
E := EllipticCurve([K|1,fromint(32),0,0,fromint(63)]);
G := E![fromint(62),fromint(1499),1];
Q := E![fromint(2633),fromint(1798),1];
assert #E eq 4126 and Order(G) eq 2063 and Q eq 7*G;
print "source_ok", #E, Order(G), "field_modulus", MinimalPolynomial(w);
print "expected_genus", 4;
print "computed_genus", WeilDescentGenus(E,k,K!1);
cover_wall := Realtime();
C,h := WeilDescent(E,k,K!1);
print "curve_type", Type(C), "genus", Genus(C);
print "cover_wall", Realtime(cover_wall);
map_wall := Realtime();
J := Jacobian(C);
D := h(G);
T := h(Q);
Z := J!0;
print "image_nonzero", D ne Z;
print "image_r_torsion", 2063*D eq Z;
print "target_relation", T eq 7*D;
assert D ne Z and 2063*D eq Z and T eq 7*D;
print "map_wall", Realtime(map_wall);
print "total_wall", Realtime(total_wall);
