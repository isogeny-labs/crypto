total_wall := Realtime();
K<w> := GF(4096);
k<a> := GF(16);
Embed(k,K);
fromint := func<n | &+[(Integers()!((n div 2^i) mod 2))*w^i : i in [0..11]]>;
E := EllipticCurve([K|1,fromint(32),0,0,fromint(63)]);
G := E![fromint(62),fromint(1499),1];
Q := E![fromint(2633),fromint(1798),1];
assert #E eq 4126 and Order(G) eq 2063 and Q eq 7*G;
cover_wall := Realtime();
C,h := WeilDescent(E,k,K!1 : HyperellipticImage := false);
print "curve_type", Type(C), "degree", Degree(C), "genus", Genus(C);
print "cover_wall", Realtime(cover_wall);
map_wall := Realtime();
dO := h(E!0);
D := h(G)-dO;
T := h(Q)-dO;
print "image_degree", Degree(D), "target_degree", Degree(T);
z0 := IsPrincipal(D);
zr := IsPrincipal(2063*D);
z7 := IsPrincipal(T-7*D);
print "image_nonprincipal", not z0;
print "image_r_principal", zr;
print "target_relation_principal", z7;
assert not z0 and zr and z7;
print "map_wall", Realtime(map_wall);
print "total_wall", Realtime(total_wall);
