+// ── L5 kernel split (l5-kernel-split lane) ──────────────────────────────
+//
+// Every count made through `lin` is also added to the bucket of the kernel
+// that is current on this thread. The kernel is set by `KScope` guards in
+// `fast_inner` and `roots_in_fp`; bucket 0 (`unscoped`) receives counts made
+// outside any guard (none inside `fast_stage`, by the conservation check).
+
+/// Number of kernel buckets.
+pub const NK: usize = 10;
+/// Kernel names, in bucket order.
+pub const KERNELS: [&str; NK] = [
+    "unscoped",
+    "setup",
+    "nf",
+    "krylov",
+    "bm",
+    "xpow_mod_f",
+    "gcd",
+    "ring_split",
+    "readout",
+    "candidate_eval",
+];
+const K_SETUP: usize = 1;
+const K_NF: usize = 2;
+const K_KRYLOV: usize = 3;
+const K_BM: usize = 4;
+const K_XPOW: usize = 5;
+const K_GCD: usize = 6;
+const K_RING: usize = 7;
+const K_READOUT: usize = 8;
+const K_CAND: usize = 9;
+
+thread_local! {
+    static KER: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+    static LINK: std::cell::RefCell<[LinOps; NK]> = const {
+        std::cell::RefCell::new([LinOps {
+            mul: 0, add: 0, mac: 0, word: 0, probe: 0, rng: 0,
+            mul_outside_legacy: 0, legacy_overcount: 0, ring_muls: 0,
+        }; NK])
+    };
+}
+
+/// This thread's cumulative per-kernel counts.
+pub fn kernel_ops_snapshot() -> [LinOps; NK] {
+    LINK.with(|c| *c.borrow())
+}
+
+/// `a − b`, bucket by bucket.
+pub fn kernel_ops_since(a: &[LinOps; NK], b: &[LinOps; NK]) -> [LinOps; NK] {
+    let mut out = [LinOps::default(); NK];
+    for k in 0..NK {
+        out[k] = a[k].since(&b[k]);
+    }
+    out
+}
+
+/// Sets the current kernel; restores the previous one on drop.
+struct KScope(usize);
+impl KScope {
+    #[inline(always)]
+    fn enter(k: usize) -> KScope {
+        KScope(KER.with(|c| c.replace(k)))
+    }
+}
+impl Drop for KScope {
+    #[inline(always)]
+    fn drop(&mut self) {
+        KER.with(|c| c.set(self.0));
+    }
+}
