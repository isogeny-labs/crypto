+// ── Native operation counts of this stage (complete-accounting patch) ────
+//
+// Before this patch the stage's own `F_p` arithmetic (the `Fp` struct and the
+// lazy u128/u64-lane kernels) emitted no `jv_bitops` hooks: only `inv_mod`
+// and the `PolyRing` root splitting were hooked. The legacy `FastStats`
+// counters count multiplications only, by formula at each call site.
+//
+// Counting rules (the existing `bitop/v1` conventions, no new unit):
+// * `mul` — one `Fp::mul` (a product reduced mod `p`);
+// * `add` — one `Fp::add`/`Fp::sub`, an inline negation `p − c`, or the
+//   doubling of a lazy lane in `square_into`;
+// * `mac` — one lazily accumulated product (dot products, `axpy`, the inline
+//   lazy loops): charged as one `field_mul` and one `field_add`, F4's
+//   multiply-subtract convention (`jv_bitops::row_ops`). The once-per-output
+//   reduction of a lazy sum is part of its products and is not charged again;
+// * `word` — one 64-bit compare/scan step on the stage's data (staircase and
+//   normal-form divisibility tests, non-zero scans, sort/dedup compares);
+// * `probe` — one `FxMap` insert or lookup keyed by one packed monomial word
+//   (`hash_probe` plus one `word_op`, `jv_bitops::probes(n, 1)`);
+// * `rng` — one `StdRng` draw made by the stage (`rng_words`; a lower bound:
+//   `gen_range` rejection draws are not visible here).
+// Inversions are not counted here: `inv_mod` already emits `field_inv`.
+// Allocation, copies, loop control and the `Instant` timers stay excluded.
+//
+// The bookkeeping counters below are not charged; they let the conservation
+// test reconcile these operation counts with the legacy `FastStats::muls`:
+// `mul_outside_legacy` (products the legacy formula never counted),
+// `legacy_overcount` (legacy multiplications that are not executed: one per
+// root in the read-out's `Q` chain) and `ring_muls` (the hooked `PolyRing`
+// products that the legacy counter includes).
+
+/// Operation counts of the linear stage on this thread (cumulative; take
+/// differences of [`lin_ops_snapshot`]).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize)]
+pub struct LinOps {
+    pub mul: u64,
+    pub add: u64,
+    pub mac: u64,
+    pub word: u64,
+    pub probe: u64,
+    pub rng: u64,
+    pub mul_outside_legacy: u64,
+    pub legacy_overcount: u64,
+    pub ring_muls: u64,
+}
+
+impl LinOps {
+    pub fn since(&self, b: &LinOps) -> LinOps {
+        LinOps {
+            mul: self.mul - b.mul,
+            add: self.add - b.add,
+            mac: self.mac - b.mac,
+            word: self.word - b.word,
+            probe: self.probe - b.probe,
+            rng: self.rng - b.rng,
+            mul_outside_legacy: self.mul_outside_legacy - b.mul_outside_legacy,
+            legacy_overcount: self.legacy_overcount - b.legacy_overcount,
+            ring_muls: self.ring_muls - b.ring_muls,
+        }
+    }
+    pub fn add_assign(&mut self, o: &LinOps) {
+        self.mul += o.mul;
+        self.add += o.add;
+        self.mac += o.mac;
+        self.word += o.word;
+        self.probe += o.probe;
+        self.rng += o.rng;
+        self.mul_outside_legacy += o.mul_outside_legacy;
+        self.legacy_overcount += o.legacy_overcount;
+        self.ring_muls += o.ring_muls;
+    }
+    /// `field_mul` this patch charges.
+    pub fn field_mul(&self) -> u64 {
+        self.mul + self.mac
+    }
+    /// `field_add` this patch charges.
+    pub fn field_add(&self) -> u64 {
+        self.add + self.mac
+    }
+    /// `word_op` this patch charges (scans, the probes' key words, draws).
+    pub fn word_op(&self) -> u64 {
+        self.word + self.probe + self.rng
+    }
+}
+
+thread_local! {
+    static LIN: std::cell::Cell<LinOps> = const {
+        std::cell::Cell::new(LinOps {
+            mul: 0, add: 0, mac: 0, word: 0, probe: 0, rng: 0,
+            mul_outside_legacy: 0, legacy_overcount: 0, ring_muls: 0,
+        })
+    };
+}
+
+/// This thread's cumulative linear-stage operation counts.
+pub fn lin_ops_snapshot() -> LinOps {
+    LIN.with(|c| c.get())
+}
+
+#[inline(always)]
+fn lin(f: impl FnOnce(&mut LinOps)) {
+    LIN.with(|c| {
+        let mut v = c.get();
+        f(&mut v);
+        c.set(v);
+    });
+}
+#[inline(always)]
+fn c_mul(n: u64) {
+    lin(|v| v.mul += n);
+}
+#[inline(always)]
+fn c_add(n: u64) {
+    lin(|v| v.add += n);
+}
+#[inline(always)]
+fn c_mac(n: u64) {
+    lin(|v| v.mac += n);
+}
+#[inline(always)]
+fn c_word(n: u64) {
+    lin(|v| v.word += n);
+}
+#[inline(always)]
+fn c_probe(n: u64) {
+    lin(|v| v.probe += n);
+}
+#[inline(always)]
+fn c_rng(n: u64) {
+    lin(|v| v.rng += n);
+}
+#[inline(always)]
+fn c_outside(n: u64) {
+    lin(|v| v.mul_outside_legacy += n);
+}
+
+/// Emit a stage's counts through the existing `jv_bitops` hooks (charged to
+/// the caller's current phase, only while counting is on).
+fn charge_lin(d: &LinOps) {
+    use super::jv_bitops::{charge, probes, rng_words, words, Kind};
+    charge(Kind::FieldMul, d.field_mul());
+    charge(Kind::FieldAdd, d.field_add());
+    words(d.word);
+    probes(d.probe, 1);
+    rng_words(d.rng);
+}
+
+/// `f4_fp::eval` (the candidate check) with its operations counted: per term,
+/// for each variable of exponent `k > 0`, the square-and-multiply `powmod`
+/// (`bits(k)` squarings and `popcount(k)` products) and one product; one
+/// addition per term. The value is `f4_fp::eval`'s own.
+fn eval_counted(f: &Poly, x: &[u64], p: u64) -> u64 {
+    let mut m = 0u64;
+    for (e, _) in f {
+        for &k in e.iter() {
+            if k > 0 {
+                m += (32 - k.leading_zeros()) as u64 + k.count_ones() as u64 + 1;
+            }
+        }
+    }
+    c_mul(m);
+    c_outside(m);
+    c_add(f.len() as u64);
+    f4_fp::eval(f, x, p)
+}
