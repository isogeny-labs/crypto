[package]
name = "crypto_lib"
version = "0.0.0"
edition = "2021"

[lib]
path = "src/lib.rs"

[[bin]]
name = "l1c1_cost"
path = "LANE/l1c1_cost.rs"

[features]
counted = []

[dependencies]
rand = { version = "0.8", features = ["small_rng"] }
rayon = "1"
serde = { version = "1.0", features = ["derive"] }
serde_json = { version = "1.0", features = ["arbitrary_precision", "raw_value"] }
num-bigint = { version = "0.4", features = ["rand"] }
num-traits = "0.2"
sha2 = { version = "0.10", features = ["compress"] }
blake3 = "1.5"

[profile.release]
debug = 0
incremental = false
