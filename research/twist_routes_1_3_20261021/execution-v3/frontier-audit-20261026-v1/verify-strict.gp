zz='zz;w=ffgen(Mod(1,751)*(zz^2-3),'w);E=ellinit([748,355],w);T=[(13+0*w),(384+0*w)];A=[(1+0*w),(0+676*w)];if(!ellisoncurve(E,T)||!ellisoncurve(E,A),error("mixed point off curve"));S=elladd(E,T,A);if(frontier_f3(T[1],A[1],S[1],E[4],E[5])!=0||frontier_f3(S[1],A[1],T[1],E[4],E[5])!=0,error("mixed F3 not zero"));if(S!=[(517+400*w),(20+572*w)]||elladd(E,S,ellneg(E,A))!=T,error("mixed prefix"));if(S[1]^751==S[1],error("mixed prefix incorrectly rational"));mixed++;
