/* Any errors become explicit rejected responses; no permissive sentinel gate. */
coldcall(s)={tstart();iferr(eval(s),cex,print("ERROR|",cex));tstop();print("END")};
coldpairs(ee,pp,bb,xm,rr)={my(out=List(),xi,zz,aa,bbq,cc,ff,roots,jj,pa,pb);if(rr==[0],for(ii=1,#bb,listput(out,[ii-1,ii-1,1]);listput(out,[ii-1,ii-1,2]));return(Vec(out)));zz=rr[1];for(ii=1,#bb,xi=bb[ii][1];aa=Mod((xi-zz)^2,pp);bbq=Mod(-2*((xi+zz)*(xi*zz+ee.a4)+2*ee.a6),pp);cc=Mod((xi*zz-ee.a4)^2-4*ee.a6*(xi+zz),pp);ff=aa*'x^2+bbq*'x+cc;if(ff==0,roots=vector(#bb,h,bb[h][1]),roots=lift(polrootsmod(ff,pp)));for(h=1,#roots,if(mapisdefined(xm,roots[h],&jj)&&jj>=ii,for(mm=0,3,pa=if(bittest(mm,0),ellneg(ee,bb[ii]),bb[ii]);pb=if(bittest(mm,1),ellneg(ee,bb[jj]),bb[jj]);if(elladd(ee,pa,pb)==rr,listput(out,[ii-1,jj-1,mm]))))));Vec(out)};
coldcollect(pp,aa,bb,base,targets)={my(ee=ellinit([aa,bb],pp),xm=Map(),all=List(),out,prs,rr);for(i=1,#base,mapput(xm,base[i][1],i));for(qi=1,#targets,out=List();prs=coldpairs(ee,pp,base,xm,targets[qi]);for(h=1,#prs,listput(out,[2,prs[h][1],prs[h][2],-1,prs[h][3]]));for(kk=1,#base,for(ss=0,1,rr=ellsub(ee,targets[qi],if(ss,ellneg(ee,base[kk]),base[kk]));prs=coldpairs(ee,pp,base,xm,rr);for(h=1,#prs,listput(out,[3,prs[h][1],prs[h][2],kk-1,prs[h][3]+4*ss]))));listput(all,vecsort(Vec(out))));Vec(all)};
