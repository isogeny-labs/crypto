// Known complete basis and deliberately truncated basis for a one-point task.
ring rr=59,(x,y),dp;
ideal I=x-1,y-2;
ideal G=std(I);
proc block_complete(ideal B,ideal I,ideal G){
  ideal LB=lead(B);ideal LG=lead(G);
  if(size(reduce(B,G))!=0){return(0);}
  if(size(reduce(I,B))!=0){return(0);}
  if(size(reduce(LB,LG))!=0){return(0);}
  if(size(reduce(LG,LB))!=0){return(0);}
  return(1);
}
ideal good=x-1,y-2;
ideal truncated=x-1;
print("POSITIVE="+string(block_complete(good,I,G)));
print("TRUNCATED="+string(block_complete(truncated,I,G)));
print("VDIM="+string(vdim(G)));
print("E26_CHECKER_CONTROLS_DONE");
quit;
