crreduce(qr,cp,cols,r)={my(nn=#cp);vector(#qr,i,vector(#cols+2,j,lift(Mod(if(j<=#cols,sum(t=1,nn,qr[i][t]*cols[j][t]),if(j==#cols+1,qr[i][nn+1],qr[i][nn+2]-sum(t=1,nn,qr[i][t]*cp[t]))),r))))};
