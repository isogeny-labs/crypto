    {
      "id": "row-degree-frontier",
      "text": "Exact complete scale/cost-control census and per-input timing observations, not signed verification or IC-vs-rho/fastest speed claim",
      "class": "exact_computation",
      "decided_by": [
        "exact-coverage"
      ]
    },
    {
      "id": "speed-regularity",
      "text": "Complete admitted-public-log IC, stationary yield, intrinsic regularity and global hardness outside this component scope",
      "class": "out_of_scope",
      "decided_by": []
    }
  ],
