\\ EXP8g: diagnose low-coverage case-P lines. Hypothesis: when v2(N) > 2, the FB's 2-primary projections
\\ generate a proper subgroup of E(K)[2^inf], so sums sit in a deeper subgroup; coverage of the ODD-order part
\\ (the real targets) is unaffected. Re-run every case-P line from the 8b and 8f seeds, report v2(N), the index of
\\ the subgroup generated by 2-primary projections, cov(2E), and coverage of the odd-order part.
read("exp8_yield.gp");
oddcov(E, FB, N) = {
  my(h2=2^valuation(N,2), o=N/h2, S2=Map(), L2=List(), S4=Map(), co=0, G=Map(), Gl=List([[0]]));
  \\ subgroup generated by 2-primary projections (closure by repeated addition)
  mapput(G,key([0]),1);
  my(gens=List()); for(i=1,#FB, my(Q=ellmul(E,FB[i],o)); if(!mapisdefined(G,key(Q)), listput(gens,Q);
     my(ch=1); while(ch, ch=0; my(cur=Vec(Gl)); for(a=1,#cur, for(b=1,#gens, my(R=elladd(E,cur[a],gens[b]), k=key(R)); if(!mapisdefined(G,k), mapput(G,k,1); listput(Gl,R); ch=1))))));
  for(i=1,#FB, for(j=i,#FB, my(R=elladd(E,FB[i],FB[j]), k=key(R)); if(!mapisdefined(S2,k), mapput(S2,k,1); listput(L2,R))));
  for(i=1,#L2, for(j=i,#L2, my(R=elladd(E,L2[i],L2[j]), k=key(R)); if(!mapisdefined(S4,k), mapput(S4,k,1); if(ellmul(E,R,o)==[0], co++))));
  [valuation(N,2), h2/#Gl, co/o, #L2];
}
diagseed(q, ncurves, seed, need_l) = {
  setrand(seed); my(n=4, t=ffgen(q^4,'t), one=t^0, bas=vector(n,i,t^(i-1)), gam=ffprimroot(t)^((q^4-1)/(q^2-1)), done=0);
  while(done < ncurves,
    my(e=vector(3,i,random(t)), c, E, N, got=0);
    if(#Set(e)<3, next);
    c=[-(e[1]+e[2]+e[3]), e[1]*e[2]+e[1]*e[3]+e[2]*e[3], -e[1]*e[2]*e[3]];
    E=ellinit([0,c[1],0,c[2],c[3]],t); N=ellcard(E);
    if(need_l, my(f=factor(N)[,1]); if(f[#f]<60, next));
    for(i=1,3, if(got,break); for(j=1,3, if(i==j||got, next); my(k=6-i-j, Aa=e[i]-e[k], B=e[j]-e[k], M=matrix(n,n), sol, z, c1, c0);
      for(b=1,n, M[,b] = tovec(B*bas[b] - Aa^q*bas[b]^q, n)~);
      sol = iferr(matsolve(M, tovec(gam^q-gam,n)~), err, 0); if(sol==0, next);
      z = sum(b=1,n, lift(sol[b])*bas[b]); if(z==0, next);
      c1=1/z; c0=e[k]-c1*gam; if(!issquare(c1), next); got=1;
      my(FB=fbase(E,c,c0,c1,q,one), r=oddcov(E,FB,N));
      printf("seed=%d q=%d N=%d v2=%d  index of <2-primary proj> in E[2^inf]=%d  2-sums=%d  cov(odd part)=%.3f\n", seed, q, N, r[1], r[2], r[4], r[3])));
    \\ consume RNG exactly like the original runs is not possible across scripts; we match the curve sequence only
    if(got, done++));
}
diagseed(13, 5, 42, 0);
diagseed(11, 6, 81, 1);
diagseed(11, 6, 41, 0);
diagseed(17, 3, 83, 1);
