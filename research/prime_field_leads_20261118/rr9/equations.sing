// The runner defines rx, ry, and the full polynomial ring.
number curve_a=847514846;
number curve_b=2087444724;
if (ry^2!=rx^3+curve_a*rx+curve_b) { ERROR("residual off curve"); }
intvec xs=0,1,2,3,5,6,8,9;
matrix H[1][9];
H[1,1]=1;
int i,j,k;
for (i=1;i<=8;i++) {
  for (j=i+1;j>=2;j--) { H[1,j]=H[1,j-1]-xs[i]*H[1,j]; }
  H[1,1]=-xs[i]*H[1,1];
}
ideal A=a0,a1,a2,a3;
ideal V=v0,v1,v2,1;
matrix Q[1][9];
matrix D[1][3];
D[1,1]=rx^2+curve_a; D[1,2]=rx; D[1,3]=1;
for (i=1;i<=4;i++) {
  for (j=1;j<=4;j++) {
    for (k=1;k<=3;k++) { Q[1,i+j+k-2]=Q[1,i+j+k-2]+D[1,k]*V[i]*V[j]; }
    Q[1,i+j-1]=Q[1,i+j-1]+rx*A[i]*A[j]-2*ry*A[i]*V[j];
    Q[1,i+j]=Q[1,i+j]-A[i]*A[j];
  }
}
for (i=1;i<=9;i++) { Q[1,i]=Q[1,i]-H[1,i]; }
if (Q[1,9]!=0) { ERROR("leading term mismatch"); }
ideal I=Q[1,1],Q[1,2],Q[1,3],Q[1,4],Q[1,5],Q[1,6],Q[1,7],Q[1,8];
