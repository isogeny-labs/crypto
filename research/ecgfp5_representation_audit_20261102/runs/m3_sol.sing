ring r = 4111,(s1,s2,w),lp;
ideal I = 991*1+2799*w^2+1097*w^4+2194*s2^1+1425*s2^1*w^2+1304*s2^2+2061*s1^1+1617*s1^1*w^2+1661*s1^1*s2^1+1421*s1^2+3952*w^1+4059*w^3+1739*s2^1*w^1+946*s1^1*w^1,
1942*1+1223*w^2+3499*w^4+1492*s2^1+3781*s2^1*w^2+3038*s2^2+3002*s1^1+2959*s1^1*w^2+606*s1^1*s2^1+1960*s1^2+3123*w^1+1314*w^3+2178*s2^1*w^1+2974*s1^1*w^1,
3023*1+327*w^2+1878*w^4+387*s2^1+354*s2^1*w^2+1546*s2^2+2203*s1^1+1312*s1^1*w^2+866*s1^1*s2^1+33*s1^2+1944*w^1+3660*w^3+3339*s2^1*w^1+1012*s1^1*w^1;
option(redSB); ideal G = std(I);
poly el = G[1]; list f = factorize(el); int i; 
for (i=1; i<=size(f[1]); i++) { if (deg(f[1][i])==1) { ideal J = std(I + f[1][i]); print("SOL"); print(J); } }
print("ELDEG"); print(deg(el));
quit;
