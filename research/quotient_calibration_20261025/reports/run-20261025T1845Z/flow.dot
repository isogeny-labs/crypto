digraph preflight {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.3", ranksep="0.35"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#256454", fillcolor="#e9f4ef", margin="0.15,0.13"];
  edge [color="#256454", arrowsize=0.7];
  source [label="Frozen source\nF343, r=373\nkernel 153"];
