+/// `F4_FP_BPRIME_SPLIT=0` finishes a block of `B'` row by row on the
+/// calling thread; a same-binary control for [`finish_block_by_columns`].
+fn bprime_split() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("F4_FP_BPRIME_SPLIT").as_deref() != Ok("0"))
+}
