+/// `acc[start..to] += factor · row[start..to]` for every `(row, factor,
+/// start)` of `active`, four rows per pass over `acc` where
+/// their ranges overlap: the accumulator tile is loaded and stored once
+/// for four updates instead of once each.  Each lane receives the same
+/// products as one [`add_lazy_range`] per reducer, only summed in another
+/// order, and the sum is exact; uncounted, like [`add_lazy_range`].
+fn add_lazy_group(acc: &mut [u64], active: &[(&[u32], u64, usize)], to: usize, simd: u8) {
+    let mut quads = active.chunks_exact(4);
+    for q in &mut quads {
+        // the common range; each row's own prefix runs alone
+        let common = q.iter().map(|&(_, _, s)| s).max().unwrap_or(to);
+        for &(row, factor, start) in q {
+            if start < common {
+                add_lazy_range(acc, row, start, common, factor, simd);
+            }
+        }
+        let p = [&q[0].0[..to], &q[1].0[..to], &q[2].0[..to], &q[3].0[..to]];
+        let f = [q[0].1, q[1].1, q[2].1, q[3].1];
+        add_lazy4(&mut acc[..to], p, common, f, simd);
+    }
+    for &(row, factor, start) in quads.remainder() {
+        add_lazy_range(acc, row, start, to, factor, simd);
+    }
+}
