+/// Finish a block of `B'` rows whose in-block dependencies are pending:
+/// row `k` still takes `−v · B'_j` for each `(j, v)` of its `later` list,
+/// `j` earlier in the block.  That chain is serial along the rows but
+/// independent along the columns, so the free columns are cut into tiles
+/// and each tile runs the whole chain for every row of the block, in
+/// parallel.  A tile sees the same updates in the same order, with the
+/// same normalisation points, as the row-at-a-time loop on its columns,
+/// so every entry of `B'` is the same; the field operations are counted
+/// once, on the calling thread, as that loop counted them.
+#[allow(clippy::too_many_arguments)]
+fn finish_block_by_columns(
+    block: &[usize],
+    partial: &mut [(Vec<u64>, usize, Vec<(usize, u64)>)],
+    bprime: &mut [Vec<u32>],
+    position: &[usize],
+    bstart: &[usize],
+    block_start: usize,
+    n_free: usize,
+    fp: Barrett,
+    simd: u8,
+    fused: bool,
+) {
+    const NORMALIZE_AFTER: usize = 256;
+    let tile = n_free.div_ceil(4 * rayon::current_num_threads()).max(256);
+    let mut later: Vec<(usize, Vec<(usize, u64)>)> = Vec::with_capacity(block.len());
+    let mut acc_tiles: Vec<Vec<&mut [u64]>> = (0..n_free.div_ceil(tile)).map(|_| Vec::new()).collect();
+    for (acc, pending, l) in partial.iter_mut() {
+        later.push((*pending, std::mem::take(l)));
+        for (t, a) in acc.chunks_mut(tile).enumerate() {
+            acc_tiles[t].push(a);
+        }
+    }
+    let mut out: Vec<Vec<u32>> = vec![vec![0u32; n_free]; block.len()];
+    let mut out_tiles: Vec<Vec<&mut [u32]>> = (0..acc_tiles.len()).map(|_| Vec::new()).collect();
+    for o in out.iter_mut() {
+        for (t, a) in o.chunks_mut(tile).enumerate() {
+            out_tiles[t].push(a);
+        }
+    }
+    acc_tiles
+        .into_par_iter()
+        .zip(out_tiles.into_par_iter())
+        .enumerate()
+        .for_each(|(t, (mut accs, mut outs))| {
+            let lo = t * tile;
+            for b in 0..accs.len() {
+                let (done, rest) = outs.split_at_mut(b);
+                let acc = &mut *accs[b];
+                let len = acc.len();
+                let (mut pending, ref deps) = later[b];
+                if fused {
+                    let mut upd: Vec<(&[u32], u64, usize)> = Vec::with_capacity(deps.len());
+                    for &(j, v) in deps {
+                        let jb = position[j] - block_start;
+                        let start = bstart[j].saturating_sub(lo).min(len);
+                        upd.push((&*done[jb], fp.p - v, start));
+                    }
+                    for g in upd.chunks(4) {
+                        if pending + g.len() > NORMALIZE_AFTER {
+                            normalize_lazy(acc, fp);
+                            pending = 0;
+                        }
+                        add_lazy_group(acc, g, len, simd);
+                        pending += g.len();
+                    }
+                } else {
+                    for &(j, v) in deps {
+                        let jb = position[j] - block_start;
+                        let start = bstart[j].saturating_sub(lo).min(len);
+                        add_lazy_range(acc, &done[jb][..], start, len, fp.p - v, simd);
+                        pending += 1;
+                        if pending == NORMALIZE_AFTER {
+                            normalize_lazy(acc, fp);
+                            pending = 0;
+                        }
+                    }
+                }
+                for (o, &x) in rest[0].iter_mut().zip(acc.iter()) {
+                    *o = fp.reduce(x) as u32;
+                }
+            }
+        });
+    count_ops(
+        later
+            .iter()
+            .flat_map(|(_, deps)| deps.iter().map(|&(j, _)| n_free - bstart[j]))
+            .sum(),
+    );
+    for (b, &k) in block.iter().enumerate() {
+        bprime[k] = std::mem::take(&mut out[b]);
+    }
+}
