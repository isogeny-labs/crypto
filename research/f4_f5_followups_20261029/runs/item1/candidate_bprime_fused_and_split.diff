+/// `acc[from..] += Σ f[k] · p[k][from..]`, all slices of one length.
+#[inline]
+fn add_lazy4(acc: &mut [u64], p: [&[u32]; 4], from: usize, f: [u64; 4], simd: u8) {
+    #[cfg(target_arch = "x86_64")]
+    if simd != 0 {
+        // SAFETY: `lazy_simd_kind` verified AVX2 for every nonzero kind.
+        unsafe { add_lazy4_avx2(acc, p, from, f) };
+        return;
+    }
+    let _ = simd;
+    for (c, x) in acc.iter_mut().enumerate().skip(from) {
+        *x += f[0] * u64::from(p[0][c])
+            + f[1] * u64::from(p[1][c])
+            + f[2] * u64::from(p[2][c])
+            + f[3] * u64::from(p[3][c]);
+    }
+}
+
+/// [`add_lazy4`] four lanes at a time: one accumulator load and store per
+/// four bounded 32-bit products a lane.
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2")]
+unsafe fn add_lazy4_avx2(acc: &mut [u64], p: [&[u32]; 4], from: usize, f: [u64; 4]) {
+    use std::arch::x86_64::{
+        __m128i, __m256i, _mm256_add_epi64, _mm256_cvtepu32_epi64, _mm256_loadu_si256,
+        _mm256_mul_epu32, _mm256_set1_epi64x, _mm256_storeu_si256, _mm_loadu_si128,
+    };
+    let n = acc.len();
+    assert!(p.iter().all(|r| r.len() == n), "equal lengths");
+    let m = [
+        _mm256_set1_epi64x(f[0] as i64),
+        _mm256_set1_epi64x(f[1] as i64),
+        _mm256_set1_epi64x(f[2] as i64),
+        _mm256_set1_epi64x(f[3] as i64),
+    ];
+    let mut i = from;
+    while i + 4 <= n {
+        // SAFETY: `i + 4 <= n` and every slice has length `n`; the loads
+        // and the store accept unaligned pointers.
+        unsafe {
+            let mut a = _mm256_loadu_si256(acc.as_ptr().add(i) as *const __m256i);
+            for k in 0..4 {
+                let v = _mm_loadu_si128(p[k].as_ptr().add(i) as *const __m128i);
+                a = _mm256_add_epi64(a, _mm256_mul_epu32(_mm256_cvtepu32_epi64(v), m[k]));
+            }
+            _mm256_storeu_si256(acc.as_mut_ptr().add(i) as *mut __m256i, a);
+        }
+        i += 4;
+    }
+    for c in i..n {
+        acc[c] += f[0] * u64::from(p[0][c])
+            + f[1] * u64::from(p[1][c])
+            + f[2] * u64::from(p[2][c])
+            + f[3] * u64::from(p[3][c]);
+    }
+}
