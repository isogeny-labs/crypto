+/// `acc += factor · row` from `start` on for every `(row, factor, start)`
+/// of `updates`, in groups of four ([`add_lazy_group`]), counted as
+/// one [`add_lazy`] each.  `pending` counts the products a lane has taken
+/// since `acc` was last reduced; a group that would take it past
+/// `normalize_after` reduces `acc` first, so no lane takes more products
+/// between reductions than the row-at-a-time loop allows.
+fn add_lazy_updates(
+    acc: &mut [u64],
+    updates: &[(&[u32], u64, usize)],
+    pending: &mut usize,
+    normalize_after: usize,
+    fp: Barrett,
+    simd: u8,
+) {
+    let n = acc.len();
+    for g in updates.chunks(4) {
+        if *pending + g.len() > normalize_after {
+            normalize_lazy(acc, fp);
+            *pending = 0;
+        }
+        add_lazy_group(acc, g, n, simd);
+        count_ops(g.iter().map(|&(_, _, start)| n - start).sum());
+        *pending += g.len();
+    }
+}
