 d [label="ACTUAL INTEGRAL RESIDUAL J\nDerived residualFI<=1; exact H=I^4*J"];
 e [label="ACTUAL FINITE QUOTIENT BOUND SIX\nR/H surjects R/J, dim(R/J)<=dim(R/H)<=6"];
