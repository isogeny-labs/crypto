 operator [label="ACTUAL FINITE MAP\n7 positions x 10 mixed jets = 70 rows\nExact strict budget a=2, ell=7, r=4"];
 kernel [label="CHECKED CLASSICAL EXISTENCE\n72 > 70 gives nonzero kernel\nInjection gives nonzero polynomial Q"];
 filter [label="ACTUAL CURVE FILTER\nRemainder of Q modulo Y^2-f(X)\nZero iff curve equation divides Q"];
