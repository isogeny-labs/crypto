#Leading ideal data
#---
#field characteristic: 4111
#variable order:       s1, s2, s3, w
#monomial order:       graded reverse lexicographical
#length of basis:      12 elements sorted by increasing leading monomials
#---
[s1^2*s3^2,
s2^4,
s1^2*s2^2,
s1^4,
w^5,
s3^2*w^3,
s2^2*w^3,
s1^2*w^3,
s3^4*w^1,
s2^2*s3^2*w^1,
s3^6,
s2^2*s3^4]:
