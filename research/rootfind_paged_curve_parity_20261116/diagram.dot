digraph parity {
  graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.45", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fillcolor="#eff6fb", color="#356078", fontname="Helvetica", fontsize=11];
  edge [color="#4a6b7e", arrowsize=0.7, fontname="Helvetica", fontsize=10];

  fixture [label="Pinned E0 K13/K19/K23\ncurve and signed-orbit base"];
  production [label="Production torsion builder\ncollision vector + counts", fillcolor="#e9f0ff"];
  replay [label="Ordered pair-sum replay\nFastCurve.add"];
  hash [label="Reference HashMap\nfirst witness + collisions", fillcolor="#e7f6ee"];
  paged [label="PagedPairIndex\nfirst witness", fillcolor="#fff2dd"];
  checks [label="Insertion parity, full group\nequations, collision-vector parity", fillcolor="#f2eafd"];

  fixture -> production;
  fixture -> replay;
  replay -> hash;
  replay -> paged;
  production -> checks;
  hash -> checks;
  paged -> checks;
}
