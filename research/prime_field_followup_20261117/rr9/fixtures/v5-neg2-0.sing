ring R=2147483647,(a0,a1,a2,a3,v0,v1,v2),dp;
number rx=1923055775; number ry=307731458; int presentation=0;
option(noredefine);
number curveA=847514846;
number curveB=2087444724;
intvec xs=0,1,2,3,5,6,8,9;
matrix H[1][9];
H[1,1]=1;
int i,j,k;
for (i=1;i<=8;i++) {
  for (j=i+1;j>=2;j--) { H[1,j]=H[1,j-1]-xs[i]*H[1,j]; }
  H[1,1]=-xs[i]*H[1,1];
}
ideal A=a0,a1,a2,a3;
ideal V=v0,v1,v2,1;
matrix Q[1][9];
matrix D[1][3];
D[1,1]=rx^2+curveA; D[1,2]=rx; D[1,3]=1;
for (i=1;i<=4;i++) {
  for (j=1;j<=4;j++) {
    for (k=1;k<=3;k++) { Q[1,i+j+k-2]=Q[1,i+j+k-2]+D[1,k]*V[i]*V[j]; }
    Q[1,i+j-1]=Q[1,i+j-1]+rx*A[i]*A[j]-2*ry*A[i]*V[j];
    Q[1,i+j]=Q[1,i+j]-A[i]*A[j];
  }
}
for (i=1;i<=9;i++) { Q[1,i]=Q[1,i]-H[1,i]; }
if (Q[1,9]!=0) { ERROR("leading term mismatch"); }
if (ry^2!=rx^3+curveA*rx+curveB) { ERROR("residual off curve"); }
ideal C=Q[1,1],Q[1,2],Q[1,3],Q[1,4],Q[1,5],Q[1,6],Q[1,7],Q[1,8];
ideal I;
poly z,ax,vx;
number x;
for (i=1;i<=8;i++) {
  if (presentation==1) {
    x=xs[i]; ax=0; vx=0; z=0;
    for (j=4;j>=1;j--) { ax=ax*x+A[j]; vx=vx*x+V[j]; }
    I[i]=(x^2+rx*x+rx^2+curveA)*vx^2-(x-rx)*ax^2-2*ry*ax*vx;
    for (j=8;j>=1;j--) { z=z*x+C[j]; }
    if (z!=I[i]) { ERROR("evaluation presentation disagrees"); }
  } else { I[i]=C[i]; }
}
print("affine liftstd start");
matrix T;
ideal G=liftstd(I,T);
print("basis size "+string(size(G)));
if (size(G)==1 && deg(G[1])==0) {
    poly replay=0;
    for (i=1;i<=8;i++) { replay=replay+(T[i,1]/leadcoef(G[1]))*I[i]; }
    if (replay!=1) { ERROR("unit failed replay"); }
    print("UNIT_REPLAY_OK");
    for (i=1;i<=8;i++) {
      print("Q"+string(i)+" "+string(I[i]));
      print("W"+string(i)+" "+string(T[i,1]/leadcoef(G[1])));
    }
} else {
    if (size(G)==7) {
        for (i=1;i<=7;i++) {
            z=reduce(var(i),G);
            if (deg(z)>0) { ERROR("nonconstant normal form"); }
            print("VALUE"+string(i)+" "+string(z));
        }
        print("POSITIVE_EXTRACTED");
    } else { print("NO_UNIT"); }
}
quit;
