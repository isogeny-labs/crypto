// The imported model is the exact file used by upstream's Isabelle bridge.
import "MLDSA_NTT.cry";
m <- llvm_load_module "build/native.bc";

let mont_spec delta = do {
    a <- llvm_fresh_var "a" (llvm_int 64);
    // Strict symmetric range stated by the Rust function's contract.
    llvm_precond {{ (a >$ (-17996808470921216 : [64])) && (a <$ 17996808470921216) }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ montgomery_reduce a ^ delta }});
};
let reduce_spec delta = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ reduce32_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ reduce32 a ^ delta }});
};
let caddq_spec delta = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    // Ensures canonicalization, and prevents overflow with checks enabled.
    llvm_precond {{ (a >$ (-8380417 : [32])) && (a <$ 8380417) }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ caddq a ^ delta }});
};
let canon_spec delta = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    llvm_precond {{ reduce32_in_range a }};
    llvm_execute_func [llvm_term a];
    llvm_return (llvm_term {{ freeze a ^ delta }});
};

// Positive and negative obligations share the symbol and the spec constructor.
let check symbol spec = do {
    llvm_verify m symbol [] false (spec {{ 0 : [32] }}) z3;
    fails (llvm_verify m symbol [] false (spec {{ 1 : [32] }}) z3);
    print symbol;
};
check "assay_montgomery_reduce" mont_spec;
check "assay_reduce32" reduce_spec;
check "assay_caddq" caddq_spec;
check "assay_canon" canon_spec;
print "ASSAY COMPLETE: four production Rust functions match the pinned Cryptol model";
