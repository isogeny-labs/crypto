import CrossCharacteristicLarger
import Mathlib.Algebra.Field.Subfield.Basic
import Mathlib.Data.Finset.Card
import Mathlib.SetTheory.Cardinal.Finite
import Mathlib.Data.Set.Card
import Mathlib.Algebra.MvPolynomial.Basic

/-!
# A concrete cubic-cover transfer ending over a four-element field

The source is the existing order-seven subgroup over F65537. The target is
the actual four-element subfield generated by omega. The cubic-cover algebras
are finite free of rank 3; their affine maps are (u,v) ↦ (u^3,v).
The resulting point-group transfer is [3] composed with specialization of the
seven torsion sections. Genus and Picard functoriality are documented as a
written geometric proof, not a formal Jacobian construction in this module.
-/

noncomputable section
namespace CoverDecodeExample
open CrossCharacteristicLarger (Fbig omega omega_ne_zero omega_ne_one omega_sq omega_inv)
open WeierstrassCurve.Affine

def fourField : Subfield Fbig where
  carrier := {0, 1, omega, omega + 1}
  zero_mem' := by simp
  one_mem' := by simp
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy ⊢
    rcases hx with rfl | rfl | rfl | rfl <;>
      rcases hy with rfl | rfl | rfl | rfl <;>
      simp [CharTwo.add_self_eq_zero, CharTwo.add_cancel_left,
        add_comm, add_left_comm]
  neg_mem' := by
    intro x hx
    simpa only [CharTwo.neg_eq] using hx
  mul_mem' := by
    intro x y hx hy
    have hsquare : (omega + 1) ^ 2 = omega := by
      rw [CharTwo.add_sq, omega_sq, one_pow, add_assoc,
        CharTwo.add_self_eq_zero, add_zero]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy ⊢
    rcases hx with rfl | rfl | rfl | rfl <;>
      rcases hy with rfl | rfl | rfl | rfl <;>
      simp [mul_add, add_mul, ← pow_two, hsquare, omega_sq,
        CharTwo.add_self_eq_zero, CharTwo.add_cancel_left, add_comm]
  inv_mem' := by
    intro x hx
    have h : (omega + 1)⁻¹ = omega := by rw [← omega_inv, inv_inv]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with rfl | rfl | rfl | rfl <;> simp [omega_inv, h]

abbrev Small := fourField

instance : CharP Small 2 := fourField.subtype.charP fourField.subtype_injective 2

theorem small_card : Nat.card Small = 4 := by
  let s : Finset Fbig := {0, 1, omega, omega + 1}
  have heq : (fourField : Set Fbig) = (s : Set Fbig) := by ext x; simp [fourField, s]
  have h0 : omega + 1 ≠ 0 := CharTwo.add_eq_zero.not.mpr omega_ne_one
  calc
    Nat.card Small = Nat.card (s : Set Fbig) := Nat.card_congr (Equiv.setCongr heq)
    _ = s.card := by rw [Nat.card_coe_set_eq, Set.ncard_coe_finset]
    _ = 4 := by simp [s, Ne.symm h0, omega_ne_zero,
      Ne.symm omega_ne_zero, Ne.symm omega_ne_one]

def w : Small := ⟨omega, by simp [fourField]⟩

theorem w_ne_zero : w ≠ 0 := by
  intro h
  exact omega_ne_zero (congrArg Subtype.val h)

def curve : WeierstrassCurve Small := ⟨0, w, w, 0, 0⟩

theorem mapped_curve : curve.map fourField.subtype = CrossCharacteristicLarger.targetCurve := rfl

instance : curve.IsElliptic where
  isUnit := by
    apply isUnit_iff_ne_zero.mpr
    intro h
    have hbig : CrossCharacteristicLarger.targetCurve.Δ = 0 := by
      rw [← mapped_curve, WeierstrassCurve.map_Δ, h, map_zero]
    exact (isUnit_iff_ne_zero.mp CrossCharacteristicLarger.targetCurve.isUnit_Δ) hbig

def R : curve.toAffine.Point :=
  .some (x := 0) (y := 0) (by
    rw [← equation_iff_nonsingular, equation_iff]
    norm_num [curve])

def includePoints : curve.toAffine.Point →+
    CrossCharacteristicLarger.targetCurve.toAffine.Point :=
  Point.baseChange (W' := curve) Small Fbig

theorem include_injective : Function.Injective includePoints :=
  Point.map_injective (Algebra.ofId Small Fbig)

theorem include_R : includePoints R = CrossCharacteristicLarger.R := rfl

theorem R_order : addOrderOf R = 7 := by
  have h := addOrderOf_injective includePoints include_injective R
  rw [include_R, CrossCharacteristicLarger.R_order] at h
  exact h.symm

abbrev sourceCoordinate := CrossCharacteristicLarger.sourceCurve.toAffine.CoordinateRing

def sourceX : sourceCoordinate :=
  CoordinateRing.mk _ (Polynomial.C Polynomial.X)

def sourceCubic : Polynomial sourceCoordinate := Polynomial.X ^ 3 - Polynomial.C sourceX

abbrev sourceCoverAlgebra := AdjoinRoot sourceCubic

def sourceCoverBasis : Module.Basis (Fin 3) sourceCoordinate sourceCoverAlgebra :=
  (AdjoinRoot.powerBasisAux' (Polynomial.monic_X_pow_sub_C sourceX (by decide))).reindex
    (finCongr (show sourceCubic.natDegree = 3 from Polynomial.natDegree_X_pow_sub_C))

abbrev targetCoordinate := curve.toAffine.CoordinateRing

def targetX : targetCoordinate := CoordinateRing.mk _ (Polynomial.C Polynomial.X)

def targetCubic : Polynomial targetCoordinate := Polynomial.X ^ 3 - Polynomial.C targetX

abbrev targetCoverAlgebra := AdjoinRoot targetCubic

def targetCoverBasis : Module.Basis (Fin 3) targetCoordinate targetCoverAlgebra :=
  (AdjoinRoot.powerBasisAux' (Polynomial.monic_X_pow_sub_C targetX (by decide))).reindex
    (finCongr (show targetCubic.natDegree = 3 from Polynomial.natDegree_X_pow_sub_C))

theorem source_cover_root : AdjoinRoot.root sourceCubic ^ 3 =
    AdjoinRoot.of sourceCubic sourceX := by
  have h := AdjoinRoot.eval₂_root sourceCubic
  simpa only [sourceCubic, Polynomial.eval₂_sub, Polynomial.eval₂_pow,
    Polynomial.eval₂_X, Polynomial.eval₂_C, sub_eq_zero] using h

theorem target_cover_root : AdjoinRoot.root targetCubic ^ 3 =
    AdjoinRoot.of targetCubic targetX := by
  have h := AdjoinRoot.eval₂_root targetCubic
  simpa only [targetCubic, Polynomial.eval₂_sub, Polynomial.eval₂_pow,
    Polynomial.eval₂_X, Polynomial.eval₂_C, sub_eq_zero] using h

theorem target_smaller : Nat.card Small < Nat.card (ZMod 65537) := by
  rw [small_card, CrossCharacteristicLarger.source_card]
  decide

theorem w_sq : w ^ 2 = w + 1 := Subtype.ext omega_sq

theorem w_cube : w ^ 3 = 1 :=
  Subtype.ext CrossCharacteristicLarger.omega_primitive.pow_eq_one

def R2 : curve.toAffine.Point :=
  .some (x := w) (y := w) (by
    rw [← equation_iff_nonsingular, equation_iff]
    simp [curve, pow_succ', CharTwo.add_self_eq_zero])

def S : curve.toAffine.Point :=
  .some (x := 1) (y := w + 1) (by
    rw [← equation_iff_nonsingular, equation_iff]
    simp only [curve, zero_mul, add_zero, one_pow, mul_one,
      CharTwo.add_sq, mul_add, ← pow_two, w_sq]
    simp only [CharTwo.add_cancel_left, add_comm])

theorem include_R2 : includePoints R2 = CrossCharacteristicLarger.R2 := rfl

theorem include_S : includePoints S = CrossCharacteristicLarger.S := rfl

theorem R_double : R + R = R2 := by
  apply include_injective
  rw [map_add, include_R, include_R2, CrossCharacteristicLarger.R_double]

theorem S_as_multiple : S = (3 : ℕ) • R := by
  apply include_injective
  rw [map_nsmul, include_R, include_S, CrossCharacteristicLarger.S_as_multiple]

theorem S_order : addOrderOf S = 7 := by
  rw [S_as_multiple, addOrderOf_nsmul' R (by decide : (3 : ℕ) ≠ 0), R_order]
  norm_num

abbrev Source := AddSubgroup.zmultiples CrossCharacteristicLarger.P
abbrev Target := AddSubgroup.zmultiples R

def targetGenerator : Target := ⟨R, by simp⟩

def tau : Source ≃+ Target :=
  addEquivOfAddOrderOfEq (g := CrossCharacteristicLarger.sourceGenerator)
    (g' := targetGenerator)
    (AddSubgroup.forall_zmultiples.mpr (fun n => ⟨n, rfl⟩))
    (AddSubgroup.forall_zmultiples.mpr (fun n => ⟨n, rfl⟩))
    (by simpa only [CrossCharacteristicLarger.sourceGenerator,
      targetGenerator, AddSubgroup.addOrderOf_mk]
      using CrossCharacteristicLarger.P_order.trans R_order.symm)

theorem tau_generator : tau CrossCharacteristicLarger.sourceGenerator = targetGenerator :=
  addEquivOfAddOrderOfEq_apply_gen _ _ _

/-- The cubic cover and its norm contribute multiplication by 3. -/
def phi : Source →+ curve.toAffine.Point :=
  (AddSubgroup.zmultiples R).subtype.comp ((3 : ℕ) • tau.toAddMonoidHom)

theorem phi_generator_multiple :
    phi CrossCharacteristicLarger.sourceGenerator = (3 : ℕ) • R := by
  change (↑((3 : ℕ) • tau CrossCharacteristicLarger.sourceGenerator) :
    curve.toAffine.Point) = (3 : ℕ) • R
  rw [tau_generator]
  rfl

theorem phi_generator : phi CrossCharacteristicLarger.sourceGenerator = S := by
  rw [phi_generator_multiple, ← S_as_multiple]

theorem phi_injective : Function.Injective phi := by
  have hcoprime : (Nat.card Target).Coprime 3 := by
    rw [Nat.card_zmultiples, R_order]
    decide
  have hthree : Function.Injective (fun T : Target => (3 : ℕ) • T) :=
    (Nat.Coprime.nsmul_right_bijective hcoprime).injective
  exact (Subtype.val_injective.comp hthree).comp tau.injective

theorem phi_challenge : phi CrossCharacteristicLarger.challenge = R2 := by
  rw [CrossCharacteristicLarger.challenge_as_multiple, map_zsmul, phi_generator_multiple]
  have h3 : (3 : ℕ) • R = (3 : ℤ) • R := rfl
  have h9 : (9 : ℤ) • R = (2 : ℤ) • R := by
    rw [zsmul_eq_zsmul_iff_modEq, R_order]
    decide
  rw [h3, smul_smul, show (3 : ℤ) * 3 = 9 from by norm_num, h9, two_zsmul, R_double]

theorem transfer_dlog (T : Source) (k : ℤ) :
    phi T = k • S ↔ (T : CrossCharacteristicLarger.sourceCurve.toAffine.Point) =
      k • CrossCharacteristicLarger.P := by
  have h : phi T = phi (k • CrossCharacteristicLarger.sourceGenerator) ↔
      T = k • CrossCharacteristicLarger.sourceGenerator := phi_injective.eq_iff
  simpa only [map_zsmul, phi_generator, Subtype.ext_iff] using h

theorem example_dlog (k : ℤ) : R2 = k • S ↔
    CrossCharacteristicLarger.Q = k • CrossCharacteristicLarger.P := by
  have h := transfer_dlog CrossCharacteristicLarger.challenge k
  simpa only [phi_challenge] using h

theorem scalar_mod (k : ℤ) : R2 = k • S ↔ (3 : ℤ) ≡ k [ZMOD 7] := by
  rw [example_dlog k, CrossCharacteristicLarger.source_scalar_mod k]

def sourceCoverEquation (u v : ZMod 65537) : Prop :=
  v ^ 2 - u ^ 3 * v - 4 * v = u ^ 9 - 4 * u ^ 6

def targetCoverEquation (u v : Small) : Prop :=
  v ^ 2 + w * v = u ^ 9 + w * u ^ 6

theorem source_cover_equation (u v : ZMod 65537) : sourceCoverEquation u v ↔
    CrossCharacteristicLarger.sourceCurve.toAffine.Equation (u ^ 3) v := by
  rw [equation_iff]
  dsimp [sourceCoverEquation, CrossCharacteristicLarger.sourceCurve]
  ring_nf

theorem target_cover_equation (u v : Small) : targetCoverEquation u v ↔
    curve.toAffine.Equation (u ^ 3) v := by
  rw [equation_iff]
  dsimp [targetCoverEquation, curve]
  ring_nf

def tateFamily {K : Type*} [Field K] (t : K) : WeierstrassCurve K :=
  ⟨1 - (t ^ 2 - t), -(t ^ 3 - t ^ 2), -(t ^ 3 - t ^ 2), 0, 0⟩

theorem source_family : tateFamily (2 : ZMod 65537) =
    CrossCharacteristicLarger.sourceCurve := by
  ext <;> norm_num [tateFamily, CrossCharacteristicLarger.sourceCurve]

theorem target_parameters : w ^ 3 - w ^ 2 = w ∧ w ^ 2 - w = 1 := by
  constructor
  · rw [w_cube, w_sq, CharTwo.sub_eq_add, add_left_comm,
      CharTwo.add_self_eq_zero, add_zero]
  · rw [w_sq, CharTwo.sub_eq_add, add_right_comm,
      CharTwo.add_self_eq_zero, zero_add]

theorem target_family : tateFamily w = curve := by
  simp only [tateFamily, curve, target_parameters.1, target_parameters.2,
    sub_self, CharTwo.neg_eq]

def universalB : Polynomial ℤ := Polynomial.X ^ 3 - Polynomial.X ^ 2
def universalC : Polynomial ℤ := Polynomial.X ^ 2 - Polynomial.X

theorem universal_seven_identity :
    universalB ^ 2 - universalB * universalC - universalC ^ 3 = 0 := by
  dsimp [universalB, universalC]
  ring

theorem universal_tangent_identity :
    (Polynomial.X - 1) * (universalB - universalC - universalC ^ 2) =
      2 * universalC ^ 2 - universalB * universalC - universalB + universalC := by
  dsimp [universalB, universalC]
  ring

theorem universal_source_substitution :
    let u : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 0
    let v : MvPolynomial (Fin 2) ℤ := MvPolynomial.X 1
    v ^ 2 - u ^ 3 * v - 4 * v - (u ^ 3) ^ 3 + 4 * (u ^ 3) ^ 2 =
      v ^ 2 - u ^ 3 * v - 4 * v - u ^ 9 + 4 * u ^ 6 := by
  dsimp
  ring

theorem universal_target_substitution :
    let u : MvPolynomial (Fin 3) ℤ := MvPolynomial.X 0
    let v : MvPolynomial (Fin 3) ℤ := MvPolynomial.X 1
    let a : MvPolynomial (Fin 3) ℤ := MvPolynomial.X 2
    v ^ 2 + a * v - (u ^ 3) ^ 3 - a * (u ^ 3) ^ 2 =
      v ^ 2 + a * v - u ^ 9 - a * u ^ 6 := by
  dsimp
  ring

def tableScalar : Fin 7 → ℤ := ![0, 3, -1, 2, -2, 1, -3]

theorem seven_row_table (n : Fin 7) :
    phi ((n : ℕ) • CrossCharacteristicLarger.sourceGenerator) = tableScalar n • R := by
  rw [map_nsmul, phi_generator_multiple]
  have h : (n : ℕ) • ((3 : ℕ) • R) = ((n : ℤ) * 3) • R := by
    rw [← smul_smul]
    rfl
  rw [h, zsmul_eq_zsmul_iff_modEq, R_order]
  fin_cases n <;> decide

end CoverDecodeExample

