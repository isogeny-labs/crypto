  "independence": "std-only; its own F_{p^2} = F_p[i]/(i^2 - kappa), affine Weierstrass arithmetic, deterministic Miller-Rabin and Tonelli-Shanks over F_{p^2}; shares no code with n2_routes.rs",
  "checks_per_line": [
   "p prime",
   "kappa a non-residue mod p",
   "4a^3 + 27b^2 != 0",
