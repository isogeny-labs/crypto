{
  "schema": "crypto.ic-success-criteria/v1",
  "owner_rule": "2026-11-15",
  "doc": "docs/ic/SUCCESS_CRITERIA.md",
  "unit": {"cost": "GAE on E", "headline": "S = total_gae / sqrt(r)", "band": [0, 0.1, 1], "calibrated": ["0", "w_cal", "10*w_cal"], "targets": "one target, cold; amortized rows name t and are never the headline"},
  "size_bands": [
    {"band": "toy", "b_min": 0, "b_max": 32, "supports": ["T0"]},
    {"band": "small", "b_min": 32, "b_max": 64, "supports": ["T0", "T1", "T2-fit", "T3-fit"]},
    {"band": "medium", "b_min": 64, "b_max": 100, "supports": ["T1", "T2-fit", "T2-heldout", "T3-fit", "T3-heldout"], "rho_reference_when_infeasible": "sealed rho bound at alpha=1/2, low end of constant 95% CI"},
    {"band": "challenge", "instance": "ECC2K-130: E_0 over GF(2^131), #E = 4r", "supports": ["target-specific only"]}
  ],
  "tiers": {
    "T0": {"name": "improvement over IC baseline", "requires": ["frozen_baseline", "same_instances", "verified_answers", "cost_chain_3a", "class_3", "ratio_to_matched_rho"]},
    "T1": {"name": "faster than rho at a stated size", "requires": ["cold_one_target_both_arms", "min_targets:32", "verified_and_replayed", "paired_ci95_ratio_below_1_at_band", "below_1_at_0_wcal_10wcal", "validation_json", "size_family_instance_named"]},
    "T2": {"name": "smaller exponent than rho", "requires": ["T1_rules_each_size", "family_path_declared_before_data", "min_sizes:6", "min_span_bits:24", "max_size_b:48", "alpha_ci95_below_rho_alpha_ci95", "per_phase_fits", "dominant_phase_named", "derived_prediction_with_assumptions", "heldout_prediction_frozen_then_measured:+8_bits", "red_team_breakthrough", "validator_breakthrough"]},
    "T3": {"name": "subexponential L_N[a,c], 0<a<1", "requires": ["family_parametrised_in_N", "complexity_statement_a_c", "proof_or_named_heuristics", "each_heuristic_tested_each_size", "min_sizes:8", "fit_L_and_power_models", "heldout_prediction_each_model:+8_bits", "lean_or_partial_reported", "red_team_breakthrough", "validator_breakthrough"]}
  },
  "transfer": {
    "allowed_for": ["T0", "T1", "T2", "T3"],
    "requires": ["map_construction_charged_per_curve", "map_evaluation_charged_per_target", "homomorphism_injective_on_subgroup_certificate_independent", "answer_verified_on_E", "unit_conversion_measured_with_host", "applicability_class_checked_on_exact_instance", "weak_subfamily_labelled", "cost_chain_3a_interface_unchanged"]
  },
  "does_not_count": ["exponent_from_<6_sizes_or_<24_bits_or_changed_path", "subexp_from_data_alone_or_stage_or_unnamed_heuristic", "weak_instance_generalised", "uncharged_transfer_map", "answer_verified_only_on_target_group", "amortized_headline", "textbook_rho_where_measurable", "high_end_rho_bound", "heldout_written_after_measurement"]
}
