{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aburan28/crypto/blob/main/docs/curves/binary-subgroup-transfer-certificates.schema.json",
  "title": "Binary cover named-generated-subgroup transfer corpus",
  "description": "Structural contract for producer-side replay records binding each ordinary-binary cubic cover to every named EC1 generator. A supported record certifies injectivity only on the cyclic subgroup generated by the recorded point, using its checked annihilator and the identity phi_* phi^* = [3]. Schema validity alone does not check hashes, catalog coverage, arithmetic, evidence status, or PCC standing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "producer",
    "inputs",
    "scope",
    "summary",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "binary-subgroup-transfer-certificates/v1"
    },
    "generated_by": {
      "$ref": "#/$defs/nonemptyString"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mapRecord"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "positiveIntegerString": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "hexFieldElement": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
    },
    "encodedPolynomial": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/hexFieldElement"
      }
    },
    "icv1Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "slug"],
      "properties": {
        "full": {
          "type": "string",
          "pattern": "^ICV1:[^\\s]+$"
        },
        "slug": {
          "type": "string",
          "pattern": "^icv1-[a-z0-9-]+-[0-9a-f]{8}$"
        }
      }
    },
    "ec1": {
      "type": "string",
      "pattern": "^EC1(?:N[0-9]+|P[0-9]+|Q[0-9]+D[0-9]+)C[a-z][a-z0-9]*h[0-9a-f]{12,64}$"
    },
    "curveUid": {
      "type": "string",
      "pattern": "^urn:ec-record:1:sha256:[0-9a-f]{64}$"
    },
    "coverUid": {
      "type": "string",
      "pattern": "^urn:hc-model:1:sha256:[0-9a-f]{64}$"
    },
    "mapUid": {
      "type": "string",
      "pattern": "^urn:curve-cover-map:1:sha256:[0-9a-f]{64}$"
    },
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "git_commit",
        "source_sha256",
        "command",
        "rustc_version",
        "attestation"
      ],
      "properties": {
        "repository": {
          "const": "aburan28/crypto"
        },
        "git_commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "command": {
          "$ref": "#/$defs/nonemptyString"
        },
        "rustc_version": {
          "$ref": "#/$defs/nonemptyString"
        },
        "attestation": {
          "const": "caller_supplied_unverified"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "cover_graph"],
      "properties": {
        "registry": {
          "$ref": "#/$defs/artifactPin"
        },
        "cover_graph": {
          "$ref": "#/$defs/artifactPin"
        },
        "traits": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactPin"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "field_relation",
        "source_infinity",
        "map_degree",
        "supported_claim",
        "exact_cardinality_not_implied",
        "traits_role",
        "solver_assessment",
        "computational_advantage"
      ],
      "properties": {
        "family": {
          "const": "binary_cubic_pullback_v1"
        },
        "field_relation": {
          "const": "same_field"
        },
        "source_infinity": {
          "const": "one_base_field_rational_point"
        },
        "map_degree": {
          "const": 3
        },
        "supported_claim": {
          "const": "injective_on_each_named_generated_subgroup_with_checked_annihilator_coprime_to_3"
        },
        "exact_cardinality_not_implied": {
          "const": true
        },
        "traits_role": {
          "const": "advisory_provenance_only_not_used_for_exact_order"
        },
        "solver_assessment": {
          "const": "not_provided"
        },
        "computational_advantage": {
          "const": "not_assessed"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binary_maps",
        "maps_with_named_subgroups",
        "maps_without_named_subgroups",
        "named_subgroup_records",
        "supported_named_subgroup_records",
        "failed_named_subgroup_records"
      ],
      "properties": {
        "binary_maps": {
          "type": "integer",
          "minimum": 1
        },
        "maps_with_named_subgroups": {
          "type": "integer",
          "minimum": 0
        },
        "maps_without_named_subgroups": {
          "type": "integer",
          "minimum": 0
        },
        "named_subgroup_records": {
          "type": "integer",
          "minimum": 0
        },
        "supported_named_subgroup_records": {
          "type": "integer",
          "minimum": 0
        },
        "failed_named_subgroup_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "$ref": "#/$defs/hexFieldElement"
        },
        "y": {
          "$ref": "#/$defs/hexFieldElement"
        }
      }
    },
    "divisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u", "v"],
      "properties": {
        "u": {
          "$ref": "#/$defs/encodedPolynomial"
        },
        "v": {
          "$ref": "#/$defs/encodedPolynomial"
        }
      }
    },
    "evidenceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {
          "enum": ["proved", "probable", "unknown"]
        },
        "evidence_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "evidence_ref": {
                "$ref": "#/$defs/nonemptyString"
              }
            }
          }
        }
      ]
    },
    "exactOrderEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annihilator_primality", "generated_subgroup_cardinality"],
      "properties": {
        "annihilator_primality": {
          "$ref": "#/$defs/evidenceStatus"
        },
        "generated_subgroup_cardinality": {
          "$ref": "#/$defs/evidenceStatus"
        }
      }
    },
    "unknownEvidenceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref"],
      "properties": {
        "status": {
          "const": "unknown"
        },
        "evidence_ref": {
          "type": "null"
        }
      }
    },
    "unknownExactOrderEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annihilator_primality", "generated_subgroup_cardinality"],
      "properties": {
        "annihilator_primality": {
          "$ref": "#/$defs/unknownEvidenceStatus"
        },
        "generated_subgroup_cardinality": {
          "$ref": "#/$defs/unknownEvidenceStatus"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generator_on_curve",
        "target_generator_nonidentity",
        "annihilator_kills_target_generator",
        "pullback_nonidentity",
        "annihilator_kills_pullback",
        "pull_push_equals_degree_times_generator",
        "arbitrary_norm_matches_typed_pushforward",
        "degree_inverse_recovers_generator"
      ],
      "properties": {
        "target_generator_on_curve": {
          "type": "boolean"
        },
        "target_generator_nonidentity": {
          "type": "boolean"
        },
        "annihilator_kills_target_generator": {
          "type": "boolean"
        },
        "pullback_nonidentity": {
          "type": "boolean"
        },
        "annihilator_kills_pullback": {
          "type": "boolean"
        },
        "pull_push_equals_degree_times_generator": {
          "type": "boolean"
        },
        "arbitrary_norm_matches_typed_pushforward": {
          "type": "boolean"
        },
        "degree_inverse_recovers_generator": {
          "type": "boolean"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation", "reason"],
      "properties": {
        "obligation": {
          "$ref": "#/$defs/nonemptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "subgroupRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "claim_scope",
        "ec1",
        "curve_uid",
        "exact_order_evidence",
        "failures"
      ],
      "properties": {
        "status": {
          "enum": ["supported_on_named_generated_subgroup", "failed"]
        },
        "claim_scope": {
          "const": "named_generated_subgroup_only"
        },
        "ec1": {
          "$ref": "#/$defs/ec1"
        },
        "curve_uid": {
          "$ref": "#/$defs/curveUid"
        },
        "generator": {
          "$ref": "#/$defs/point"
        },
        "annihilator": {
          "$ref": "#/$defs/positiveIntegerString"
        },
        "map_degree": {
          "const": 3
        },
        "gcd_degree_annihilator": {
          "const": 1
        },
        "degree_inverse_mod_annihilator": {
          "$ref": "#/$defs/positiveIntegerString"
        },
        "pullback_witness": {
          "$ref": "#/$defs/divisor"
        },
        "typed_pushforward": {
          "$ref": "#/$defs/point"
        },
        "three_times_generator": {
          "$ref": "#/$defs/point"
        },
        "checks": {
          "$ref": "#/$defs/checks"
        },
        "exact_order_evidence": {
          "$ref": "#/$defs/exactOrderEvidence"
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported_on_named_generated_subgroup"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": [
              "generator",
              "annihilator",
              "map_degree",
              "gcd_degree_annihilator",
              "degree_inverse_mod_annihilator",
              "pullback_witness",
              "typed_pushforward",
              "three_times_generator",
              "checks"
            ],
            "properties": {
              "checks": {
                "allOf": [
                  {
                    "properties": {
                      "target_generator_on_curve": {"const": true},
                      "target_generator_nonidentity": {"const": true},
                      "annihilator_kills_target_generator": {"const": true},
                      "pullback_nonidentity": {"const": true},
                      "annihilator_kills_pullback": {"const": true},
                      "pull_push_equals_degree_times_generator": {"const": true},
                      "arbitrary_norm_matches_typed_pushforward": {"const": true},
                      "degree_inverse_recovers_generator": {"const": true}
                    }
                  }
                ]
              },
              "failures": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "exact_order_evidence": {
                "$ref": "#/$defs/unknownExactOrderEvidence"
              },
              "failures": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "mapRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "icv1_identity",
        "model_sha256",
        "model_json",
        "cover_uid",
        "map_uid",
        "map_degree",
        "named_subgroups",
        "failures"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported_on_all_named_generated_subgroups",
            "not_applicable_no_named_subgroup",
            "failed"
          ]
        },
        "icv1_identity": {
          "$ref": "#/$defs/icv1Identity"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_json": {
          "type": "string",
          "minLength": 2,
          "contentMediaType": "application/json"
        },
        "cover_uid": {
          "$ref": "#/$defs/coverUid"
        },
        "map_uid": {
          "$ref": "#/$defs/mapUid"
        },
        "map_degree": {
          "const": 3
        },
        "named_subgroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subgroupRecord"
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported_on_all_named_generated_subgroups"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "named_subgroups": {
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/subgroupRecord"
                    },
                    {
                      "properties": {
                        "status": {
                          "const": "supported_on_named_generated_subgroup"
                        }
                      },
                      "required": ["status"]
                    }
                  ]
                }
              },
              "failures": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable_no_named_subgroup"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "named_subgroups": {
                "maxItems": 0
              },
              "failures": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "failures": {
                    "minItems": 1
                  }
                }
              },
              {
                "properties": {
                  "named_subgroups": {
                    "contains": {
                      "properties": {
                        "status": {
                          "const": "failed"
                        }
                      },
                      "required": ["status"]
                    },
                    "minContains": 1
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
