{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isogeny-labs.example/schemas/ecdlp-claim-corpus-v1.json",
  "title": "ECDLP claim corpus",
  "type": "object",
  "required": [
    "schema",
    "version",
    "title",
    "scope",
    "sources",
    "nodes",
    "edges",
    "research_targets"
  ],
  "properties": {
    "schema": { "const": "ecdlp.claim-corpus/v1" },
    "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "fragments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "required": ["statement", "completeness", "reduction_direction"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "completeness": { "type": "string", "minLength": 1 },
        "reduction_direction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "research_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/researchTarget" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
    "sourceRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "kind", "verification", "citation"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["primary_publication", "standard_or_book", "repository_proof", "repository_measurement", "repository_synthesis", "lead_index"]
        },
        "verification": {
          "enum": ["primary_read", "repository_read", "metadata_only", "secondary_only"]
        },
        "citation": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "repository_path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "label", "kind", "status", "model", "statement", "scope", "assumptions", "source_refs", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["definition", "assumption", "structural_theorem", "reduction", "algorithmic_upper_bound", "model_lower_bound", "conditional_attack", "measured_bound", "heuristic", "open_obligation"]
        },
        "status": {
          "enum": ["definition", "assumed", "proved_external", "proved_internal_unreviewed", "algorithm", "conditional", "measured", "heuristic", "open"]
        },
        "model": {
          "enum": ["mathematical", "classical_unrestricted", "generic_group", "generic_group_preprocessing", "algebraic_coordinate", "curve_family_restricted", "quantum", "repository_measurement"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "source_locations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "formula": { "type": "string" },
        "parameters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "quantifiers": { "type": "string" },
        "evidence_class": { "enum": ["theorem", "algorithm", "conditional_theorem", "asymptotic_heuristic", "concrete_estimate", "measurement", "assumption", "definition", "open"] },
        "failure_modes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "non_implications": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "from", "to", "relation", "statement", "source_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "relation": {
          "enum": ["defines", "reduces_to", "hardness_implies", "upper_bounds", "lower_bounds", "attacks_when", "enables", "conditions", "instantiates", "model_bridge", "does_not_cover", "obstructs", "leaves_open", "measures", "qualifies"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" }
      },
      "additionalProperties": false
    },
    "researchTarget": {
      "type": "object",
      "required": ["id", "label", "status", "priority", "objective", "depends_on", "acceptance", "next_step", "source_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "status": { "enum": ["working", "ready", "blocked", "open"] },
        "priority": { "type": "integer", "minimum": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "acceptance": { "type": "string", "minLength": 1 },
        "next_step": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/sourceRefs" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
