digraph ecdlp_claims {
  graph [rankdir=LR, newrank=true, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.65, fontname="DejaVu Sans", fontsize=16, labelloc=t, label="ECDLP claim graph — theorem scope, attacks, and open obligations"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07"] ;
  edge [fontname="DejaVu Sans", fontsize=8, color="#66788a", fontcolor="#445566", arrowsize=0.7];
  subgraph cluster_foundations {
    label="Problems and assumption lattice"; color="#cad5df"; style="rounded";
    "PROB-ECDLP" [label="PROB-ECDLP\\nElliptic-curve discrete logarithm problem", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "ASM-CLASSICAL-ECDLP" [label="ASM-CLASSICAL-ECDLP\\nNamed-curve classical ECDLP hardness assumption", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "PROB-CDH" [label="PROB-CDH\\nComputational Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "PROB-DDH" [label="PROB-DDH\\nDecisional Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-CDH-DLP" [label="RED-CDH-DLP\\nCDH reduces to ECDLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DDH-CDH" [label="RED-DDH-CDH\\nDDH reduces to CDH", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "THEOREM-JMV-ISOGENY-REDUCTION" [label="THEOREM-JMV-ISOGENY-REDUCTION\\nJMV random reduction within an isogeny stratum", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "CONCLUSION-SPECIFIC-CURVE" [label="CONCLUSION-SPECIFIC-CURVE\\nSpecific-curve hardness remains assumption-based", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-SUBGROUP-COFACTOR" [label="DEF-SUBGROUP-COFACTOR\\nPrime subgroup and cofactor\\n#E(F_q)=h r", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-EMBEDDING-DEGREE" [label="DEF-EMBEDDING-DEGREE\\nEmbedding degree\\nk=ord_r(q)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-CONCRETE-SECURITY" [label="DEF-CONCRETE-SECURITY\\nConcrete security experiment", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-INDEX-CALCULUS-PIPELINE" [label="DEF-INDEX-CALCULUS-PIPELINE\\nECDLP index-calculus pipeline", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FACTOR-BASE" [label="DEF-FACTOR-BASE\\nAlgebraic factor base\\nB=|F|", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-XEDNI-CALCULUS" [label="DEF-XEDNI-CALCULUS\\nXedni calculus lifting attack", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GAP-DH" [label="DEF-GAP-DH\\nGap Diffie-Hellman setting", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-SCHNORR-ROM" [label="RED-SCHNORR-ROM\\nSchnorr-to-DL random-oracle reduction", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
  }
  subgraph cluster_bounds {
    label="Rigorous model bounds and structural theorems"; color="#cad5df"; style="rounded";
    "THEOREM-RANDOM-SELF-REDUCTION" [label="THEOREM-RANDOM-SELF-REDUCTION\\nPrime-order DLP random self-reducibility", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-SHOUP-DLP" [label="LB-SHOUP-DLP\\nShoup generic DLP lower bound\\nsuccess = O(m^2/p); constant success => m = Omega(sqrt(p))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-SHOUP-CDH" [label="LB-SHOUP-CDH\\nShoup generic CDH lower bound", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-CGK-ADVICE" [label="LB-CGK-ADVICE\\nGeneric preprocessing advice tradeoff\\nS T^2 = soft-Omega(epsilon N)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-CGK-PREPROCESS-TIME" [label="LB-CGK-PREPROCESS-TIME\\nGeneric preprocessing-time tradeoff\\nP T + T^2 = Omega(epsilon N)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SEMAEV-SUMMATION" [label="THEOREM-SEMAEV-SUMMATION\\nSemaev summation-polynomial criterion", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "BRIDGE-GENERIC-TABLE" [label="BRIDGE-GENERIC-TABLE\\nConditional generic simulation of table decomposition", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-YIELD-CONSERVATION" [label="THEOREM-YIELD-CONSERVATION\\nMean decomposition-yield conservation", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-ISOGENY-GENERIC" [label="LB-ISOGENY-GENERIC\\nIsogeny-augmented generic lower bound", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-FROB-SUBSPACES-131" [label="THEOREM-FROB-SUBSPACES-131\\nFrobenius-stable subspaces at n=131", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-GHS-GENUS-131" [label="THEOREM-GHS-GENUS-131\\nGHS genus classification at n=131", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-HASSE-BOUND" [label="THEOREM-HASSE-BOUND\\nHasse bound\\n#E(F_q)=q+1-t, |t|<=2 sqrt(q)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-QUADRATIC-TWIST-ORDER" [label="THEOREM-QUADRATIC-TWIST-ORDER\\nQuadratic-twist order relation\\n#E(F_q)+#E'(F_q)=2(q+1)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SUPERSINGULAR-SMALL-K" [label="THEOREM-SUPERSINGULAR-SMALL-K\\nSupersingular embedding-degree ceiling\\nk=2 over F_p (p>=5); k<=6 in general", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "STANDARD-CURVE-EXCLUSIONS" [label="STANDARD-CURVE-EXCLUSIONS\\nStandard curve exclusion checklist", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "OBSTRUCTION-NEGATION-CYCLES" [label="OBSTRUCTION-NEGATION-CYCLES\\nNegation-map fruitless-cycle obstruction", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SEMAEV-DEGREE" [label="THEOREM-SEMAEV-DEGREE\\nSummation-polynomial degree growth\\ndeg_Xi S_m=2^(m-2)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-GROEBNER-COST-DEPENDENCE" [label="FACT-GROEBNER-COST-DEPENDENCE\\nGroebner cost depends on solving geometry\\nFGLM=O(n D^3); F4/F5 matrix cost depends on d_reg/d_solve", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-PRIME-FIELD-NO-EXTENSION-GAIN" [label="FACT-PRIME-FIELD-NO-EXTENSION-GAIN\\nPrime-field boundary for extension index calculus", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "OBSTRUCTION-XEDNI-HEIGHT" [label="OBSTRUCTION-XEDNI-HEIGHT\\nCanonical-height obstruction to xedni\\none-shot Pr[success] <= C0/p (conditional); history-uniform hazard <= C0/p => E[T]=Omega(p)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-XEDNI-FINITE-CORE" [label="THEOREM-XEDNI-FINITE-CORE\\nKernel-checked finite xedni core\\nPr[fixed useful relation]=(q-1)/q^2; uniform hazard O(1/p) => E[T]=Omega(p)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-XEDNI-FF-DENSITY" [label="THEOREM-XEDNI-FF-DENSITY\\nExact codimension-three function-field lift density\\nP_lift(p)=(1-2/p+p^-3)/(2p^3)=Theta(p^-3)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-S3-ROOTS-ARE-GROUP-LAW" [label="FACT-S3-ROOTS-ARE-GROUP-LAW\\nS3 rootfinding collapses to group subtraction\\nS3(x_R,x_F,X)=(x_R-x_F)^2 (X-x(R-F))(X-x(R+F))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
  }
  subgraph cluster_attacks {
    label="Algorithms and special-family attacks"; color="#cad5df"; style="rounded";
    "ALG-POHLIG-HELLMAN" [label="ALG-POHLIG-HELLMAN\\nPohlig-Hellman order decomposition", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-BSGS" [label="ALG-BSGS\\nBaby-step giant-step", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-POLLARD-RHO" [label="ALG-POLLARD-RHO\\nPollard rho collision search\\nT = O(sqrt(r))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-RHO-AUTOMORPHISM" [label="ALG-RHO-AUTOMORPHISM\\nAutomorphism-folded rho", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ATTACK-SMART-TRACE-ONE" [label="ATTACK-SMART-TRACE-ONE\\nSmart anomalous-curve attack", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-MOV-PAIRING" [label="ATTACK-MOV-PAIRING\\nMOV pairing transfer", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-GHS-WEIL-DESCENT" [label="ATTACK-GHS-WEIL-DESCENT\\nGHS Weil-descent attack\\nT = O(q^(2+epsilon)) for fixed n", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-DIEM-EXTENSION" [label="ATTACK-DIEM-EXTENSION\\nDiem extension-field index calculus\\nT = exp(O(max(log q, n^2)))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ATTACK-SHOR-QUANTUM" [label="ATTACK-SHOR-QUANTUM\\nShor quantum discrete-log algorithm", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-PARALLEL-COLLISION" [label="ALG-PARALLEL-COLLISION\\nDistinguished-point parallel collision search\\nT_detect=(sqrt(pi N/(2u))/m + 1/theta) t", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-KANGAROO-INTERVAL" [label="ALG-KANGAROO-INTERVAL\\nPollard lambda/kangaroo interval DLP\\nT=O(sqrt(W))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ATTACK-CHEON-AUXILIARY" [label="ATTACK-CHEON-AUXILIARY\\nCheon auxiliary-input attack\\nT=O(sqrt(r/d)+sqrt(d))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-FREY-RUECK" [label="ATTACK-FREY-RUECK\\nFrey-Rueck Tate-pairing transfer", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "FACT-FIELD-DLP-AFTER-PAIRING" [label="FACT-FIELD-DLP-AFTER-PAIRING\\nTarget finite-field DLP governs pairing attack", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-SPARSE-LINEAR-ALGEBRA" [label="ALG-SPARSE-LINEAR-ALGEBRA\\nSparse relation-matrix solving\\nT_LA roughly O(m B^2), storage O(mB)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GAUDRY-FIXED-EXTENSION" [label="ALG-GAUDRY-FIXED-EXTENSION\\nGaudry fixed-extension index calculus\\nT=soft-O(q^(2-2/n)) for fixed n", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-PKM-PRIME-ALGEBRAIC" [label="COND-PKM-PRIME-ALGEBRAIC\\nPKM prime-field algebraic route", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-BINARY-WEIL-DESCENT" [label="COND-BINARY-WEIL-DESCENT\\nBinary summation-polynomial Weil descent", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ESTIMATE-QUANTUM-ROETTELER" [label="ESTIMATE-QUANTUM-ROETTELER\\n2017 logical quantum circuit estimate\\nQ<=9n+2 ceil(log2 n)+10; Toffoli<=448 n^3 log2(n)+4090 n^3", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ESTIMATE-QUANTUM-HAENER" [label="ESTIMATE-QUANTUM-HAENER\\n2020 reversible-circuit tradeoff frontier", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ESTIMATE-QUANTUM-CAT-2023" [label="ESTIMATE-QUANTUM-CAT-2023\\n2023 repetition-cat physical estimate\\n126133 cat qubits; 9 h; mean 19 photons/cat under stated assumptions", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ESTIMATE-QUANTUM-IONQ-2026" [label="ESTIMATE-QUANTUM-IONQ-2026\\n2026 trapped-ion secp256k1 preprint estimate\\n~1450 logical qubits; 40e6 Toffoli; 19397 physical qubits; 25.7 d; estimated success 63%", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "BOUNDARY-INVALID-CURVE" [label="BOUNDARY-INVALID-CURVE\\nInvalid-curve and small-subgroup boundary", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
  }
  subgraph cluster_evidence {
    label="Measured and heuristic evidence"; color="#cad5df"; style="rounded";
    "FACT-MEASURED-BOUND" [label="FACT-MEASURED-BOUND\\nECBND records are measured upper bounds", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEASURED-CURRENT-FRONTIER" [label="MEASURED-CURRENT-FRONTIER\\nCurrent measured classical frontier", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "HEUR-RHO-RANDOM-MAPPING" [label="HEUR-RHO-RANDOM-MAPPING\\nRho random-mapping heuristic\\nE[steps to repeat] ~= sqrt(pi N/2)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-AUTOMORPHISM-SPEEDUP" [label="HEUR-AUTOMORPHISM-SPEEDUP\\nAutomorphism quotient speedup\\nT_quotient/T_plain ~= 1/sqrt(a)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-DECOMPOSITION-PROBABILITY" [label="HEUR-DECOMPOSITION-PROBABILITY\\nRandom decomposition-yield heuristic\\nmu=B^m/r; Pr[decomposition]~=1-exp(-mu)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-ZERO-DIMENSIONAL-PDP" [label="HEUR-ZERO-DIMENSIONAL-PDP\\nZero-dimensional PDP hypothesis", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-FIRST-FALL-DEGREE" [label="HEUR-FIRST-FALL-DEGREE\\nFirst-fall/regularity degree heuristic", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RELATION-RANK" [label="HEUR-RELATION-RANK\\nRelation independence/rank heuristic\\nR >= B + margin", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-SYMMETRY-PDP-SPEEDUP" [label="HEUR-SYMMETRY-PDP-SPEEDUP\\nInvariant-coordinate PDP speedup", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
  }
  subgraph cluster_open {
    label="Open proof and attack surfaces"; color="#cad5df"; style="rounded";
    "GAP-UNCONDITIONAL-CLASSICAL" [label="GAP-UNCONDITIONAL-CLASSICAL\\nNo unconditional classical ECDLP lower bound", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-COORDINATE-ALGEBRAIC" [label="GAP-COORDINATE-ALGEBRAIC\\nCoordinate-algebraic escape from generic bounds", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-AUTOMORPHISM-PREPROCESS" [label="GAP-AUTOMORPHISM-PREPROCESS\\nPreprocessing bounds with automorphism quotients", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-PKM-SOLVING-DEGREE" [label="GAP-PKM-SOLVING-DEGREE\\nPrime-field PKM solving-degree growth", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-BINARY-M4-DEGREE" [label="GAP-BINARY-M4-DEGREE\\nBinary m=4 Weil-descent degree growth", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-TRANSPORT-ORACLE-SIM" [label="GAP-TRANSPORT-ORACLE-SIM\\nCoordinate transport-oracle simulation", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-QUANTUM-RESOURCES" [label="GAP-QUANTUM-RESOURCES\\nConcrete fault-tolerant quantum resources", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-XEDNI-END-TO-END" [label="GAP-XEDNI-END-TO-END\\nXedni end-to-end bridge obligations", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-MULTITARGET-NONUNIFORM" [label="GAP-MULTITARGET-NONUNIFORM\\nMulti-target/nonuniform security conversion", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-END-TO-END-IC-EXPONENT" [label="GAP-END-TO-END-IC-EXPONENT\\nEnd-to-end index-calculus exponent obligation", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
    "GAP-PROTOCOL-ASSUMPTION-MAPPING" [label="GAP-PROTOCOL-ASSUMPTION-MAPPING\\nProtocol-to-problem assumption mapping", fillcolor="#fff1b8", color="#9a6700", style="rounded,filled,dashed"];
  }
  "ASM-CLASSICAL-ECDLP" -> "PROB-ECDLP" [label="defines", color="#66788a", style="solid"];
  "PROB-CDH" -> "PROB-ECDLP" [label="reduces_to", color="#66788a", style="solid"];
