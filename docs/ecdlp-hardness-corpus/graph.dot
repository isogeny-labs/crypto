    "HEUR-RHO-RANDOM-MAPPING" [label="HEUR-RHO-RANDOM-MAPPING\\nRho random-mapping heuristic\\nE[steps to repeat] ~= sqrt(pi N/2)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-AUTOMORPHISM-SPEEDUP" [label="HEUR-AUTOMORPHISM-SPEEDUP\\nAutomorphism quotient speedup\\nT_quotient/T_plain ~= 1/sqrt(a)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-DECOMPOSITION-PROBABILITY" [label="HEUR-DECOMPOSITION-PROBABILITY\\nRandom decomposition-yield heuristic\\nmu=B^m/r; Pr[decomposition]~=1-exp(-mu)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-ZERO-DIMENSIONAL-PDP" [label="HEUR-ZERO-DIMENSIONAL-PDP\\nZero-dimensional PDP hypothesis", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-FIRST-FALL-DEGREE" [label="HEUR-FIRST-FALL-DEGREE\\nFirst-fall/regularity degree heuristic", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RELATION-RANK" [label="HEUR-RELATION-RANK\\nRelation independence/rank heuristic\\nR >= B + margin", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-SYMMETRY-PDP-SPEEDUP" [label="HEUR-SYMMETRY-PDP-SPEEDUP\\nInvariant-coordinate PDP speedup", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-WAGNER-FOUR-SUM" [label="HEUR-WAGNER-FOUR-SUM\\nWagner four-sum cube-root heuristic\\nT,S = soft-O(2^(n/3))", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "MEAS-RP-IC-BOUNDARY-ROUND1" [label="MEAS-RP-IC-BOUNDARY-ROUND1\\nIC boundary ledger: no variant below rho at r >= 2^20; fitted exponents >= 0.54", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-BOUNDARY-TARGETS-PRIME" [label="MEAS-RP-BOUNDARY-TARGETS-PRIME\\nPrime-field IC slower than rho at all measured sizes (boundary targets)", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-KOBLITZ-N61-ONLINE" [label="MEAS-RP-KOBLITZ-N61-ONLINE\\nKoblitz n=61 compact-orbit IC: online 37.13x vs strong rho on the same point, cold about 90x slower", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-COMPACT-ORBIT-PREPROCESSING" [label="MEAS-RP-COMPACT-ORBIT-PREPROCESSING\\nCompact-orbit Koblitz IC sits on or above S*T^2 >~ r/|Aut| at every rung", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-JV-WEAK-CLASS" [label="MEAS-RP-JV-WEAK-CLASS\\nJoux-Vitse cover-and-decomposition on the weak F_{p^6} class: S/rho ~ n^-0.32, sieve crossover near 2^49-2^50", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-JV-E2E-NONWEAK" [label="MEAS-RP-JV-E2E-NONWEAK\\nJV route end to end from non-weak curves: 32/32 verified, S/rho 0.005-0.019 at l = 2^61.4", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-FALL-DEGREE-TOY" [label="MEAS-RP-FALL-DEGREE-TOY\\nSemaev closure degree bounded at toy size: d_F <= 4 through m=6, N <= 60; one below the semi-regular control", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-FALL-DEGREE-M3-DIAGONAL" [label="MEAS-RP-FALL-DEGREE-M3-DIAGONAL\\nm=3 diagonal: d_F censored >= 5 exactly at ell >= 7; (3,24,7) reads 'mixed'", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-SECANT-F4" [label="MEAS-RP-SECANT-F4\\nSplit-graph secant bases lower the observed stock-F4 degree but raise branch-summed rows vs dense", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-TWIST-CENSUS" [label="MEAS-RP-TWIST-CENSUS\\nQuadratic-twist S3 censuses: zero strict joint useful-rank/degree gains", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-PLANNER-RETEST" [label="MEAS-RP-PLANNER-RETEST\\nPlanner re-test: Koblitz descent dearer at all six sizes; residual collector wins only as a generic collision search", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-CALIBRATION-DRIFT" [label="MEAS-RP-CALIBRATION-DRIFT\\nPer-run GAE calibration drifted ratios up to 3.7x before pinning", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-DREG-PROXY-MISS" [label="MEAS-RP-DREG-PROXY-MISS\\nTwo-summand Weil systems: homogeneous D_reg = l+1 while D_solve = 2-4", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-GAUDRY-CUBIC" [label="MEAS-RP-GAUDRY-CUBIC\\nGaudry cubic-extension IC whole method never beats rho at measured sizes", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "HEUR-RP-LIFT-SUBGROUP-HALF" [label="HEUR-RP-LIFT-SUBGROUP-HALF\\nA random abscissa lifts with probability ~1/2 and lands in <G> with probability ~1/2 (A-FB2)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RP-SEMIREGULAR-DREG-PROXY" [label="HEUR-RP-SEMIREGULAR-DREG-PROXY\\nSemi-regular D_reg predicts Groebner cost of descended Semaev systems (A-PDP5)\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "HEUR-RP-WALK-TARGET-GUARD" [label="HEUR-RP-WALK-TARGET-GUARD\\nWalk targets behave as uniform, with a mandatory repeated-target guard (A-RC1)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RP-LARGE-PRIME-GRAPH" [label="HEUR-RP-LARGE-PRIME-GRAPH\\nLarge-prime leftovers meet with birthday probability and the graph connects (A-RC2)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RP-DESCENT-TERMINATION" [label="HEUR-RP-DESCENT-TERMINATION\\nRecursive target descent terminates (A-TD1)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-FACTOR-BASE-SIZE" [label="HEUR-BK-GG-FACTOR-BASE-SIZE\\nHeuristic #F ~ #V for subspace factor bases", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-DECOMP-PROPORTION" [label="HEUR-BK-GG-DECOMP-PROPORTION\\nDecomposable proportion ~1/n! (l=1) or q^(lk-n)/k!\\nPr[decompose] ~ q^(l k - n) / k!  (l = 1, k = n: 1/n!)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-FFDA-DESCRIPTION" [label="HEUR-BK-GG-FFDA-DESCRIPTION\\nSurvey definition of the First Fall Degree Assumption", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-RIGHT-KERNEL-RANK" [label="HEUR-BK-GG-RIGHT-KERNEL-RANK\\nRight-kernel IC needs full rank, rarely met at #relations = #F", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-GHS-GENERIC-FAILURE" [label="HEUR-BK-GG-GHS-GENERIC-FAILURE\\nGHS fails in general: cover genus exponential in n", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-BREAK-SYMMETRY" [label="HEUR-BK-GG-BREAK-SYMMETRY\\nDisjoint factor bases: expected (k-1)! gain", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-RHO-HEURISTIC" [label="HEUR-BK-GG-RHO-HEURISTIC\\nRho/kangaroo analyses are heuristic; worst case unbounded\\n(sqrt(pi/2) + o(1)) sqrt r serial, heuristic", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-NEGATION-DISPUTE" [label="HEUR-BK-GG-NEGATION-DISPUTE\\nNegation-map speedup: practical dispute recorded", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-GG-ISOGENY-WALK" [label="HEUR-BK-GG-ISOGENY-WALK\\nMapping ECDLP to an isogenous curve is generally efficient", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-KM-ORACLE-NOT-ALGORITHM" [label="HEUR-BK-KM-ORACLE-NOT-ALGORITHM\\nOracle-relative DL assumptions (all-primes-but-p) are easier than DL", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-BK-BRAINPOOL-CLASS-NUMBER-LIFT" [label="HEUR-BK-BRAINPOOL-CLASS-NUMBER-LIFT\\nLarge class number as a guard against lifting", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-MILLER-HEIGHT" [label="HEUR-XT-MILLER-HEIGHT\\nMiller's height argument against lifted index calculus", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-SS-ANALYSIS" [label="HEUR-XT-SS-ANALYSIS\\nSilverman-Suzuki: lifted index calculus slower than brute force", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-PPVW-BOUNDED-RANK" [label="HEUR-XT-PPVW-BOUNDED-RANK\\nPPVW heuristic: ranks of E/Q are bounded (finitely many > 21)\\n#{E : ht E <= H, rk >= r} = H^((21-r)/24+o(1)), 1<=r<=20 (model)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-EASY-LIFT-DEPENDENCE" [label="HEUR-XT-EASY-LIFT-DEPENDENCE\\nEasy-lift (xedni) points are dependent with probability below 1/p\\nPr[lifted points dependent] < 1/p (heuristic)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "MEAS-XT-ECC2K130-EMBEDDING-DEGREE" [label="MEAS-XT-ECC2K130-EMBEDDING-DEGREE\\nECC2K-130 embedding degree exceeds 10^7\\nord_r(2^131) > 10^7", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "HEUR-XT-LS-MNT-COUNT" [label="HEUR-XT-LS-MNT-COUNT\\nLuca-Shparlinski: about z^(1/2+o(1)) MNT curves with CM discriminant <= z", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-NFS-SMOOTHNESS" [label="HEUR-XT-NFS-SMOOTHNESS\\nClassical NFS smoothness heuristic", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-NFS-C32-FLOOR" [label="HEUR-XT-NFS-C32-FLOOR\\nBarbulescu-Duquesne: arguments that c cannot go below 32", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-BGJT-REPRESENTATION" [label="HEUR-XT-BGJT-REPRESENTATION\\nBGJT heuristic: a sparse medium subfield representation exists", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-XT-BGJT-DESCENT" [label="HEUR-XT-BGJT-DESCENT\\nBGJT descent heuristics (smoothness and PGL2 full rank)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "CLAIM-XT-JOUX-PINPOINT-ORIGINAL" [label="CLAIM-XT-JOUX-PINPOINT-ORIGINAL\\nClaim: Joux pinpointing reaches L(1/3, (8/9)^(1/3))\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "HEUR-XT-JOUX-PINPOINT-CORRECTED" [label="HEUR-XT-JOUX-PINPOINT-CORRECTED\\nJoux pinpointing: corrected constant L(1/3, 2^(1/3))", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-GG-DP-RHO" [label="HEUR-GG-DP-RHO\\nDP rho heuristic (Galbraith Heur. 14.2.15 / Thm 14.2.16)\\nE[T] = (1.253 + o(1)) sqrt r (DP); (3.093 + o(1)) sqrt r (Floyd)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-GG-BRENT-POLLARD-ADDING" [label="HEUR-GG-BRENT-POLLARD-ADDING\\nBrent-Pollard nonrandomness: factor 1/sqrt(1 - sum p_i^2)\\nslowdown ~= 1/sqrt(1 - sum p_i^2) = 1/sqrt(1 - 1/r)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-GG-BL-HIGHER-ANTICOLLISIONS" [label="HEUR-GG-BL-HIGHER-ANTICOLLISIONS\\nBernstein-Lange: higher-degree local anti-collisions slow rho beyond Brent-Pollard\\nr = 6: 1.129162 (all degrees) vs 1.095445 (Brent-Pollard)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-GG-TESKE-ADDING-WALK" [label="HEUR-GG-TESKE-ADDING-WALK\\nTeske: r-adding walks with r >= 20 behave like random walks\\nE[cycle length] <= 1.3 sqrt r for r >= 20 (conjectured)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-GG-KANGAROO-FOOTPRINTS" [label="HEUR-GG-KANGAROO-FOOTPRINTS\\nKangaroo heuristic (Galbraith Heur. 14.5.4)\\nE[T] = (2 + o(1)) sqrt w", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-GG-DGM-CYCLE-RATES" [label="HEUR-GG-DGM-CYCLE-RATES\\nFruitless-cycle rates: 2-cycles Theta(1/r), 2c-cycles Theta(1/r^c)\\nP(2-cycle per step) ~ 1/(2r); P(2c-cycle) = Theta(1/r^c)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
