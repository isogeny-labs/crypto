    "ESTIMATE-QUANTUM-IONQ-2026" [label="ESTIMATE-QUANTUM-IONQ-2026\\n2026 trapped-ion secp256k1 preprint estimate\\n~1450 logical qubits; 40e6 Toffoli; 19397 physical qubits; 25.7 d; estimated success 63%", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
