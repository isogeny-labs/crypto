    "ALG-GG-KUHN-STRUIK" [label="ALG-GG-KUHN-STRUIK\\nKuhn-Struik: L targets with one DP table in about sqrt(2 r L)\\n~sqrt(2 r L) for L targets", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GG-BL-PRECOMP-RHO" [label="ALG-GG-BL-PRECOMP-RHO\\nBernstein-Lange precomputed-DP rho: ~ell^(1/3) online\\nonline ~ 2 ell^(1/3); RAM cost (p ell)^(1/3); AT cost (p ell)^(1/2)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GG-BL-SMALLDL-TABLE" [label="ALG-GG-BL-SMALLDL-TABLE\\nBL small DL: 1.77 ell^(1/3) with a table of ell^(1/3)\\n1.77 ell^(1/3) online, table ell^(1/3), precomputation 1.24 ell^(2/3)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-GG-KMT-NEAR-OPTIMAL" [label="THM-GG-KMT-NEAR-OPTIMAL\\nKim-Montenegro-Tetali: rho collision in O(sqrt|G| log|G| loglog|G|)\\nT = O(sqrt(|G|) log|G| log log|G|)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-GG-KMPT-RHO-OPTIMAL" [label="THM-GG-KMPT-RHO-OPTIMAL\\nKMPT: rho collides in Theta(sqrt|G|), constant <= 52.5\\nE[T_collision] <= (1+o(1)) 12 sqrt(19) sqrt|G| < 52.5 sqrt|G|", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GG-GRUMPY" [label="ALG-GG-GRUMPY\\nTwo grumpy giants and a baby beats rho on average (high memory)\\nsuccess after 1.5 sqrt(ell): 0.71875 (grumpy) vs 0.6753 (random walk) vs 0.5625 (BSGS)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-GG-MT-KANGAROO" [label="THM-GG-MT-KANGAROO\\nMontenegro-Tetali: kangaroo takes (2 + o(1)) sqrt(b - a)\\naverage (2 + o(1)) sqrt(b-a); worst (3 + o(1)) sqrt(b-a)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GG-GPR-FOUR-KANGAROO" [label="ALG-GG-GPR-FOUR-KANGAROO\\nGalbraith-Pollard-Ruprai: 4-kangaroo 1.714 sqrt N, hybrid 1.66 sqrt N\\n1.818, 1.714, 1.661 times sqrt N", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GG-FOWLER-FIVE-KANGAROO" [label="ALG-GG-FOWLER-FIVE-KANGAROO\\nFowler: five kangaroos at 1.737 sqrt N (not below four)\\n(1.737 + o(1)) sqrt N", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-GG-EQUIV-CLASS-RHO" [label="THM-GG-EQUIV-CLASS-RHO\\nRho on equivalence classes: sqrt(pi r/(2 N_C)) (C1 + C2)\\n(sqrt(pi/(2 N_C)) + o(1)) sqrt(r) (C1 + C2)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "CLAIM-GG-CERTICOM-DP-NORMALIZATION" [label="CLAIM-GG-CERTICOM-DP-NORMALIZATION\\nCerticom 1998: normalizing distinguished points alone gives sqrt 2 / sqrt(2d)\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "ALG-GG-WZ-NEGATION" [label="ALG-GG-WZ-NEGATION\\nWiener-Zuccherato negating additive walk with 2-cycle look-back", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "CLAIM-GG-BKL-SIMD-NEGATION" [label="CLAIM-GG-BKL-SIMD-NEGATION\\nBKL 2010: negation gives little or no speedup on SIMD\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "ALG-GG-BLS-BRANCHLESS-NEGATION" [label="ALG-GG-BLS-BRANCHLESS-NEGATION\\nBLS branchless negating rho: (1+o(1)) sqrt(pi ell/4)\\nE[iterations] = (1+o(1)) sqrt(pi ell/4); overhead 1 + Theta(1/sqrt r)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GG-GLV-FROBENIUS-WALK" [label="ALG-GG-GLV-FROBENIUS-WALK\\nGallant-Lambert-Vanstone multiplicative walk on Frobenius-negation orbits\\n~ sqrt(pi 2^m / (4m)) group operations on Koblitz curves", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-PF-PKM-INDEX-CALCULUS" [label="ALG-PF-PKM-INDEX-CALCULUS\\nPKM Algorithm 1 (prime-curve index calculus)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-PF-PKM-COST-THRESHOLD" [label="COND-PF-PKM-COST-THRESHOLD\\nPKM cost decomposition and the p^(1/2-1/m) bar\\nP(p,m) + m! p (deg L)^(1-m) T(E,m,L) + (deg L)^omega < p^(1/2)  <=  T(E,m,L) < p^(1/2-1/m) when (deg L)^m ~ m! p", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-PF-APS-SINGLE-RELATION" [label="ALG-PF-APS-SINGLE-RELATION\\nAPS single-relation variant of Semaev's method", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-PF-APS-COST" [label="COND-PF-APS-COST\\nAPS cost q m^m / s^m * T(E,m,V)\\n(q m^m / s^m) * T(E,m,V)", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-PF-APS-BEATS-PKM" [label="COND-PF-APS-BEATS-PKM\\nAPS outperforms PKM for fixed m and growing p", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-PF-HKPYY-COMPLEXITY" [label="COND-PF-HKPYY-COMPLEXITY\\nHKPYY Theorem 3.2: QSP index-calculus complexity", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-PF-EP-BETA-THRESHOLD" [label="COND-PF-EP-BETA-THRESHOLD\\nEuler-Petit Prop. 8: beating generic needs beta < 0.103\\ncost = O~(p^((1 - 1/(4 kappa beta)) n)); generic beaten iff beta < 1/(2 kappa) ~ 0.103", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "THM-GB-MACAULAY-MATRIX-COST" [label="THM-GB-MACAULAY-MATRIX-COST\\nMacaulay-matrix Groebner cost up to degree D\\nO(m D C(n+D-1,D)^omega)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-GB-F5-COMPLEXITY" [label="THM-GB-F5-COMPLEXITY\\nMatrix-F5 complexity for regular systems (BFS Theorem 2)\\nB(delta)^n n (A(delta,l)+O(1/n))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-GB-PQ-SUBEXP-BINARY-ECDLP" [label="COND-GB-PQ-SUBEXP-BINARY-ECDLP\\nPetit-Quisquater subexponential binary ECDLP: 2^{c n^{2/3} log n}\\nO(2^{c log(n) (n^{2/3}+1)}), c = 2omega/3", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-GB-HFE-FIRST-FALL-ESTIMATES" [label="COND-GB-HFE-FIRST-FALL-ESTIMATES\\nFirst-fall/degree-of-regularity HFE estimates (Dubois-Gama, Ding-Hodges, Ding-Kleinjung)", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-FREY-1998" [label="COND-WD-FREY-1998\\nFrey 1998: Weil descent as an attack methodology", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-WD-MMT-EG-COST" [label="ALG-WD-MMT-EG-COST\\nMMT non-asymptotic Enge-Gaudry cost model for GHS curves", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-WD-MMT-COMPOSITE-N" [label="COND-WD-MMT-COMPOSITE-N\\nMMT: GHS beats rho on some curves for many composite N in [160, 600]", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-GALHS-ISOGENY" [label="COND-WD-GALHS-ISOGENY\\nGalbraith-Hess-Smart 2002: extend GHS through isogenies", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-MTW-WEAK-FIELDS" [label="COND-WD-MTW-WEAK-FIELDS\\nMenezes-Teske-Weng: weak fields for ECC (e.g. GF(2^210))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-HESS-F2155" [label="COND-WD-HESS-F2155\\nHess 2004: about 2^123 more curves over F_(2^155) attackable", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-MT-HESS-FIELDS" [label="COND-WD-MT-HESS-FIELDS\\nMenezes-Teske 2006: which GF(2^N) are weak under gGHS", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-JV-COVER-DECOMP" [label="COND-WD-JV-COVER-DECOMP\\nJoux-Vitse 2012: cover-and-decomposition index calculus\\nÕ(p^(2-2/(ng))) or Õ(p^(2-2/(ng+2))); F_(p^6): Õ(p^(5/3))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-WD-ADH-1994" [label="ALG-WD-ADH-1994\\nAdleman-DeMarrais-Huang: subexponential DLP on large-genus hyperelliptic Jacobians", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-WD-ENGE-GAUDRY-2002" [label="THM-WD-ENGE-GAUDRY-2002\\nEnge-Gaudry Theorem 1: rigorous L_(q^g)(sqrt(2)) hyperelliptic DLP\\nL_(q^g)(sqrt(2) + o(1))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-WD-EG-2007-L13" [label="COND-WD-EG-2007-L13\\nEnge-Gaudry 2007: L(1/3 + epsilon) DLP for low-degree curves\\nL_(q^g)(1/3 + epsilon, o(1))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-WD-GAUDRY-2000" [label="ALG-WD-GAUDRY-2000\\nGaudry 2000: fixed-genus index calculus, Õ(q^2)\\nO((g^2 log^3 p) g! p + (g^2 log p) p^2)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-WD-THERIAULT-2003" [label="ALG-WD-THERIAULT-2003\\nTheriault 2003: single large prime, Õ(q^(2 - 2/(g + 1/2)))\\nÕ(q^(2-4/(2g+1)))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-WD-GTTD-THM1" [label="THM-WD-GTTD-THM1\\nGTTD Theorem 1: double large prime, Õ(q^(2-2/g)) rigorous\\nÕ(q^(2-2/g))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THM-WD-DIEM-SMALL-GENUS" [label="THM-WD-DIEM-SMALL-GENUS\\nDiem 2006: Õ(q^(2-2/g)) for all curves of fixed genus g >= 2 (cyclic class group)\\nÕ(q^(2-2/g))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-WD-DIEM-PLANE-CURVES" [label="COND-WD-DIEM-PLANE-CURVES\\nDiem 2006 (ANTS): Õ(q^(2-2/(d-2))) for plane curves of degree d\\nÕ(q^(2-2/(d-2)))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-WD-DT-RESULT13" [label="COND-WD-DT-RESULT13\\nDiem-Thome Heuristic Result 13: Õ(q) for non-hyperelliptic genus 3\\nÕ(q)", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-LAINE-LAUTER" [label="COND-WD-LAINE-LAUTER\\nLaine-Lauter: time-memory trade-offs for genus-3 index calculus", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-WD-SMITH-THM2" [label="COND-WD-SMITH-THM2\\nSmith Theorem 2: about 18.57% of genus-3 hyperelliptic DLPs move to plane quartics\\nsum_T (1-(3/4)^s(T)) / prod (nu_T(n)! n^nu_T(n)) ~ 0.1857", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-SP-SEMAEV-2004-PRIME-FIELD" [label="COND-SP-SEMAEV-2004-PRIME-FIELD\\nSemaev 2004: prime-field index calculus if bounded roots are easy", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-SP-GAUDRY-ABELIAN-IC" [label="ALG-SP-GAUDRY-ABELIAN-IC\\nGaudry: index calculus on abelian varieties of fixed dimension\\nT = O~(q^(2-2/n)), constant c(n, family)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-SP-JV-N1-DECOMPOSITION" [label="COND-SP-JV-N1-DECOMPOSITION\\nJoux-Vitse: (n-1)-point decomposition index calculus\\nT = O~(((n-1)! 2^((n-1)(n-2)) e^n n^(-1/2))^omega q^2)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "OBS-SP-JV-FP5-TIMINGS" [label="OBS-SP-JV-FP5-TIMINGS\\nJoux-Vitse: F_{p^5} decomposition test timings", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-SP-JV-COVER-DECOMPOSITION" [label="ALG-SP-JV-COVER-DECOMPOSITION\\nJoux-Vitse cover-and-decomposition attack\\nT = O~(p^(2-2/(ng))) or O~(p^(2-2/(ng+2)))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "OBS-SP-JV-149BIT-RECORD" [label="OBS-SP-JV-149BIT-RECORD\\nJoux-Vitse: 149-bit ECDLP over F_{p^6} record", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-SP-FPPR-BINARY" [label="COND-SP-FPPR-BINARY\\nFPPR: binary ECDLP in O(2^(omega t)), t ~ n/2\\nT = O(2^(omega t)), t ~ n/2", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "OBS-SP-FPPR-GB-COUNTS" [label="OBS-SP-FPPR-GB-COUNTS\\nFPPR: Groebner operation counts for m = 2 PDP up to n = 131", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-SP-FGHR-PDP-EDWARDS" [label="COND-SP-FGHR-PDP-EDWARDS\\nFGHR Theorem 4.1: PDP cost for twisted Edwards / Jacobi intersections\\nO~(n 2^(3(n-1)^2)) or O~(n^2 2^(omega (n-1)^2))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "OBS-SP-FHJRV-SYMMETRIZED-RECORDS" [label="OBS-SP-FHJRV-SYMMETRIZED-RECORDS\\nFHJRV 2014: 8th symmetrized summation polynomial", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-SP-HPST-SYMMETRIZED-PRIME-DEGREE" [label="COND-SP-HPST-SYMMETRIZED-PRIME-DEGREE\\nHPST 2013: symmetrized FPPR for prime-degree binary fields", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-SP-SEMAEV15-COMPLEXITY" [label="COND-SP-SEMAEV15-COMPLEXITY\\nSemaev 2015: binary ECDLP in 2^(c sqrt(n ln n)), c ~ 1.69\\nT ~ 2^(c sqrt(n ln n)); first stage m! 2^(n/m) n^(4 omega); second 2^(2k)", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-SP-KARABINA-PDP" [label="COND-SP-KARABINA-PDP\\nKarabina 2015: S_3-split PDP with constant D_reg extrapolation\\nT ~ 2^31 2^(n/5) n^12 + 2^(2n/5) (m = 5, D_reg = 4)", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-PA-FS-BATCH-SOUNDNESS" [label="COND-PA-FS-BATCH-SOUNDNESS\\nFiat-Shamir RLC batch verification fails with probability <= d/|F|", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
  }
  subgraph cluster_evidence {
    label="Measured and heuristic evidence"; color="#cad5df"; style="rounded";
