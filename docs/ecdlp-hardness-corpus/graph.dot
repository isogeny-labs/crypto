    "COND-XT-MOV-SS-SMALLCHAR" [label="COND-XT-MOV-SS-SMALLCHAR\\nRigorous quasi-polynomial ECDLP on supersingular curves of fixed characteristic", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-XT-GKZ-F2-367-BREAK" [label="ALG-XT-GKZ-F2-367-BREAK\\nTotal break of the DLP in F_{2^{12*367}} (genus-2 supersingular pairing target)\\n~52240 core-hours (~2^48 M_r2)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
