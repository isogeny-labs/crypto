    "ALG-STATIC-DH-AUXILIARY-POWERS" [label="ALG-STATIC-DH-AUXILIARY-POWERS\\nStatic-DH auxiliary-power attack\\nT = O((sqrt((r-1)/d)+sqrt(d))log(r)); Q = d", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
