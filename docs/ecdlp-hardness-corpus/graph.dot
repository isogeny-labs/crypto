    "HEUR-AUTOMORPHISM-SPEEDUP" [label="HEUR-AUTOMORPHISM-SPEEDUP\\nAutomorphism quotient speedup\\nT_quotient/T_plain ~= 1/sqrt(a)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-DECOMPOSITION-PROBABILITY" [label="HEUR-DECOMPOSITION-PROBABILITY\\nRandom decomposition-yield heuristic\\nmu=B^m/r; Pr[decomposition]~=1-exp(-mu)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-ZERO-DIMENSIONAL-PDP" [label="HEUR-ZERO-DIMENSIONAL-PDP\\nZero-dimensional PDP hypothesis", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-FIRST-FALL-DEGREE" [label="HEUR-FIRST-FALL-DEGREE\\nFirst-fall/regularity degree heuristic", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RELATION-RANK" [label="HEUR-RELATION-RANK\\nRelation independence/rank heuristic\\nR >= B + margin", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-SYMMETRY-PDP-SPEEDUP" [label="HEUR-SYMMETRY-PDP-SPEEDUP\\nInvariant-coordinate PDP speedup", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-WAGNER-FOUR-SUM" [label="HEUR-WAGNER-FOUR-SUM\\nWagner four-sum cube-root heuristic\\nT,S = soft-O(2^(n/3))", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "MEAS-RP-IC-BOUNDARY-ROUND1" [label="MEAS-RP-IC-BOUNDARY-ROUND1\\nIC boundary ledger: no variant below rho at r >= 2^20; fitted exponents >= 0.54", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-BOUNDARY-TARGETS-PRIME" [label="MEAS-RP-BOUNDARY-TARGETS-PRIME\\nPrime-field IC slower than rho at all measured sizes (boundary targets)", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-KOBLITZ-N61-ONLINE" [label="MEAS-RP-KOBLITZ-N61-ONLINE\\nKoblitz n=61 compact-orbit IC: online 37.13x vs strong rho on the same point, cold about 90x slower", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-COMPACT-ORBIT-PREPROCESSING" [label="MEAS-RP-COMPACT-ORBIT-PREPROCESSING\\nCompact-orbit Koblitz IC sits on or above S*T^2 >~ r/|Aut| at every rung", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-JV-WEAK-CLASS" [label="MEAS-RP-JV-WEAK-CLASS\\nJoux-Vitse cover-and-decomposition on the weak F_{p^6} class: S/rho ~ n^-0.32, sieve crossover near 2^49-2^50", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-JV-E2E-NONWEAK" [label="MEAS-RP-JV-E2E-NONWEAK\\nJV route end to end from non-weak curves: 32/32 verified, S/rho 0.005-0.019 at l = 2^61.4", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-FALL-DEGREE-TOY" [label="MEAS-RP-FALL-DEGREE-TOY\\nSemaev closure degree bounded at toy size: d_F <= 4 through m=6, N <= 60; one below the semi-regular control", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-FALL-DEGREE-M3-DIAGONAL" [label="MEAS-RP-FALL-DEGREE-M3-DIAGONAL\\nm=3 diagonal: d_F censored >= 5 exactly at ell >= 7; (3,24,7) reads 'mixed'", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-SECANT-F4" [label="MEAS-RP-SECANT-F4\\nSplit-graph secant bases lower the observed stock-F4 degree but raise branch-summed rows vs dense", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-TWIST-CENSUS" [label="MEAS-RP-TWIST-CENSUS\\nQuadratic-twist S3 censuses: zero strict joint useful-rank/degree gains", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-PLANNER-RETEST" [label="MEAS-RP-PLANNER-RETEST\\nPlanner re-test: Koblitz descent dearer at all six sizes; residual collector wins only as a generic collision search", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-CALIBRATION-DRIFT" [label="MEAS-RP-CALIBRATION-DRIFT\\nPer-run GAE calibration drifted ratios up to 3.7x before pinning", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-DREG-PROXY-MISS" [label="MEAS-RP-DREG-PROXY-MISS\\nTwo-summand Weil systems: homogeneous D_reg = l+1 while D_solve = 2-4", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "MEAS-RP-GAUDRY-CUBIC" [label="MEAS-RP-GAUDRY-CUBIC\\nGaudry cubic-extension IC whole method never beats rho at measured sizes", fillcolor="#ece7fb", color="#6047a8", style="rounded,filled"];
    "HEUR-RP-LIFT-SUBGROUP-HALF" [label="HEUR-RP-LIFT-SUBGROUP-HALF\\nA random abscissa lifts with probability ~1/2 and lands in <G> with probability ~1/2 (A-FB2)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RP-SEMIREGULAR-DREG-PROXY" [label="HEUR-RP-SEMIREGULAR-DREG-PROXY\\nSemi-regular D_reg predicts Groebner cost of descended Semaev systems (A-PDP5)\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "HEUR-RP-WALK-TARGET-GUARD" [label="HEUR-RP-WALK-TARGET-GUARD\\nWalk targets behave as uniform, with a mandatory repeated-target guard (A-RC1)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RP-LARGE-PRIME-GRAPH" [label="HEUR-RP-LARGE-PRIME-GRAPH\\nLarge-prime leftovers meet with birthday probability and the graph connects (A-RC2)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
    "HEUR-RP-DESCENT-TERMINATION" [label="HEUR-RP-DESCENT-TERMINATION\\nRecursive target descent terminates (A-TD1)", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
  }
