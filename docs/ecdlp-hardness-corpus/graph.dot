    "HEUR-PF-PKM-RANK-DELTA" [label="HEUR-PF-PKM-RANK-DELTA\\nPKM: Delta = 10 surplus relations suffice", fillcolor="#f4e8fb", color="#7b3fa1", style="rounded,filled,dashed"];
