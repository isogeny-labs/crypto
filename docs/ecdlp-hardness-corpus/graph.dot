digraph ecdlp_claims {
  graph [rankdir=LR, newrank=true, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.65, fontname="DejaVu Sans", fontsize=16, labelloc=t, label="ECDLP claim graph — theorem scope, attacks, and open obligations"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07"] ;
  edge [fontname="DejaVu Sans", fontsize=8, color="#66788a", fontcolor="#445566", arrowsize=0.7];
  subgraph cluster_foundations {
    label="Problems and assumption lattice"; color="#cad5df"; style="rounded";
    "PROB-ECDLP" [label="PROB-ECDLP\\nElliptic-curve discrete logarithm problem", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "ASM-CLASSICAL-ECDLP" [label="ASM-CLASSICAL-ECDLP\\nNamed-curve classical ECDLP hardness assumption", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "PROB-CDH" [label="PROB-CDH\\nComputational Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "PROB-DDH" [label="PROB-DDH\\nDecisional Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-CDH-DLP" [label="RED-CDH-DLP\\nCDH reduces to ECDLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DDH-CDH" [label="RED-DDH-CDH\\nDDH reduces to CDH", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "THEOREM-JMV-ISOGENY-REDUCTION" [label="THEOREM-JMV-ISOGENY-REDUCTION\\nJMV random reduction within an isogeny stratum", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "CONCLUSION-SPECIFIC-CURVE" [label="CONCLUSION-SPECIFIC-CURVE\\nSpecific-curve hardness remains assumption-based", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-SUBGROUP-COFACTOR" [label="DEF-SUBGROUP-COFACTOR\\nPrime subgroup and cofactor\\n#E(F_q)=h r", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-EMBEDDING-DEGREE" [label="DEF-EMBEDDING-DEGREE\\nEmbedding degree\\nk=ord_r(q)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-CONCRETE-SECURITY" [label="DEF-CONCRETE-SECURITY\\nConcrete security experiment", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-INDEX-CALCULUS-PIPELINE" [label="DEF-INDEX-CALCULUS-PIPELINE\\nECDLP index-calculus pipeline", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FACTOR-BASE" [label="DEF-FACTOR-BASE\\nAlgebraic factor base\\nB=|F|", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-XEDNI-CALCULUS" [label="DEF-XEDNI-CALCULUS\\nXedni calculus lifting attack", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GAP-DH" [label="DEF-GAP-DH\\nGap Diffie-Hellman setting", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-SCHNORR-ROM" [label="RED-SCHNORR-ROM\\nSchnorr-to-DL random-oracle reduction", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "DEF-MULTIDIMENSIONAL-DLP" [label="DEF-MULTIDIMENSIONAL-DLP\\nRepresentation and product DLP", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-LOW-HAMMING-DLP" [label="DEF-LOW-HAMMING-DLP\\nLow-Hamming-weight DLP", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-SUBEXPONENTIAL-L" [label="DEF-SUBEXPONENTIAL-L\\nSubexponential L notation\\nL_N(alpha,c)=exp((c+o(1))(log N)^alpha(log log N)^(1-alpha))", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FIXED-CDH" [label="DEF-FIXED-CDH\\nFixed-base Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "THEOREM-CDH-SELF-CORRECTION" [label="THEOREM-CDH-SELF-CORRECTION\\nCDH success amplification", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DEN-BOER-FIXED-CDH" [label="RED-DEN-BOER-FIXED-CDH\\nden Boer DLP-to-Fixed-CDH reduction\\ngroup cost = O(sqrt(l) log(r)^2/log(l)); oracle queries = O(log(r)log log(r))", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-MAURER-AUXILIARY-CURVE" [label="RED-MAURER-AUXILIARY-CURVE\\nMaurer auxiliary-curve reduction\\noracle queries = O(log(r)^2 log log(r))", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DLP-LEAST-SIGNIFICANT-BIT" [label="RED-DLP-LEAST-SIGNIFICANT-BIT\\nLeast-significant DLP bit is as hard as DLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-ISOGENY-DLP-TRANSPORT" [label="RED-ISOGENY-DLP-TRANSPORT\\nEfficient isogeny transports ECDLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "DEF-FIRST-FALL-DEGREE" [label="DEF-FIRST-FALL-DEGREE\\nFirst fall degree d_F (Nagao Def. 5)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FAKE-FIRST-FALL-DEGREE" [label="DEF-FAKE-FIRST-FALL-DEGREE\\nFake first fall degree d'_F (Nagao Def. 6)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-LAST-FALL-DEGREE" [label="DEF-LAST-FALL-DEGREE\\nLast fall degree", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-SOLVING-DEGREE" [label="DEF-SOLVING-DEGREE\\nSolving degree sd_sigma", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-RP-EC1-INSTANCE-ID" [label="DEF-RP-EC1-INSTANCE-ID\\nEC1 curve identity binds the exact representation (A-SETUP1)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-BK-GG-UNROLLED-SYSTEM" [label="DEF-BK-GG-UNROLLED-SYSTEM\\nUnrolled-resultant (splitting) decomposition system", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "CLAIM-BK-X962-NO-AMORTIZATION" [label="CLAIM-BK-X962-NO-AMORTIZATION\\nANSI X9.62 (1997): effort must be repeated per key\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "RED-BK-AGCODE-MINDIST" [label="RED-BK-AGCODE-MINDIST\\nAG-code minimum distance vs ECDLP (survey says 'equivalent')", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "ASM-BK-GG-CDH-ONLY-VIA-DLP" [label="ASM-BK-GG-CDH-ONLY-VIA-DLP\\nCDH: only known method is solving ECDLP", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "STD-BK-SEC1-VALIDATION" [label="STD-BK-SEC1-VALIDATION\\nSEC 1 v2.0 domain-parameter validation (B < 100, n != p)", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "STD-BK-SEC1-HARDNESS-NARRATIVE" [label="STD-BK-SEC1-HARDNESS-NARRATIVE\\nSEC 1 v2.0 ECDLP hardness narrative", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "CLAIM-BK-SEC1-COFACTOR-CDH" [label="CLAIM-BK-SEC1-COFACTOR-CDH\\nSEC 1: a slightly larger cofactor makes ECDH roughly as hard as DLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "STD-BK-BRAINPOOL-REQS" [label="STD-BK-BRAINPOOL-REQS\\nBrainpool (RFC 5639) security requirements", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "STD-BK-NIST-DISC-NO-RATIONALE" [label="STD-BK-NIST-DISC-NO-RATIONALE\\nNIST SP 800-186: no technical rationale for a |Disc| bound", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "STD-BK-NIST-HALF-BITLENGTH" [label="STD-BK-NIST-HALF-BITLENGTH\\nNIST: security strength ~ half the bit length of n", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "STD-BK-SAFECURVES-RHO" [label="STD-BK-SAFECURVES-RHO\\nSafeCurves rho rule: l >= 2^200 (0.886 sqrt l > 2^100)", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "STD-BK-SAFECURVES-TRANSFER" [label="STD-BK-SAFECURVES-TRANSFER\\nSafeCurves transfer rule: embedding degree >= (l-1)/100", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "CLAIM-BK-SAFECURVES-SEC1-20" [label="CLAIM-BK-SAFECURVES-SEC1-20\\nSafeCurves: 'SEC1 requires the embedding degree to be at least 20'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "STD-BK-SAFECURVES-DISC" [label="STD-BK-SAFECURVES-DISC\\nSafeCurves discriminant rule: |D| > 2^100", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "CLAIM-BK-SAFECURVES-BRAINPOOL-1E6" [label="CLAIM-BK-SAFECURVES-BRAINPOOL-1E6\\nSafeCurves: Brainpool class number must exceed 1000000\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "STD-BK-SAFECURVES-TWIST" [label="STD-BK-SAFECURVES-TWIST\\nSafeCurves twist-security rule (>= 2^100 combined attack)", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-XT-LIFTING-PROBLEM" [label="DEF-XT-LIFTING-PROBLEM\\nECDLP lifting problem (Silverman)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-XT-LIFTED-INDEX-CALCULUS" [label="DEF-XT-LIFTED-INDEX-CALCULUS\\nIndex calculus on a lift E~(Q)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-XT-CHENG-HUANG-PARTIAL-LIFT" [label="RED-XT-CHENG-HUANG-PARTIAL-LIFT\\nCheng-Huang: ECDLP reduces to three partial lifting problems", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "DEF-XT-DISTORTION-MAP" [label="DEF-XT-DISTORTION-MAP\\nDistortion map", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-XT-GPS-PAIRING-TYPES" [label="DEF-XT-GPS-PAIRING-TYPES\\nGalbraith-Paterson-Smart pairing types", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-XT-SPARSE-MEDIUM-SUBFIELD-REP" [label="DEF-XT-SPARSE-MEDIUM-SUBFIELD-REP\\nSparse medium subfield representation", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GG-MAURER-MODEL" [label="DEF-GG-MAURER-MODEL\\nMaurer register-based generic model", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GG-GENERIC-ROM" [label="DEF-GG-GENERIC-ROM\\nGeneric group plus random oracle model (Schnorr-Jakobsson)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GG-AGM" [label="DEF-GG-AGM\\nAlgebraic group model (FKL 2018)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-GG-FKL-AGM-CDH-DL" [label="RED-GG-FKL-AGM-CDH-DL\\nFKL: CDH, SDH, LRSW equivalent to DL in the AGM", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "ASM-GG-RANDOM-PARTITION" [label="ASM-GG-RANDOM-PARTITION\\nRigorous rho analyses assume a uniformly random partition", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-PF-SEMAEV-SMALL-X-BASE" [label="DEF-PF-SEMAEV-SMALL-X-BASE\\nSemaev's prime-field small-x factor base", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-PF-GENERALIZED-ROOT-FINDING" [label="DEF-PF-GENERALIZED-ROOT-FINDING\\nGeneralized root-finding problem (PKM Problem 1)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-PF-RATIONAL-MAP-FACTOR-BASE" [label="DEF-PF-RATIONAL-MAP-FACTOR-BASE\\nPKM rational-map factor base", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "ASM-PF-PKM-UNIT-COST" [label="ASM-PF-PKM-UNIT-COST\\nPKM unit-cost accounting model", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-PF-PKM-SMOOTH-SUBGROUP-BASE" [label="DEF-PF-PKM-SMOOTH-SUBGROUP-BASE\\nPKM p-1 smooth-subgroup factor base", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-PF-PKM-ISOGENY-BASE" [label="DEF-PF-PKM-ISOGENY-BASE\\nPKM isogeny-kernel factor base", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "ASM-PF-KY-CURVE-CONSTRUCTION" [label="ASM-PF-KY-CURVE-CONSTRUCTION\\nKosters-Yeo Assumption 3.3 (curves with a large-order point)", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-PF-QUASI-SUBFIELD-POLY" [label="DEF-PF-QUASI-SUBFIELD-POLY\\nQuasi-subfield polynomial and its quality beta", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GB-DEGREE-OF-REGULARITY" [label="DEF-GB-DEGREE-OF-REGULARITY\\nDegree of regularity d_reg (Bardet-Faugere-Salvy)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GB-DS-DEGREE-OF-REGULARITY" [label="DEF-GB-DS-DEGREE-OF-REGULARITY\\nDubois-Gama / Ding-Schmidt degree of regularity (= first fall degree)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GB-SEMI-REGULAR" [label="DEF-GB-SEMI-REGULAR\\nSemi-regular and cryptographic semi-regular sequences\\nHS(z) = [ prod_{i=1}^m (1 - z^{d_i}) / (1 - z)^n ]_+", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GB-SEMI-REGULAR-F2" [label="DEF-GB-SEMI-REGULAR-F2\\nSemi-regular sequences over F_2 (Boolean, field equations)\\nT_{d,n}(z) = [ (1+z)^n / prod_i (1+z^{d_i}) ]_+", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GB-CM-REGULARITY" [label="DEF-GB-CM-REGULARITY\\nCastelnuovo-Mumford regularity and generic coordinates", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "CONJ-GB-BFS-SEMIREG-PROPORTION-F2" [label="CONJ-GB-BFS-SEMIREG-PROPORTION-F2\\nBFS Conjecture 2: almost all F_2 sequences are semi-regular\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "DEF-WD-COVER-ATTACK" [label="DEF-WD-COVER-ATTACK\\nCover (Weil-descent) attack via conorm-norm", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-WD-GHS-MAGIC-NUMBER" [label="DEF-WD-GHS-MAGIC-NUMBER\\nGHS magic number m(b) and type of b\\nm(b) = dim_F2 Span{(1, sqrt(sigma^i b))}", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-SP-SUMMATION-POLYNOMIAL" [label="DEF-SP-SUMMATION-POLYNOMIAL\\nSemaev summation polynomials f_m (recursive definition)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-SP-DIEM-CONDITION-27" [label="DEF-SP-DIEM-CONDITION-27\\nDiem's Condition 2.7 on the covering phi", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "CLAIM-PA-SCHNORR-ANY-TWO" [label="CLAIM-PA-SCHNORR-ANY-TWO\\n'Any two accepting Schnorr-like transcripts reveal the witness'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "ASM-PA-FS-CHALLENGE-INDEPENDENCE" [label="ASM-PA-FS-CHALLENGE-INDEPENDENCE\\nFiat-Shamir-derived batching challenges act as independent uniform challenges", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "ASM-XEDNI-HAZARD-RECURRENCE" [label="ASM-XEDNI-HAZARD-RECURRENCE\\nAdaptive xedni trials satisfy a history-uniform conditional-hazard recurrence", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "ASM-XEDNI-TRIAL-MARGINAL" [label="ASM-XEDNI-TRIAL-MARGINAL\\nEach adaptive xedni trial, as run, succeeds with marginal probability O(1/p)", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "CLAIM-PA-SS-IMPLIES-FS" [label="CLAIM-PA-SS-IMPLIES-FS\\n'Special soundness implies Fiat-Shamir security'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CLAIM-PA-AMBIENT-BLINDING" [label="CLAIM-PA-AMBIENT-BLINDING\\n'Blinding by any group element preserves a subgroup DLP instance'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
  }
  subgraph cluster_bounds {
    label="Rigorous model bounds and structural theorems"; color="#cad5df"; style="rounded";
    "THEOREM-RANDOM-SELF-REDUCTION" [label="THEOREM-RANDOM-SELF-REDUCTION\\nPrime-order DLP random self-reducibility", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-SHOUP-DLP" [label="LB-SHOUP-DLP\\nShoup generic DLP lower bound\\nsuccess = O(m^2/p); constant success => m = Omega(sqrt(p))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-SHOUP-CDH" [label="LB-SHOUP-CDH\\nShoup generic CDH lower bound", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-CGK-ADVICE" [label="LB-CGK-ADVICE\\nGeneric preprocessing advice tradeoff\\nS T^2 = soft-Omega(epsilon N)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-CGK-PREPROCESS-TIME" [label="LB-CGK-PREPROCESS-TIME\\nGeneric preprocessing-time tradeoff\\nP T + T^2 = Omega(epsilon N)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SEMAEV-SUMMATION" [label="THEOREM-SEMAEV-SUMMATION\\nSemaev summation-polynomial criterion", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "BRIDGE-GENERIC-TABLE" [label="BRIDGE-GENERIC-TABLE\\nConditional generic simulation of table decomposition", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-YIELD-CONSERVATION" [label="THEOREM-YIELD-CONSERVATION\\nMean decomposition-yield conservation", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-ISOGENY-GENERIC" [label="LB-ISOGENY-GENERIC\\nIsogeny-augmented generic lower bound", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-FROB-SUBSPACES-131" [label="THEOREM-FROB-SUBSPACES-131\\nFrobenius-stable subspaces at n=131", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-GHS-GENUS-131" [label="THEOREM-GHS-GENUS-131\\nGHS genus classification at n=131", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-HASSE-BOUND" [label="THEOREM-HASSE-BOUND\\nHasse bound\\n#E(F_q)=q+1-t, |t|<=2 sqrt(q)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-QUADRATIC-TWIST-ORDER" [label="THEOREM-QUADRATIC-TWIST-ORDER\\nQuadratic-twist order relation\\n#E(F_q)+#E'(F_q)=2(q+1)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SUPERSINGULAR-SMALL-K" [label="THEOREM-SUPERSINGULAR-SMALL-K\\nSupersingular embedding-degree ceiling\\nk=2 over F_p (p>=5); k<=6 in general", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "STANDARD-CURVE-EXCLUSIONS" [label="STANDARD-CURVE-EXCLUSIONS\\nStandard curve exclusion checklist", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "OBSTRUCTION-NEGATION-CYCLES" [label="OBSTRUCTION-NEGATION-CYCLES\\nNegation-map fruitless-cycle obstruction", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SEMAEV-DEGREE" [label="THEOREM-SEMAEV-DEGREE\\nSummation-polynomial degree growth\\ndeg_Xi S_m=2^(m-2)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-GROEBNER-COST-DEPENDENCE" [label="FACT-GROEBNER-COST-DEPENDENCE\\nGroebner cost depends on solving geometry\\nFGLM=O(n D^3); F4/F5 matrix cost depends on d_reg/d_solve", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-PRIME-FIELD-NO-EXTENSION-GAIN" [label="FACT-PRIME-FIELD-NO-EXTENSION-GAIN\\nPrime-field boundary for extension index calculus", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "OBSTRUCTION-XEDNI-HEIGHT" [label="OBSTRUCTION-XEDNI-HEIGHT\\nCanonical-height obstruction to xedni\\none-shot Pr[success] <= C0/p (conditional); history-uniform hazard <= C0/p => E[T]=Omega(p)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-XEDNI-FINITE-CORE" [label="THEOREM-XEDNI-FINITE-CORE\\nKernel-checked finite xedni core\\nPr[fixed useful relation]=(q-1)/q^2; uniform hazard O(1/p) => E[T]=Omega(p)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-XEDNI-FF-DENSITY" [label="THEOREM-XEDNI-FF-DENSITY\\nExact codimension-three function-field lift density\\nP_lift(p)=(1-2/p+p^-3)/(2p^3)=Theta(p^-3)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-S3-ROOTS-ARE-GROUP-LAW" [label="FACT-S3-ROOTS-ARE-GROUP-LAW\\nS3 rootfinding collapses to group subtraction\\nS3(x_R,x_F,X)=(x_R-x_F)^2 (X-x(R-F))(X-x(R+F))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-GENERIC-REPRESENTATION" [label="LB-GENERIC-REPRESENTATION\\nGeneric representation lower bound\\nT = Omega(s^(l/2)/log(s)^(c/2))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-CDH-RANDOM-SELF-REDUCTION" [label="THEOREM-CDH-RANDOM-SELF-REDUCTION\\nCDH random self-reducibility", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-PAIRING-BILINEAR-NONDEGENERATE" [label="THEOREM-PAIRING-BILINEAR-NONDEGENERATE\\nPairing bilinearity and nondegeneracy", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-PAIRING-FRIENDLY-TWO-DLPS" [label="FACT-PAIRING-FRIENDLY-TWO-DLPS\\nPairing-friendly security is two-sided", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-NAGAO-LEMMA4" [label="CLAIM-NAGAO-LEMMA4\\nNagao 2015/984 Lemma 4: d_F <= d'_F\\nd_F <= d'_F\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-NAGAO-LEMMA4-F2" [label="CEX-NAGAO-LEMMA4-F2\\nWitnesses A, B: d'_F = 2 < d_F = 3 over F_2", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-CG-SOLVING-DEGREE" [label="THM-CG-SOLVING-DEGREE\\nCaminata-Gorla: sd = max(last fall, max GB degree)\\nsd_sigma(F) = max{d_lastfall(F), maxGBdeg_sigma(F)}", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
