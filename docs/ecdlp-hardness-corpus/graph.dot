digraph ecdlp_claims {
  graph [rankdir=LR, newrank=true, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.65, fontname="DejaVu Sans", fontsize=16, labelloc=t, label="ECDLP claim graph — theorem scope, attacks, and open obligations"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=9, margin="0.10,0.07"] ;
  edge [fontname="DejaVu Sans", fontsize=8, color="#66788a", fontcolor="#445566", arrowsize=0.7];
  subgraph cluster_foundations {
    label="Problems and assumption lattice"; color="#cad5df"; style="rounded";
    "PROB-ECDLP" [label="PROB-ECDLP\\nElliptic-curve discrete logarithm problem", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "ASM-CLASSICAL-ECDLP" [label="ASM-CLASSICAL-ECDLP\\nNamed-curve classical ECDLP hardness assumption", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "PROB-CDH" [label="PROB-CDH\\nComputational Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "PROB-DDH" [label="PROB-DDH\\nDecisional Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-CDH-DLP" [label="RED-CDH-DLP\\nCDH reduces to ECDLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DDH-CDH" [label="RED-DDH-CDH\\nDDH reduces to CDH", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "THEOREM-JMV-ISOGENY-REDUCTION" [label="THEOREM-JMV-ISOGENY-REDUCTION\\nJMV random reduction within an isogeny stratum", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "CONCLUSION-SPECIFIC-CURVE" [label="CONCLUSION-SPECIFIC-CURVE\\nSpecific-curve hardness remains assumption-based", fillcolor="#fff4cc", color="#8a6200", style="rounded,filled"];
    "DEF-SUBGROUP-COFACTOR" [label="DEF-SUBGROUP-COFACTOR\\nPrime subgroup and cofactor\\n#E(F_q)=h r", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-EMBEDDING-DEGREE" [label="DEF-EMBEDDING-DEGREE\\nEmbedding degree\\nk=ord_r(q)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-CONCRETE-SECURITY" [label="DEF-CONCRETE-SECURITY\\nConcrete security experiment", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-INDEX-CALCULUS-PIPELINE" [label="DEF-INDEX-CALCULUS-PIPELINE\\nECDLP index-calculus pipeline", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FACTOR-BASE" [label="DEF-FACTOR-BASE\\nAlgebraic factor base\\nB=|F|", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-XEDNI-CALCULUS" [label="DEF-XEDNI-CALCULUS\\nXedni calculus lifting attack", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-GAP-DH" [label="DEF-GAP-DH\\nGap Diffie-Hellman setting", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "RED-SCHNORR-ROM" [label="RED-SCHNORR-ROM\\nSchnorr-to-DL random-oracle reduction", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "DEF-MULTIDIMENSIONAL-DLP" [label="DEF-MULTIDIMENSIONAL-DLP\\nRepresentation and product DLP", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-LOW-HAMMING-DLP" [label="DEF-LOW-HAMMING-DLP\\nLow-Hamming-weight DLP", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-SUBEXPONENTIAL-L" [label="DEF-SUBEXPONENTIAL-L\\nSubexponential L notation\\nL_N(alpha,c)=exp((c+o(1))(log N)^alpha(log log N)^(1-alpha))", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FIXED-CDH" [label="DEF-FIXED-CDH\\nFixed-base Diffie-Hellman", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "THEOREM-CDH-SELF-CORRECTION" [label="THEOREM-CDH-SELF-CORRECTION\\nCDH success amplification", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DEN-BOER-FIXED-CDH" [label="RED-DEN-BOER-FIXED-CDH\\nden Boer DLP-to-Fixed-CDH reduction\\ngroup cost = O(sqrt(l) log(r)^2/log(l)); oracle queries = O(log(r)log log(r))", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-MAURER-AUXILIARY-CURVE" [label="RED-MAURER-AUXILIARY-CURVE\\nMaurer auxiliary-curve reduction\\noracle queries = O(log(r)^2 log log(r))", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-DLP-LEAST-SIGNIFICANT-BIT" [label="RED-DLP-LEAST-SIGNIFICANT-BIT\\nLeast-significant DLP bit is as hard as DLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "RED-ISOGENY-DLP-TRANSPORT" [label="RED-ISOGENY-DLP-TRANSPORT\\nEfficient isogeny transports ECDLP", fillcolor="#e6f1ff", color="#2468a2", style="rounded,filled"];
    "DEF-FIRST-FALL-DEGREE" [label="DEF-FIRST-FALL-DEGREE\\nFirst fall degree d_F (Nagao Def. 5)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-FAKE-FIRST-FALL-DEGREE" [label="DEF-FAKE-FIRST-FALL-DEGREE\\nFake first fall degree d'_F (Nagao Def. 6)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-LAST-FALL-DEGREE" [label="DEF-LAST-FALL-DEGREE\\nLast fall degree", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-SOLVING-DEGREE" [label="DEF-SOLVING-DEGREE\\nSolving degree sd_sigma", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
    "DEF-RP-EC1-INSTANCE-ID" [label="DEF-RP-EC1-INSTANCE-ID\\nEC1 curve identity binds the exact representation (A-SETUP1)", fillcolor="#e8eef5", color="#334e68", style="rounded,filled"];
  }
  subgraph cluster_bounds {
    label="Rigorous model bounds and structural theorems"; color="#cad5df"; style="rounded";
    "THEOREM-RANDOM-SELF-REDUCTION" [label="THEOREM-RANDOM-SELF-REDUCTION\\nPrime-order DLP random self-reducibility", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-SHOUP-DLP" [label="LB-SHOUP-DLP\\nShoup generic DLP lower bound\\nsuccess = O(m^2/p); constant success => m = Omega(sqrt(p))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-SHOUP-CDH" [label="LB-SHOUP-CDH\\nShoup generic CDH lower bound", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-CGK-ADVICE" [label="LB-CGK-ADVICE\\nGeneric preprocessing advice tradeoff\\nS T^2 = soft-Omega(epsilon N)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-CGK-PREPROCESS-TIME" [label="LB-CGK-PREPROCESS-TIME\\nGeneric preprocessing-time tradeoff\\nP T + T^2 = Omega(epsilon N)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SEMAEV-SUMMATION" [label="THEOREM-SEMAEV-SUMMATION\\nSemaev summation-polynomial criterion", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "BRIDGE-GENERIC-TABLE" [label="BRIDGE-GENERIC-TABLE\\nConditional generic simulation of table decomposition", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-YIELD-CONSERVATION" [label="THEOREM-YIELD-CONSERVATION\\nMean decomposition-yield conservation", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-ISOGENY-GENERIC" [label="LB-ISOGENY-GENERIC\\nIsogeny-augmented generic lower bound", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-FROB-SUBSPACES-131" [label="THEOREM-FROB-SUBSPACES-131\\nFrobenius-stable subspaces at n=131", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-GHS-GENUS-131" [label="THEOREM-GHS-GENUS-131\\nGHS genus classification at n=131", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-HASSE-BOUND" [label="THEOREM-HASSE-BOUND\\nHasse bound\\n#E(F_q)=q+1-t, |t|<=2 sqrt(q)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-QUADRATIC-TWIST-ORDER" [label="THEOREM-QUADRATIC-TWIST-ORDER\\nQuadratic-twist order relation\\n#E(F_q)+#E'(F_q)=2(q+1)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SUPERSINGULAR-SMALL-K" [label="THEOREM-SUPERSINGULAR-SMALL-K\\nSupersingular embedding-degree ceiling\\nk=2 over F_p (p>=5); k<=6 in general", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "STANDARD-CURVE-EXCLUSIONS" [label="STANDARD-CURVE-EXCLUSIONS\\nStandard curve exclusion checklist", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "OBSTRUCTION-NEGATION-CYCLES" [label="OBSTRUCTION-NEGATION-CYCLES\\nNegation-map fruitless-cycle obstruction", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-SEMAEV-DEGREE" [label="THEOREM-SEMAEV-DEGREE\\nSummation-polynomial degree growth\\ndeg_Xi S_m=2^(m-2)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-GROEBNER-COST-DEPENDENCE" [label="FACT-GROEBNER-COST-DEPENDENCE\\nGroebner cost depends on solving geometry\\nFGLM=O(n D^3); F4/F5 matrix cost depends on d_reg/d_solve", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-PRIME-FIELD-NO-EXTENSION-GAIN" [label="FACT-PRIME-FIELD-NO-EXTENSION-GAIN\\nPrime-field boundary for extension index calculus", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "OBSTRUCTION-XEDNI-HEIGHT" [label="OBSTRUCTION-XEDNI-HEIGHT\\nCanonical-height obstruction to xedni\\none-shot Pr[success] <= C0/p (conditional); history-uniform hazard <= C0/p => E[T]=Omega(p)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-XEDNI-FINITE-CORE" [label="THEOREM-XEDNI-FINITE-CORE\\nKernel-checked finite xedni core\\nPr[fixed useful relation]=(q-1)/q^2; uniform hazard O(1/p) => E[T]=Omega(p)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-XEDNI-FF-DENSITY" [label="THEOREM-XEDNI-FF-DENSITY\\nExact codimension-three function-field lift density\\nP_lift(p)=(1-2/p+p^-3)/(2p^3)=Theta(p^-3)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-S3-ROOTS-ARE-GROUP-LAW" [label="FACT-S3-ROOTS-ARE-GROUP-LAW\\nS3 rootfinding collapses to group subtraction\\nS3(x_R,x_F,X)=(x_R-x_F)^2 (X-x(R-F))(X-x(R+F))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "LB-GENERIC-REPRESENTATION" [label="LB-GENERIC-REPRESENTATION\\nGeneric representation lower bound\\nT = Omega(s^(l/2)/log(s)^(c/2))", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-CDH-RANDOM-SELF-REDUCTION" [label="THEOREM-CDH-RANDOM-SELF-REDUCTION\\nCDH random self-reducibility", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THEOREM-PAIRING-BILINEAR-NONDEGENERATE" [label="THEOREM-PAIRING-BILINEAR-NONDEGENERATE\\nPairing bilinearity and nondegeneracy", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "FACT-PAIRING-FRIENDLY-TWO-DLPS" [label="FACT-PAIRING-FRIENDLY-TWO-DLPS\\nPairing-friendly security is two-sided", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-NAGAO-LEMMA4" [label="CLAIM-NAGAO-LEMMA4\\nNagao 2015/984 Lemma 4: d_F <= d'_F\\nd_F <= d'_F\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-NAGAO-LEMMA4-F2" [label="CEX-NAGAO-LEMMA4-F2\\nWitnesses A, B: d'_F = 2 < d_F = 3 over F_2", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-CG-SOLVING-DEGREE" [label="THM-CG-SOLVING-DEGREE\\nCaminata-Gorla: sd = max(last fall, max GB degree)\\nsd_sigma(F) = max{d_lastfall(F), maxGBdeg_sigma(F)}", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-KY-S3-FIRST-FALL-TWO" [label="THM-KY-S3-FIRST-FALL-TWO\\nKosters-Yeo: descended S_3 has first fall degree 2", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-HKYY-ZERO-DIM-LAST-FALL" [label="THM-HKYY-ZERO-DIM-LAST-FALL\\nHKYY: n-independent last fall degree (zero-dim only)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-S3-ROOTS-FACTOR" [label="THM-RP-S3-ROOTS-FACTOR\\nS3(xR,xF,X) = (xR-xF)^2 (X-x(R+F)) (X-x(R-F)) (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-YIELD-SUM-COUNT" [label="THM-RP-YIELD-SUM-COUNT\\nTotal yield = domain size; K2 neutrality; K5 restriction (Lean, list form)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-ICNEG-YIELD-CONSERVATION" [label="THM-RP-ICNEG-YIELD-CONSERVATION\\nYield conservation over Finset fibres with coverage bound (IcNegative, unchecked)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-AFFINE-CORE" [label="THM-RP-AFFINE-CORE\\nCounting core of the isogeny-augmented generic group bound (IcNegative, unchecked)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-SEMAEV-MONODROMY" [label="THM-RP-SEMAEV-MONODROMY\\nMonodromy of the Semaev cover is (Z/2)^(m-2)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-GUARDED-EXACT-PAIR" [label="THM-RP-GUARDED-EXACT-PAIR\\nGuarded three-abscissa prime-field system: first fall 4, last fall 5 (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-GUARDED-GROWING-B" [label="THM-RP-GUARDED-GROWING-B\\nExplicit-membership presentation: first fall B+1, last fall in [max(5,B+1), 3B-4]", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-BOOLEAN-CHAIN-UPPER" [label="THM-RP-BOOLEAN-CHAIN-UPPER\\nFully Boolean two-S3 chain: d_F <= 3*ell+1, independent of n", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-SECANT-DEGREE-REDUCTION" [label="THM-RP-SECANT-DEGREE-REDUCTION\\nSplit-graph secant presentation: top-ideal first vanishing d+1 vs dense 2d+1 (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-RECODED-SELECTOR-DEGREE" [label="THM-RP-RECODED-SELECTOR-DEGREE\\nSelector recodings of one F17 base: canonical degree 7 -> 6 (XOR) -> 5 (one-hot)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-SCALAR-TRANSPORT" [label="THM-RP-SCALAR-TRANSPORT\\nScalar transport and answer reflection under an injective homomorphism (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-RP-JKSST-LANG-QUADRATICITY" [label="CEX-RP-JKSST-LANG-QUADRATICITY\\nQuadraticity of height alone gives no uniform Lang constant (Lean countermodel)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-RP-JKSST-MODEL-DISCRIMINANT" [label="CEX-RP-JKSST-MODEL-DISCRIMINANT\\nNo all-multiples height bound by a fixed model discriminant; model log-discriminant unbounded under rescaling", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-RP-JKSST-ASYMPTOTIC-COUNTING" [label="CEX-RP-JKSST-ASYMPTOTIC-COUNTING\\nAsymptotic remainders and coarse lattice data do not give finite counting bounds", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-RP-JKSST-PROBABILITY" [label="CEX-RP-JKSST-PROBABILITY\\nFinite-field relation probability: composite modulus, fixed probability not O(1/p), usefulness not automatic", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-TWIST-MIXED-RELATION" [label="THM-RP-TWIST-MIXED-RELATION\\nA rational relation with a Frobenius-negated (twist) term forces that term to vanish on odd order (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-KEYED-INVARIANCE" [label="THM-RP-KEYED-INVARIANCE\\nKeyed-generic transcript invariance under injective operation-preserving maps (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-BAND-AFFINE" [label="THM-RP-BAND-AFFINE\\nPriced cost is affine in the native-work weight; band reversals force an interior crossing (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-FB-BREAK-EVEN" [label="THM-RP-FB-BREAK-EVEN\\nBreak-even of the per-relation cost model at m=4, n=131 (Lean instances)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-KOBLITZ-CYCLIC-WINDOW" [label="THM-RP-KOBLITZ-CYCLIC-WINDOW\\nCyclic-cover window for the n=131 trace-zero factor: genus >= 394 (conditional), modular carrier genus 378,708,949", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-RP-COMMON-KERNEL-WITNESSES" [label="CEX-RP-COMMON-KERNEL-WITNESSES\\nBoolean kernel not multiplicative under gauge; exterior/code witness has a nonzero passive-axis coefficient (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-FF-HANDBOOK" [label="THM-RP-FF-HANDBOOK\\nFinite-field handbook facts (cyclic multiplicative group, Frobenius, trace/norm surjectivity) in Lean", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "COND-RP-TWO-SUMMAND-FAMILY-LAW" [label="COND-RP-TWO-SUMMAND-FAMILY-LAW\\nTwo-summand pair-table IC family costs ~0.75 r^(1/6) in S units: no crossover with rho\\nops(F) = F^2/(4t) + c #E/(2kF);  S_family ~ 0.75 r^(1/6)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-SUBSPACE-PRODUCT-BOUND" [label="THM-RP-SUBSPACE-PRODUCT-BOUND\\nField Kneser/Vosper product bound: dim V^(2) >= 2l-1, equality only for progressions (A-FB1)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-AUTOMORPHISM-ORBIT-FOLD" [label="THM-RP-AUTOMORPHISM-ORBIT-FOLD\\nAutomorphism-orbit factor bases: psi(G) = [lambda]G with per-instance checks (A-FB3)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-TRACE-ZERO-DOUBLING" [label="THM-RP-TRACE-ZERO-DOUBLING\\nTrace-zero bases lie in 2E and double the yield at the same degree (A-FB4)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-WEIL-LIFT-SOUNDNESS" [label="THM-RP-WEIL-LIFT-SOUNDNESS\\nWeil descent is sound but solutions need lift checks (A-PDP2)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-S3-LINEAR-HALF-TRACE" [label="THM-RP-S3-LINEAR-HALF-TRACE\\nS3 is F_2-linear in (e1,e2): linearized half-trace two-point PDP (A-PDP8)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-COFACTOR4-RANK-SHORTFALL" [label="THM-RP-COFACTOR4-RANK-SHORTFALL\\nCofactor-4 curves: two-summand relation space has rank C-1 (A-RC3/A-LA4)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-RP-VOLCANO-STRUCTURE" [label="THM-RP-VOLCANO-STRUCTURE\\nOrdinary l-isogeny components are volcanoes (A-ISO1)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "COND-RP-LINEARIZED-SUBSPACE-FLOOR" [label="COND-RP-LINEARIZED-SUBSPACE-FLOOR\\nLinearized k-point subspace IC needs relation work >= 2^(2n/3)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
  }
  subgraph cluster_attacks {
    label="Algorithms and special-family attacks"; color="#cad5df"; style="rounded";
    "ALG-POHLIG-HELLMAN" [label="ALG-POHLIG-HELLMAN\\nPohlig-Hellman order decomposition", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-BSGS" [label="ALG-BSGS\\nBaby-step giant-step", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-POLLARD-RHO" [label="ALG-POLLARD-RHO\\nPollard rho collision search\\nT = O(sqrt(r))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-RHO-AUTOMORPHISM" [label="ALG-RHO-AUTOMORPHISM\\nAutomorphism-folded rho", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ATTACK-SMART-TRACE-ONE" [label="ATTACK-SMART-TRACE-ONE\\nSmart anomalous-curve attack", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-MOV-PAIRING" [label="ATTACK-MOV-PAIRING\\nMOV pairing transfer", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-GHS-WEIL-DESCENT" [label="ATTACK-GHS-WEIL-DESCENT\\nGHS Weil-descent attack\\nT = O(q^(2+epsilon)) for fixed n", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-DIEM-EXTENSION" [label="ATTACK-DIEM-EXTENSION\\nDiem extension-field index calculus\\nT = exp(O(max(log q, n^2)))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ATTACK-SHOR-QUANTUM" [label="ATTACK-SHOR-QUANTUM\\nShor quantum discrete-log algorithm", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-PARALLEL-COLLISION" [label="ALG-PARALLEL-COLLISION\\nDistinguished-point parallel collision search\\nT_detect=(sqrt(pi N/(2u))/m + 1/theta) t", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-KANGAROO-INTERVAL" [label="ALG-KANGAROO-INTERVAL\\nPollard lambda/kangaroo interval DLP\\nT=O(sqrt(W))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ATTACK-CHEON-AUXILIARY" [label="ATTACK-CHEON-AUXILIARY\\nCheon auxiliary-input attack\\nT=O(sqrt(r/d)+sqrt(d))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ATTACK-FREY-RUECK" [label="ATTACK-FREY-RUECK\\nFrey-Rueck Tate-pairing transfer", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "FACT-FIELD-DLP-AFTER-PAIRING" [label="FACT-FIELD-DLP-AFTER-PAIRING\\nTarget finite-field DLP governs pairing attack", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-SPARSE-LINEAR-ALGEBRA" [label="ALG-SPARSE-LINEAR-ALGEBRA\\nSparse relation-matrix solving\\nT_LA roughly O(m B^2), storage O(mB)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GAUDRY-FIXED-EXTENSION" [label="ALG-GAUDRY-FIXED-EXTENSION\\nGaudry fixed-extension index calculus\\nT=soft-O(q^(2-2/n)) for fixed n", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "COND-PKM-PRIME-ALGEBRAIC" [label="COND-PKM-PRIME-ALGEBRAIC\\nPKM prime-field algebraic route", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-BINARY-WEIL-DESCENT" [label="COND-BINARY-WEIL-DESCENT\\nBinary summation-polynomial Weil descent", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ESTIMATE-QUANTUM-ROETTELER" [label="ESTIMATE-QUANTUM-ROETTELER\\n2017 logical quantum circuit estimate\\nQ<=9n+2 ceil(log2 n)+10; Toffoli<=448 n^3 log2(n)+4090 n^3", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ESTIMATE-QUANTUM-HAENER" [label="ESTIMATE-QUANTUM-HAENER\\n2020 reversible-circuit tradeoff frontier", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ESTIMATE-QUANTUM-CAT-2023" [label="ESTIMATE-QUANTUM-CAT-2023\\n2023 repetition-cat physical estimate\\n126133 cat qubits; 9 h; mean 19 photons/cat under stated assumptions", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ESTIMATE-QUANTUM-IONQ-2026" [label="ESTIMATE-QUANTUM-IONQ-2026\\n2026 trapped-ion secp256k1 preprint estimate\\n~1450 logical qubits; 40e6 Toffoli; 19397 physical qubits; 25.7 d; estimated success 63%", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "BOUNDARY-INVALID-CURVE" [label="BOUNDARY-INVALID-CURVE\\nInvalid-curve and small-subgroup boundary", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-COPPERSMITH-LOW-HAMMING" [label="ALG-COPPERSMITH-LOW-HAMMING\\nCoppersmith low-weight meet-in-the-middle\\nE[T] = O(sqrt(w) * binom(n/2,w/2)); S = O(binom(n/2,w/2))", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "THEOREM-RHO-THREE-PARTITION" [label="THEOREM-RHO-THREE-PARTITION\\nRigorous three-partition rho bound\\nT = O_epsilon(sqrt(r) log(r)^3)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
    "ALG-GAUDRY-SCHOST-TWO-DIMENSIONAL" [label="ALG-GAUDRY-SCHOST-TWO-DIMENSIONAL\\nGaudry-Schost two-dimensional walk\\nE[T] = (2.43+o(1)) N", fillcolor="#fce8d8", color="#b45309", style="rounded,filled,dashed"];
    "ALG-STATIC-DH-AUXILIARY-POWERS" [label="ALG-STATIC-DH-AUXILIARY-POWERS\\nStatic-DH auxiliary-power attack\\nT = O((sqrt((r-1)/d)+sqrt(d))log(r)); Q = d", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "RED-PAIRING-CO-DDH" [label="RED-PAIRING-CO-DDH\\nPairing decision reduction", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-NAGAO-2015-COMPLEXITY" [label="COND-NAGAO-2015-COMPLEXITY\\nNagao 2015/984: polynomial-time binary ECDLP under FFDA\\nO(n^(8w+1))", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "COND-ECC2K130-FFDA-PROJECTION" [label="COND-ECC2K130-FFDA-PROJECTION\\nECC2K-130 IC projection 2^86 (FFDA)\\n2^86.0 at n = 131", fillcolor="#fde2e2", color="#a33a3a", style="rounded,filled"];
    "ALG-RP-VELU-COST" [label="ALG-RP-VELU-COST\\nVelu O(l) and sqrt-Velu O~(sqrt l) isogeny evaluation (A-ISO5)", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
  }
  subgraph cluster_evidence {
    label="Measured and heuristic evidence"; color="#cad5df"; style="rounded";
