    "THM-LEFT-KERNEL-RELATIONS" [label="THM-LEFT-KERNEL-RELATIONS\\nLeft-kernel index calculus: no rank condition, failure density exactly 1/q (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-HAZARD-MARGINAL-SUFFICES" [label="THM-HAZARD-MARGINAL-SUFFICES\\nPer-trial marginal bounds give the linear waiting time (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-MARGINAL-IMPLIES-HAZARD" [label="CLAIM-MARGINAL-IMPLIES-HAZARD\\n'Per-trial success bounds give the conditional-hazard recurrence'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-HAZARD-SEPARATION" [label="CEX-HAZARD-SEPARATION\\nThree-point model: marginals <= 1/3, hazard recurrence fails (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-SD-DEGREE2-CRITERION" [label="THM-SD-DEGREE2-CRITERION\\nSolving degree >= 3 when k + rank(quadratic parts) > |F| (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-NAGAO-LEMMA4-LITERAL-INSIDE" [label="THM-NAGAO-LEMMA4-LITERAL-INSIDE\\nNagao Lemma 4 holds in the literal >=, field-equations-inside cell (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-PA-ZERO-HASH-FORGERY" [label="CEX-PA-ZERO-HASH-FORGERY\\nConstant-zero challenge: (sP, 0, s) verifies for every key (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-PA-PEDERSEN-UNCONDITIONAL-BINDING" [label="CLAIM-PA-PEDERSEN-UNCONDITIONAL-BINDING\\n'Pedersen commitments with independent generators are binding unconditionally'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-PA-PEDERSEN-ALTERNATE-OPENING" [label="CEX-PA-PEDERSEN-ALTERNATE-OPENING\\nH = tG gives commit(m, r) = commit(m + t, r - 1) (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-PA-COFACTOR-PRESERVES-SUBGROUP" [label="CLAIM-PA-COFACTOR-PRESERVES-SUBGROUP\\n'Cofactor clearing maps onto the prime subgroup bijectively'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-PA-COFACTOR-ZMOD9" [label="CEX-PA-COFACTOR-ZMOD9\\nIn Z/9, cofactor 3 kills the order-3 subgroup; coprime cofactors are bijective (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-PA-PAIRING-DECIDES-DDH" [label="THM-PA-PAIRING-DECIDES-DDH\\nA nondegenerate pairing decides DDH with one evaluation (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CEX-PA-AMBIENT-BLINDING" [label="CEX-PA-AMBIENT-BLINDING\\nAmbient blinding leaves the subgroup; subgroup blinding is a bijection (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-PA-ZK-IMPLIES-SOUND" [label="CLAIM-PA-ZK-IMPLIES-SOUND\\n'Complete, zero-knowledge protocols are sound'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-PA-ALWAYS-ACCEPT" [label="CEX-PA-ALWAYS-ACCEPT\\nAlways-accept protocol: complete, simulatable, unsound (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-SD-SUBSPACE-CRITERION" [label="THM-SD-SUBSPACE-CRITERION\\nLinear-count criterion for any finite-dimensional subspace: d_lin <= sd (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-BOOLEAN-NSS-UNIQUE" [label="THM-BOOLEAN-NSS-UNIQUE\\nUnique F_2-solution puts every X_i - z_i in the ideal (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "THM-MEAN-COUNT-IDENTITY" [label="THM-MEAN-COUNT-IDENTITY\\nMean ordered representation count is exactly |F|^m / |G| (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
    "CLAIM-SHOUP-ALL-ALGORITHMS" [label="CLAIM-SHOUP-ALL-ALGORITHMS\\n'Every algorithm needs Omega(sqrt r) group operations for DLP in a prime-order group'\\nREFUTED", fillcolor="#f8c9c9", color="#a33a3a", style="rounded,filled", penwidth=2];
    "CEX-TRANSPARENT-ENCODING" [label="CEX-TRANSPARENT-ENCODING\\nZ/r with the identity encoding: the logarithm is the encoding (Lean)", fillcolor="#dff4e5", color="#257942", style="rounded,filled"];
  }
