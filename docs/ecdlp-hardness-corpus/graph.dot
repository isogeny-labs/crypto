    "COND-XT-BD-BN-100BIT" [label="COND-XT-BD-BN-100BIT\\nBD: the 3072-bit BN curve offers about 100 bits, not 128\\n2^98.65 + 2^98.73 = 2^99.69", fillcolor="#fce8d8", color="#b45309", style="rounded,filled"];
