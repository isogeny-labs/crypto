digraph comparison {
  graph [rankdir=TB, bgcolor="white", pad=0.12, nodesep=0.24, ranksep=0.20,
         label="Exact synthetic outcomes  |  PCC-unverified", labelloc=t, fontname="DejaVu Sans", fontsize=13];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  coverage [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3">
      <TR><TD COLSPAN="3"><B>Uniform-target coverage</B></TD></TR>
      <TR><TD ALIGN="LEFT">Residue space</TD><TD>Fixture A</TD><TD>Fixture B</TD></TR>
      <TR><TD ALIGN="LEFT">19 (two moments tied)</TD><TD BGCOLOR="#DDE9F7">15 / 19</TD><TD BGCOLOR="#B7D5F3">19 / 19</TD></TR>
      <TR><TD ALIGN="LEFT">23 (three moments tied)</TD><TD BGCOLOR="#DDE9F7">18 / 23</TD><TD BGCOLOR="#B7D5F3">20 / 23</TD></TR>
    </TABLE>>];
  rank [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLPADDING="3">
      <TR><TD COLSPAN="3"><B>Matrix rank over F101</B></TD></TR>
      <TR><TD ALIGN="LEFT">Observable</TD><TD>Fixture A</TD><TD>Fixture B</TD></TR>
      <TR><TD ALIGN="LEFT">Signed graph rank</TD><TD BGCOLOR="#E5F2E6">3</TD><TD BGCOLOR="#BEE4C5">4</TD></TR>
      <TR><TD ALIGN="LEFT">Auxiliary fixture total rank</TD><TD BGCOLOR="#E5F2E6">3</TD><TD BGCOLOR="#E5F2E6">3</TD></TR>
      <TR><TD ALIGN="LEFT">Auxiliary fixture primary rank</TD><TD BGCOLOR="#BEE4C5">2</TD><TD BGCOLOR="#E5F2E6">1</TD></TR>
    </TABLE>>];
  { rank=same; coverage; rank; }
  coverage -> rank [style=invis];
}
