{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness-independent experiment run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "spec_sha256", "job", "workspace", "paths", "checkpoint", "status", "resume"],
  "properties": {
    "schema": {"const": "experiment.run/v1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "spec_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workspace": {"type": "string", "description": "Workspace location hint; --root can select a coherently copied workspace."},
    "job": {
      "type": "object",
      "required": ["id", "cwd", "argv", "checkpoint_contract"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "cwd": {"type": "string"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "checkpoint_contract": {"enum": ["manifest-sha256-v1", "atomic-files-and-sigterm-v1"]}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "checkpoint", "output", "stdout", "stderr"],
      "properties": {
        "record": {"type": "string", "pattern": "^state/[A-Za-z0-9_-]+/run\\.json$"},
        "checkpoint": {"type": "string", "pattern": "^state/[A-Za-z0-9_-]+/checkpoint$"},
        "output": {"type": "string", "pattern": "^state/[A-Za-z0-9_-]+/output$"},
        "stdout": {"type": "string", "pattern": "^state/[A-Za-z0-9_-]+/stdout\\.log$"},
        "stderr": {"type": "string", "pattern": "^state/[A-Za-z0-9_-]+/stderr\\.log$"}
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["contract", "selection", "validation", "last_selected"],
      "properties": {
        "contract": {"enum": ["manifest-sha256-v1", "atomic-files-and-sigterm-v1"]},
        "selection": {"const": "latest-at-resume"},
        "validation": {"enum": ["sha256-manifest", "application-managed"]},
        "last_selected": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["manifest", "generation"], "properties": {
              "manifest": {"type": "string"}, "generation": {"type": "integer", "minimum": 0}
            }}
          ]
        }
      }
    },
    "status": {
      "type": "object",
      "required": ["phase", "observed_unix"],
      "properties": {
        "phase": {"enum": ["unknown", "preparing", "running", "interrupted", "failed", "blocked", "complete"]},
        "observed_unix": {"type": "number", "minimum": 0},
        "attempt_id": {"type": "string"},
        "started_unix": {"type": "number"},
        "host": {"type": "string"},
        "pid": {"type": "integer", "minimum": 1},
        "exit_code": {"type": ["integer", "null"]},
        "reason": {"type": "string"}
      }
    },
    "resume": {
      "type": "object",
      "required": ["policy", "argv"],
      "properties": {
        "policy": {"const": "resume-only"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"},
          "description": "Submission command. The CLI validates the record and queues work; it never evaluates shell text from the record."}
      }
    }
  }
}
