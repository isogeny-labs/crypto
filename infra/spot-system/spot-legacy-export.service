[Unit]
Description=Export authorized legacy memory checkpoints to private encrypted S3
After=network-online.target spot-legacy-checkpoint.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/spot-criu/criu_export.py --root /var/lib/spot-criu-managed --staging /var/lib/spot-criu-export --authorization /var/lib/spot-criu-managed/export-authorization.json
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=0
